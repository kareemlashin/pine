//@version=6
indicator("EGX Volume Up/Down index", shorttitle="EGX VUD", overlay=false, max_tables_count=2, calc_bars_count=5000)

// حجم أيام صاعدة vs هابطة · docs/EGX_VOLUME.md

string G = "Index"
int roll = input.int(20, "Roll", minval=5, group=G)
float minBias = input.float(1.15, "Bias ratio", step=0.05, group=G)

float upV = close >= open ? volume : 0.0
float dnV = close < open ? volume : 0.0
float sumUp = ta.sma(upV, roll) * roll
float sumDn = ta.sma(dnV, roll) * roll
float ratio = sumDn > 0 ? sumUp / sumDn : sumUp > 0 ? 99.0 : 1.0
float idx = sumUp + sumDn > 0 ? (sumUp - sumDn) / (sumUp + sumDn) * 100.0 : 0.0

bool bullBias = ratio >= minBias and idx > 0
bool bearBias = ratio <= 1.0 / minBias and idx < 0

plot(idx, "UD index", color=idx >= 0 ? color.lime : color.red, linewidth=2)
plot(ratio, "Up/Dn ratio", color=color.orange, linewidth=1)
hline(0, "0", color=color.gray)
hline(minBias, "Bull", color=color.new(color.lime, 60))
hline(1.0 / minBias, "Bear", color=color.new(color.red, 60))

var table t = table.new(position.top_left, 2, 4, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 3)
    table.cell(t, 0, 0, "Up/Down V", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, bullBias ? "BULL" : bearBias ? "BEAR" : "Mix", text_size=size.tiny)
    table.cell(t, 0, 1, "Idx/R", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(idx, "#") + " / " + str.tostring(ratio, "#.##"), text_size=size.tiny)

plot(bullBias ? 1 : 0, "EGVUD_Bull", display=display.all)
plot(bearBias ? 1 : 0, "EGVUD_Bear", display=display.all)
plot(idx, "EGVUD_Idx", display=display.all)

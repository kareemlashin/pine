// ─── Preset EGX → قيم فعّالة (ت override المدخلات عند ≠ مخصص) ─────────────────
float effMinAvgVol = i_minAvgVol
int   effVolWinTop = i_volWinTop
float effDecMinRvol = i_decMinRvol
float effScoreBuy = i_scoreBuy
float effScoreWatch = i_scoreWatch
float effRvolClimax = i_rvolClimax

if i_egxPreset == "يومي EGX (252)"
    effMinAvgVol := 2000.0
    effVolWinTop := 252
    effDecMinRvol := 0.85
    effScoreBuy := 62.0
    effScoreWatch := 52.0
    effRvolClimax := 2.0
else if i_egxPreset == "مضاربة 60m"
    effMinAvgVol := 5000.0
    effVolWinTop := 120
    effDecMinRvol := 1.05
    effScoreBuy := 58.0
    effScoreWatch := 50.0
    effRvolClimax := 2.2
else if i_egxPreset == "استثمار أسبوعي"
    effMinAvgVol := 800.0
    effVolWinTop := 104
    effDecMinRvol := 0.75
    effScoreBuy := 60.0
    effScoreWatch := 50.0
    effRvolClimax := 1.8

// ─── MTF helpers (حساب داخل security لتفادي repainting/state خاطئ) ─────────────
f_trendPack() =>
    int sc = 0
    float c = close
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    float e100 = ta.ema(close, 100)
    sc += c > e20 ? 1 : c < e20 ? -1 : 0
    sc += e20 > e50 ? 1 : e20 < e50 ? -1 : 0
    sc += e50 > e100 ? 1 : e50 < e100 ? -1 : 0
    sc

f_structPack(int plen) =>
    var float sh1 = na
    var float sh2 = na
    var float sl1 = na
    var float sl2 = na
    float ph = ta.pivothigh(high, plen, plen)
    float pl = ta.pivotlow(low, plen, plen)
    if not na(ph)
        sh2 := sh1
        sh1 := ph
    if not na(pl)
        sl2 := sl1
        sl1 := pl
    int bias = 0
    if not na(sh1) and not na(sh2) and not na(sl1) and not na(sl2)
        bool hh = sh1 > sh2
        bool hl = sl1 > sl2
        bool lh = sh1 < sh2
        bool ll = sl1 < sl2
        if hh and hl
            bias := 1
        else if lh and ll
            bias := -1
    bias

f_secTrend(string tf) =>
    request.security(syminfo.tickerid, tf, f_trendPack(), barmerge.gaps_off, barmerge.lookahead_off)

f_secStruct(string tf) =>
    request.security(syminfo.tickerid, tf, f_structPack(i_pivotLen), barmerge.gaps_off, barmerge.lookahead_off)

// ─── مؤشرات محلية ────────────────────────────────────────────────────────────
float ema20  = ta.ema(close, 20)
float ema50  = ta.ema(close, 50)
float ema100 = ta.ema(close, 100)
float ema200 = ta.ema(close, 200)
plot(i_showEMA ? ema20 : na, "EMA20", color=color.new(color.blue, 35))
plot(i_showEMA ? ema50 : na, "EMA50", color=color.new(color.orange, 35))
plot(i_showEMA ? ema100 : na, "EMA100", color=color.new(color.purple, 45))
plot(i_showEMA ? ema200 : na, "EMA200", color=color.new(color.fuchsia, 35), linewidth=2)

bool  vwapOk = timeframe.isintraday
float vwapVal = ta.vwap(hlc3)
plot(i_showVWAP and vwapOk ? vwapVal : na, "VWAP", color=color.new(color.yellow, 0), linewidth=2)

float rsi = ta.rsi(close, i_rsiLen)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
float atr = ta.atr(i_atrLen)
[diPlus, diMinus, adx] = ta.dmi(i_adxLen, i_adxLen)

plot(i_showMomPane ? rsi : na, "RSI", color=color.new(color.purple, 0), linewidth=2, display=display.pane)
plot(i_showMomPane ? adx : na, "ADX", color=color.new(color.orange, 0), linewidth=1, display=display.pane)
hline(70, "RSI 70", color=color.new(color.red, 50), linestyle=hline.style_dotted, display=i_showMomPane ? display.pane : display.none)
hline(30, "RSI 30", color=color.new(color.green, 50), linestyle=hline.style_dotted, display=i_showMomPane ? display.pane : display.none)
hline(25, "ADX 25", color=color.new(color.gray, 60), linestyle=hline.style_dashed, display=i_showMomPane ? display.pane : display.none)

// ─── أدوات انتشار عالمي + شائعة في EGX ───────────────────────────────────────
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
plot(i_showBB ? bbMid : na, "BB Mid", color=color.new(color.gray, 50))
plot(i_showBB ? bbUp : na, "BB Up", color=color.new(color.blue, 60))
plot(i_showBB ? bbLo : na, "BB Lo", color=color.new(color.blue, 60))

[stLine, stDir] = ta.supertrend(i_stFactor, i_stLen)
plot(i_showST ? stLine : na, "Supertrend", color=stDir < 0 ? i_colBear : i_colBull, linewidth=2)

float stK = ta.sma(ta.stoch(close, high, low, 14), 3)
float stD = ta.sma(stK, 3)

[dH, dL, dC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)
float pp = (dH + dL + dC) / 3.0
float pivR1 = 2.0 * pp - dL
float pivR2 = pp + (dH - dL)
float pivS1 = 2.0 * pp - dH
float pivS2 = pp - (dH - dL)
plot(i_showClassicPiv ? pp : na, "PP", color=color.new(color.white, 40), linewidth=1, style=plot.style_circles)
plot(i_showClassicPiv ? pivR1 : na, "R1", color=color.new(color.red, 50), linewidth=1, style=plot.style_linebr)
plot(i_showClassicPiv ? pivS1 : na, "S1", color=color.new(color.green, 50), linewidth=1, style=plot.style_linebr)

float wkHigh = ta.highest(high, i_wk252)
float wkLow  = ta.lowest(low, i_wk252)
float pctFromWkHigh = wkHigh > 0 ? (close - wkHigh) / wkHigh * 100.0 : na
float pctFromWkLow  = wkLow > 0 ? (close - wkLow) / wkLow * 100.0 : na

float benchC = i_useBench ? request.security(i_benchSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off) : na
float rsRatio = not na(benchC) and benchC > 0 ? close / benchC : na
float rsMom = not na(rsRatio) and rsRatio[20] > 0 ? (rsRatio / rsRatio[20] - 1.0) * 100.0 : na

f_regimePack() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : close < e20 ? -1 : 0
    sc += close > e50 ? 1 : close < e50 ? -1 : 0
    sc

int regime30 = i_useRegime ? request.security(i_benchSym, timeframe.period, f_regimePack(), barmerge.gaps_off, barmerge.lookahead_off) : 0
int regime70 = i_useRegime ? request.security(i_egx70Sym, timeframe.period, f_regimePack(), barmerge.gaps_off, barmerge.lookahead_off) : 0
string marketRegime = not i_useRegime ? "—" : regime30 > 0 and regime70 > 0 ? f_txt("صعود واسع", "Broad rally") : regime30 > 0 and regime70 <= 0 ? f_txt("صعود ضيق — EGX30 يقود", "Narrow — EGX30 leads") : regime30 <= 0 and regime70 <= 0 ? f_txt("ضغط سوقي", "Market pressure") : f_txt("مختلط / قطاعي", "Mixed / sector")
string regimeHint = regime30 > regime70 ? f_txt("السهم vs سوق: تحقق RS", "Stock vs mkt: check RS") : f_txt("انتشار أضعف على 70", "Weaker breadth on 70")

int globBull = 0
globBull += close > ema20 ? 1 : -1
globBull += close > ema50 ? 1 : -1
globBull += macdH > 0 ? 1 : -1
globBull += rsi > 50 ? 1 : rsi < 40 ? -1 : 0
globBull += close > stLine ? 1 : -1
globBull += close > pp ? 1 : close < pp ? -1 : 0
globBull += not na(rsMom) and rsMom > 0 ? 1 : not na(rsMom) and rsMom < 0 ? -1 : 0

string globVerdict = globBull >= 4 ? f_txt("توافق عالمي/محلي — صاعد", "Global/local bull") : globBull <= -3 ? f_txt("توافق سلبي", "Bearish consensus") : f_txt("مختلط — شائع في EGX", "Mixed — typical EGX")
string egxToolkit = f_txt("EMA+RSI+MACD+حجم+Pivot+ST", "EMA+RSI+MACD+Vol+Pivot+ST")

bool barOk = i_confirmOnly ? barstate.isconfirmed : true

// ─── Pivot / BOS / CHoCH ───────────────────────────────────────────────────────
float pHigh = ta.pivothigh(high, i_pivotLen, i_pivotLen)
float pLow  = ta.pivotlow(low, i_pivotLen, i_pivotLen)

var float swingHigh = na
var float swingLow  = na
var float prevSwingHigh = na
var float prevSwingLow  = na
var int   structBias = 0
var int   zoneTestsSupport = 0
var int   zoneTestsResist  = 0

if not na(pHigh)
    prevSwingHigh := swingHigh
    swingHigh := pHigh
if not na(pLow)
    prevSwingLow := swingLow
    swingLow := pLow

bool bosUp = false
bool bosDn = false
bool chochUp = false
bool chochDn = false

if barOk and not na(swingHigh) and close > swingHigh and close[1] <= nz(swingHigh[1], swingHigh)
    bosUp := true
    if structBias == -1
        chochUp := true
    structBias := 1

if barOk and not na(swingLow) and close < swingLow and close[1] >= nz(swingLow[1], swingLow)
    bosDn := true
    if structBias == 1
        chochDn := true
    structBias := -1

var int fbTimer = 0
var float fbLevel = na
var int fbDir = 0
if bosUp and barOk
    fbTimer := 3
    fbLevel := swingHigh
    fbDir := 1
else if bosDn and barOk
    fbTimer := 3
    fbLevel := swingLow
    fbDir := -1
else if fbTimer > 0
    fbTimer -= 1

bool fakeBreakUp = fbDir == 1 and fbTimer > 0 and close < fbLevel
bool fakeBreakDn = fbDir == -1 and fbTimer > 0 and close > fbLevel
bool trueBreakVol = volume > ta.sma(volume, i_volAvgLen) * 1.2

bool retestSupport = not na(swingLow) and low <= swingLow * 1.005 and close > swingLow and barOk
bool retestResist  = not na(swingHigh) and high >= swingHigh * 0.995 and close < swingHigh and barOk

if retestSupport and barOk
    zoneTestsSupport += 1
if retestResist and barOk
    zoneTestsResist += 1

float histRes = ta.highest(high, i_srLookback)
float histSup = ta.lowest(low, i_srLookback)

float zoneWidth = atr * i_zoneAtrMult
float demandLo = na(swingLow) ? na : swingLow - zoneWidth
float demandHi = na(swingLow) ? na : swingLow + zoneWidth
float supplyLo = na(swingHigh) ? na : swingHigh - zoneWidth
float supplyHi = na(swingHigh) ? na : swingHigh + zoneWidth

bool gapUp   = low > high[1]
bool gapDown = high < low[1]
plotshape(i_showGaps and gapUp and barOk, "Gap Up", shape.diamond, location.belowbar, color.new(color.aqua, 0), size=size.tiny)
plotshape(i_showGaps and gapDown and barOk, "Gap Down", shape.diamond, location.abovebar, color.new(color.maroon, 0), size=size.tiny)

bool fvgBull = i_showFvg and low > high[2] and close > open
bool fvgBear = i_showFvg and high < low[2] and close < open
float fvgBullTop = low
float fvgBullBot = high[2]
float fvgBearTop = low[2]
float fvgBearBot = high
plotshape(i_showFvg and barOk and fvgBull, "FVG+", shape.square, location.belowbar, color=color.new(color.blue, 70), size=size.tiny, text="FVG")
plotshape(i_showFvg and barOk and fvgBear, "FVG-", shape.square, location.abovebar, color=color.new(color.maroon, 70), size=size.tiny, text="FVG")

// ─── Volume Intelligence ───────────────────────────────────────────────────────
float volAvg = ta.sma(volume, i_volAvgLen)
float rvol   = volAvg > 0 ? volume / volAvg : na
float cmf    = ta.cmf(i_cmfLen)
float obv    = ta.obv
float obvSlope = ta.linreg(obv, 10, 0) - ta.linreg(obv, 10, 1)

var float histMaxVol = na
var int   histMaxVolBarsAgo = 0
var int   histMaxVolTime = na
if na(histMaxVol) or volume >= histMaxVol
    histMaxVol := volume
    histMaxVolBarsAgo := 0
    histMaxVolTime := time
else
    histMaxVolBarsAgo += 1

float maxVol20  = ta.highest(volume, i_rvolLen20)
float maxVol60  = ta.highest(volume, i_rvolLen60)
float maxVol120 = ta.highest(volume, i_rvolLen120)
float maxVol252 = ta.highest(volume, i_rvolLen252)
float volPctRank = ta.percentrank(volume, effVolWinTop)
bool  volTop10Pct = volPctRank >= 90.0

float notionalEst = close * volume
bool  notionalReliable = volume > 0 and close > 0

bool volUpPriceUp   = rvol > 1.2 and close > open
bool volUpPriceDown = rvol > 1.2 and close < open
bool volUpNoProgress = rvol > 1.5 and math.abs(close - open) < atr * 0.15

bool bullDiv = i_showVolDiv and close < close[5] and obv > obv[5] and barOk
bool bearDiv = i_showVolDiv and close > close[5] and obv < obv[5] and barOk
plotshape(bullDiv, "OBV Bull Div", shape.triangleup, location.belowbar, color.new(i_colBull, 30), size=size.tiny)
plotshape(bearDiv, "OBV Bear Div", shape.triangledown, location.abovebar, color.new(i_colBear, 30), size=size.tiny)

int accScore = 0
int distScore = 0
if rvol > 1.0 and math.abs(close - open) < atr * 0.25
    accScore += 1
if low < open and close > (high + low) / 2
    accScore += 1
if not na(swingLow) and low <= swingLow * 1.01 and close > swingLow
    accScore += 1
if cmf > 0.05
    accScore += 1
if obvSlope > 0
    accScore += 1
if retestSupport and rvol < 1.0
    accScore += 1
if bullDiv
    accScore += 1

if rvol > 1.2 and close < open and close < (high + low) / 2
    distScore += 1
if fakeBreakUp or fakeBreakDn
    distScore += 1
if cmf < -0.05
    distScore += 1
if obvSlope < 0
    distScore += 1
if retestResist and rvol > 1.2
    distScore += 1
if volUpNoProgress
    distScore += 1
if bearDiv
    distScore += 1

string volClass = "حجم طبيعي"
float volConf = 30.0
if rvol >= effRvolClimax or volTop10Pct
    if accScore >= 4 and accScore > distScore
        volClass := "تجميع محتمل"
        volConf := math.min(92.0, 38.0 + accScore * 8.0)
    else if distScore >= 4 and distScore > accScore
        volClass := "تصريف محتمل"
        volConf := math.min(92.0, 38.0 + distScore * 8.0)
    else
        volClass := "نشاط مرتفع غير محسوم"
        volConf := 45.0

string volEvidenceFor = accScore >= distScore ? "تجميع" : distScore > accScore ? "تصريف" : "—"
string volEvidenceTxt = "+" + str.tostring(accScore) + " / -" + str.tostring(distScore)

string activityNote = rvol >= effRvolClimax ? "حجم استثنائي — تقدير نشاط (≠ Delta/Footprint)" : "—"

// ─── Volume footprint (تقديرات OHLCV — غير مباشرة) ───────────────────────────
float spreadBar = high - low
float closeInBar = spreadBar > syminfo.mintick ? (close - low) / spreadBar : 0.5
string volIntel = closeInBar > 0.65 and rvol > 1.1 ? "ضغط شراء تقديري" : closeInBar < 0.35 and rvol > 1.1 ? "ضغط بيع تقديري" : rvol > 1.5 and closeInBar > 0.45 and closeInBar < 0.55 ? "امتصاص تقديري" : "محايد"
float volIntelScore = closeInBar > 0.65 and rvol > 1.1 ? 72.0 : closeInBar < 0.35 and rvol > 1.1 ? 28.0 : volUpNoProgress ? 45.0 : 50.0

// ─── Time module (محسّن) ───────────────────────────────────────────────────────
var int barsSincePivot = 0
var int barsSincePH = 0
var int barsSincePL = 0
if not na(pHigh) or not na(pLow)
    barsSincePivot := 0
else
    barsSincePivot += 1
if not na(pHigh)
    barsSincePH := 0
else
    barsSincePH += 1
if not na(pLow)
    barsSincePL := 0
else
    barsSincePL += 1

var int upLegBars = 0
var int dnLegBars = 0
if close > close[1]
    upLegBars += 1
    dnLegBars := 0
else if close < close[1]
    dnLegBars += 1
    upLegBars := 0

int bsPH = ta.barssince(not na(pHigh))
int bsPL = ta.barssince(not na(pLow))
int avgUpCycle = ta.sma(na(bsPH) ? na : float(bsPH), 20)
int avgDnCycle = ta.sma(na(bsPL) ? na : float(bsPL), 20)
float cycleRatio = avgUpCycle > 0 and avgDnCycle > 0 ? avgUpCycle / avgDnCycle : na

var int[] gannCycles = array.from(9, 18, 27, 45, 90)
int timeSyncCount = 0
int nextGann = -1
int nextGannDist = 999
if i_useGannWin
    for i = 0 to array.size(gannCycles) - 1
        int g = array.get(gannCycles, i)
        bool hit = math.abs(barsSincePivot - g) <= i_timeTol or math.abs(upLegBars - g) <= i_timeTol or math.abs(dnLegBars - g) <= i_timeTol
        if hit
            timeSyncCount += 1
        int distG = math.abs(barsSincePivot - g)
        if distG < nextGannDist
            nextGannDist := distG
            nextGann := g

float timeConf = timeSyncCount >= 2 ? 72.0 : timeSyncCount == 1 ? 52.0 : nextGannDist <= 3 ? 42.0 : 22.0
string timeMethod = f_txt("من pivot: ", "From pivot: ") + str.tostring(barsSincePivot) + f_txt(" ش | Gann±", " | Gann±") + str.tostring(i_timeTol)
string timeWindow = i_useGannWin and timeSyncCount > 0 ? timeMethod + " · تزامن " + str.tostring(timeSyncCount) : i_useGannWin and not na(nextGann) ? timeMethod + " · أقرب " + str.tostring(nextGann) + " (" + str.tostring(nextGannDist) + ")" : f_txt("لا نافذة قوية", "No strong window")
string timeInvalidate = f_txt("إبطال: pivot جديد بلا تأكيد · كسر دعم · Gann Miss >±", "Inv: new pivot · support break · Gann miss") + str.tostring(i_timeTol + 3) + f_txt(" ش", " b")
string timeStability = timeSyncCount >= 2 ? f_txt("استقرار: متوسط (≥2 دورة)", "Stability: medium (≥2)") : timeSyncCount == 1 ? f_txt("استقرار: ضعيف (1)", "Stability: weak (1)") : f_txt("استقرار: منخفض", "Stability: low")
string legCompare = upLegBars > dnLegBars ? f_txt("صعود أطول ", "Up leg ") + str.tostring(upLegBars) + f_txt(" ش", " b") : dnLegBars > upLegBars ? f_txt("هبوط أطول ", "Dn leg ") + str.tostring(dnLegBars) + f_txt(" ش", " b") : f_txt("متقارب", "Balanced")
string cycleTxt = na(cycleRatio) ? "—" : f_txt("دورة ق/ق ", "H/L cycle ") + str.tostring(cycleRatio, "#.##") + (cycleRatio > 1.1 ? " · تمدد صعود" : cycleRatio < 0.9 ? " · تمدد هبوط" : "")

// ─── Wave module (Elliott — استكشافي محسّن) ───────────────────────────────────
float wPh = ta.pivothigh(high, i_wavePivot, i_wavePivot)
float wPl = ta.pivotlow(low, i_wavePivot, i_wavePivot)
var float w0 = na
var float w1 = na
var float w2 = na
var float w3 = na
var float w4 = na
if not na(wPl)
    w4 := w3
    w3 := w2
    w2 := w1
    w1 := w0
    w0 := wPl
if not na(wPh)
    w4 := w3
    w3 := w2
    w2 := w1
    w1 := w0
    w0 := wPh

string waveState = "غير محسوم"
string waveMain  = "—"
string waveAlt   = "—"
string wavePhase = "—"
float waveInv = na
float waveTgt1 = na
float waveTgt2 = na

bool haveSwings = not na(w1) and not na(w2) and not na(w3) and not na(w4)
float legA = haveSwings ? math.abs(w1 - w2) : na
float legB = haveSwings ? math.abs(w2 - w3) : na
float legC = haveSwings ? math.abs(w3 - w4) : na
bool wave3NotShortest = haveSwings and legB >= legA and legB >= legC
bool rule4Approx = haveSwings and w3 > w4
float fib382 = haveSwings and legA > 0 ? w1 - legA * 0.382 : na
float fib618 = haveSwings and legA > 0 ? w1 - legA * 0.618 : na

if haveSwings and wave3NotShortest and rule4Approx and structBias == 1
    waveState := "عد صاعد محتمل (1-5)"
    wavePhase := "موجة 3/5 محتملة"
    waveMain := "دافعة — امتداد من " + str.tostring(w2, format.mintick)
    waveAlt := "ABC عند كسر " + str.tostring(nz(swingLow, w4), format.mintick)
    waveInv := na(swingLow) ? w4 - atr * 0.5 : swingLow - atr * 0.5
    waveTgt1 := w1 + legA * 0.618
    waveTgt2 := w1 + legA * 1.0
else if haveSwings and wave3NotShortest and structBias == -1
    waveState := "عد هابط محتمل"
    wavePhase := "موجة C محتملة"
    waveMain := "دافعة هابطة"
    waveAlt := "ارتداد B ثم استئناف"
    waveInv := na(swingHigh) ? w0 + atr : swingHigh + atr * 0.5
    waveTgt1 := w1 - legA * 0.618
    waveTgt2 := w1 - legA * 1.0
else if haveSwings
    waveState := "غير محسوم"
    waveMain := f_txt("قواعد Elliott غير مكتملة", "Elliott rules incomplete")
    waveAlt := f_txt("Fib تصحيح ", "Fib retrace ") + str.tostring(fib618, format.mintick)
    waveInv := na

string wavePack = waveMain + " | " + f_txt("بديل: ", "Alt: ") + waveAlt
string waveFibPack = not na(fib382) ? "Fib38.2 " + str.tostring(fib382, format.mintick) + " · Fib61.8 " + str.tostring(fib618, format.mintick) : "—"
bool waveUnclear = waveState == "غير محسوم"
string waveAltNote = waveUnclear ? f_txt("⚠ أكثر من قراءة — لا تُجبر العد", "⚠ Ambiguous — no forced count") : f_txt("عد أساسي أقوى", "Primary count preferred")

// ─── Targets — تجميع مصادر ثم T1/T2/T3 فوق السعر ─────────────────────────────
f_pickTargets(float refPrice, float a, float b, float c, float d, float e, float f, float g, float h) =>
    float t1 = na
    float t2 = na
    float t3 = na
    string s1 = "—"
    string s2 = "—"
    string s3 = "—"
    for k = 0 to 7
        float v = k == 0 ? a : k == 1 ? b : k == 2 ? c : k == 3 ? d : k == 4 ? e : k == 5 ? f : k == 6 ? g : h
        string nm = k == 0 ? "Fib618" : k == 1 ? "Fib100" : k == 2 ? "Fib1618" : k == 3 ? "Meas" : k == 4 ? "HistR" : k == 5 ? "Wave" : k == 6 ? "PivR1" : "PivR2"
        if not na(v) and v > refPrice
            if na(t1) or v < t1
                if not na(t1)
                    t3 := t2
                    s3 := s2
                    t2 := t1
                    s2 := s1
                t1 := v
                s1 := nm
            else if na(t2) or v < t2
                if not na(t2)
                    t3 := t2
                    s3 := s2
                t2 := v
                s2 := nm
            else if na(t3) or v < t3
                t3 := v
                s3 := nm
    [t1, t2, t3, s1, s2, s3]

float fibBase = na(swingLow) or na(swingHigh) ? na : swingHigh - swingLow
float fib618e = na(fibBase) ? na : swingHigh + fibBase * 0.618
float fib100e = na(fibBase) ? na : swingHigh + fibBase * 1.0
float fib1618e = na(fibBase) ? na : swingHigh + fibBase * 1.618
float measMove = na(swingHigh) or na(swingLow) ? na : swingHigh + (swingHigh - swingLow)
float histT = histRes
float supTgt = na(supplyHi) ? na : supplyHi

[tgt1, tgt2, tgt3, tgtSrc1, tgtSrc2, tgtSrc3] = f_pickTargets(close, fib618e, fib100e, fib1618e, measMove, histT, waveTgt1, pivR1, pivR2)

if na(tgt1)
    tgt1 := close + atr * 1.5
    tgtSrc1 := "ATR"
if na(tgt2)
    tgt2 := close + atr * 2.5
    tgtSrc2 := "ATR"
if na(tgt3)
    tgt3 := close + atr * 4.0
    tgtSrc3 := "ATR"

string tgtPack = "T1 " + str.tostring(tgt1, format.mintick) + " (" + tgtSrc1 + ") · T2 " + str.tostring(tgt2, format.mintick) + " (" + tgtSrc2 + ") · T3 " + str.tostring(tgt3, format.mintick) + " (" + tgtSrc3 + ")"

float clusterLo = math.min(math.min(tgt1, tgt2), tgt3)
float clusterHi = math.max(math.max(tgt1, tgt2), tgt3)
bool targetCluster = math.abs(tgt1 - tgt2) < atr * i_tgtCluster or math.abs(tgt2 - tgt3) < atr * i_tgtCluster or (not na(histT) and math.abs(tgt1 - histT) < atr * i_tgtCluster)
string clusterTxt = targetCluster ? f_txt("توافق عند ", "Cluster ") + str.tostring(clusterLo, format.mintick) + "–" + str.tostring(clusterHi, format.mintick) : f_txt("لا توافق قوي", "No cluster")

// ─── MTF ───────────────────────────────────────────────────────────────────────
int tr15 = i_useMTF15 ? f_secTrend(i_tf15) : 0
int tr60 = i_useMTF60 ? f_secTrend(i_tf60) : 0
int trD  = i_useMTFD ? f_secTrend(i_tfD) : 0
int trW  = i_useMTFW ? f_secTrend(i_tfW) : 0
int trM  = i_useMTFM ? f_secTrend(i_tfM) : 0
int structD = i_useMTFD ? f_secStruct(i_tfD) : 0

string trendTxt = trD > 0 and trW >= 0 ? "صاعد" : trD < 0 and trW <= 0 ? "هابط" : "مختلط / متذبذب"
string mtfLine = "15:" + str.tostring(tr15) + " 60:" + str.tostring(tr60) + " D:" + str.tostring(trD) + " W:" + str.tostring(trW) + " M:" + str.tostring(trM)
int mtfBiasQ = tr15 + tr60 + trD + trW + trM
bool mtfBullOkQ = mtfBiasQ >= 1

// ─── Entry zone / R:R ──────────────────────────────────────────────────────────
float entryConfirm = demandHi
float stopSuggest  = na(demandLo) ? na : demandLo - atr * 0.5
float investInv    = na(swingLow) ? ema200 - atr : swingLow - atr
float swingInv     = stopSuggest

float risk = na(entryConfirm) or na(stopSuggest) ? na : entryConfirm - stopSuggest
float reward1 = na(entryConfirm) ? na : tgt1 - entryConfirm
float rr1 = risk > 0 and not na(reward1) ? reward1 / risk : na

bool inDemandZone = not na(demandLo) and not na(demandHi) and low <= demandHi and high >= demandLo
int zoneStrength = zoneTestsSupport + (volClass == "تجميع محتمل" ? 2 : 0) + (structBias == 1 ? 1 : 0)
bool setupQuality = not na(rr1) and rr1 >= i_minRR and trD >= 0 and accScore >= distScore and volAvg >= effMinAvgVol

string zoneType = inDemandZone ? (retestSupport ? "إعادة اختبار طلب" : "طلب") : "—"
string zoneFor = setupQuality ? "مضاربة+" : trW > 0 ? "استثمار تدريجي؟" : "مراقبة فقط"

f_quantSetupHits() =>
    int h = 0
    h += ema20 > ema50 and ema50 > ema100 ? 1 : 0
    h += trW > 0 and close > ema200 ? 1 : 0
    h += macdH > 0 and macdL > macdS ? 1 : 0
    h += cmf > 0 and obvSlope > 0 ? 1 : 0
    h += not na(rsMom) and rsMom > 0 ? 1 : 0
    h += structBias == 1 ? 1 : 0
    h += inDemandZone ? 1 : 0
    h += retestSupport ? 1 : 0
    h += not na(rr1) and rr1 >= i_minRR ? 1 : 0
    h += globBull >= 5 ? 1 : 0
    h += mtfBullOkQ ? 1 : 0
    h += rvol >= 1.2 or volTop10Pct ? 1 : 0
    h

int setupHits = f_quantSetupHits()
string setupTier = setupHits >= 9 ? "A" : setupHits >= 7 ? "B" : setupHits >= 5 ? "C" : "D"
bool setupOk = i_minSetupHits <= 0 or setupHits >= i_minSetupHits

// ─── Mode A / B scores (0–100 scale) ─────────────────────────────────────────
float swingScore = 50.0
if i_modeSwing
    swingScore += tr60 > 0 ? 15.0 : tr60 < 0 ? -12.0 : 0.0
    swingScore += trD > 0 ? 12.0 : -8.0
    swingScore += bosUp and trueBreakVol ? 12.0 : 0.0
    swingScore += volClass == "تجميع محتمل" ? 10.0 : volClass == "تصريف محتمل" ? -18.0 : 0.0
    swingScore += setupQuality ? 12.0 : -6.0
    swingScore += fakeBreakUp ? -14.0 : 0.0
    swingScore := math.max(0.0, math.min(100.0, swingScore))

float investScore = 50.0
if i_modeInvest
    investScore += trW > 0 ? 18.0 : trW < 0 ? -15.0 : 0.0
    investScore += trM > 0 ? 15.0 : -10.0
    investScore += close > ema200 ? 12.0 : -12.0
    investScore += structD == 1 ? 12.0 : structD == -1 ? -12.0 : 0.0
    investScore += volClass == "تجميع محتمل" ? 10.0 : 0.0
    investScore += volClass == "تصريف محتمل" ? -15.0 : 0.0
    investScore := math.max(0.0, math.min(100.0, investScore))

// Opportunity Score — يُحسب بعد محركات QUANT (أسفل)
var float composite = 50.0
string verdict = "محايد — لا فرصة واضحة"
string scenBull = "—"
string scenBase = "أساسي: " + trendTxt + " | " + volClass
string scenBear = close < nz(swingLow, histSup) ? "هابط: كسر دعم محوري" : "—"
string oppClass = "مراقبة فقط"
float sTrendQ = 50.0
float sVolQ = 50.0
float sEntryQ = 50.0
float sBreakQ = 50.0
float sTimeQ = 50.0
float sWaveQ = 50.0
float sRRQ = 50.0
var string topVolTxt = "—"
var string topVolScopeNote = "—"
var string volBenchTxt = "—"
var string volBenchPctTxt = "—"

// ═══════════════════════════════════════════════════════════════════════════════
// قرار رئيسي: مضاربة | استثمار | دعم | قاع (متعدد الشروط — ليس سعرًا رخيصًا فقط)
// ═══════════════════════════════════════════════════════════════════════════════
bool inSupplyZone = not na(supplyLo) and not na(supplyHi) and low <= supplyHi and high >= supplyLo

float refHigh = ta.highest(high, i_srLookback)
float dropPct = refHigh > 0 ? (refHigh - close) / refHigh * 100.0 : 0.0
float supSwing = swingLow
float supHist  = histSup
float supEma   = ema200
float activeSupport = na(supSwing) ? supHist : supSwing
float distSupAtr = na(activeSupport) ? na : (close - activeSupport) / atr

bool atSwingSup = not na(supSwing) and low <= supSwing + atr * i_nearSupAtr and close >= supSwing * 0.995
bool atHistSup  = low <= supHist + atr * i_nearSupAtr and close >= supHist * 0.995
bool atEmaSup   = low <= ema200 + atr * i_nearSupAtr and close >= ema200 * 0.99
bool atSupport  = atSwingSup or atHistSup or atEmaSup
bool supportHold = barOk and atSupport and close >= open and close > activeSupport
bool supportBreak = barOk and not na(supSwing) and close < supSwing and close[1] >= supSwing

// ─── Accumulation / Distribution 0–100 ───────────────────────────────────────
float atrMaQ = ta.sma(atr, 20)
bool rangeContract = ta.highest(high, i_consolLen) - ta.lowest(low, i_consolLen) < (ta.highest(high, i_consolLen * 2) - ta.lowest(low, i_consolLen * 2)) * 0.55
bool volExpand = atr > atrMaQ * 0.95 and atr[5] < atrMaQ[5] * i_squeezePct
bool volUpTight = rvol > 1.2 and math.abs(close - open) < atr * 0.22
bool closeImprove = close > ta.sma(close, 5) and close > open
bool supportDefense = zoneTestsSupport >= 2
bool failedLow = not na(swingLow) and low <= swingLow * 1.008 and close > swingLow
bool volRangeShift = volUpNoProgress and cmf > 0

float accPts = 0.0
accPts += rangeContract ? 12.0 : 0.0
accPts += volExpand ? 10.0 : 0.0
accPts += volUpTight ? 14.0 : 0.0
accPts += closeImprove ? 8.0 : 0.0
accPts += supportDefense ? 10.0 : 0.0
accPts += failedLow ? 12.0 : 0.0
accPts += retestSupport ? 10.0 : 0.0
accPts += fakeBreakDn ? 8.0 : 0.0
accPts += volRangeShift ? 8.0 : 0.0
accPts += cmf > 0.05 ? 8.0 : 0.0
accPts += obvSlope > 0 ? 8.0 : 0.0
float accumScore100 = math.min(100.0, accPts)

float distPts = 0.0
distPts += not na(swingHigh) and rvol > 1.15 and high >= swingHigh * 0.99 and close < (high + low) / 2 ? 14.0 : 0.0
distPts += volUpPriceDown ? 12.0 : 0.0
distPts += zoneTestsResist >= 2 ? 10.0 : 0.0
distPts += volUpNoProgress and close < open ? 12.0 : 0.0
distPts += atr > atrMaQ * 1.15 and trD > 0 ? 8.0 : 0.0
distPts += fakeBreakUp ? 14.0 : 0.0
distPts += supportBreak ? 16.0 : 0.0
distPts += bearDiv ? 10.0 : 0.0
distPts += cmf < -0.05 ? 8.0 : 0.0
distPts += obvSlope < 0 ? 8.0 : 0.0
float distRisk100 = math.min(100.0, distPts)

string accFactors = (rangeContract ? "نطاق↓ " : "") + (volUpTight ? "حجم/مدى " : "") + (supportDefense ? "دفاع دعم " : "") + (failedLow ? "فشل قيعان " : "") + (closeImprove ? "إغلاقات " : "")
string distFactors = (fakeBreakUp ? "اختراق كاذب " : "") + (volUpPriceDown ? "حجم↓سعر " : "") + (zoneTestsResist >= 2 ? "فشل قمة " : "") + (supportBreak ? "كسر دعم " : "")

// ─── Breakout engine ─────────────────────────────────────────────────────────
float consolHi = ta.highest(high, i_consolLen)
float consolLo = ta.lowest(low, i_consolLen)
float consolMid = (consolHi + consolLo) / 2.0
bool squeezeOn = atr < atrMaQ * i_squeezePct
bool nearRes = not na(swingHigh) and high >= swingHigh * 0.985 and close < swingHigh
bool breakEarly = not na(swingHigh) and close > swingHigh and not barOk
bool breakConfirmed = barOk and bosUp and trueBreakVol and close > consolHi
bool breakFailed = fakeBreakUp or (barOk and high > nz(swingHigh, consolHi) and close < nz(swingHigh, consolHi))
bool breakRetest = barOk and bosUp[1] and retestSupport

string ST_BRK_FAIL = "فشل اختراق"
string ST_BRK_CONF = "اختراق مؤكد"
string ST_BRK_RT = "إعادة اختبار"
string ST_BRK_EARLY = "اختراق مبكر"
string ST_BRK_WATCH = "قائمة مراقبة"
string breakState = breakFailed ? ST_BRK_FAIL : breakConfirmed ? ST_BRK_CONF : breakRetest ? ST_BRK_RT : breakEarly ? ST_BRK_EARLY : squeezeOn and nearRes and rangeContract ? ST_BRK_WATCH : "—"
float breakScore = breakConfirmed ? 88.0 : breakRetest ? 72.0 : breakEarly ? 55.0 : squeezeOn and nearRes ? 48.0 : breakFailed ? 15.0 : 35.0
bool extended52 = not na(pctFromWkHigh) and pctFromWkHigh > -3.0
bool chaseWarn = extended52 and rsi > i_chaseRsiMax and (na(rr1) or rr1 < i_chaseRrBelow)

// ─── خطط دخول (3) ────────────────────────────────────────────────────────────
float planConsEntry = entryConfirm
float planConsStop = stopSuggest
float planEarlyEntry = na(demandLo) ? close : demandLo
float planEarlyStop = na(demandLo) ? close - atr * 2 : demandLo - atr * 0.8
float planDca1 = na(fib382) ? nz(demandLo, ema200) : fib382
float planDca2 = nz(demandLo, ema200)
float planDca3 = ema200
float rrCons = risk > 0 and not na(reward1) ? reward1 / risk : na
float riskEarly = planEarlyEntry - planEarlyStop
float rrEarly = riskEarly > 0 ? (tgt1 - planEarlyEntry) / riskEarly : na
string planPack = "محافظ " + str.tostring(planConsEntry, format.mintick) + " SL " + str.tostring(planConsStop, format.mintick) + " RR " + str.tostring(rrCons, "#.##") + " | مبكر " + str.tostring(planEarlyEntry, format.mintick) + " | DCA " + str.tostring(planDca1, format.mintick) + "/" + str.tostring(planDca2, format.mintick)

string invalidateTxt = supportBreak ? "كسر دعم " + str.tostring(supSwing, format.mintick) : fakeBreakUp ? "فشل اختراق" : not na(waveInv) ? "موجي " + str.tostring(waveInv, format.mintick) : volClass == "تصريف محتمل" ? "تصريف محتمل" : "—"

// ─── قاعدة سعرية (Wave Hunter) ───────────────────────────────────────────────
float rangeHiBase = ta.highest(high, i_baseLook)
float rangeLoBase = ta.lowest(low, i_baseLook)
float rangePctBase = rangeLoBase > 0 ? (rangeHiBase - rangeLoBase) / rangeLoBase * 100.0 : na
bool atrCompressBase = atrMaQ > 0 and atr / atrMaQ <= i_compressBase
bool tightRangeBase = not na(rangePctBase) and rangePctBase < 18.0
var int barsInBase = 0
bool inBaseZone = tightRangeBase and atrCompressBase and (structBias <= 0 or trD <= 0)
if inBaseZone
    barsInBase += 1
else
    barsInBase := 0
bool higherLows = not na(swingLow) and not na(swingLow[1]) and swingLow > swingLow[1]
bool baseCandidate = barsInBase >= i_baseMinBars or (inBaseZone and higherLows)
float baseScore = math.min(100.0, barsInBase / float(i_baseMinBars) * 40.0 + (atrCompressBase ? 25.0 : 0.0) + (tightRangeBase ? 20.0 : 0.0) + (higherLows ? 15.0 : 0.0))

// ─── State Machine — دورة 1–12 (قواعد قابلة للقياس — لا Smart Money) ─────────
f_cycleName(int st) =>
    st == 1 ? f_txt("1 هبوط مستمر", "1 Decline") :
     st == 2 ? f_txt("2 تباطؤ هبوط", "2 Slowing dn") :
     st == 3 ? f_txt("3 قاعدة", "3 Base") :
     st == 4 ? f_txt("4 تجميع", "4 Accum") :
     st == 5 ? f_txt("5 اختراق أولي", "5 Init break") :
     st == 6 ? f_txt("6 صعود", "6 Uptrend") :
     st == 7 ? f_txt("7 إعادة تجميع", "7 Re-acc") :
     st == 8 ? f_txt("8 امتداد", "8 Extended") :
     st == 9 ? f_txt("9 تصريف؟", "9 Dist?") :
     st == 10 ? f_txt("10 ضعف اتجاه", "10 Weak trend") :
     st == 11 ? f_txt("11 كسر هيكل", "11 Struct break") :
     f_txt("12 هبوط جديد", "12 New dn")

var int cycleState = 3
var int cycleStateBars = 0
string cycleName = f_cycleName(cycleState)
string cycleNextHint = "—"
string cycleInvTxt = "—"
float cycleScore = 50.0

if i_useCycleSM
    float rangeVsAtr = spreadBar / math.max(atr, syminfo.mintick)
    bool dnTrend = close < ema50 and ema50 < ema200 and structBias <= 0
    bool dnSlow = dnTrend and adx < adx[5] and rangeVsAtr < rangeVsAtr[3]
    bool inBase = rangeContract and squeezeOn and math.abs(close - ema50) < atr * 1.2
    bool accPhase = inBase and accScore >= distScore + 1 and cmf > 0
    bool initBreak = breakConfirmed or (bosUp and trueBreakVol)
    bool upTrend = structBias == 1 and close > ema50 and close > ema20
    bool pullBack = close < ta.highest(close, 15) and close > ema50
    bool nearResist = not na(swingHigh) and high >= swingHigh - atr * i_nearSupAtr
    bool reaccPhase = upTrend and pullBack and rvol < 1.0 and low > nz(swingLow, ema200)
    bool extRally = upTrend and close > ema50 + atr * 3 and rsi > 62
    bool distPhase = distScore >= accScore + 2 and (nearResist or close > wkHigh * 0.97)
    bool weakTrend = upTrend and close < ema20 and adx < 20
    bool structBreakC = bosDn or supportBreak
    bool newDn = structBreakC and close < ema50
    int newState = cycleState
    if dnTrend and not dnSlow
        newState := 1
    else if dnSlow
        newState := 2
    else if accPhase
        newState := 4
    else if inBase or baseCandidate
        newState := 3
    else if initBreak and not upTrend
        newState := 5
    else if reaccPhase
        newState := 7
    else if extRally
        newState := 8
    else if distPhase
        newState := 9
    else if weakTrend
        newState := 10
    else if structBreakC and cycleState <= 10
        newState := 11
    else if newDn
        newState := 12
    else if upTrend
        newState := 6
    if barOk
        if newState != cycleState
            cycleState := newState
            cycleStateBars := 0
        else
            cycleStateBars += 1
    cycleName := f_cycleName(cycleState)
    cycleNextHint := cycleState == 3 or cycleState == 4 ? f_txt("→ BOS + RVOL", "→ BOS + RVOL") : cycleState == 6 ? f_txt("→ حذر تصريف عند R", "→ dist at R") : f_txt("راقب هيكل", "Watch structure")
    cycleInvTxt := structBreakC ? f_txt("كسر هيكل", "Struct break") : distPhase ? f_txt("تصريف محتمل", "Dist?") : f_txt("BOS معاكس", "Opposite BOS")
    cycleScore := cycleState == 4 or cycleState == 5 or cycleState == 7 ? 78.0 : cycleState == 3 or cycleState == 6 ? 62.0 : cycleState == 9 or cycleState == 11 or cycleState == 12 ? 22.0 : 48.0

string behScenario = distScore >= accScore + 2 ? f_txt("تصريف/ضغط محتمل", "Dist pressure?") : accScore >= distScore + 2 ? f_txt("تراكم محتمل", "Accum?") : breakConfirmed ? f_txt("اختراق مؤكد", "Break confirmed") : fakeBreakUp ? f_txt("فشل اختراق", "Failed break") : baseCandidate ? f_txt("قاعدة/تماسك", "Base/consol") : f_txt("—", "—")

// ─── Opportunity Score V2 (بدون تكرار RSI/MACD داخل الفوليوم) ─────────────────
float wSumQ = i_wTrend + i_wVol + i_wEntry + i_wBreak + i_wTime + i_wWave + i_wRR + i_wCycle
wSumQ := wSumQ <= 0 ? 1.0 : wSumQ
sTrendQ := math.max(0.0, math.min(100.0, 45.0 + (trD + trW + trM) / 9.0 * 85.0 + structBias * 5.0))
sVolQ := math.max(0.0, math.min(100.0, accumScore100 * 0.5 + volIntelScore * 0.35 + (100.0 - distRisk100) * 0.15))
sEntryQ := setupHits >= 9 ? 85.0 : setupHits >= 7 ? 72.0 : setupQuality ? 78.0 : inDemandZone ? 56.0 : atSupport ? 48.0 : 32.0
sBreakQ := breakScore
sTimeQ := timeConf
sWaveQ := waveState == "غير محسوم" ? 38.0 : waveState == "عد صاعد محتمل (1-5)" ? 68.0 : 55.0
sRRQ := na(rr1) ? 40.0 : math.min(100.0, rr1 / 3.0 * 100.0)
float sCycleQ = i_useCycleSM ? cycleScore : 50.0
if i_useRegime and regime30 <= 0
    sTrendQ := math.max(0.0, sTrendQ - 8.0)
else if i_useRegime and regime30 > 0 and regime70 > 0
    sTrendQ := math.min(100.0, sTrendQ + 4.0)
if baseCandidate and cycleState <= 4
    sEntryQ := math.min(100.0, sEntryQ + 6.0)
composite := (sTrendQ * i_wTrend + sVolQ * i_wVol + sEntryQ * i_wEntry + sBreakQ * i_wBreak + sTimeQ * i_wTime + sWaveQ * i_wWave + sRRQ * i_wRR + sCycleQ * i_wCycle) / wSumQ
composite := math.max(0.0, math.min(100.0, composite))

if composite >= effScoreBuy and setupQuality and setupHits >= 7 and trD >= 0 and distRisk100 < 55
    verdict := "فرصة قوية نسبيًا"
    oppClass := "فرصة قوية نسبيًا"
else if composite >= effScoreWatch and distRisk100 < 65
    verdict := "فرصة تحتاج تأكيد"
    oppClass := "فرصة تحتاج تأكيد"
else if distRisk100 >= 70 or volClass == "تصريف محتمل"
    verdict := "مخاطرة مرتفعة"
    oppClass := "مخاطرة مرتفعة"
else if composite < 40.0
    verdict := "فرصة ضعيفة"
    oppClass := "فرصة ضعيفة"
else
    verdict := "مراقبة فقط"
    oppClass := "مراقبة فقط"

scenBull := composite >= effScoreBuy ? "صاعد: " + breakState + " + " + volIntel : "—"
scenBase := "أساسي: " + trendTxt + " | Acc " + str.tostring(accumScore100, "#") + " DistRisk " + str.tostring(distRisk100, "#")

// ─── أكبر أحداث حجم (مسح — أداء لاحق تقديري OHLCV) ───────────────────────────
f_histFwd(int barsAgo, int fwd) =>
    barsAgo >= fwd and barsAgo < bar_index ? (close[barsAgo - fwd] - close[barsAgo]) / close[barsAgo] * 100.0 : na

f_volEventTag(int off) =>
    float c0 = close[off]
    float c5 = off >= 5 ? close[off - 5] : na
    bool brk = c0 > nz(swingHigh[off], high[off])
    bool up = not na(c5) and c0 > c5 * 1.02
    bool flat = not na(c5) and math.abs(c0 - c5) / c5 < 0.03
    brk ? "BREAK" : up ? "UP" : flat ? "SIDE" : "MIX"

f_srAtBar(int off, float refPrice) =>
    float hWin = ta.highest(high, i_srLookback)[off]
    float lWin = ta.lowest(low, i_srLookback)[off]
    refPrice >= hWin * 0.99 ? f_txt("قرب مقاومة", "Near R") : refPrice <= lWin * 1.01 ? f_txt("قرب دعم", "Near S") : f_txt("وسط", "Mid")

f_scanVolLen() =>
    int len = i_volScanScope == "سجل الشارت" ? bar_index - 1 : math.min(effVolWinTop, bar_index - 1)
    math.max(len, 1)

if barstate.islast
    int scanLen = f_scanVolLen()
    topVolScopeNote := i_volScanScope + " · " + str.tostring(scanLen) + f_txt(" ش", " b")
    topVolTxt := ""
    array<int> picked = array.new_int()
    int showRanks = math.min(i_topVolN, 10)
    for rank = 0 to showRanks - 1
        float bestV = -1.0
        int bestOff = -1
        for off = 1 to scanLen
            bool used = false
            for u = 0 to array.size(picked) - 1
                if array.get(picked, u) == off
                    used := true
            if not used and volume[off] > bestV
                bestV := volume[off]
                bestOff := off
        if bestOff > 0
            array.push(picked, bestOff)
            if rank == 0
                float vAvgAt0 = ta.sma(volume, i_volAvgLen)[bestOff]
                float rAt0 = vAvgAt0 > 0 ? volume[bestOff] / vAvgAt0 : na
                topVolTxt := "#1 " + str.tostring(bestOff) + f_txt("ش ", "b ") + "V " + str.tostring(volume[bestOff], "#") + " RVOL " + str.tostring(rAt0, "#.#") + " +60d " + str.tostring(f_histFwd(bestOff, 60), "#.#") + "%"
    if topVolTxt == ""
        topVolTxt := f_txt("لا بيانات كافية", "Insufficient data")

var table volTopTbl = table.new(position.bottom_center, 7, 14, border_width=1)
if i_showTopVolTable and barstate.islast
    int scanLenT = f_scanVolLen()
    array<int> pickedT = array.new_int()
    int ranksT = math.min(i_topVolN, 10)
    table.clear(volTopTbl, 0, 0, 6, 13)
    float sumBrk20 = 0.0
    float sumUp20 = 0.0
    float sumSide20 = 0.0
    float sumMix20 = 0.0
    int cntBrk = 0
    int cntUp = 0
    int cntSide = 0
    int cntMix = 0
    color vHdr = color.new(color.black, 10)
    table.cell(volTopTbl, 0, 0, f_txt("Top حجم", "Top vol"), bgcolor=vHdr, text_color=color.yellow)
    table.cell(volTopTbl, 1, 0, topVolScopeNote, bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    table.cell(volTopTbl, 2, 0, f_txt("السعر", "Px"), bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    table.cell(volTopTbl, 3, 0, "RVOL", bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    table.cell(volTopTbl, 4, 0, "+5/+10/+20/+60 %", bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    table.cell(volTopTbl, 5, 0, "S/R", bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    table.cell(volTopTbl, 6, 0, f_txt("لاحق", "After"), bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    float winMax = ta.highest(volume, scanLenT)
    table.cell(volTopTbl, 0, 1, f_txt("أقصى النطاق", "Range max"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(volTopTbl, 1, 1, str.tostring(winMax, "#") + (volume >= winMax * 0.99 ? f_txt(" · شمعة حالية!", " · current!") : ""), bgcolor=color.new(color.gray, 85), text_color=color.yellow, text_size=size.tiny)
    for rank = 0 to ranksT - 1
        float bestV = -1.0
        int bestOff = -1
        for off = 1 to scanLenT
            bool used = false
            for u = 0 to array.size(pickedT) - 1
                if array.get(pickedT, u) == off
                    used := true
            if not used and volume[off] > bestV
                bestV := volume[off]
                bestOff := off
        int row = rank + 2
        if bestOff > 0 and row <= 11
            array.push(pickedT, bestOff)
            float vAvgAt = ta.sma(volume, i_volAvgLen)[bestOff]
            float rAt = vAvgAt > 0 ? volume[bestOff] / vAvgAt : na
            float pctOfWin = winMax > 0 ? volume[bestOff] / winMax * 100.0 : na
            string fwdPack = str.tostring(f_histFwd(bestOff, 5), "#.#") + "/" + str.tostring(f_histFwd(bestOff, 10), "#.#") + "/" + str.tostring(f_histFwd(bestOff, 20), "#.#") + "/" + str.tostring(f_histFwd(bestOff, 60), "#.#")
            table.cell(volTopTbl, 0, row, "#" + str.tostring(rank + 1), text_color=color.white, text_size=size.tiny)
            table.cell(volTopTbl, 1, row, str.tostring(bestOff) + f_txt("ش ", "b ") + str.tostring(volume[bestOff], "#") + " (" + str.tostring(pctOfWin, "#") + "%)", text_color=color.white, text_size=size.tiny)
            table.cell(volTopTbl, 2, row, str.tostring(close[bestOff], format.mintick), text_color=color.white, text_size=size.tiny)
            table.cell(volTopTbl, 3, row, str.tostring(rAt, "#.##"), text_color=color.fuchsia, text_size=size.tiny)
            table.cell(volTopTbl, 4, row, fwdPack, text_color=color.aqua, text_size=size.tiny)
            table.cell(volTopTbl, 5, row, f_srAtBar(bestOff, close[bestOff]), text_color=color.gray, text_size=size.tiny)
            string tg = f_volEventTag(bestOff)
            table.cell(volTopTbl, 6, row, tg, text_color=color.white, text_size=size.tiny)
            float f20b = f_histFwd(bestOff, 20)
            if not na(f20b)
                if tg == "BREAK"
                    sumBrk20 += f20b
                    cntBrk += 1
                else if tg == "UP"
                    sumUp20 += f20b
                    cntUp += 1
                else if tg == "SIDE"
                    sumSide20 += f20b
                    cntSide += 1
                else
                    sumMix20 += f20b
                    cntMix += 1
    if i_volBenchRow
        float avgBrk = cntBrk > 0 ? sumBrk20 / cntBrk : na
        float avgSide = cntSide > 0 ? sumSide20 / cntSide : na
        float avgUp = cntUp > 0 ? sumUp20 / cntUp : na
        float avgMix = cntMix > 0 ? sumMix20 / cntMix : na
        volBenchTxt := f_txt("متوسط +20d (TopN): ", "Avg +20d (TopN): ") + "BREAK " + str.tostring(avgBrk, "#.#") + "%(n" + str.tostring(cntBrk) + ") · UP " + str.tostring(avgUp, "#.#") + " · SIDE " + str.tostring(avgSide, "#.#") + "(n" + str.tostring(cntSide) + ") · MIX " + str.tostring(avgMix, "#.#")
        table.cell(volTopTbl, 0, 12, f_txt("Bench TopN", "Bench TopN"), bgcolor=color.new(color.teal, 70), text_color=color.white, text_size=size.tiny)
        table.cell(volTopTbl, 1, 12, volBenchTxt, bgcolor=color.new(color.gray, 88), text_color=color.aqua, text_size=size.tiny)
        table.merge_cells(volTopTbl, 1, 12, 6, 12)
    if i_volBenchRow and i_volBenchPct
        float volThr = ta.percentile_nearest_rank(volume, scanLenT, i_volPctBench)
        float pBrk = 0.0
        float pUp = 0.0
        float pSide = 0.0
        float pMix = 0.0
        int nBrk = 0
        int nUp = 0
        int nSide = 0
        int nMix = 0
        int capPct = math.min(scanLenT, i_volPctScanCap)
        for off = 1 to capPct
            if volume[off] >= volThr
                string tgP = f_volEventTag(off)
                float f20p = f_histFwd(off, 20)
                if not na(f20p)
                    if tgP == "BREAK"
                        pBrk += f20p
                        nBrk += 1
                    else if tgP == "UP"
                        pUp += f20p
                        nUp += 1
                    else if tgP == "SIDE"
                        pSide += f20p
                        nSide += 1
                    else
                        pMix += f20p
                        nMix += 1
        volBenchPctTxt := "P" + str.tostring(i_volPctBench, "#") + f_txt("+ TopN · +20d BREAK ", "+ TopN · +20d BREAK ") + str.tostring(nBrk > 0 ? pBrk / nBrk : na, "#.#") + "%(n" + str.tostring(nBrk) + ") SIDE " + str.tostring(nSide > 0 ? pSide / nSide : na, "#.#") + "(n" + str.tostring(nSide) + ")"
        table.cell(volTopTbl, 0, 13, f_txt("Bench Pct", "Bench Pct"), bgcolor=color.new(color.teal, 60), text_color=color.white, text_size=size.tiny)
        table.cell(volTopTbl, 1, 13, volBenchPctTxt, bgcolor=color.new(color.gray, 86), text_color=color.aqua, text_size=size.tiny)
        table.merge_cells(volTopTbl, 1, 13, 6, 13)

var label volLbl1 = na
var label volLbl2 = na
var label volLbl3 = na
if i_markTopVol and barstate.islast
    label.delete(volLbl1)
    label.delete(volLbl2)
    label.delete(volLbl3)
    int scanLenM = f_scanVolLen()
    array<int> pickedM = array.new_int()
    for rank = 0 to 2
        float bestV = -1.0
        int bestOff = -1
        for off = 1 to scanLenM
            bool used = false
            for u = 0 to array.size(pickedM) - 1
                if array.get(pickedM, u) == off
                    used := true
            if not used and volume[off] > bestV
                bestV := volume[off]
                bestOff := off
        if bestOff > 0
            array.push(pickedM, bestOff)
            int xBar = bar_index - bestOff
            string txt = "V" + str.tostring(rank + 1) + "\n" + str.tostring(volume[bestOff], "#")
            if rank == 0
                volLbl1 := label.new(xBar, high[bestOff], txt, style=label.style_label_down, color=color.new(color.yellow, 20), textcolor=color.black, size=size.tiny)
            else if rank == 1
                volLbl2 := label.new(xBar, high[bestOff], txt, style=label.style_label_down, color=color.new(color.orange, 30), textcolor=color.black, size=size.tiny)
            else
                volLbl3 := label.new(xBar, high[bestOff], txt, style=label.style_label_down, color=color.new(color.orange, 50), textcolor=color.black, size=size.tiny)

var int barsSincePLow = 999
if not na(pLow)
    barsSincePLow := 0
else
    barsSincePLow += 1

bool pivotLowBar = not na(pLow) and barOk
bool inBottomWindow = barsSincePLow <= i_bottomBars
bool deepDrop = dropPct >= i_bottomDropPct
bool rsiTurn = rsi > rsi[1] and rsi[1] < 38.0
bool bottomReversal = (chochUp or bullDiv or rsiTurn or (macdH > macdH[1] and macdH[1] < 0)) and accScore >= distScore
bool bottomConfirmed = barOk and inBottomWindow and atSupport and bottomReversal and volClass != "تصريف محتمل" and deepDrop
bool bottomWatch = barOk and inBottomWindow and atSupport and deepDrop and not bottomConfirmed

// ─── مضاربة (7 شروط) ───
bool cTrTrend  = tr60 > 0 and trD >= 0
bool cTrMicro  = not i_useMTF15 or tr15 >= 0
bool cStruct   = structBias == 1 or bosUp or chochUp
bool cVolume   = accScore >= distScore and volClass != "تصريف محتمل"
bool cMomentum = rsi > 42 and rsi < 78 and macdH > 0 and adx >= 18
bool cLocation = inDemandZone or retestSupport or atSupport or (bosUp and trueBreakVol)
bool cRisk     = not na(rr1) and rr1 >= i_minRR
bool cLiquidity = volAvg >= effMinAvgVol and (na(rvol) ? false : rvol >= effDecMinRvol)

int bullHits = 0
bullHits += cTrTrend ? 1 : 0
bullHits += cTrMicro ? 1 : 0
bullHits += cStruct ? 1 : 0
bullHits += cVolume ? 1 : 0
bullHits += cMomentum ? 1 : 0
bullHits += cLocation ? 1 : 0
bullHits += cRisk ? 1 : 0

// ─── استثمار (7 شروط) ───
bool iW = trW > 0
bool iM = trM >= 0
bool i200 = close > ema200 or (atSupport and close > ema200 * 0.96)
bool iStr = structD == 1 or structBias == 1
bool iVol = volClass == "تجميع محتمل" or accScore >= distScore + 1
bool iLoc = atSupport or inDemandZone or bottomWatch
bool iSafe = close > nz(investInv, histSup) and volClass != "تصريف محتمل"
bool iLiq = volAvg >= effMinAvgVol * 0.5

int invHits = 0
invHits += iW ? 1 : 0
invHits += iM ? 1 : 0
invHits += i200 ? 1 : 0
invHits += iStr ? 1 : 0
invHits += iVol ? 1 : 0
invHits += iLoc ? 1 : 0
invHits += iSafe ? 1 : 0

bool hardBlock = volClass == "تصريف محتمل" or fakeBreakUp or supportBreak or not cLiquidity
bool softBlock = inSupplyZone and retestResist or bearDiv or volUpPriceDown

bool exitLong = barOk and (bosDn or chochDn or supportBreak or volClass == "تصريف محتمل" or (inSupplyZone and close < ema20))

bool buyZoneActive = not supportBreak and volAvg >= effMinAvgVol and setupQuality and globBull >= 0 and composite >= effScoreWatch
float dPrevLim = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctLim = dPrevLim > 0 ? (close - dPrevLim) / dPrevLim * 100.0 : 0.0
float haltPctLim = egxBoardLim == "SME تميّز" or egxBoardLim == "SME نايل" or egxBoardLim == "غير نشط" ? 5.0 : 10.0
float luldPctLim = egxBoardLim == "غير نشط" ? 5.0 : (egxBoardLim == "SME تميّز" or egxBoardLim == "SME نايل" ? 10.0 : 20.0)
bool nearLimitLim = blockLimitLim and dPrevLim > 0 and (dayPctLim >= math.min(9.0, haltPctLim - 1.0) or dayPctLim >= luldPctLim - 0.25)

bool buyConfluence = barOk and buyZoneActive and setupOk and not nearLimitLim and not chaseWarn and (inDemandZone or retestSupport or breakRetest or fvgBull)
float egxRank = math.max(0.0, math.min(100.0, composite * 0.55 + globBull * 8.0 + mtfBiasQ * 3.0 + (buyConfluence ? 15.0 : buyZoneActive ? 8.0 : 0.0) + (bottomConfirmed ? 6.0 : 0.0) + (breakConfirmed ? 6.0 : breakRetest ? 4.0 : 0.0) + (fvgBull ? 3.0 : 0.0) - (supportBreak ? 20.0 : 0.0) - (chaseWarn ? 10.0 : 0.0)))
bool rankOk = i_minEgxRank <= 0 or egxRank >= i_minEgxRank
bool screenerPass = not supportBreak and volAvg >= effMinAvgVol and setupHits >= 7 and rankOk and not na(rr1) and rr1 >= i_minRR and buyZoneActive

bool cycleBlocksLong = i_useCycleSM and (cycleState >= 9 or cycleState == 11 or cycleState == 12)
bool setupGateOk = not i_setupGate or setupOk
bool rankGateOk = i_minEgxRank <= 0 or egxRank >= i_minEgxRank
bool enterScalp = barOk and not hardBlock and not cycleBlocksLong and not chaseWarn and setupGateOk and rankGateOk and bullHits >= i_decMinBull and swingScore >= i_decSwingMin and composite >= effScoreWatch and cLiquidity and globBull >= 0 and (setupQuality or retestSupport or (bosUp and trueBreakVol) or (i_useCycleSM and cycleState == 4 and baseCandidate))
bool watchScalp = barOk and not hardBlock and bullHits >= i_decMinWatch and swingScore >= i_decSwingMin - 6.0 and not enterScalp

bool enterInvest = barOk and not supportBreak and not cycleBlocksLong and invHits >= i_decInvMinHit and investScore >= i_decInvestMin and iLiq and (bottomConfirmed or supportHold or volClass == "تجميع محتمل" or (i_useCycleSM and cycleState <= 4 and baseCandidate))
bool watchInvest = barOk and invHits >= i_decInvWatch and investScore >= i_decInvestMin - 8.0 and not enterInvest

var float trailStop = na
var bool trailOn = false
if enterScalp or enterInvest
    trailOn := true
    trailStop := na(trailStop) ? stopSuggest : trailStop
if exitLong or supportBreak
    trailOn := false
    trailStop := na
if trailOn and i_showTrail and barOk
    float trailCand = close - atr * i_trailAtr
    trailStop := math.max(nz(trailStop, stopSuggest), trailCand)
    if high >= tgt1 and high[1] < tgt1
        trailStop := math.max(trailStop, entryConfirm)

var int scalpState = 0
if enterScalp or enterInvest
    scalpState := 1
else if exitLong
    scalpState := 0

string scalpLine = enterScalp ? "🟢 مضاربة: شراء" : watchScalp ? "🟡 مضاربة: مراقبة" : hardBlock ? "🔴 مضاربة: لا" : "⚪ مضاربة: انتظار"
string investLine = enterInvest ? "🟢 استثمار: تراكم" : watchInvest ? "🟡 استثمار: مراقبة" : supportBreak ? "🔴 استثمار: تجنب" : "⚪ استثمار: انتظار"
string supLine = supportBreak ? "🔴 كسر دعم " + str.tostring(supSwing, format.mintick) : supportHold ? "🟢 دعم صامد " + str.tostring(activeSupport, format.mintick) : atSupport ? "🟡 عند دعم " + str.tostring(activeSupport, format.mintick) : f_txt("— لا قرب دعم واضح", "— not near support")
string bottomLine = bottomConfirmed ? "🟢 قاع محتمل (مؤكد جزئيًا)" : bottomWatch ? "🟡 قاع — انتظر تأكيد" : pivotLowBar ? "🔵 pivot قاع (تأكيد pivot)" : "—"

bool autoIntraday = i_decFocus == "تلقائي" and timeframe.isintraday
bool autoPos = i_decFocus == "تلقائي" and not timeframe.isintraday
bool showScalp = i_decFocus == "مضاربة" or i_decFocus == "الاثنان" or autoIntraday
bool showInvest = i_decFocus == "استثمار" or i_decFocus == "الاثنان" or autoPos

int primaryRank = 0
string primaryDec = "⚪ لا قرار — انتظر"
string primaryAct = "—"
color primaryCol = i_colNeutral

if supportBreak
    primaryRank := -2
    primaryDec := "🔴 كسر دعم — لا شراء"
    primaryAct := f_txt("أغلق فكرة الشراء أو خفّض", "Exit / reduce long bias")
    primaryCol := i_colBear
else if hardBlock and not atSupport
    primaryRank := -2
    primaryDec := "🔴 لا تداول"
    primaryAct := volClass == "تصريف محتمل" ? "تصريف" : "سيولة/اتجاه ضعيف"
    primaryCol := i_colBear
else if bottomConfirmed and (enterInvest or enterScalp)
    primaryRank := 3
    primaryDec := "🟢 قاع + دعم — دخول"
    primaryAct := showInvest and enterInvest ? "استثمار تراكمي" : "مضاربة على الارتداد"
    primaryCol := i_colBull
else if bottomConfirmed
    primaryRank := 2
    primaryDec := "🟢 قاع محتمل — عند دعم"
    primaryAct := f_txt("انتظر إغلاق أو CHoCH/حجم", "Wait close / CHoCH")
    primaryCol := i_colBull
else if supportHold and enterScalp and showScalp
    primaryRank := 2
    primaryDec := "🟢 ارتداد من دعم — مضاربة"
    primaryAct := "SL " + str.tostring(stopSuggest, format.mintick) + " · T1 " + str.tostring(tgt1, format.mintick)
    primaryCol := i_colBull
else if supportHold and enterInvest and showInvest
    primaryRank := 2
    primaryDec := "🟢 دعم + تراكم — استثمار"
    primaryAct := "إلغاء LT: " + str.tostring(investInv, format.mintick)
    primaryCol := color.new(color.teal, 0)
else if enterScalp and showScalp
    primaryRank := 2
    primaryDec := "🟢 شراء مضاربة"
    primaryAct := "دخول " + str.tostring(nz(entryConfirm, close), format.mintick)
    primaryCol := i_colBull
else if enterInvest and showInvest
    primaryRank := 2
    primaryDec := "🟢 تراكم استثماري"
    primaryAct := "منطقة " + str.tostring(nz(demandLo, activeSupport), format.mintick)
    primaryCol := color.new(color.teal, 0)
else if atSupport and (watchScalp or watchInvest or bottomWatch)
    primaryRank := 1
    primaryDec := "🟡 عند دعم/قاع — مراقبة"
    primaryAct := f_txt("شروط ", "Hits ") + str.tostring(bullHits) + "/7 · " + str.tostring(invHits) + "/7"
    primaryCol := color.yellow
else if exitLong and scalpState[1] == 1
    primaryRank := -1
    primaryDec := "🟠 خروج / تقليل"
    primaryAct := bosDn ? "BOS↓" : supportBreak ? "كسر دعم" : "ضعف حجم"
    primaryCol := color.orange
else
    primaryRank := 0
    primaryDec := "⚪ انتظار — لا إعداد كامل"
    primaryAct := supLine

int decRank = primaryRank
color decColor = primaryCol

bool markScalp = i_showDecMarks and enterScalp and not enterScalp[1]
bool markInvest = i_showDecMarks and enterInvest and not enterInvest[1]
bool markBottom = i_showDecMarks and bottomConfirmed and not bottomConfirmed[1]
bool markSup = i_showDecMarks and supportHold and atSupport and not supportHold[1]
bool decExitMark = i_showDecMarks and exitLong and scalpState[1] == 1

plotshape(markScalp, "Scalp", shape.triangleup, location.belowbar, color=i_colBull, size=size.normal, text="مض")
plotshape(markInvest, "Invest", shape.diamond, location.belowbar, color=color.teal, size=size.small, text="است")
plotshape(markBottom, "Bottom", shape.circle, location.belowbar, color=color.aqua, size=size.small, text="قاع")
plotshape(markSup, "Support", shape.xcross, location.belowbar, color=color.yellow, size=size.tiny, text="دعم")
plotshape(decExitMark, "Exit", shape.triangledown, location.abovebar, color=color.orange, size=size.normal, text="خروج")

bool inEgxSession = i_useEgxSession and not na(time(timeframe.period, "1000-1430:23456", "Africa/Cairo"))
bgcolor(inEgxSession ? color.new(color.blue, 97) : na)
bgcolor(i_showDecBg and primaryRank >= 2 ? color.new(primaryCol, 93) : i_showDecBg and primaryRank == 1 ? color.new(color.yellow, 94) : i_showDecBg and primaryRank <= -1 ? color.new(primaryCol, 93) : na)

var table decBanner = table.new(position.bottom_right, 1, 14, border_width=2)
if i_showDecBanner and barstate.islast
    table.clear(decBanner, 0, 0, 0, 13)
    table.cell(decBanner, 0, 0, f_txt("القرار الرئيسي", "Primary decision"), bgcolor=color.new(color.black, 5), text_color=color.white)
    table.cell(decBanner, 0, 1, primaryDec, bgcolor=color.new(primaryCol, 70), text_color=color.white, text_size=size.large)
    table.cell(decBanner, 0, 2, primaryAct, bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(decBanner, 0, 3, showScalp ? scalpLine : f_txt("— مضاربة مخفية", "Scalp hidden"), bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(decBanner, 0, 4, showInvest ? investLine : f_txt("— استثمار مخفي", "Invest hidden"), bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(decBanner, 0, 5, supLine + " | " + bottomLine, bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.small)
    table.cell(decBanner, 0, 6, tgtPack, bgcolor=color.new(color.green, 85), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 7, timeWindow + " · " + cycleTxt, bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 8, waveState + " · " + wavePhase, bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 9, globVerdict + " · PP " + str.tostring(pp, format.mintick), bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 10, f_txt("تراكم / تصريف / فرصة", "Acc/Dist/Opp"), bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 11, "ترتيب " + str.tostring(egxRank, "#") + " · " + setupTier + " (" + str.tostring(setupHits) + "/11) · فرصة " + str.tostring(composite, "#.#") + " — " + oppClass, bgcolor=color.new(color.gray, 86), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 12, i_useCycleSM ? cycleName + " · Base " + str.tostring(baseScore, "#") + " · " + behScenario + " · " + marketRegime : marketRegime, bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(decBanner, 0, 13, breakState + " · إلغاء: " + invalidateTxt + " · " + planPack, bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)

// ─── Data quality ──────────────────────────────────────────────────────────────
string dataWarn = "مقبول — تحقق من وحدات الحجم"
if i_warnData
    if volAvg < effMinAvgVol
        dataWarn := "سيولة ضعيفة (EGX)"
    else if not notionalReliable
        dataWarn := "حجم/سعر غير موثوق"
    else if not vwapOk and i_showVWAP
        dataWarn := "VWAP: استخدم intraday"
    else if volume == 0
        dataWarn := "حجم = 0"

string egxExec = i_egxNote ? "عمولة+انزلاق+حدود يومية — حذر الأحجام" : "—"

// ─── Draw zones ────────────────────────────────────────────────────────────────
var box demandBox = na
var box supplyBox = na
if i_showZones and barstate.islast
    if not na(demandBox)
        box.delete(demandBox)
    if not na(supplyBox)
        box.delete(supplyBox)
    if not na(demandLo) and not na(demandHi)
        demandBox := box.new(bar_index - 60, demandHi, bar_index + 8, demandLo, border_color=color.new(i_colBull, 40), bgcolor=color.new(i_colBull, 88), text="طلب")
    if not na(supplyLo) and not na(supplyHi)
        supplyBox := box.new(bar_index - 60, supplyHi, bar_index + 8, supplyLo, border_color=color.new(i_colBear, 40), bgcolor=color.new(i_colBear, 88), text="عرض")

var box consolBox = na
if i_showConsolBox and barstate.islast
    if not na(consolBox)
        box.delete(consolBox)
    bool drawConsol = squeezeOn or breakState == ST_BRK_WATCH or breakState == ST_BRK_EARLY
    if drawConsol
        consolBox := box.new(bar_index - i_consolLen, consolHi, bar_index + 6, consolLo, border_color=color.new(color.blue, 50), bgcolor=color.new(color.blue, 92), text=f_txt("تماسك ", "Base ") + str.tostring(i_consolLen) + f_txt("ش", "b"))

var box fvgBox = na
if i_showFvgBox and barstate.islast
    if not na(fvgBox)
        box.delete(fvgBox)
    if fvgBull
        fvgBox := box.new(bar_index - 2, fvgBullTop, bar_index + 12, fvgBullBot, border_color=color.new(color.blue, 40), bgcolor=color.new(color.blue, 85), text="FVG+")
    else if fvgBear
        fvgBox := box.new(bar_index - 2, fvgBearTop, bar_index + 12, fvgBearBot, border_color=color.new(color.maroon, 40), bgcolor=color.new(color.maroon, 88), text="FVG-")

plot(i_showTrail and trailOn ? trailStop : na, "Trail stop", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)

plot(i_showTargets ? tgt1 : na, "T1", color=color.new(color.green, 25), linewidth=1, style=plot.style_linebr)
plot(i_showTargets ? tgt2 : na, "T2", color=color.new(color.green, 45), linewidth=1, style=plot.style_linebr)
plot(i_showTargets ? tgt3 : na, "T3", color=color.new(color.green, 65), linewidth=1, style=plot.style_linebr)

var label lblT1 = na
var label lblT2 = na
var label lblT3 = na
if i_showTgtLbl and barstate.islast
    if not na(lblT1)
        label.delete(lblT1)
    if not na(lblT2)
        label.delete(lblT2)
    if not na(lblT3)
        label.delete(lblT3)
    lblT1 := label.new(bar_index + 3, tgt1, "T1 " + tgtSrc1, style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.tiny)
    lblT2 := label.new(bar_index + 3, tgt2, "T2 " + tgtSrc2, style=label.style_label_left, color=color.new(color.green, 35), textcolor=color.white, size=size.tiny)
    lblT3 := label.new(bar_index + 3, tgt3, "T3 " + tgtSrc3, style=label.style_label_left, color=color.new(color.green, 50), textcolor=color.white, size=size.tiny)

if i_showStructMarks and barOk
    if bosUp
        label.new(bar_index, low, "BOS↑", style=label.style_label_up, color=i_colBull, textcolor=color.white, size=size.tiny)
    if bosDn
        label.new(bar_index, high, "BOS↓", style=label.style_label_down, color=i_colBear, textcolor=color.white, size=size.tiny)
    if chochUp
        label.new(bar_index, low, "CHoCH↑", style=label.style_label_up, color=color.new(i_colBull, 35), textcolor=color.white, size=size.tiny)
    if chochDn
        label.new(bar_index, high, "CHoCH↓", style=label.style_label_down, color=color.new(i_colBear, 35), textcolor=color.white, size=size.tiny)

// ─── Dashboard ─────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 42, border_width=1)

f_pct(float x) =>
    na(x) ? "—" : str.tostring((x - close) / close * 100.0, "#.##") + "%"

var table wavePanel = table.new(position.top_left, 2, 7, border_width=1)
if i_showWavePanel and barstate.islast
    table.clear(wavePanel, 0, 0, 1, 6)
    color wHdr = color.new(color.purple, 25)
    table.cell(wavePanel, 0, 0, f_txt("موجي Elliott", "Elliott"), bgcolor=wHdr, text_color=color.white)
    table.cell(wavePanel, 1, 0, waveState, bgcolor=wHdr, text_color=color.white, text_size=size.small)
    table.cell(wavePanel, 0, 1, f_txt("مرحلة", "Phase"), bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 1, 1, wavePhase, text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 0, 2, f_txt("أساسي", "Primary"), bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 1, 2, waveMain, text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 0, 3, f_txt("بديل", "Alternate"), bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 1, 3, waveAlt, text_color=waveUnclear ? color.orange : color.white, text_size=size.tiny)
    table.cell(wavePanel, 0, 4, f_txt("Fib / إلغاء", "Fib / Inv"), bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 1, 4, waveFibPack + " · inv " + str.tostring(waveInv, format.mintick), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 0, 5, f_txt("دورة 1–12", "Cycle 1–12"), bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 1, 5, i_useCycleSM ? str.tostring(cycleState) + " · " + cycleName : "—", text_color=cycleState == 4 or cycleState == 5 ? i_colBull : cycleState >= 9 ? i_colBear : i_colNeutral, text_size=size.tiny)
    table.cell(wavePanel, 0, 6, f_txt("ملاحظة", "Note"), bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(wavePanel, 1, 6, waveAltNote, text_color=color.gray, text_size=size.tiny)

if i_showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 41)
    color hdr = color.new(color.navy, 15)
    table.cell(dash, 0, 0, f_txt("EGX كوانت برو", "EGX QUANT PRO"), bgcolor=hdr, text_color=color.white)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period + " · " + i_egxPreset, bgcolor=hdr, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 1, f_txt("قرار رئيسي", "Primary"), bgcolor=color.new(primaryCol, 50), text_color=color.white)
    table.cell(dash, 1, 1, primaryDec, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 2, f_txt("دعم / قاع", "Support/Bottom"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 2, supLine + " · " + bottomLine, text_color=atSupport ? i_colBull : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 3, f_txt("الاتجاه", "Trend"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 3, trendTxt, text_color=trD >= 0 ? i_colBull : i_colBear)

    table.cell(dash, 0, 4, f_txt("أطر متعددة", "MTF"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 4, mtfLine, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 5, f_txt("مضاربة A", "Swing A"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(swingScore, "#") + "/100 · " + scalpLine, text_color=swingScore >= 60 ? i_colBull : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 6, f_txt("استثمار B", "Invest B"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(investScore, "#") + "/100 · " + investLine, text_color=investScore >= 60 ? i_colBull : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 7, f_txt("درجة الفرصة", "Opportunity"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(composite, "#.#") + "/100 · " + oppClass + " (≥" + str.tostring(effScoreBuy, "#") + ") · ترتيب " + str.tostring(egxRank, "#"), text_color=composite >= effScoreBuy ? i_colBull : composite <= 40 ? i_colBear : i_colNeutral)

    table.cell(dash, 0, 8, f_txt("تراكم / مخاطرة تصريف", "Acc / Dist"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 8, str.tostring(accumScore100, "#") + " / " + str.tostring(distRisk100, "#") + " · " + accFactors, text_color=accumScore100 > distRisk100 ? i_colBull : distRisk100 > accumScore100 ? i_colBear : i_colNeutral, text_size=size.tiny)

    table.cell(dash, 0, 9, f_txt("مكونات Opp", "Opp parts"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 9, "Tr" + str.tostring(sTrendQ, "#") + " Vol" + str.tostring(sVolQ, "#") + " Ent" + str.tostring(sEntryQ, "#") + " Brk" + str.tostring(sBreakQ, "#") + " Tm" + str.tostring(sTimeQ, "#") + " Wv" + str.tostring(sWaveQ, "#") + " Cyc" + str.tostring(sCycleQ, "#") + " RR" + str.tostring(sRRQ, "#"), text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 10, f_txt("ذكاء الحجم", "Vol intel"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 10, volIntel + " · " + activityNote, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 11, f_txt("الاختراق", "Breakout"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 11, breakState + " · انكماش " + (squeezeOn ? "✓" : "—"), text_color=breakState == ST_BRK_FAIL ? i_colBear : breakState == ST_BRK_CONF ? i_colBull : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 12, f_txt("خطط دخول", "Entry plans"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 12, planPack, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 13, f_txt("إبطال التحليل", "Invalidate"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 13, invalidateTxt + " · " + distFactors, text_color=color.orange, text_size=size.tiny)

    table.cell(dash, 0, 14, f_txt("أكبر حجم (نافذة)", "Top vol window"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 14, topVolTxt + " · " + topVolScopeNote + f_txt(" (جدول أسفل)", " (table below)"), text_color=color.yellow, text_size=size.tiny)

    table.cell(dash, 0, 15, f_txt("حجم نسبي RVOL", "RVOL"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 15, str.tostring(rvol, "#.##") + "x · pct " + str.tostring(volPctRank, "#") + " | " + volClass, text_color=volClass == "تصريف محتمل" ? i_colBear : volClass == "تجميع محتمل" ? i_colBull : i_colNeutral)

    table.cell(dash, 0, 16, f_txt("نظام السوق EGX", "Regime EGX"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 16, marketRegime + " · 30:" + str.tostring(regime30) + " 70:" + str.tostring(regime70) + " · " + regimeHint, text_color=regime30 > 0 ? i_colBull : regime30 < 0 ? i_colBear : i_colNeutral, text_size=size.tiny)

    table.cell(dash, 0, 17, f_txt("انتشار EGX/عالمي", "EGX/Global"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 17, globVerdict + " (" + str.tostring(globBull) + ") · " + egxToolkit, text_color=globBull >= 4 ? i_colBull : globBull <= -3 ? i_colBear : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 18, f_txt("Pivot / 252", "Pivot / 52w"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 18, "PP " + str.tostring(pp, format.mintick) + " · S1 " + str.tostring(pivS1, format.mintick) + " · R1 " + str.tostring(pivR1, format.mintick) + " · 252H " + str.tostring(pctFromWkHigh, "#.#") + "%", text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 19, f_txt("RS vs مؤشر", "RS vs index"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 19, i_useBench ? str.tostring(rsMom, "#.##") + "% · Stoch " + str.tostring(stK, "#") : "—", text_color=not na(rsMom) and rsMom > 0 ? i_colBull : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 20, f_txt("أدلة حجم", "Vol evidence"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 20, volEvidenceTxt + " · " + str.tostring(volConf, "#") + "% → " + volEvidenceFor, text_color=color.white)

    table.cell(dash, 0, 21, f_txt("ذروة حجم", "Vol peaks"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 21, "20:" + str.tostring(maxVol20, "#") + " 60:" + str.tostring(maxVol60, "#") + " 252:" + str.tostring(maxVol252, "#"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 22, f_txt("أقصى سجل", "All-time bar"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 22, str.tostring(histMaxVol, "#") + " · " + str.tostring(histMaxVolBarsAgo) + f_txt(" ش قبل", " bars"), text_color=color.white)

    table.cell(dash, 0, 23, f_txt("قيمة تقديرية", "Notional"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 23, notionalReliable ? str.tostring(notionalEst, "#") + f_txt(" (تقدير)", " (est)") : f_txt("غير موثوق", "Unreliable"), text_color=color.orange)

    table.cell(dash, 0, 24, f_txt("دعم/مقاومة", "S/R"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 24, str.tostring(swingLow, format.mintick) + " / " + str.tostring(swingHigh, format.mintick), text_color=color.white)

    table.cell(dash, 0, 25, f_txt("تاريخي", "Historical"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 25, str.tostring(histSup, format.mintick) + " – " + str.tostring(histRes, format.mintick), text_color=color.white)

    table.cell(dash, 0, 26, f_txt("منطقة دخول", "Zone"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 26, na(demandLo) ? "—" : str.tostring(demandLo, format.mintick) + "–" + str.tostring(demandHi, format.mintick) + " · " + zoneType, text_color=i_colBull)

    table.cell(dash, 0, 27, f_txt("وقف/إلغاء", "SL/Inv"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 27, str.tostring(stopSuggest, format.mintick) + " | LT " + str.tostring(investInv, format.mintick), text_color=color.white)

    table.cell(dash, 0, 28, f_txt("أهداف T1-T3", "Targets"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 28, tgtPack, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 29, f_txt("توافق/R/R", "Cluster/RR"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 29, clusterTxt + " · RR " + str.tostring(rr1, "#.##"), text_color=targetCluster ? i_colBull : i_colNeutral, text_size=size.small)

    table.cell(dash, 0, 30, f_txt("موجي Elliott", "Wave"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 30, waveState + " · " + wavePhase + " · inv " + str.tostring(waveInv, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 31, f_txt("عد بديل / Fib", "Alt / Fib"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 31, waveAltNote + " · " + wavePack, text_color=waveUnclear ? color.orange : color.white, text_size=size.tiny)

    table.cell(dash, 0, 32, f_txt("تحليل زمني", "Time"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 32, timeWindow + " · " + cycleTxt + " · " + timeStability, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 33, f_txt("إبطال زمني", "Time inv"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 33, timeInvalidate, text_color=color.orange, text_size=size.tiny)

    table.cell(dash, 0, 34, f_txt("سيناريوهات", "Scenarios"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 34, scenBull + " | " + scenBase + " | " + scenBear, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 35, f_txt("معيار الحجم", "Vol bench"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 35, volBenchTxt + " | " + volBenchPctTxt, text_color=color.aqua, text_size=size.tiny)

    table.cell(dash, 0, 36, f_txt("دورة State", "Cycle state"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 36, i_useCycleSM ? cycleName + " · " + str.tostring(cycleStateBars) + f_txt(" ش · ", " b · ") + cycleNextHint + " · " + cycleInvTxt : "—", text_color=cycleState == 4 or cycleState == 5 ? i_colBull : cycleState >= 9 ? i_colBear : i_colNeutral, text_size=size.tiny)

    table.cell(dash, 0, 37, f_txt("قاعدة / سلوك", "Base / beh"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 37, f_txt("Base ", "Base ") + str.tostring(baseScore, "#") + " · " + str.tostring(barsInBase) + f_txt("ش · ", "b · ") + behScenario, text_color=baseCandidate ? i_colBull : i_colNeutral, text_size=size.tiny)

    table.cell(dash, 0, 38, f_txt("تأكيد الإشارة", "Signal"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 38, verdict + " · " + (barOk ? "إغلاق ✓" : "جارية") + " · Cyc" + str.tostring(sCycleQ, "#"), text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 39, f_txt("ترتيب EGX / إعداد", "Rank / Setup"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 39, str.tostring(egxRank, "#") + " · " + setupTier + " " + str.tostring(setupHits) + "/11" + (screenerPass ? " · ✓ فحص" : "") + (chaseWarn ? " · مطاردة" : ""), text_color=setupTier == "A" ? color.lime : setupTier == "B" ? color.yellow : i_colNeutral, text_size=size.tiny)

    table.cell(dash, 0, 40, f_txt("FVG / توافق", "FVG / Conf"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 40, (fvgBull ? "FVG+ " : fvgBear ? "FVG- " : "— ") + (buyConfluence ? f_txt("توافق شراء", "Buy conf") : f_txt("لا توافق", "No conf")), text_color=buyConfluence ? i_colBull : i_colNeutral, text_size=size.tiny)

    table.cell(dash, 0, 41, f_txt("بيانات/EGX", "Data"), bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(dash, 1, 41, dataWarn + " · " + egxExec + " · ±10% EGX", text_color=color.orange, text_size=size.small)

// ─── Signals ───────────────────────────────────────────────────────────────────
bool confirmedLong = barOk and setupQuality and composite >= effScoreBuy and not composite[1] >= effScoreBuy
plotshape(confirmedLong, "Confirmed setup", shape.labelup, location.belowbar, color=i_colBull, text="✓", textcolor=color.white, size=size.small)
plotshape(i_showDecMarks and buyConfluence and not buyConfluence[1], "توافق شراء", shape.circle, location.belowbar, color=color.lime, size=size.small, text="شر")
plotshape(barOk and chaseWarn and not chaseWarn[1], "تحذير مطاردة", shape.xcross, location.abovebar, color=color.orange, size=size.tiny, text="!")
plotshape(barOk and breakState == ST_BRK_CONF and breakState[1] != ST_BRK_CONF, "اختراق OK", shape.flag, location.belowbar, color=color.lime, size=size.small, text="اخ")
plotshape(barOk and breakState == ST_BRK_FAIL and breakState[1] != ST_BRK_FAIL, "فشل اختراق", shape.xcross, location.abovebar, color=color.red, size=size.tiny, text="فش")
plotshape(barOk and breakState == ST_BRK_WATCH and accumScore100 >= 55, "مراقبة", shape.square, location.bottom, color=color.new(color.blue, 40), size=size.tiny)

bool cycleChanged = barOk and i_useCycleSM and cycleState != cycleState[1]
plotshape(i_showCycleMarks and cycleChanged and cycleState == 4, "Cycle 4", shape.labelup, location.belowbar, color=color.new(i_colBull, 20), size=size.tiny, text="C4")
plotshape(i_showCycleMarks and cycleChanged and cycleState == 5, "Cycle 5", shape.labelup, location.belowbar, color=color.new(i_colBull, 10), size=size.tiny, text="C5")
plotshape(i_showCycleMarks and cycleChanged and cycleState == 9, "Cycle 9", shape.labeldown, location.abovebar, color=color.new(i_colBear, 20), size=size.tiny, text="C9")
plotshape(i_showCycleMarks and cycleChanged and cycleState == 11, "Cycle 11", shape.labeldown, location.abovebar, color=color.new(i_colBear, 10), size=size.tiny, text="C11")
plotshape(i_showCycleMarks and barOk and baseCandidate and not baseCandidate[1], "Base ready", shape.diamond, location.bottom, color=color.new(color.blue, 30), size=size.tiny, text="BASE")

bool earlyBuy = i_earlySignals and not barstate.isconfirmed and inDemandZone and rvol > 1.0
plotshape(earlyBuy, "Early", shape.circle, location.belowbar, color=color.orange, size=size.tiny, text="مبكر")

bool hitT1 = barOk and high >= tgt1 and high[1] < tgt1
bool hitSL = barOk and low <= stopSuggest and low[1] > stopSuggest and not na(stopSuggest)

int volWinLen = math.max(math.min(effVolWinTop, bar_index), 1)
float volWinMax = ta.highest(volume, volWinLen)
bool nearWindowVolHigh = barOk and volume >= volWinMax * 0.99 and bar_index > volWinLen

// ─── Alerts ────────────────────────────────────────────────────────────────────
bool alertBar = barstate.isconfirmed

alertcondition(alertBar and bosUp and trueBreakVol, "BOS صاعد + حجم", "EGX كوانت: BOS صاعد + حجم {{ticker}}")
alertcondition(alertBar and bosDn, "BOS هابط", "EGX كوانت: BOS هابط {{ticker}}")
alertcondition(alertBar and chochUp, "CHoCH صاعد", "EGX كوانت: CHoCH صاعد {{ticker}}")
alertcondition(alertBar and chochDn, "CHoCH هابط", "EGX كوانت: CHoCH هابط {{ticker}}")
alertcondition(alertBar and rvol >= effRvolClimax, "RVOL ذروة", "EGX كوانت: RVOL استثنائي {{ticker}}")
alertcondition(alertBar and accumScore100 >= 60 and accumScore100[1] < 60, "تراكم 60+", "EGX كوانت: درجة تراكم ≥60 {{ticker}}")
alertcondition(alertBar and distRisk100 >= 65 and distRisk100[1] < 65, "تصريف 65+", "EGX كوانت: مخاطرة تصريف ≥65 {{ticker}}")
alertcondition(alertBar and volClass == "تجميع محتمل" and volClass[1] != "تجميع محتمل", "مرحلة تجميع", "EGX كوانت: تجميع محتمل {{ticker}}")
alertcondition(alertBar and volClass == "تصريف محتمل" and volClass[1] != "تصريف محتمل", "مرحلة تصريف", "EGX كوانت: تصريف محتمل {{ticker}}")
alertcondition(alertBar and inDemandZone, "منطقة طلب", "EGX كوانت: منطقة طلب {{ticker}}")
alertcondition(alertBar and confirmedLong, "فرصة مؤكدة", "EGX كوانت: فرصة ≥حد الشراء {{ticker}}")
alertcondition(alertBar and breakState == ST_BRK_CONF, "اختراق مؤكد", "EGX كوانت: اختراق مؤكد {{ticker}}")
alertcondition(alertBar and breakState == ST_BRK_FAIL, "فشل اختراق", "EGX كوانت: فشل اختراق {{ticker}}")
alertcondition(alertBar and breakState == ST_BRK_RT, "إعادة اختبار", "EGX كوانت: إعادة اختبار {{ticker}}")
alertcondition(alertBar and retestSupport, "إعادة اختبار دعم", "EGX كوانت: retest دعم {{ticker}}")
alertcondition(alertBar and hitT1, "هدف 1", "EGX كوانت: T1 {{ticker}}")
alertcondition(alertBar and hitSL, "منطقة وقف", "EGX كوانت: وقف {{ticker}}")
alertcondition(alertBar and targetCluster, "توافق أهداف", "EGX كوانت: توافق أهداف {{ticker}}")
alertcondition(alertBar and bottomConfirmed, "قاع/دعم", "EGX كوانت: قاع/دعم محتمل {{ticker}}")
alertcondition(alertBar and enterInvest, "تراكم استثمار", "EGX كوانت: تراكم استثماري {{ticker}}")
alertcondition(alertBar and globBull >= 4, "توافق EGX/عالمي", "EGX كوانت: توافق EGX/عالمي {{ticker}}")
alertcondition(alertBar and supportBreak, "كسر دعم", "EGX كوانت: كسر دعم {{ticker}}")
alertcondition(alertBar and nearWindowVolHigh, "حجم قرب الذروة", "EGX كوانت: حجم قرب أقصى النافذة {{ticker}}")
alertcondition(alertBar and oppClass == "فرصة قوية نسبيًا" and oppClass[1] != "فرصة قوية نسبيًا", "فرصة قوية", "EGX كوانت: فرصة قوية {{ticker}}")
alertcondition(alertBar and i_useCycleSM and cycleState != cycleState[1], "تغيّر الدورة", "EGX كوانت: تغيّر مرحلة الدورة {{ticker}}")
alertcondition(alertBar and i_useCycleSM and cycleState == 4 and cycleState[1] != 4, "دورة تجميع 4", "EGX كوانت: مرحلة تجميع (4) {{ticker}}")
alertcondition(alertBar and i_useCycleSM and cycleState == 5 and cycleState[1] != 5, "دورة اختراق 5", "EGX كوانت: اختراق أولي (5) {{ticker}}")
alertcondition(alertBar and i_useCycleSM and cycleState >= 9 and cycleState[1] < 9, "دورة تصريف 9+", "EGX كوانت: تصريف/ضغط (9+) {{ticker}}")
alertcondition(alertBar and baseCandidate and not baseCandidate[1], "قاعدة جاهزة", "EGX كوانت: قاعدة/تماسك {{ticker}}")
alertcondition(alertBar and i_useRegime and regime30 > 0 and regime70 > 0 and (regime30[1] <= 0 or regime70[1] <= 0), "صعود واسع EGX", "EGX كوانت: صعود واسع EGX30+70 {{ticker}}")
alertcondition(alertBar and setupHits >= 9, "إعداد A", "EGX كوانت: إعداد A (9+/11) {{ticker}}")
alertcondition(alertBar and egxRank >= 70 and egxRank[1] < 70, "ترتيب 70+", "EGX كوانت: ترتيب ≥70 {{ticker}}")
alertcondition(alertBar and screenerPass and not screenerPass[1], "اجتياز الفحص", "EGX كوانت: فحص ✓ {{ticker}}")
alertcondition(alertBar and fvgBull, "FVG صاعد", "EGX كوانت: FVG صاعد {{ticker}}")
alertcondition(alertBar and buyConfluence and not buyConfluence[1], "توافق شراء", "EGX كوانت: توافق شراء {{ticker}}")
alertcondition(alertBar and chaseWarn and not chaseWarn[1], "تحذير مطاردة", "EGX كوانت: تحذير مطاردة {{ticker}}")

plot(accumScore100, "EGX_تراكم", display=display.data_window)
plot(distRisk100, "EGX_تصريف", display=display.data_window)
plot(composite, "EGX_فرصة", display=display.data_window)
plot(breakScore, "EGX_اختراق", display=display.data_window)
plot(i_useCycleSM ? cycleState : na, "EGX_دورة", display=display.data_window)
plot(cycleScore, "EGX_درجة_دورة", display=display.data_window)
plot(baseScore, "EGX_قاعدة", display=display.data_window)
plot(egxRank, "EGX_ترتيب", display=display.data_window)
plot(setupHits, "EGX_شروط", display=display.data_window)

if i_webhookJson and barstate.isconfirmed and confirmedLong
    alert('{"event":"opp_confirmed","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","rank":' + str.tostring(egxRank, "#.##") + ',"opp":' + str.tostring(composite, "#.##") + ',"acc":' + str.tostring(accumScore100, "#") + ',"dist":' + str.tostring(distRisk100, "#") + ',"setup":"' + setupTier + '","hits":' + str.tostring(setupHits) + ',"break":"' + breakState + '","cycle":' + str.tostring(cycleState) + '}', alert.freq_once_per_bar_close)

string i_egxPreset = input.string("يومي EGX (252)", "Preset نشط", options=["يومي EGX (252)", "مضاربة 60m", "استثمار أسبوعي", "مخصص — من الإعدادات"], group=GRP_PRESET, tooltip="يومي: D + 252 · 60m: RVOL أعلى · أسبوعي: W/M · مخصص: قيم المدخلات فقط")


//@version=6
indicator("EGX كوانت برو — تراكم · ذكاء حجم · دورات", shorttitle="EGX كوانت", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100, max_tables_count=10, calc_bars_count=5000)


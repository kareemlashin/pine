//@version=6
indicator("EGX Volume Profile — POC · VA · HVN", shorttitle="EGX VP", overlay=true, max_lines_count=120, max_boxes_count=30, max_tables_count=4, calc_bars_count=5000)

// ملف حجم سعري — POC · Value Area 70% · HVN/LVN · EGX يومي
// docs/EGX_VOLUME.md

string G = "إعداد"
int vpLen = input.int(120, "نافذة (bars)", minval=30, maxval=500, group=G)
int bins = input.int(36, "مستويات", minval=12, maxval=60, group=G)
float vaPct = input.float(70.0, "Value Area %", minval=60, maxval=90, group=G)
int topHvn = input.int(3, "HVN خطوط", minval=1, maxval=6, group=G)
int topLvn = input.int(2, "LVN خطوط", minval=0, maxval=4, group=G)
bool extendVa = input.bool(true, "مد VA لليمين", group=G)
bool showTbl = input.bool(true, "جدول", group=G)

float atr = ta.atr(14)
int n = math.min(vpLen, bar_index)
float hi = ta.highest(high, n)
float lo = ta.lowest(low, n)
float step = (hi - lo) / math.max(bins, 1)
step := step <= syminfo.mintick ? syminfo.mintick : step

array<float> volBins = array.new_float(bins, 0.0)
for i = 0 to n - 1
    float px = hlc3[i]
    int b = int(math.floor((px - lo) / step))
    b := math.max(0, math.min(bins - 1, b))
    array.set(volBins, b, array.get(volBins, b) + volume[i])

int pocI = 0
float maxV = array.get(volBins, 0)
for b = 1 to bins - 1
    float v = array.get(volBins, b)
    if v > maxV
        maxV := v
        pocI := b

float poc = lo + (pocI + 0.5) * step
float totalV = 0.0
for b = 0 to bins - 1
    totalV += array.get(volBins, b)
float target = totalV * vaPct / 100.0
float acc = array.get(volBins, pocI)
int loI = pocI
int hiI = pocI
while acc < target and (loI > 0 or hiI < bins - 1)
    float vLo = loI > 0 ? array.get(volBins, loI - 1) : 0.0
    float vHi = hiI < bins - 1 ? array.get(volBins, hiI + 1) : 0.0
    if vLo >= vHi and loI > 0
        loI -= 1
        acc += vLo
    else if hiI < bins - 1
        hiI += 1
        acc += vHi
    else if loI > 0
        loI -= 1
        acc += array.get(volBins, loI)
    else
        break

float vaLo = lo + loI * step
float vaHi = lo + (hiI + 1) * step
bool inVa = close >= vaLo and close <= vaHi
bool abovePoc = close > poc
bool belowPoc = close < poc

f_pickExtreme(bool wantHigh) =>
    array<int> picked = array.new_int()
    int k = wantHigh ? topHvn : topLvn
    for rank = 0 to k - 1
        float best = wantHigh ? -1.0 : 1e15
        int bestB = -1
        for b = 0 to bins - 1
            bool used = false
            for u = 0 to array.size(picked) - 1
                if array.get(picked, u) == b
                    used := true
            float v = array.get(volBins, b)
            bool ok = wantHigh ? v > best : v < best and v > 0
            if not used and ok
                best := v
                bestB := b
        if bestB >= 0
            array.push(picked, bestB)
    picked

var box vaBox = na
if barstate.islast
    box.delete(vaBox)
    int x1 = bar_index - n
    int x2 = extendVa ? bar_index + 10 : bar_index
    vaBox := box.new(x1, vaHi, x2, vaLo, bgcolor=color.new(color.blue, 92), border_color=color.new(color.blue, 60), text="VA" + str.tostring(vaPct, "#"), text_size=size.tiny)

plot(poc, "POC", color=color.yellow, linewidth=3)
plot(vaLo, "VA Low", color=color.new(color.gray, 40), linewidth=1)
plot(vaHi, "VA High", color=color.new(color.gray, 40), linewidth=1)

array<int> hvn = f_pickExtreme(true)
array<int> lvn = f_pickExtreme(false)
var array<line> hvnLines = array.new_line()
var array<line> lvnLines = array.new_line()
if barstate.islast
    for i = 0 to array.size(hvnLines) - 1
        line.delete(array.get(hvnLines, i))
    array.clear(hvnLines)
    for i = 0 to array.size(lvnLines) - 1
        line.delete(array.get(lvnLines, i))
    array.clear(lvnLines)
    int x1 = bar_index - n
    int x2 = extendVa ? bar_index + 10 : bar_index
    for i = 0 to array.size(hvn) - 1
        float px = lo + (array.get(hvn, i) + 0.5) * step
        array.push(hvnLines, line.new(x1, px, x2, px, color=color.new(color.lime, 20 + i * 15), width=1, style=line.style_solid))
    for i = 0 to array.size(lvn) - 1
        float px = lo + (array.get(lvn, i) + 0.5) * step
        array.push(lvnLines, line.new(x1, px, x2, px, color=color.new(color.orange, 30), width=1, style=line.style_dotted))

bgcolor(inVa ? color.new(color.blue, 95) : na)

var table t = table.new(position.top_right, 2, 6, border_width=1)
if showTbl and barstate.islast
    table.clear(t, 0, 0, 1, 5)
    table.cell(t, 0, 0, "Profile", bgcolor=color.black, text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(n) + "b", text_size=size.tiny)
    table.cell(t, 0, 1, "POC", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(poc, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 2, "VA", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(vaLo, format.mintick) + "–" + str.tostring(vaHi, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 3, "Price vs POC", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, abovePoc ? "فوق" : belowPoc ? "تحت" : "على", text_color=abovePoc ? color.lime : color.red, text_size=size.tiny)

plot(inVa ? 1 : 0, "EGVP_InVA", display=display.data_window)
plot(poc, "EGVP_POC", display=display.data_window)

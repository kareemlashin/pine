//@version=6
indicator("EGX أفضل فرص — 200 سهم", shorttitle="أفضل فرص 200", overlay=false, max_tables_count=1, calc_bars_count=5000)

// 40 رمز × 5 صفحات = 200 سهم مرتّب فرصة↓
// ضع اللوحة على شارت EGX:EGX30 لحساب RS الصحيح (بدون استدعاء إضافي)
// المسح عبر الماسح: pine/EGX_افضل_فرص.pine · قائمة: docs/EGX_WATCHLIST_200.txt
// plots: EGXOppB_*

int N = 40
string G = "═══ 200 سهم ═══"
string page = input.string("1 كبار 1–40", "صفحة", options=["1 كبار 1–40","2 SCEM–BONY","3 SUGR–ADCI","4 GDWA–AALR","5 GTWL–UNIP"], group=G)
string bench = input.symbol("EGX:EGX30", "EGX30 (إن لم يكن الشارت)", group=G)
bool chartIs30 = input.bool(true, "الشارت هو EGX30 (موصى)", group=G)
float minVol = input.float(800.0, "حد حجم", group=G)
int showTop = input.int(40, "عرض أعلى N", minval=5, maxval=40, group=G)
float minOppShow = input.float(55.0, "حد فرصة للتمييز", minval=0, maxval=80, group=G)
bool hideWeak = input.bool(false, "إخفاء الأضعف", group=G)
bool onlyBuy = input.bool(false, "شراء فقط", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)


//@version=6
indicator("EGX Volume Relative — vs EGX30", shorttitle="EGX VRel", overlay=false, max_tables_count=3, calc_bars_count=5000)

// RVOL · RS Volume vs EGX30 · حجم/Symbol · docs/EGX_VOLUME.md

string G = "مقارنة"
string bench = input.symbol("EGX:EGX30", "مؤشر", group=G)
string peer = input.symbol("", "سهم مقارن (اختياري)", group=G)
int maLen = input.int(20, "MA حجم", minval=5, group=G)
bool usePeer = input.bool(false, "RS vs سهم ثان", group=G)

float volMa = ta.sma(volume, maLen)
float rvol = volume / math.max(volMa, 1.0)

float bVol = request.security(bench, timeframe.period, volume, barmerge.gaps_off, barmerge.lookahead_off)
float bMa = request.security(bench, timeframe.period, ta.sma(volume, maLen), barmerge.gaps_off, barmerge.lookahead_off)
float bRvol = bMa > 0 ? bVol / bMa : na
float rsVol = not na(bRvol) and bRvol > 0 ? rvol / bRvol : na

float pRvol = na
float rsPeer = na
if usePeer and peer != ""
    pRvol := request.security(peer, timeframe.period, volume / math.max(ta.sma(volume, maLen), 1.0), barmerge.gaps_off, barmerge.lookahead_off)
    rsPeer := not na(pRvol) and pRvol > 0 ? rvol / pRvol : na

bool spike = not na(rsVol) and rsVol >= 1.2
bool leader = not na(rsVol) and rsVol >= 1.05

plot(volume, "Volume", style=plot.style_columns, color=color.new(spike ? color.orange : color.gray, 60))
plot(volMa, "Vol MA", color=color.yellow, linewidth=2)
plot(rvol, "RVOL", color=color.white, scale=scale.right, linewidth=2)
plot(rsVol, "RS vol vs 30", color=leader ? color.lime : color.aqua, scale=scale.right, linewidth=2)
plot(1.0, "Parity", color=color.gray, scale=scale.right)
plot(usePeer ? rsPeer : na, "RS vs peer", color=color.purple, scale=scale.right, linewidth=1)

var table t = table.new(position.top_left, 2, 4, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 3)
    table.cell(t, 0, 0, syminfo.ticker, bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, leader ? "Vol leader" : "—", text_color=leader ? color.lime : color.gray, text_size=size.tiny)
    table.cell(t, 0, 1, "RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(rvol, "#.##"), text_size=size.tiny)
    table.cell(t, 0, 2, "RS vs 30", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(rsVol, "#.##"), text_color=spike ? color.orange : color.white, text_size=size.tiny)

plot(rsVol, "EGVRel_RSVol30", display=display.all)
plot(spike ? 1 : 0, "EGVRel_Spike", display=display.all)

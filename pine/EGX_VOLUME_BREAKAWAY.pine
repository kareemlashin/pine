//@version=6
indicator("EGX Volume Breakaway gap", shorttitle="EGX VBrkA", overlay=true, max_tables_count=2, calc_bars_count=5000)

// فجوة breakaway + RVOL · docs/EGX_VOLUME.md

string G = "Breakaway"
float minGap = input.float(2.0, "Gap %", minval=0.5, group=G)
float minRvol = input.float(1.5, "RVOL", group=G)
int boxLen = input.int(20, "Prior range", group=G)

float prevC = close[1]
float gapUp = prevC > 0 ? (open - prevC) / prevC * 100.0 : 0.0
float gapDn = prevC > 0 ? (prevC - open) / prevC * 100.0 : 0.0
float rvol = volume / math.max(ta.sma(volume, 20), 1.0)
float hi = ta.highest(high, boxLen)[1]
float lo = ta.lowest(low, boxLen)[1]

bool brkUp = gapUp >= minGap and open > hi and rvol >= minRvol and close >= open
bool brkDn = gapDn >= minGap and open < lo and rvol >= minRvol and close <= open

plotshape(brkUp, "Brk↑", shape.triangleup, location.belowbar, color=color.lime, size=size.normal, text="BA")
plotshape(brkDn, "Brk↓", shape.triangledown, location.abovebar, color=color.red, size=size.normal, text="BA")

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "Breakaway", bgcolor=color.black, text_color=color.orange, text_size=size.small)
    table.cell(t, 1, 0, brkUp ? "UP" : brkDn ? "DN" : "—", text_size=size.tiny)

plot(brkUp ? 1 : 0, "EGVBrkA_Up", display=display.all)
plot(brkDn ? 1 : 0, "EGVBrkA_Dn", display=display.all)

alertcondition(brkUp, "Breakaway up", "Breakaway gap up with volume")

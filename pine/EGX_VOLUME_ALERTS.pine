//@version=6
indicator("EGX Volume Alerts Hub — screener", shorttitle="EGX VAl", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مركز تنبيهات/ماسح خفيف · docs/EGX_VOLUME.md · Filter: EGVAl_Any

string G = "Hub"
float minRvol = input.float(1.5, "RVOL spike", group=G)
float minNet = input.float(54.0, "Net buy %", group=G)
float minVolMa = input.float(600.0, "Min avg vol", group=G)
int pctLen = input.int(120, "Vol rank", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockLimit = input.bool(true, "منع تنبيه شراء قرب halt", group=G)

float vma = ta.sma(volume, 20)
float rvol = volume / math.max(vma, 1.0)
float pct = ta.percentrank(volume, pctLen)
float rng = math.max(high - low, syminfo.mintick)
float netPct = (close - low) / rng * 100.0
float z = (volume - vma) / math.max(ta.stdev(volume, 20), 1.0)

bool liq = vma >= minVolMa
bool spike = rvol >= minRvol or z >= 2.0 or pct >= 90.0
bool buyFlow = netPct >= minNet and close >= open
bool sellFlow = netPct <= 100.0 - minNet and close <= open
bool dryExpand = rvol >= 1.3 and volume[1] < vma[1] * 0.7 and volume[2] < vma[2] * 0.7

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)

bool alBuy = liq and spike and buyFlow and not nearLimit
bool alSell = liq and spike and sellFlow
bool alDry = liq and dryExpand and close > open
bool any = alBuy or alSell or alDry

var table t = table.new(position.middle_center, 2, 6, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 5)
    table.cell(t, 0, 0, syminfo.ticker, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, any ? "ALERT" : "—", text_color=any ? color.orange : color.gray, text_size=size.large)
    table.cell(t, 0, 1, "Buy/Sell/Dry", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, (alBuy ? "B " : "") + (alSell ? "S " : "") + (alDry ? "D" : ""), text_size=size.tiny)
    table.cell(t, 0, 2, "RVOL/Z", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(rvol, "#.##") + " / " + str.tostring(z, "#.#"), text_size=size.tiny)

plot(alBuy ? 1 : 0, "EGVAl_Buy", display=display.all)
plot(alSell ? 1 : 0, "EGVAl_Sell", display=display.all)
plot(alDry ? 1 : 0, "EGVAl_DryExp", display=display.all)
plot(any ? 1 : 0, "EGVAl_Any", display=display.all)
plot(pct, "EGVAl_VolPct", display=display.all)

alertcondition(alBuy, "V hub buy", "EGX volume alert BUY")
alertcondition(any, "V hub any", "EGX volume alert")

//@version=6
indicator("EGX Volume WAD — Williams A/D", shorttitle="EGX VWAD", overlay=false, max_tables_count=2, calc_bars_count=5000)

// Williams Accumulation/Distribution · docs/EGX_VOLUME.md

string G = "WAD"
int maLen = input.int(25, "MA WAD", group=G)

float trh = math.max(high, close[1])
float trl = math.min(low, close[1])
float wadInc = close > close[1] ? close - trl : close < close[1] ? close - trh : 0.0
var float wad = 0.0
wad += wadInc
float wadMa = ta.sma(wad, maLen)

bool acc = wad > wadMa and wad > wad[3]
bool dist = wad < wadMa and wad < wad[3]

plot(wad, "EGVWAD_Val", color=color.teal, linewidth=2, display=display.all)
plot(wadMa, "MA", color=color.orange, linewidth=1, display=display.none)

var table t = table.new(position.top_right, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "WAD", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, acc ? "Acc" : dist ? "Dist" : "—", text_size=size.tiny)

plot(acc ? 1 : 0, "EGVWAD_Acc", display=display.all)
plot(wad - wadMa, "EGVWAD_Spread", display=display.all)

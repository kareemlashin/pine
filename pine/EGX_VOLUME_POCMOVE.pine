//@version=6
indicator("EGX Volume POC Move", shorttitle="EGX VPOC", overlay=true, max_lines_count=20, max_tables_count=2, calc_bars_count=5000)

// تحرك POC بين نافذتين · docs/EGX_VOLUME.md

string G = "POC"
int win = input.int(80, "Window", minval=30, group=G)
int bins = input.int(24, "Bins", group=G)
float minShift = input.float(0.8, "Min shift %", step=0.1, group=G)

f_poc(int w) =>
    int n = math.min(w, bar_index)
    float hi = ta.highest(high, n)
    float lo = ta.lowest(low, n)
    float step = math.max((hi - lo) / bins, syminfo.mintick)
    array<float> volB = array.new_float(bins, 0.0)
    for i = 0 to n - 1
        int bi = int(math.floor((hlc3[i] - lo) / step))
        bi := math.max(0, math.min(bins - 1, bi))
        array.set(volB, bi, array.get(volB, bi) + volume[i])
    float maxV = 0.0
    int maxI = 0
    for b = 0 to bins - 1
        float v = array.get(volB, b)
        if v > maxV
            maxV := v
            maxI := b
    lo + (maxI + 0.5) * step

float pocNow = f_poc(win)
int lag = math.max(int(win / 2), 1)
float pocPrev = pocNow[lag]
float shiftPct = pocPrev > 0 ? (pocNow - pocPrev) / pocPrev * 100.0 : 0.0

bool upPoc = shiftPct >= minShift
bool dnPoc = shiftPct <= -minShift

plot(pocNow, "POC", color=color.orange, linewidth=2)
plotshape(upPoc, "POC↑", shape.triangleup, location.belowbar, color=color.lime, size=size.tiny)
plotshape(dnPoc, "POC↓", shape.triangledown, location.abovebar, color=color.red, size=size.tiny)

var table t = table.new(position.bottom_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "POC move", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(shiftPct, "#.##") + "%", text_size=size.tiny)

plot(upPoc ? 1 : 0, "EGVPOC_Up", display=display.all)
plot(dnPoc ? 1 : 0, "EGVPOC_Dn", display=display.all)
plot(shiftPct, "EGVPOC_ShiftPct", display=display.all)

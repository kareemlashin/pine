//@version=6
strategy("EGX استراتيجية المحلل v10 — اختبار", shorttitle="EGX محلل STR", overlay=true, pyramiding=2, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=2, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP, max_boxes_count=20)

// مرتبط بـ EGX_ANALYZER · ماسح EGX_* · ORB · Gann · DCA382 · بوابات 10

string G_SET = "ضبط EGX"
string profile = input.string("معياري EGX", "الملف", options=["معياري EGX", "مضاربة 15د", "استثمار يومي", "مخصص"], group=G_SET)

string G_IN = "دخول"
int pivotLen = input.int(8, "محور التأرجح", minval=3, maxval=15, group=G_IN)
int volMaLen = input.int(20, "متوسط الحجم", group=G_IN)
float minAvgVolIn = input.float(1500.0, "حد أدنى متوسط حجم", group=G_IN)
float minScoreIn = input.float(58.0, "حد التقييم /100", group=G_IN)
float minRRIn = input.float(1.5, "حد R/R", group=G_IN)
float minRvolIn = input.float(1.0, "حد RVOL", group=G_IN)
bool useConfirm = input.bool(true, "دخول عند إغلاق الشمعة", group=G_IN)
int minSetupHitsIn = input.int(7, "حد شروط الإعداد (/11–13، 0=إيقاف)", minval=0, maxval=13, group=G_IN)
float minEgxRankIn = input.float(65.0, "حد الرتبة (0=إيقاف)", minval=0, maxval=100, group=G_IN)
float minOppIn = input.float(62.0, "حد الفرصة (0=إيقاف)", minval=0, maxval=100, group=G_IN)
float maxDistIn = input.float(65.0, "أقصى مخاطرة تصريف", minval=30, maxval=100, group=G_IN)
float minAccIn = input.float(0.0, "أدنى تجميع (0=إيقاف)", minval=0, maxval=100, group=G_IN)
bool requirePro = input.bool(false, "فلتر Pro (فرصة+دورة+رتبة)", group=G_IN)
bool requireBroadMkt = input.bool(false, "يتطلب اتساع 30/70", group=G_IN)
bool requireMtf = input.bool(true, "MTF ≥ 1", group=G_IN)
bool requireGlob = input.bool(true, "توافق عالمي ≥ 0", group=G_IN)
bool blockOnStructBreak = input.bool(true, "منع بعد كسر دعم", group=G_IN)
bool blockBearRegime = input.bool(true, "منع في ضغط بيعي على المؤشرات", group=G_IN)
int minGates = input.int(8, "حد أدنى بوابات (/10، 0=إيقاف)", minval=0, maxval=10, group=G_IN)
bool blockLimitBuy = input.bool(true, "منع شراء قرب halt اليومي", group=G_IN)
float limitBuyPct = input.float(9.0, "تحذير halt %", minval=3.0, maxval=10.0, step=0.5, group=G_IN)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G_IN)
bool skipSundayBuy = input.bool(false, "لا دخول يوم الأحد", group=G_IN)
int breakConfirmBars = input.int(2, "إغلاقات لتأكيد الاختراق", minval=1, maxval=5, group=G_IN)
bool skipOffHours = input.bool(false, "لا دخول خارج المستمر", group=G_IN)
bool useMktHalt100 = input.bool(true, "منع شراء إذا EGX100 ≤ −10%", group=G_IN)
float riskPctEq = input.float(1.5, "مخاطرة % محفظة", minval=0.5, maxval=3.0, step=0.1, group=G_IN)
float partCapPct = input.float(8.0, "سقف ADV 20 يوم %", minval=2, maxval=15, group=G_IN)
bool useRiskQty = input.bool(true, "حجم = مخاطرة 1–2% + سقف ADV", group=G_IN)

string G_COST = "تنفيذ"
string execProfile = input.string("EGX متوسط", "ملف slippage", options=["EGX سائل", "EGX متوسط", "EGX رقيق"], group=G_COST)

string G_EX = "خروج"
bool useInvestStop = input.bool(false, "وقف إلغاء موجي", group=G_EX)
bool usePartial = input.bool(true, "جزئي عند 50% للهدف", group=G_EX)
float partialPct = input.float(50.0, "نسبة الخروج الجزئي", minval=10, maxval=90, group=G_EX)
string runnerTarget = input.string("T2", "هدف الباقي بعد جزئي", options=["T1", "T2", "T3"], group=G_EX)
bool useTrail = input.bool(true, "وقف متحرك بعد جزئي", group=G_EX)
float trailAtrMult = input.float(1.2, "متحرك × ATR", minval=0.5, step=0.1, group=G_EX)
bool useBreakeven = input.bool(true, "تعادل بعد جزئي", group=G_EX)
bool usePartialT2 = input.bool(false, "جزئي إضافي عند T2 (25%)", group=G_EX)
float partialT2Pct = input.float(25.0, "نسبة T2 %", minval=5, maxval=50, group=G_EX)
int maxBarsInTrade = input.int(0, "أقصى شموع في الصفقة (0=إيقاف)", minval=0, maxval=500, group=G_EX)

string G_TIME = "زمني / ORB"
bool useGann = input.bool(true, "نوافذ Gann (9/18/27/45/90)", group=G_TIME)
int gannTol = input.int(2, "تسامح Gann (±شموع)", minval=0, maxval=5, group=G_TIME)
bool requireGann = input.bool(false, "يتطلب توافق Gann للدخول", group=G_TIME)
bool showOrb = input.bool(true, "خطوط نطاق الافتتاح", group=G_TIME)
bool showPivotDay = input.bool(true, "خط S1 يومي", group=G_TIME)
bool allowOrb = input.bool(false, "دخول: كسر ORB (intraday)", group=G_TIME)
int orbBars = input.int(6, "ORB — أول N شموع", minval=3, maxval=15, group=G_TIME)
bool allowPivotDay = input.bool(false, "دخول: ارتداد S1 يومي", group=G_TIME)

string G_BR = "اختراق / منطقة"
bool allowZone = input.bool(true, "دخول: منطقة طلب", group=G_BR)
bool allowBreakRetest = input.bool(true, "دخول: إعادة اختبار اختراق", group=G_BR)
bool allowBreakConfirm = input.bool(false, "دخول: كسر بنية + حجم نسبي", group=G_BR)
bool allowFvg = input.bool(true, "دخول: FVG صاعد + منطقة", group=G_BR)
bool allowChoch = input.bool(false, "دخول: CHoCH + retest دعم", group=G_BR)
bool allowScOnly = input.bool(false, "دخول: ذروة بيع SC (تأكيد)", group=G_BR)
bool allowObvDiv = input.bool(false, "دخول: تباعد OBV صاعد", group=G_BR)
bool showSqueezeBox = input.bool(false, "صندوق تماسك (squeeze)", group=G_BR)
bool blockChase = input.bool(true, "منع مطاردة", group=G_BR)
bool blockFakeBreak = input.bool(true, "منع عند فشل اختراق", group=G_BR)
float chaseRsiMax = input.float(72.0, "مطاردة RSI >", group=G_BR)
float chaseRrMax = input.float(1.0, "مطاردة R/R <", group=G_BR)
int structPivot = input.int(5, "محور كسر البنية", minval=2, maxval=15, group=G_BR)
float breakRvolMin = input.float(1.2, "حد الحجم النسبي للكسر", minval=1.0, step=0.1, group=G_BR)
int minCycleLong = input.int(3, "أدنى مرحلة دورة (0=إيقاف)", minval=0, maxval=12, group=G_BR)
int maxCycleLong = input.int(10, "أقصى مرحلة دورة للشراء", minval=1, maxval=12, group=G_BR)

string G_UI = "عرض"
bool showStatusTbl = input.bool(true, "جدول حالة (أسفل يمين)", group=G_UI)
bool showEntryMarks = input.bool(true, "علامات دخول على الشارت", group=G_UI)
bool useEgxSession = input.bool(false, "دخول داخل جلسة EGX فقط", group=G_UI)

string G_KELLY = "كيلي"
bool useKellyQty = input.bool(false, "حجم الصفقة = كيلي (بدل 10%)", group=G_KELLY)
float kellyCap = input.float(15.0, "سقف كيلي %", minval=5, maxval=25, group=G_KELLY)

string G_DCA = "توسيع DCA"
bool useDcaAdd = input.bool(false, "إضافة عند فيب 38.2% (مرة واحدة)", group=G_DCA)
float dcaAddPct = input.float(50.0, "نسبة الإضافة %", minval=10, maxval=100, group=G_DCA)

string G_ALT = "تنبيهات"
bool alertEntry = input.bool(true, "إشارة دخول", group=G_ALT)
bool alertChase = input.bool(true, "تحذير مطاردة", group=G_ALT)
bool alertExit = input.bool(true, "خروج / كسر دعم", group=G_ALT)
bool alertScreener = input.bool(true, "نجاح الماسح", group=G_ALT)
bool useWebhookJson = input.bool(false, "JSON عند الدخول", group=G_ALT)
bool showStratBanner = input.bool(false, "بانر قرار (أسفل يمين)", group=G_ALT)
bool showCycleBg = input.bool(false, "خلفية مرحلة دورة صاعدة", group=G_UI)

bool showStratPanel = input.bool(true, "لوحة إشارة (أعلى وسط)", group=G_UI)
bool uiClearSt = input.bool(true, "تخطيط واضح (لا تداخل)", group=G_UI)
bool effStPanel = showStratPanel and uiClearSt
bool effStTbl = showStatusTbl and (not uiClearSt or not showStratPanel)
bool effStBanner = showStratBanner and (not uiClearSt or not showStatusTbl) and not effStPanel

bool profCustom = profile == "مخصص"
float effMinVol = profCustom ? minAvgVolIn : profile == "مضاربة 15د" ? 3000.0 : profile == "استثمار يومي" ? 800.0 : 1500.0
float minScore = profCustom ? minScoreIn : profile == "مضاربة 15د" ? 60.0 : 58.0
float minRR = profCustom ? minRRIn : 1.5
float minRvol = profCustom ? minRvolIn : 1.0
float minOpp = profCustom ? minOppIn : 62.0
float maxDist = profCustom ? maxDistIn : 65.0
int minSetupHits = profCustom ? minSetupHitsIn : 7
float minEgxRank = profCustom ? minEgxRankIn : profile == "استثمار يومي" ? 60.0 : 65.0
float minAcc = profCustom ? minAccIn : profile == "استثمار يومي" ? 50.0 : 0.0
bool effRequirePro = profile == "معياري EGX" ? true : profCustom ? requirePro : false

strategy.risk.max_drawdown(50, strategy.percent_of_equity)

bool barOk = useConfirm ? barstate.isconfirmed : true

float emaF = ta.ema(close, 9)
float emaM = ta.ema(close, 21)
float emaS = ta.ema(close, 50)
float emaT = ta.ema(close, 200)
bool bullStack = emaF > emaM and emaM > emaS
bool above200 = close > emaT

float htfClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float htfEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = htfClose > htfEma50

f_tfBull(string tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)

int mtfBulls = 0
mtfBulls += f_tfBull("15") ? 1 : 0
mtfBulls += f_tfBull("60") ? 1 : 0
mtfBulls += f_tfBull("D") ? 1 : 0
mtfBulls += f_tfBull("W") ? 1 : 0
int mtfBias = (f_tfBull("15") ? 1 : -1) + (f_tfBull("60") ? 1 : -1) + (f_tfBull("D") ? 1 : -1) + (f_tfBull("W") ? 1 : -1)

[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
bool macdBull = macdHist > 0 and macdLine > macdSignal
float rsi = ta.rsi(close, 14)
[_, stDir] = ta.supertrend(3.0, 10)
[bbMid, _, _] = ta.bb(close, 20, 2.0)

float atr = ta.atr(14)
float atrMa = ta.sma(atr, 20)
float volMa = ta.sma(volume, volMaLen)
float rvol = volume / math.max(volMa, 1.0)
bool volSpike = volume > volMa * 2.0

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 14) / ta.sma(volume, 14)
float ad = ta.cum(mfm * volume)
float obv = ta.cum(math.sign(ta.change(close)) * volume)
float obvSlope = ta.linreg(obv, 10, 0) - ta.linreg(obv, 10, 1)
bool accumulating = cmf > 0 and ad > ad[14]
bool distributing = cmf < 0 and ad < ad[14]

string benchSym = "EGX:EGX30"
float benchRoc = request.security(benchSym, timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
bool rsLeader = ta.roc(close, 20) - benchRoc > 0

float dPrevClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayChgPct = dPrevClose > 0 ? (close - dPrevClose) / dPrevClose * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
float haltWarnPct = math.min(limitBuyPct, math.max(haltPct - 1.0, haltPct * 0.9))
float execPad = execProfile == "EGX رقيق" ? 2.0 : execProfile == "EGX سائل" ? 0.5 : 1.0
bool nearHaltUp = blockLimitBuy and dPrevClose > 0 and dayChgPct >= math.min(haltWarnPct, haltPct - execPad)
bool atLuldUp = dPrevClose > 0 and dayChgPct >= luldPct - 0.25
bool nearLimitUp = nearHaltUp or atLuldUp
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool sundaySkip = skipSundayBuy and dayofweek == dayofweek.sunday
int egxSessId = 0
if not na(time(timeframe.period, "0830-1000:23456", "Africa/Cairo"))
    egxSessId := 1
if not na(time(timeframe.period, "1000-1415:23456", "Africa/Cairo"))
    egxSessId := 2
if not na(time(timeframe.period, "1415-1425:23456", "Africa/Cairo"))
    egxSessId := 3
if not na(time(timeframe.period, "1425-1430:23456", "Africa/Cairo"))
    egxSessId := 4
bool sessionPhaseOk = not skipOffHours or not timeframe.isintraday or egxSessId == 2

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    float e100 = ta.ema(close, 100)
    sc += close > e20 ? 1 : close < e20 ? -1 : 0
    sc += e20 > e50 ? 1 : e20 < e50 ? -1 : 0
    sc += e50 > e100 ? 1 : e50 < e100 ? -1 : 0
    sc

f_mktMom() =>
    close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0

int trMkt30 = request.security("EGX:EGX30", timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
int trMkt70 = request.security("EGX:EGX70EWI", timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
float momMkt30 = request.security("EGX:EGX30", timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off)
float momMkt70 = request.security("EGX:EGX70EWI", timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off)
bool heavySellMkt = momMkt30 < -4.0 and momMkt70 < -3.0 and trMkt30 <= -1
bool broadUpMkt = trMkt30 >= 1 and trMkt70 >= 0

int globBull = 0
globBull += bullStack ? 1 : -1
globBull += macdBull ? 1 : -1
globBull += close > bbMid ? 1 : -1
globBull += stDir < 0 ? -1 : 1
globBull += rsLeader ? 1 : -1
globBull += accumulating ? 1 : distributing ? -1 : 0
globBull += mtfBulls >= 3 ? 1 : mtfBulls <= 1 ? -1 : 0

float pl = ta.pivotlow(low, pivotLen, pivotLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
var float swingLow = na
var float swingHigh = na
var int barsSincePivotLow = 0
if not na(pl)
    swingLow := pl
    barsSincePivotLow := 0
else
    barsSincePivotLow += 1
if not na(ph)
    swingHigh := ph

f_gannHit(int b) =>
    bool hit = false
    for g in array.from(9, 18, 27, 45, 90)
        if math.abs(b - g) <= gannTol
            hit := true
            break
    hit
bool gannAlign = useGann and f_gannHit(barsSincePivotLow)

bool newSess = ta.change(time("D")) != 0
var float orbH = na
var float orbL = na
var int sessBar = 0
if newSess
    orbH := high
    orbL := low
    sessBar := 0
else
    sessBar += 1
if sessBar < orbBars
    orbH := math.max(orbH, high)
    orbL := math.min(orbL, low)
bool orbReady = sessBar >= orbBars
bool orbBreakUp = orbReady and timeframe.isintraday and close > orbH and close[1] <= orbH

[dH, dL, dC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)
float ppDay = (dH + dL + dC) / 3.0
float s1Day = 2.0 * ppDay - dH
bool nearDayS1 = low <= s1Day * 1.002 and close >= s1Day and close <= ppDay

float phs = ta.pivothigh(high, structPivot, structPivot)
var float activeHigh = na
var int structDir = 0
if not na(phs)
    activeHigh := phs
bool bullBreak = barOk and not na(activeHigh) and close > activeHigh and close[1] <= activeHigh
if bullBreak
    structDir := 1
    activeHigh := na

int consolLen = 15
bool squeezeOn = atr < atrMa * 0.85
bool rangeContract = ta.highest(high, consolLen) - ta.lowest(low, consolLen) < (ta.highest(high, consolLen * 2) - ta.lowest(low, consolLen * 2)) * 0.55
bool failedLow = not na(swingLow) and low <= swingLow * 1.008 and close > swingLow
bool retestSupport = barOk and not na(swingLow) and low <= swingLow * 1.005 and close > swingLow
bool fakeBreakUp = barOk and not na(swingHigh) and high > swingHigh and close < swingHigh and rvol > 1.05
bool fvgBull = low > high[2] and close > open
bool sellingClimax = volSpike and close < open and low <= ta.lowest(low, 10) and rsi < 38
bool scBounce = barOk and sellingClimax[1] and close > open and close > low[1]
bool obvBullDiv = barOk and low < low[5] and obv > obv[5] and close > open

float accPts = 0.0
accPts += rangeContract ? 12.0 : 0.0
accPts += squeezeOn ? 8.0 : 0.0
accPts += failedLow ? 12.0 : 0.0
accPts += retestSupport ? 10.0 : 0.0
accPts += cmf > 0.05 ? 8.0 : 0.0
accPts += obvSlope > 0 ? 8.0 : 0.0
accPts += accumulating ? 10.0 : 0.0
float accumScore100 = math.min(100.0, accPts)

float distPts = 0.0
distPts += fakeBreakUp ? 14.0 : 0.0
distPts += distributing ? 10.0 : 0.0
distPts += cmf < -0.05 ? 8.0 : 0.0
distPts += obvSlope < 0 ? 8.0 : 0.0
float distRisk100 = math.min(100.0, distPts)

bool swingBreakUp = barOk and not na(swingHigh) and close > swingHigh and close[1] <= swingHigh
bool rawBreak = allowBreakConfirm and (bullBreak or swingBreakUp) and rvol >= breakRvolMin
var float brkHoldLvl = na
var int brkHoldBars = 0
if barstate.isconfirmed
    if rawBreak
        brkHoldLvl := nz(swingHigh, close[1])
        brkHoldBars := 1
    else if not na(brkHoldLvl) and close > brkHoldLvl
        brkHoldBars += 1
    else
        brkHoldLvl := na
        brkHoldBars := 0
bool breakConfirmed = allowBreakConfirm and barOk and not na(brkHoldLvl) and brkHoldBars >= breakConfirmBars and (rvol >= breakRvolMin or rvol[1] >= breakRvolMin)
bool breakRetest = allowBreakRetest and retestSupport and structDir == 1 and not fakeBreakUp

float zoneW = atr * 0.35
float demandHi = na(swingLow) ? na : swingLow + zoneW
float demandLo = na(swingLow) ? na : swingLow - zoneW * 1.2
float waveInv = na(swingLow) ? na : swingLow - atr * 0.35

float swingRange = nz(swingHigh - swingLow, atr * 3)
float t1 = na(swingHigh) ? close + atr * 2 : swingHigh
float t2 = nz(swingLow, close) + swingRange * 1.618
float t3 = nz(swingLow, close) + swingRange * 2.618
float entryP = na(demandHi) ? close : (demandHi + demandLo) / 2.0
float stopL = useInvestStop and not na(waveInv) ? waveInv : na(demandLo) ? close - atr * 2 : demandLo - atr * 0.5
float tHalf = entryP + (t1 - entryP) * 0.5
float fib382 = nz(swingLow, close) + swingRange * 0.382
float risk = math.max(entryP - stopL, syminfo.mintick)
float rr = risk > 0 ? (t1 - entryP) / risk : na

float hi252 = ta.highest(high, 252)
bool extended52 = hi252 > 0 and (close - hi252) / hi252 * 100 > -3
bool chaseWarn = extended52 and rsi > chaseRsiMax and not na(rr) and rr < chaseRrMax

bool upTrendC = structDir == 1 and close > emaS and close > emaF
bool inBaseC = rangeContract and squeezeOn
bool accPhaseC = inBaseC and accumScore100 >= distRisk100 + 10
bool distPhaseC = distRisk100 >= accumScore100 + 15
var int cycle12 = 3
int newCyc = distPhaseC ? 9 : accPhaseC ? 4 : inBaseC ? 3 : breakConfirmed ? 5 : upTrendC ? 6 : cycle12
if barOk
    cycle12 := newCyc

float score = 0.0
score += bullStack ? 20 : 0
score += above200 ? 15 : -5
score += htfBull ? 15 : -10
score += macdBull ? 10 : 0
score += accumulating ? 15 : -10
score += rvol >= minRvol ? 10 : 0
score += rsi > 40 and rsi < 70 ? 10 : 0
score += mtfBulls >= 3 ? 5 : mtfBulls <= 1 ? -4 : 0
score += globBull >= 0 ? 3 : -5
score += accumScore100 >= 55 ? 5 : 0
score += distRisk100 >= 55 ? -8 : 0
score := math.max(0, math.min(100, score))

bool inZone = not na(demandLo) and low <= demandHi and high >= demandLo
bool mtfBullOk = mtfBias >= 1
int setupHits = 0
setupHits += bullStack ? 1 : 0
setupHits += htfBull ? 1 : 0
setupHits += macdBull ? 1 : 0
setupHits += accumulating ? 1 : 0
setupHits += rsLeader ? 1 : 0
setupHits += structDir == 1 ? 1 : 0
setupHits += inZone ? 1 : 0
setupHits += globBull >= 5 ? 1 : 0
setupHits += mtfBullOk ? 1 : 0
setupHits += rvol >= minRvol ? 1 : 0
setupHits += breakRetest or breakConfirmed ? 1 : 0
setupHits += accumScore100 >= 50 ? 1 : 0

float egxRank = math.max(0, math.min(100, score * 0.55 + globBull * 8.0 + mtfBias * 3.0))
float opportunity = score * 0.45 + setupHits / 11.0 * 100.0 * 0.35 + math.min(100.0, nz(rr, 0) / 3.0 * 100.0) * 0.2

float winProbK = math.max(0.35, math.min(0.72, setupHits / 11.0 * 0.55 + egxRank / 100.0 * 0.25))
float kellyRaw = rr > 0 ? (winProbK * rr - (1.0 - winProbK)) / rr : 0.0
float kellyPct = math.max(0.0, math.min(kellyCap, kellyRaw * 100.0))

bool liqOk = volMa >= effMinVol
bool structBreak = barOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
var int biasStruct = 0
if barOk
    if structBreak
        biasStruct := -1
    if bullBreak or swingBreakUp
        biasStruct := 1
bool chochUp = barOk and (bullBreak or swingBreakUp) and biasStruct[1] == -1
bool mtfOk = not requireMtf or mtfBias >= 1
bool globOk = not requireGlob or globBull >= 0
bool setupOk = minSetupHits <= 0 or setupHits >= minSetupHits
bool rankOk = minEgxRank <= 0 or egxRank >= minEgxRank
bool oppOk = minOpp <= 0 or opportunity >= minOpp
bool distOk = distRisk100 < maxDist
bool accOk = minAcc <= 0 or accumScore100 >= minAcc
bool cycleMinOk = minCycleLong <= 0 or cycle12 >= minCycleLong
bool cycleOk = cycleMinOk and cycle12 <= maxCycleLong and cycle12 != 9 and cycle12 != 11 and cycle12 != 12
bool regimeOk = not blockBearRegime or not heavySellMkt
bool broadOk = not requireBroadMkt or broadUpMkt
bool chaseOk = not blockChase or not chaseWarn
bool fakeOk = not blockFakeBreak or not fakeBreakUp
bool inEgxSession = not useEgxSession or not na(time(timeframe.period, "1000-1430:23456", "Africa/Cairo"))
bool sessionOk = inEgxSession and sessionPhaseOk and not sundaySkip and not mktHalt100
bool limitOk = not nearLimitUp

bool oppStrongGate = opportunity >= minOpp + 6 and setupHits >= 7 and distRisk100 < 55
bool proOk = not effRequirePro or (oppStrongGate and cycle12 >= 4 and cycle12 <= 7 and egxRank >= minEgxRank and setupHits >= 7 and distOk and regimeOk)
bool gannOk = not requireGann or gannAlign
bool atSwingSup = not na(swingLow) and low <= swingLow * 1.01 and close >= swingLow

bool gateLiq = liqOk
bool gateMtf = mtfOk
bool gateGlob = globOk
bool gateRR = not na(rr) and rr >= minRR
bool gateSetup = setupOk
bool gateRegime = regimeOk
bool gateChaseG = chaseOk
bool gateDist = distOk
bool gateCycle = cycleOk
bool gateEntry = inZone or breakRetest or breakConfirmed or (allowFvg and fvgBull) or (allowChoch and chochUp and retestSupport) or (allowScOnly and scBounce and inZone) or (allowOrb and orbBreakUp) or (allowPivotDay and nearDayS1) or (allowObvDiv and obvBullDiv)
int gatesPass = (gateLiq ? 1 : 0) + (gateMtf ? 1 : 0) + (gateGlob ? 1 : 0) + (gateRR ? 1 : 0) + (gateSetup ? 1 : 0) + (gateRegime ? 1 : 0) + (gateChaseG ? 1 : 0) + (gateDist ? 1 : 0) + (gateCycle ? 1 : 0) + (gateEntry ? 1 : 0)
bool gatesOk = minGates <= 0 or gatesPass >= minGates

bool coreLong = barOk and gatesOk and gannOk and liqOk and mtfOk and globOk and setupOk and rankOk and oppOk and distOk and accOk and cycleOk and regimeOk and broadOk and proOk and chaseOk and fakeOk and sessionOk and limitOk and not (blockOnStructBreak and structBreak) and bullStack and htfBull and macdBull and score >= minScore and rvol >= minRvol and not na(rr) and rr >= minRR

bool zoneLong = allowZone and coreLong and inZone
bool retestLong = allowBreakRetest and coreLong and breakRetest
bool confirmLong = allowBreakConfirm and coreLong and breakConfirmed
bool fvgLong = allowFvg and coreLong and fvgBull and (inZone or retestSupport)
bool chochLong = allowChoch and coreLong and chochUp and retestSupport
bool scLong = allowScOnly and coreLong and scBounce and inZone
bool orbLong = allowOrb and coreLong and orbBreakUp
bool pivotLong = allowPivotDay and coreLong and nearDayS1
bool obvLong = allowObvDiv and coreLong and obvBullDiv and (inZone or atSwingSup)
bool longSetup = zoneLong or retestLong or confirmLong or fvgLong or chochLong or scLong or orbLong or pivotLong or obvLong

int breakStateNum = breakConfirmed ? 4 : fakeBreakUp ? 3 : breakRetest ? 1 : swingBreakUp ? 2 : 0
string entryPathTxt = longSetup ? (orbLong ? "ORB" : pivotLong ? "S1" : obvLong ? "OBV" : fvgLong ? "FVG" : chochLong ? "CHoCH" : scLong ? "SC" : breakConfirmed ? "اختراق" : breakRetest ? "إعادة" : "منطقة") : "—"

int setupTierNum = setupHits >= 9 ? 4 : setupHits >= 7 ? 3 : setupHits >= 5 ? 2 : 1
bool screenerPass = liqOk and setupTierNum >= 3 and egxRank >= minEgxRank and not na(rr) and rr >= minRR and distOk and regimeOk and not structBreak and (longSetup or (inZone and score >= minScore))
bool oppStrong = opportunity >= minOpp + 6 and setupHits >= 7 and distRisk100 < 55
bool screenerPro = screenerPass and oppStrong and cycle12 >= 4 and cycle12 <= 7
bool screenerPassGates = screenerPass and gatesOk

int stratAction = longSetup ? 3 : coreLong and gatesOk ? 2 : structBreak or heavySellMkt ? 0 : 1
string stratActionTxt = stratAction == 3 ? "🟢 دخول · " + entryPathTxt : stratAction == 2 ? "🟡 جاهز" : stratAction == 0 ? "🔴 تجنب" : "⚪ انتظار"

bool exitSig = barOk and (structBreak or fakeBreakUp or distRisk100 >= 75 or (close < emaM and distributing) or cycle12 >= 9)

var bool tookHalf = false
var bool tookT2 = false
var float trailStop = na
var int barsInTrade = 0
var float entryFill = na
var bool dcaAdded = false

if strategy.position_size == 0
    tookHalf := false
    tookT2 := false
    trailStop := na
    barsInTrade := 0
    entryFill := na
    dcaAdded := false
else
    barsInTrade += 1

float qtyRiskPct = math.min(15.0, riskPctEq * close / math.max(close - stopL, syminfo.mintick))
float qtyAdvPct = strategy.equity > 0 ? math.min(20.0, volMa * close * (partCapPct / 100.0) / strategy.equity * 100.0) : qtyRiskPct
float entryQtyPct = math.max(0.5, math.min(qtyRiskPct, qtyAdvPct))

if longSetup and strategy.position_size == 0
    string cmt = breakConfirmed ? "اختراق" : breakRetest ? "إعادة" : orbLong ? "ORB" : pivotLong ? "S1" : obvLong ? "OBV" : fvgLong ? "FVG" : chochLong ? "CHoCH" : scLong ? "SC" : "شراء"
    if useKellyQty and kellyPct > 0
        strategy.entry("L", strategy.long, qty_percent=math.min(kellyPct, entryQtyPct), comment=cmt)
    else if useRiskQty
        strategy.entry("L", strategy.long, qty_percent=entryQtyPct, comment=cmt)
    else
        strategy.entry("L", strategy.long, comment=cmt)
    tookHalf := false
    trailStop := stopL
    barsInTrade := 0
    entryFill := close

bool dcaTouch = useDcaAdd and strategy.position_size > 0 and not dcaAdded and barOk and low <= fib382 and close >= nz(demandLo, fib382 - atr)
if dcaTouch
    strategy.entry("L", strategy.long, qty_percent=dcaAddPct, comment="DCA382")
    dcaAdded := true

if strategy.position_size > 0
    if usePartial and not tookHalf and high >= tHalf
        strategy.close("L", qty_percent=partialPct, comment="جزئي50")
        tookHalf := true
        if useBreakeven
            trailStop := math.max(nz(trailStop, stopL), nz(entryFill, entryP))
    if usePartialT2 and tookHalf and not tookT2 and high >= t2 and high[1] < t2
        strategy.close("L", qty_percent=partialT2Pct, comment="جزT2")
        tookT2 := true
    if useTrail and tookHalf
        trailStop := math.max(nz(trailStop, stopL), close - atr * trailAtrMult)
        if high >= t1
            trailStop := math.max(trailStop, nz(entryFill, entryP))
    float runnerLim = runnerTarget == "T3" ? t3 : runnerTarget == "T2" ? t2 : t1
    float exitLim = tookHalf ? runnerLim : t1
    float exitStop = useTrail and tookHalf and not na(trailStop) ? trailStop : stopL
    strategy.exit("LX", "L", stop=exitStop, limit=exitLim)

bool timeExit = maxBarsInTrade > 0 and barsInTrade >= maxBarsInTrade and strategy.position_size > 0
if (exitSig or timeExit) and strategy.position_size > 0
    strategy.close("L", comment=timeExit ? "وقت" : fakeBreakUp ? "فشل" : "خروج")

plotshape(showEntryMarks and longSetup and not longSetup[1], "دخول", shape.triangleup, location.belowbar, color=color.lime, size=size.small, text="↓")
plotshape(showEntryMarks and exitSig and strategy.position_size > 0, "خروج", shape.triangledown, location.abovebar, color=color.orange, size=size.tiny, text="↑")
plotshape(showEntryMarks and dcaTouch, "DCA", shape.labelup, location.belowbar, color=color.new(color.purple, 30), size=size.tiny, text="382")
plotshape(fvgBull and barOk, "FVG", shape.square, location.belowbar, color=color.new(color.blue, 60), size=size.tiny)
plotshape(gannAlign and barOk, "Gann", shape.diamond, location.bottom, color=color.new(color.aqua, 45), size=size.tiny)
plotshape(orbBreakUp and barOk, "ORB↑", shape.circle, location.belowbar, color=color.new(color.fuchsia, 40), size=size.tiny)

bgcolor(showCycleBg and cycle12 >= 4 and cycle12 <= 7 ? color.new(color.teal, 96) : showCycleBg and cycle12 >= 9 ? color.new(color.red, 97) : na)

plot(showOrb and timeframe.isintraday and orbReady ? orbH : na, "ORB ع", color=color.new(color.fuchsia, 50), style=plot.style_linebr)
plot(showOrb and timeframe.isintraday and orbReady ? orbL : na, "ORB س", color=color.new(color.fuchsia, 50), style=plot.style_linebr)
plot(showPivotDay ? s1Day : na, "S1 يومي", color=color.new(color.white, 55), style=plot.style_linebr)
plot(showPivotDay ? ppDay : na, "PP يومي", color=color.new(color.gray, 70), style=plot.style_linebr)

var box sqBox = na
if showSqueezeBox and barstate.islast and squeezeOn and inBaseC
    if not na(sqBox)
        box.delete(sqBox)
    float cHi = ta.highest(high, consolLen)
    float cLo = ta.lowest(low, consolLen)
    sqBox := box.new(bar_index - consolLen, cHi, bar_index + 4, cLo, border_color=color.new(color.blue, 50), bgcolor=color.new(color.blue, 92), text="تماسك EGX")

var table stTbl = table.new(position.bottom_right, 2, 8, border_width=1)
if effStTbl and barstate.islast
    table.clear(stTbl, 0, 0, 1, 7)
    color hdr = color.new(color.teal, 30)
    table.cell(stTbl, 0, 0, "EGX محلل ST", bgcolor=hdr, text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 0, profile, bgcolor=hdr, text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 0, 1, "فرصة / رتبة", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 1, str.tostring(opportunity, "#") + " · " + str.tostring(egxRank, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 0, 2, "إعداد / دورة", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 2, str.tostring(setupHits) + "/11 · " + str.tostring(cycle12) + " · G" + str.tostring(globBull), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 0, 3, "تجميع / تصريف", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 3, str.tostring(accumScore100, "#") + " / " + str.tostring(distRisk100, "#"), text_color=accumScore100 > distRisk100 ? color.lime : color.orange, text_size=size.tiny)
    table.cell(stTbl, 0, 4, "ماسح", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 4, screenerPro ? "✓ احترافي" : screenerPass ? "✓ نجاح" : heavySellMkt ? "ضغط مؤشر" : "—", text_color=screenerPro or screenerPass ? color.lime : color.gray, text_size=size.tiny)
    table.cell(stTbl, 0, 5, "إشارة", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 5, stratActionTxt, text_color=stratAction == 3 ? color.lime : stratAction == 0 ? color.red : color.gray, text_size=size.tiny)
    table.cell(stTbl, 0, 6, "بوابات", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 6, str.tostring(gatesPass) + "/10 · " + (screenerPassGates ? "✓" : "—"), text_color=gatesOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(stTbl, 0, 7, "مسار / Gann", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.tiny)
    table.cell(stTbl, 1, 7, entryPathTxt + (gannAlign ? " · Gann" : ""), text_color=longSetup ? color.lime : color.gray, text_size=size.tiny)

plot(demandHi, "حد طلب", color=color.new(color.green, 70), style=plot.style_linebr)
plot(demandLo, "قاع طلب", color=color.new(color.green, 70), style=plot.style_linebr)
plot(tHalf, "جزئي 50%", color=color.new(color.yellow, 50), style=plot.style_linebr)
plot(t1, "هدف1", color=color.aqua, style=plot.style_linebr)
plot(t2, "هدف2", color=color.new(color.aqua, 50), style=plot.style_linebr)
plot(t3, "هدف3", color=color.new(color.aqua, 70), style=plot.style_linebr)
plot(useTrail and strategy.position_size > 0 ? trailStop : na, "وقف متحرك", color=color.orange, style=plot.style_linebr)
plot(stopL, "وقف", color=color.red, style=plot.style_linebr)
plot(useDcaAdd ? fib382 : na, "فيب382 DCA", color=color.new(color.purple, 45), style=plot.style_linebr)
plot(opportunity, "درجة_الفرصة", display=display.data_window)
plot(egxRank, "ترتيب_EGX", display=display.data_window)
plot(kellyPct, "نسبة_كيلي", display=display.data_window)
plot(cycle12, "مرحلة_الدورة", display=display.data_window)
plot(accumScore100, "درجة_التجميع", display=display.data_window)
plot(distRisk100, "مخاطرة_التصريف", display=display.data_window)
plot(longSetup ? 1 : 0, "إشارة_دخول", display=display.data_window)
plot(proOk and coreLong ? 1 : 0, "إعداد_احترافي", display=display.data_window)

var table stPanel = table.new(position.top_center, 2, 6, bgcolor=color.new(color.black, 85), border_width=1)

if effStPanel and barstate.islast
    table.clear(stPanel, 0, 0, 1, 5)
    table.cell(stPanel, 0, 0, "استراتيجية المحلل", bgcolor=color.new(#004d40, 20), text_color=color.white, text_size=size.small)
    table.cell(stPanel, 1, 0, longSetup ? "✓ دخول" : coreLong ? "جاهز" : "انتظار", bgcolor=color.new(#004d40, 20), text_color=longSetup ? color.lime : color.gray, text_size=size.tiny)
    table.cell(stPanel, 0, 1, "فرصة/رتبة", text_color=color.gray, text_size=size.tiny)
    table.cell(stPanel, 1, 1, str.tostring(opportunity, "#") + " · R" + str.tostring(egxRank, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(stPanel, 0, 2, "تجميع/تصريف", text_color=color.gray, text_size=size.tiny)
    table.cell(stPanel, 1, 2, str.tostring(accumScore100, "#") + "/" + str.tostring(distRisk100, "#"), text_color=distRisk100 < maxDist ? color.lime : color.red, text_size=size.tiny)
    table.cell(stPanel, 0, 3, "دورة/سوق", text_color=color.gray, text_size=size.tiny)
    table.cell(stPanel, 1, 3, "مرحلة " + str.tostring(cycle12) + (gannAlign ? " · Gann" : "") + (heavySellMkt ? " · ضغط" : broadUpMkt ? " · اتساع" : ""), text_color=heavySellMkt ? color.red : color.gray, text_size=size.tiny)
    table.cell(stPanel, 0, 4, "كيلي/R/R", text_color=color.gray, text_size=size.tiny)
    table.cell(stPanel, 1, 4, str.tostring(kellyPct, "#.#") + "% · " + str.tostring(rr, "#.#"), text_color=color.yellow, text_size=size.tiny)
    table.cell(stPanel, 0, 5, "بوابات", text_color=color.gray, text_size=size.tiny)
    table.cell(stPanel, 1, 5, str.tostring(gatesPass) + "/10 · " + (screenerPassGates ? "✓ ماسح" : "—"), text_color=gatesOk ? color.lime : color.orange, text_size=size.tiny)
plot(gatesPass, "بوابات_10", display=display.data_window)
plot(screenerPassGates ? 1 : 0, "ماسح_بوابات", display=display.data_window)
plot(screenerPass ? 1 : 0, "نجاح_ماسح", display=display.data_window)
plot(screenerPro ? 1 : 0, "ماسح_احترافي", display=display.data_window)
plot(setupTierNum, "طبقة_الإعداد", display=display.data_window)
plot(stratAction, "كود_الإجراء", display=display.data_window)
plot(chaseWarn ? 1 : 0, "مطاردة", display=display.data_window)

var table stBanner = table.new(position.bottom_right, 1, 4, bgcolor=color.new(color.black, 15), border_width=2)

if effStBanner and barstate.islast
    table.clear(stBanner, 0, 0, 0, 3)
    color bCol = stratAction == 3 ? color.lime : stratAction == 0 ? color.red : color.yellow
    table.cell(stBanner, 0, 0, "محلل ST — " + stratActionTxt, bgcolor=color.new(bCol, 75), text_color=color.white, text_size=size.normal)
    table.cell(stBanner, 0, 1, "فرصة " + str.tostring(opportunity, "#") + " · رتبة " + str.tostring(egxRank, "#") + " · R/R " + str.tostring(rr, "#.#"), bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(stBanner, 0, 2, "بوابات " + str.tostring(gatesPass) + "/10 · دورة " + str.tostring(cycle12) + (strategy.position_size > 0 ? " · في صفقة" : ""), bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=size.tiny)
    table.cell(stBanner, 0, 3, (screenerPro ? "ماسح Pro ✓" : screenerPassGates ? "ماسح ✓" : heavySellMkt ? "ضغط مؤشرات" : "—") + " · " + entryPathTxt, bgcolor=color.new(color.gray, 92), text_color=color.aqua, text_size=size.tiny)

alertcondition(barOk and alertEntry and longSetup and not longSetup[1], title="محلل ST: دخول", message="EGX محلل ST: دخول {{ticker}}")
alertcondition(barOk and alertScreener and screenerPro and not screenerPro[1], title="محلل ST: ماسح Pro", message="EGX محلل ST: ماسح احترافي {{ticker}}")
alertcondition(barOk and alertChase and chaseWarn and not chaseWarn[1], title="محلل ST: مطاردة", message="EGX محلل ST: مطاردة {{ticker}}")
alertcondition(barOk and alertExit and exitSig and strategy.position_size > 0, title="محلل ST: خروج", message="EGX محلل ST: خروج {{ticker}}")
alertcondition(barOk and alertScreener and screenerPassGates and not screenerPassGates[1], title="محلل ST: ماسح", message="EGX محلل ST: نجاح الماسح {{ticker}}")

if useWebhookJson and barOk and longSetup and not longSetup[1]
    alert('{"ev":"egx_st_entry","sym":"' + syminfo.ticker + '","path":"' + entryPathTxt + '","opp":' + str.tostring(opportunity, "#") + ',"rank":' + str.tostring(egxRank, "#") + ',"setup":' + str.tostring(setupHits) + ',"cycle":' + str.tostring(cycle12) + ',"gates":' + str.tostring(gatesPass) + ',"rr":' + str.tostring(rr, "#.##") + '}', alert.freq_once_per_bar_close)

// ماسح TradingView — أسماء متوافقة مع EGX_ANALYZER
plot(score, "EGX_Score", display=display.data_window)
plot(egxRank, "EGX_Rank", display=display.data_window)
plot(setupHits, "EGX_SetupHits", display=display.data_window)
plot(setupTierNum, "EGX_SetupTier", display=display.data_window)
plot(opportunity, "EGX_Opportunity", display=display.data_window)
plot(rr, "EGX_RR", display=display.data_window)
plot(globBull, "EGX_GlobBull", display=display.data_window)
plot(mtfBias, "EGX_MtfBias", display=display.data_window)
plot(accumScore100, "EGX_AccScore", display=display.data_window)
plot(distRisk100, "EGX_DistRisk", display=display.data_window)
plot(breakStateNum, "EGX_BreakState", display=display.data_window)
plot(cycle12, "EGX_Cycle12", display=display.data_window)
plot(gatesPass, "EGX_Gates10", display=display.data_window)
plot(screenerPass ? 1 : 0, "EGX_ScreenerPass", display=display.data_window)
plot(screenerPro ? 1 : 0, "EGX_ScreenerPro", display=display.data_window)
plot(screenerPassGates ? 1 : 0, "EGX_ScreenerGates", display=display.data_window)
plot(longSetup ? 1 : 0, "EGX_BuyFlag", display=display.data_window)
plot(chaseWarn ? 1 : 0, "EGX_ChaseWarn", display=display.data_window)
plot(gannAlign ? 1 : 0, "EGX_GannAlign", display=display.data_window)
plot(orbBreakUp ? 1 : 0, "EGX_ORB_Up", display=display.data_window)
plot(kellyPct, "EGX_KellyPct", display=display.data_window)
plot(stratAction, "EGX_StratAction", display=display.data_window)

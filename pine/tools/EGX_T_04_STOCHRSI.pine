//@version=6
indicator("EGX Tool 04 StochRSI — StochRSI", shorttitle="EGX T-STOCHRSI", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #04/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(14, "RSI/Stoch")
float rsi = ta.rsi(close, len)
k = ta.sma(ta.stoch(rsi, rsi, rsi, len), 3)
d = ta.sma(k, 3)
int vote = ta.crossover(k, d) and k < 30 ? 1 : k > d and k < 80 ? 1 : k < d and k > 20 ? -1 : 0
plot(k, "EGXT_SRSI_K", color=color.aqua, linewidth=2)
plot(d, "EGXT_SRSI_D", color=color.orange)
hline(80, "80", color=color.red)
hline(20, "20", color=color.lime)

plot(vote, "EGXT_STOCHRSI_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_STOCHRSI_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_STOCHRSI_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "STOCHRSI", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-STOCHRSI صاعد", "EGX Tool STOCHRSI: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-STOCHRSI هابط", "EGX Tool STOCHRSI: vote هابط")

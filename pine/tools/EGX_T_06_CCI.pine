//@version=6
indicator("EGX Tool 06 CCI — CCI", shorttitle="EGX T-CCI", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #06/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "CCI")
float v = ta.cci(close, len)
int vote = v > 0 and v < 200 ? 1 : v < 0 and v > -200 ? -1 : v <= -200 ? 1 : v >= 200 ? -1 : 0
plot(v, "EGXT_CCI_Val", color=color.fuchsia, linewidth=2)
hline(100, "+100", color=color.red)
hline(-100, "-100", color=color.lime)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_CCI_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_CCI_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_CCI_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "CCI", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-CCI صاعد", "EGX Tool CCI: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-CCI هابط", "EGX Tool CCI: vote هابط")

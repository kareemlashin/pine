//@version=6
indicator("EGX Tool 38 CMF — Chaikin Money Flow", shorttitle="EGX T-CMF", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ج الحجم · #38/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "CMF")
float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float v = ta.sma(mfm * volume, len) / ta.sma(volume, len)
int vote = v > 0.05 ? 1 : v < -0.05 ? -1 : 0
plot(v, "EGXT_CMF", color=v >= 0 ? color.lime : color.red, style=plot.style_histogram)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_CMF_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_CMF_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_CMF_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "CMF", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-CMF صاعد", "EGX Tool CMF: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-CMF هابط", "EGX Tool CMF: vote هابط")

//@version=6
indicator("EGX Tool 73 جان 50% — Gann 50% retrace", shorttitle="EGX T-GANN", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة و موجات · #73/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int look = input.int(120, "مدى جان")
float hi = ta.highest(high, look)
float lo = ta.lowest(low, look)
float mid = (hi + lo) / 2.0
int vote = close > mid ? 1 : -1
plot(hi, "GannHi", color=color.red)
plot(mid, "Gann50", color=color.orange, linewidth=2)
plot(lo, "GannLo", color=color.lime)

plot(vote, "EGXT_GANN_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_GANN_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_GANN_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "GANN", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-GANN صاعد", "EGX Tool GANN: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-GANN هابط", "EGX Tool GANN: vote هابط")

//@version=6
indicator("EGX Tool 15 AO — Awesome Oscillator", shorttitle="EGX T-AO", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #15/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float v = ta.sma(hl2, 5) - ta.sma(hl2, 34)
int vote = v > 0 and v > v[1] ? 1 : v < 0 and v < v[1] ? -1 : 0
plot(v, "EGXT_AO_Val", color=v >= v[1] ? color.lime : color.red, style=plot.style_columns)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_AO_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_AO_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_AO_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "AO", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-AO صاعد", "EGX Tool AO: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-AO هابط", "EGX Tool AO: vote هابط")

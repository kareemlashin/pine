//@version=6
indicator("EGX Tool 31 تكديس EMA — EMA 20/50/200", shorttitle="EGX T-EMASTACK", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #31/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float e20 = ta.ema(close, 20)
float e50 = ta.ema(close, 50)
float e200 = ta.ema(close, 200)
int vote = close > e20 and e20 > e50 and e50 > e200 ? 1 : close < e20 and e20 < e50 and e50 < e200 ? -1 : 0
plot(e20, "EMA20", color=color.teal)
plot(e50, "EMA50", color=color.orange)
plot(e200, "EMA200", color=color.purple, linewidth=2)

plot(vote, "EGXT_EMASTACK_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_EMASTACK_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_EMASTACK_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "EMASTACK", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-EMASTACK صاعد", "EGX Tool EMASTACK: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-EMASTACK هابط", "EGX Tool EMASTACK: vote هابط")

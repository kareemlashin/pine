//@version=6
indicator("EGX Tool 74 موري — Murrey Math 8/8", shorttitle="EGX T-MURREY", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة و موجات · #74/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int look = input.int(64, "Murrey")
float hi = ta.highest(high, look)
float lo = ta.lowest(low, look)
float rng = (hi - lo) / 8.0
float m4 = lo + 4.0 * rng
int vote = close > m4 ? 1 : -1
plot(lo + 8.0 * rng, "8/8", color=color.red)
plot(lo + 5.0 * rng, "5/8", color=color.orange)
plot(m4, "4/8", color=color.yellow, linewidth=2)
plot(lo + 3.0 * rng, "3/8", color=color.teal)
plot(lo, "0/8", color=color.lime)

plot(vote, "EGXT_MURREY_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_MURREY_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_MURREY_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "MURREY", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-MURREY صاعد", "EGX Tool MURREY: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-MURREY هابط", "EGX Tool MURREY: vote هابط")

//@version=6
indicator("EGX Tool 18 كوبوك — Coppock Curve", shorttitle="EGX T-COPPOCK", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #18/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float v = ta.wma(ta.roc(close, 14) + ta.roc(close, 11), 10)
int vote = v > 0 and v > v[1] ? 1 : v < 0 and v < v[1] ? -1 : 0
plot(v, "EGXT_COP_Val", color=v >= 0 ? color.lime : color.red, linewidth=2)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_COPPOCK_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_COPPOCK_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_COPPOCK_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "COPPOCK", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-COPPOCK صاعد", "EGX Tool COPPOCK: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-COPPOCK هابط", "EGX Tool COPPOCK: vote هابط")

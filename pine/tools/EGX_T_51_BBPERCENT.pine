//@version=6
indicator("EGX Tool 51 %B — Bollinger %B", shorttitle="EGX T-BBPERCENT", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة د التقلب · #51/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "BB")
float mult = input.float(2.0, "Mult")
[mid, up, lo] = ta.bb(close, len, mult)
float v = (up - lo) > 0 ? (close - lo) / (up - lo) : 0.5
int vote = v > 0.8 ? -1 : v < 0.2 ? 1 : v > 0.5 ? 1 : -1
plot(v, "EGXT_PB", color=color.aqua, linewidth=2)
hline(1, "1", color=color.red)
hline(0, "0", color=color.lime)
hline(0.5, "0.5", color=color.gray)

plot(vote, "EGXT_BBPERCENT_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_BBPERCENT_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_BBPERCENT_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "BBPERCENT", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-BBPERCENT صاعد", "EGX Tool BBPERCENT: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-BBPERCENT هابط", "EGX Tool BBPERCENT: vote هابط")

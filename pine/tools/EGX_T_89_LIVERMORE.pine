//@version=6
indicator("EGX Tool 89 ليفرمور — Livermore Pivotal", shorttitle="EGX T-LIVERMORE", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ز أنظمة · #89/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(8, "Pivot")
float ph = ta.pivothigh(high, len, len)
var float piv = na
if not na(ph)
    piv := ph
bool breakPiv = not na(piv) and close > piv and close[1] <= piv
int vote = breakPiv ? 1 : not na(piv) and close > piv ? 1 : not na(piv) and close < piv ? -1 : 0
plot(piv, "Pivotal", color=color.yellow, style=plot.style_linebr, linewidth=2)

plot(vote, "EGXT_LIVERMORE_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_LIVERMORE_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_LIVERMORE_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "LIVERMORE", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-LIVERMORE صاعد", "EGX Tool LIVERMORE: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-LIVERMORE هابط", "EGX Tool LIVERMORE: vote هابط")

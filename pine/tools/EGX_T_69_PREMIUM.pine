//@version=6
indicator("EGX Tool 69 Premium/Discount — PD Array 50%", shorttitle="EGX T-PREMIUM", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ه SMC · #69/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int look = input.int(80, "Swing range")
float hi = ta.highest(high, look)
float lo = ta.lowest(low, look)
float eq = (hi + lo) / 2.0
int vote = close < eq ? 1 : -1
plot(hi, "RangeHi", color=color.new(color.red, 50))
plot(eq, "EQ 50%", color=color.yellow, linewidth=2)
plot(lo, "RangeLo", color=color.new(color.lime, 50))

plot(vote, "EGXT_PREMIUM_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_PREMIUM_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_PREMIUM_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "PREMIUM", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-PREMIUM صاعد", "EGX Tool PREMIUM: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-PREMIUM هابط", "EGX Tool PREMIUM: vote هابط")

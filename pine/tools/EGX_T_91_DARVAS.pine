//@version=6
indicator("EGX Tool 91 داروفاس — Darvas Box", shorttitle="EGX T-DARVAS", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ز أنظمة · #91/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int dvLen = input.int(20, "قمة الصندوق")
float dvH = ta.highest(high, dvLen)
float dvLow4 = ta.lowest(low, 4)
bool dvNew = dvH[3] > dvH[4] and dvH == dvH[3]
var float dvTop = na
var float dvBot = na
var int dvState = 0
if dvNew
    dvTop := dvH
    dvBot := dvLow4
    dvState := 0
if not na(dvTop)
    if dvState <= 0 and close > dvTop
        dvState := 1
    else if dvState >= 0 and close < dvBot
        dvState := -1
int vote = dvState
plot(dvTop, "BoxTop", color=color.yellow, style=plot.style_linebr)
plot(dvBot, "BoxBot", color=color.yellow, style=plot.style_linebr)

plot(vote, "EGXT_DARVAS_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_DARVAS_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_DARVAS_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "DARVAS", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-DARVAS صاعد", "EGX Tool DARVAS: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-DARVAS هابط", "EGX Tool DARVAS: vote هابط")

//@version=6
indicator("EGX Tool 24 بارابوليك SAR — Parabolic SAR", shorttitle="EGX T-SAR", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #24/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float start = input.float(0.02, "Start", step=0.01)
float inc = input.float(0.02, "Increment", step=0.01)
float mx = input.float(0.2, "Max", step=0.05)
float v = ta.sar(start, inc, mx)
int vote = close > v ? 1 : -1
plot(v, "EGXT_SAR", color=vote > 0 ? color.lime : color.red, style=plot.style_cross, linewidth=2)

plot(vote, "EGXT_SAR_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_SAR_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_SAR_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "SAR", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-SAR صاعد", "EGX Tool SAR: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-SAR هابط", "EGX Tool SAR: vote هابط")

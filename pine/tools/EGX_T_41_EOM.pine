//@version=6
indicator("EGX Tool 41 EOM — Ease of Movement", shorttitle="EGX T-EOM", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ج الحجم · #41/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(14, "EOM")
float raw = (high - low) > 0 and volume > 0 ? (hl2 - hl2[1]) / (volume / 1000000.0 / (high - low)) : 0.0
float v = ta.sma(raw, len)
int vote = v > 0 ? 1 : -1
plot(v, "EGXT_EOM", color=v >= 0 ? color.lime : color.red, linewidth=2)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_EOM_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_EOM_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_EOM_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "EOM", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-EOM صاعد", "EGX Tool EOM: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-EOM هابط", "EGX Tool EOM: vote هابط")

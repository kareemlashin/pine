//@version=6
indicator("EGX Tool 26 هال — Hull MA", shorttitle="EGX T-HULL", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #26/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(21, "HMA")
float v = ta.hma(close, len)
int vote = close > v and v > v[1] ? 1 : close < v and v < v[1] ? -1 : 0
plot(v, "EGXT_HMA", color=v >= v[1] ? color.lime : color.red, linewidth=2)

plot(vote, "EGXT_HULL_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_HULL_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_HULL_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "HULL", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-HULL صاعد", "EGX Tool HULL: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-HULL هابط", "EGX Tool HULL: vote هابط")

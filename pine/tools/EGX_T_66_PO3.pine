//@version=6
indicator("EGX Tool 66 Power of 3 — AMD Power of Three", shorttitle="EGX T-PO3", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ه SMC · #66/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "Range")
float hi = ta.highest(high, len)
float lo = ta.lowest(low, len)
float mid = (hi + lo) / 2.0
float rng = hi - lo
bool accum = rng / close < 0.04
bool manip = (high > hi[1] and close < mid) or (low < lo[1] and close > mid)
bool distUp = close > hi[1] and close > open and volume > ta.sma(volume, 20)
bool distDn = close < lo[1] and close < open
int vote = distUp ? 1 : distDn ? -1 : manip ? 0 : accum ? 0 : close > mid ? 1 : -1
plot(hi, "RangeHi", color=color.gray)
plot(lo, "RangeLo", color=color.gray)

plot(vote, "EGXT_PO3_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_PO3_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_PO3_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "PO3", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-PO3 صاعد", "EGX Tool PO3: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-PO3 هابط", "EGX Tool PO3: vote هابط")

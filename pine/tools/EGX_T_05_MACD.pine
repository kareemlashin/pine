//@version=6
indicator("EGX Tool 05 MACD — MACD", shorttitle="EGX T-MACD", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #05/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
int vote = macdH > 0 and macdL > macdS ? 1 : macdH < 0 and macdL < macdS ? -1 : 0
plot(macdH, "EGXT_MACD_H", color=macdH >= 0 ? color.lime : color.red, style=plot.style_columns)
plot(macdL, "EGXT_MACD_L", color=color.teal)
plot(macdS, "EGXT_MACD_S", color=color.orange)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_MACD_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_MACD_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_MACD_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "MACD", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-MACD صاعد", "EGX Tool MACD: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-MACD هابط", "EGX Tool MACD: vote هابط")

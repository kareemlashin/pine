//@version=6
indicator("EGX Tool 52 BBW — Bollinger Bandwidth", shorttitle="EGX T-BBW", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة د التقلب · #52/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "BB")
[mid, up, lo] = ta.bb(close, len, 2.0)
float v = mid > 0 ? (up - lo) / mid : 0.0
float p20 = ta.percentile_linear_interpolation(v, 100, 20)
int vote = v < p20 and close > mid ? 1 : v < p20 and close < mid ? -1 : 0
plot(v, "EGXT_BBW", color=color.orange, linewidth=2)

plot(vote, "EGXT_BBW_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_BBW_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_BBW_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "BBW", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-BBW صاعد", "EGX Tool BBW: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-BBW هابط", "EGX Tool BBW: vote هابط")

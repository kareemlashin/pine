//@version=6
indicator("EGX Tool 59 شاندلير — Chandelier Exit", shorttitle="EGX T-CHANDELIER", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة د التقلب · #59/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(22, "Look")
float mult = input.float(3.0, "ATR ×")
float atr = ta.atr(14)
float chL = ta.highest(high, len) - mult * atr
float chS = ta.lowest(low, len) + mult * atr
var int dir = 1
if close > chS[1]
    dir := 1
else if close < chL[1]
    dir := -1
int vote = dir
plot(dir == 1 ? chL : chS, "EGXT_CH", color=dir == 1 ? color.lime : color.red, linewidth=2)

plot(vote, "EGXT_CHANDELIER_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_CHANDELIER_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_CHANDELIER_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "CHANDELIER", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-CHANDELIER صاعد", "EGX Tool CHANDELIER: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-CHANDELIER هابط", "EGX Tool CHANDELIER: vote هابط")

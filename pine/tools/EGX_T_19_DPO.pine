//@version=6
indicator("EGX Tool 19 DPO — Detrended Price Osc", shorttitle="EGX T-DPO", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #19/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(21, "DPO")
int k = int(len / 2) + 1
float v = close[k] - ta.sma(close, len)
int vote = v > 0 ? 1 : v < 0 ? -1 : 0
plot(v, "EGXT_DPO_Val", color=color.purple, linewidth=2)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_DPO_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_DPO_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_DPO_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "DPO", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-DPO صاعد", "EGX Tool DPO: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-DPO هابط", "EGX Tool DPO: vote هابط")

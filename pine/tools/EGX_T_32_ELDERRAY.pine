//@version=6
indicator("EGX Tool 32 إلدر راي — Elder Ray", shorttitle="EGX T-ELDERRAY", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #32/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float e13 = ta.ema(close, 13)
float bullP = high - e13
float bearP = low - e13
int vote = e13 > e13[1] and bearP < 0 and bearP > bearP[1] ? 1 : e13 < e13[1] and bullP > 0 and bullP < bullP[1] ? -1 : e13 > e13[1] ? 1 : -1
plot(bullP, "BullPower", color=color.lime, style=plot.style_columns)
plot(bearP, "BearPower", color=color.red, style=plot.style_columns)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_ELDERRAY_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_ELDERRAY_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_ELDERRAY_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "ELDERRAY", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-ELDERRAY صاعد", "EGX Tool ELDERRAY: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-ELDERRAY هابط", "EGX Tool ELDERRAY: vote هابط")

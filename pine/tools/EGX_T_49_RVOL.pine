//@version=6
indicator("EGX Tool 49 حجم نسبي — Relative Volume", shorttitle="EGX T-RVOL", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ج الحجم · #49/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "MA حجم")
float volMa = ta.sma(volume, len)
float v = volume / math.max(volMa, 1.0)
int vote = v >= 1.3 and close > open ? 1 : v >= 1.3 and close < open ? -1 : 0
plot(v, "EGXT_RVOL", color=v >= 1.3 ? color.fuchsia : color.gray, style=plot.style_columns)
hline(1.0, "1x", color=color.gray)
hline(1.5, "1.5x", color=color.orange)

plot(vote, "EGXT_RVOL_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_RVOL_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_RVOL_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "RVOL", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-RVOL صاعد", "EGX Tool RVOL: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-RVOL هابط", "EGX Tool RVOL: vote هابط")

//@version=6
indicator("EGX Tool 14 PPO — Percentage Price Osc", shorttitle="EGX T-PPO", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #14/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float fast = ta.ema(close, 12)
float slow = ta.ema(close, 26)
float v = slow > 0 ? 100.0 * (fast - slow) / slow : 0.0
float sig = ta.ema(v, 9)
int vote = v > sig and v > 0 ? 1 : v < sig and v < 0 ? -1 : 0
plot(v, "EGXT_PPO_Val", color=color.teal, linewidth=2)
plot(sig, "EGXT_PPO_Sig", color=color.orange)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_PPO_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_PPO_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_PPO_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "PPO", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-PPO صاعد", "EGX Tool PPO: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-PPO هابط", "EGX Tool PPO: vote هابط")

//@version=6
indicator("EGX Tool 58 تقلب تاريخي — Historical Volatility", shorttitle="EGX T-HV", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة د التقلب · #58/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "HV")
float lr = math.log(close / math.max(close[1], syminfo.mintick))
float v = ta.stdev(lr, len) * math.sqrt(252.0) * 100.0
float med = ta.sma(v, 50)
int vote = v < med ? 1 : -1
plot(v, "EGXT_HV", color=color.purple, linewidth=2)
plot(med, "Med", color=color.gray)

plot(vote, "EGXT_HV_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_HV_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_HV_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "HV", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-HV صاعد", "EGX Tool HV: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-HV هابط", "EGX Tool HV: vote هابط")

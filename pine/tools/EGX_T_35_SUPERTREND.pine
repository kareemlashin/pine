//@version=6
indicator("EGX Tool 35 سوبرترند — SuperTrend", shorttitle="EGX T-SUPERTREND", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #35/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float factor = input.float(3.0, "Factor", step=0.1)
int atrLen = input.int(10, "ATR")
[stLine, dir] = ta.supertrend(factor, atrLen)
int vote = dir < 0 ? 1 : -1
plot(stLine, "EGXT_ST", color=vote > 0 ? color.lime : color.red, linewidth=2)

plot(vote, "EGXT_SUPERTREND_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_SUPERTREND_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_SUPERTREND_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "SUPERTREND", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-SUPERTREND صاعد", "EGX Tool SUPERTREND: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-SUPERTREND هابط", "EGX Tool SUPERTREND: vote هابط")

//@version=6
indicator("EGX Tool 97 ديمارك — TD Sequential setup", shorttitle="EGX T-DEMARK", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ح بروفايل · #97/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

var int td = 0
td := close > close[4] ? (nz(td[1]) > 0 ? nz(td[1]) + 1 : 1) : close < close[4] ? (nz(td[1]) < 0 ? nz(td[1]) - 1 : -1) : 0
bool buySetup = td <= -9
bool sellSetup = td >= 9
int vote = buySetup ? 1 : sellSetup ? -1 : td < 0 ? 1 : td > 0 ? -1 : 0
plotshape(buySetup, "TD9+", shape.labelup, location.belowbar, color.lime, text="9", textcolor=color.black, size=size.tiny)
plotshape(sellSetup, "TD9-", shape.labeldown, location.abovebar, color.red, text="9", textcolor=color.white, size=size.tiny)

plot(vote, "EGXT_DEMARK_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_DEMARK_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_DEMARK_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "DEMARK", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-DEMARK صاعد", "EGX Tool DEMARK: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-DEMARK هابط", "EGX Tool DEMARK: vote هابط")

//@version=6
indicator("EGX Tool 33 إلدر إمبلس — Elder Impulse", shorttitle="EGX T-ELDERIMP", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #33/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float e13 = ta.ema(close, 13)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool green = e13 > e13[1] and macdH > macdH[1]
bool red = e13 < e13[1] and macdH < macdH[1]
int vote = green ? 1 : red ? -1 : 0
barcolor(green ? color.new(color.lime, 40) : red ? color.new(color.red, 40) : color.new(color.blue, 70))

plot(vote, "EGXT_ELDERIMP_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_ELDERIMP_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_ELDERIMP_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "ELDERIMP", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-ELDERIMP صاعد", "EGX Tool ELDERIMP: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-ELDERIMP هابط", "EGX Tool ELDERIMP: vote هابط")

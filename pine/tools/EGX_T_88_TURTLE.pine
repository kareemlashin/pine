//@version=6
indicator("EGX Tool 88 ترتل — Turtle 20-day", shorttitle="EGX T-TURTLE", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ز أنظمة · #88/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "Breakout")
float hi = ta.highest(high[1], len)
float lo = ta.lowest(low[1], len)
bool brkUp = close > hi
bool soupUp = low < lo and close > lo
int vote = brkUp ? 1 : soupUp ? 1 : close < lo ? -1 : 0
plot(hi, "20H", color=color.lime)
plot(lo, "20L", color=color.red)
plotshape(soupUp, "Soup", shape.diamond, location.belowbar, color.aqua, size=size.tiny)

plot(vote, "EGXT_TURTLE_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_TURTLE_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_TURTLE_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "TURTLE", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-TURTLE صاعد", "EGX Tool TURTLE: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-TURTLE هابط", "EGX Tool TURTLE: vote هابط")

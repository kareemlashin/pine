//@version=6
indicator("EGX Tool 100 نظام السوق — Trend/Range regime", shorttitle="EGX T-REGIME", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ح بروفايل · #100/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

[diP, diM, adx] = ta.dmi(14, 14)
float e20 = ta.ema(close, 20)
float e50 = ta.ema(close, 50)
bool trend = adx > 22
int vote = trend and e20 > e50 ? 1 : trend and e20 < e50 ? -1 : 0
plot(adx, "ADX", color=color.yellow, linewidth=2)
hline(22, "Trend", color=color.gray)

plot(vote, "EGXT_REGIME_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_REGIME_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_REGIME_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "REGIME", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-REGIME صاعد", "EGX Tool REGIME: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-REGIME هابط", "EGX Tool REGIME: vote هابط")

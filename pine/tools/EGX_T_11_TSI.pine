//@version=6
indicator("EGX Tool 11 TSI — True Strength Index", shorttitle="EGX T-TSI", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة أ الزخم · #11/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float v = ta.tsi(close, 13, 25)
float sig = ta.ema(v, 13)
int vote = v > sig and v > 0 ? 1 : v < sig and v < 0 ? -1 : 0
plot(v, "EGXT_TSI_Val", color=color.teal, linewidth=2)
plot(sig, "EGXT_TSI_Sig", color=color.orange)
hline(0, "0", color=color.gray)

plot(vote, "EGXT_TSI_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_TSI_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_TSI_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "TSI", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-TSI صاعد", "EGX Tool TSI: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-TSI هابط", "EGX Tool TSI: vote هابط")

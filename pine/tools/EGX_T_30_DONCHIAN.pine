//@version=6
indicator("EGX Tool 30 دونشيان — Donchian", shorttitle="EGX T-DONCHIAN", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ب الاتجاه · #30/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(20, "Donchian")
float hi = ta.highest(high, len)
float lo = ta.lowest(low, len)
float mid = (hi + lo) / 2.0
int vote = close > hi[1] ? 1 : close < lo[1] ? -1 : close > mid ? 1 : close < mid ? -1 : 0
plot(hi, "EGXT_DC_HI", color=color.lime)
plot(lo, "EGXT_DC_LO", color=color.red)
plot(mid, "EGXT_DC_MID", color=color.gray)

plot(vote, "EGXT_DONCHIAN_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_DONCHIAN_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_DONCHIAN_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "DONCHIAN", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-DONCHIAN صاعد", "EGX Tool DONCHIAN: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-DONCHIAN هابط", "EGX Tool DONCHIAN: vote هابط")

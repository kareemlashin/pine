//@version=6
indicator("EGX Tool 36 OBV — On Balance Volume", shorttitle="EGX T-OBV", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ج الحجم · #36/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float v = ta.obv
float sl = ta.linreg(v, 10, 0) - ta.linreg(v, 10, 1)
int vote = sl > 0 and v > v[10] ? 1 : sl < 0 and v < v[10] ? -1 : 0
plot(v, "EGXT_OBV", color=sl >= 0 ? color.lime : color.red, linewidth=2)

plot(vote, "EGXT_OBV_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_OBV_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_OBV_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "OBV", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-OBV صاعد", "EGX Tool OBV: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-OBV هابط", "EGX Tool OBV: vote هابط")

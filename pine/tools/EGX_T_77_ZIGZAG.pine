//@version=6
indicator("EGX Tool 77 زيغزاغ داو — Dow ZigZag", shorttitle="EGX T-ZIGZAG", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة و موجات · #77/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

int len = input.int(8, "Swing")
float ph = ta.pivothigh(high, len, len)
float pl = ta.pivotlow(low, len, len)
var float h1 = na
var float h2 = na
var float l1 = na
var float l2 = na
if not na(ph)
    h2 := h1
    h1 := ph
if not na(pl)
    l2 := l1
    l1 := pl
int vote = not na(h1) and not na(h2) and not na(l1) and not na(l2) ? (h1 > h2 and l1 > l2 ? 1 : h1 < h2 and l1 < l2 ? -1 : 0) : 0
plot(h1, "HH/LH", color=color.new(color.red, 50), style=plot.style_circles)
plot(l1, "HL/LL", color=color.new(color.lime, 50), style=plot.style_circles)

plot(vote, "EGXT_ZIGZAG_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_ZIGZAG_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_ZIGZAG_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "ZIGZAG", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-ZIGZAG صاعد", "EGX Tool ZIGZAG: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-ZIGZAG هابط", "EGX Tool ZIGZAG: vote هابط")

//@version=6
indicator("EGX Tool 43 VPT — Volume Price Trend", shorttitle="EGX T-VPT", overlay=false, max_tables_count=2, calc_bars_count=5000)

// مجموعة ج الحجم · #43/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float v = ta.pvt
float ema = ta.ema(v, 20)
int vote = v > ema ? 1 : -1
plot(v, "EGXT_VPT", color=v >= ema ? color.lime : color.red, linewidth=2)
plot(ema, "EGXT_VPT_EMA", color=color.orange)

plot(vote, "EGXT_VPT_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_VPT_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_VPT_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "VPT", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-VPT صاعد", "EGX Tool VPT: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-VPT هابط", "EGX Tool VPT: vote هابط")

//@version=6
indicator("EGX Tool 87 وينستين — Weinstein Stage", shorttitle="EGX T-WEINSTEIN", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=40, max_tables_count=2, calc_bars_count=5000)

// مجموعة ز أنظمة · #87/100 · docs/EGX_TOOLS.md
// vote: +1 صاعد · 0 محايد · -1 هابط · OHLCV فقط — تعليمي مش نصيحة

float ma30 = ta.sma(close, 150)
float sl = ta.linreg(ma30, 10, 0) - ta.linreg(ma30, 10, 1)
int vote = close > ma30 and sl > 0 ? 1 : close < ma30 and sl < 0 ? -1 : 0
plot(ma30, "MA30W~", color=sl >= 0 ? color.lime : color.red, linewidth=2)

plot(vote, "EGXT_WEINSTEIN_Vote", display=display.all)
plot(vote == 1 ? 1 : 0, "EGXT_WEINSTEIN_Bull", display=display.all)
plot(vote == -1 ? 1 : 0, "EGXT_WEINSTEIN_Bear", display=display.all)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "WEINSTEIN", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, vote > 0 ? "▲ شراء" : vote < 0 ? "▼ بيع" : "— محايد", text_color=vote > 0 ? color.lime : vote < 0 ? color.red : color.gray, text_size=size.small)

alertcondition(vote == 1 and vote[1] != 1, "EGX T-WEINSTEIN صاعد", "EGX Tool WEINSTEIN: vote صاعد")
alertcondition(vote == -1 and vote[1] != -1, "EGX T-WEINSTEIN هابط", "EGX Tool WEINSTEIN: vote هابط")

//@version=6
indicator("EGX TOOLS Screener", shorttitle="EGX T Scr", overlay=false, max_tables_count=2, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// ماسح 100-lite — Watchlist · D · Pro: EGXTScr_Pro=1 · Pass: EGXTScr_Pass=1
// دقة كاملة: EGX_TOOLS_MASTER (EGXT_*) · docs/EGX_TOOLS.md
// ═══════════════════════════════════════════════════════════════════════════════

string G = "فلتر"
string profile = input.string("EGX يومي", "ملف", options=["EGX يومي", "مضاربة", "استثمار", "مخصص"], group=G)
float sigMinIn = input.float(20.0, "حد Score %", minval=5, maxval=60, group=G)
float minVolIn = input.float(1500.0, "حد متوسط حجم", minval=0, group=G)
int minGreen = input.int(14, "حد 🟢 lite (Pro)", minval=8, maxval=22, group=G)
int minHits = input.int(5, "Hits Pro", minval=3, maxval=6, group=G)
bool confirmClose = input.bool(true, "إغلاق الشمعة", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockLimit = input.bool(true, "منع قرب halt/LULD", group=G)

float sigMin = profile == "مخصص" ? sigMinIn : profile == "مضاربة" ? 18.0 : profile == "استثمار" ? 25.0 : 20.0
float minVol = profile == "مخصص" ? minVolIn : profile == "مضاربة" ? 3000.0 : profile == "استثمار" ? 800.0 : 1500.0
bool sigOk = not confirmClose or barstate.isconfirmed

f_scr() =>
    float ema20 = ta.ema(close, 20)
    float ema50 = ta.ema(close, 50)
    float ema200 = ta.ema(close, 200)
    float rsi = ta.rsi(close, 14)
    [macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
    float volMa = ta.sma(volume, 20)
    float rvol = volume / math.max(volMa, 1.0)
    bool liqOk = volMa >= minVol
    float rng = math.max(high - low, syminfo.mintick)
    float mfm = ((close - low) - (high - close)) / rng
    float cmf = ta.sma(mfm * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    [diP, diM, adx] = ta.dmi(14, 14)
    [stLine, stDir] = ta.supertrend(3.0, 10)
    float lookHi = ta.highest(high, 80)
    float lookLo = ta.lowest(low, 80)
    float f618 = lookHi - 0.618 * (lookHi - lookLo)
    bool inDem = close <= f618 and close >= lookLo
    bool bosUp = close > ta.highest(high, 20)[1]
    float hi52 = ta.highest(high, 250)
    bool chase = hi52 > 0 and (close - hi52) / hi52 * 100.0 > -3 and rsi > 72
    int v01 = rsi > 52 and rsi < 68 ? 1 : rsi >= 68 ? 0 : -1
    int v02 = macdH > 0 and macdL > macdS ? 1 : macdH < 0 ? -1 : 0
    int v03 = ta.stoch(close, high, low, 14) > 50 ? 1 : -1
    int v04 = ta.roc(close, 10) > 0 ? 1 : -1
    int v05 = ta.mfi(hlc3, 14) > 50 ? 1 : -1
    int v06 = adx > 22 and diP > diM ? 1 : adx > 22 and diM > diP ? -1 : 0
    int v07 = close > ema20 and ema20 > ema50 and ema50 > ema200 ? 1 : close < ema20 and ema20 < ema50 ? -1 : 0
    int v08 = stDir < 0 ? 1 : -1
    int v09 = close > ta.sar(0.02, 0.02, 0.2) ? 1 : -1
    int v10 = cmf > 0.05 ? 1 : cmf < -0.05 ? -1 : 0
    int v11 = obvSl > 0 ? 1 : obvSl < 0 ? -1 : 0
    int v12 = ta.accdist > ta.ema(ta.accdist, 20) ? 1 : -1
    int v13 = rvol >= 1.2 and close > open ? 1 : 0
    [bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
    int v14 = close > bbMid ? 1 : -1
    int v15 = bosUp ? 1 : close < ta.lowest(low, 20)[1] ? -1 : 0
    int v16 = inDem ? 1 : close > lookHi * 0.98 ? -1 : 0
    int sumV = v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15 + v16
    float totalPct = sumV / 16.0 * 100.0
    int nG = (v01 == 1 ? 1 : 0) + (v02 == 1 ? 1 : 0) + (v03 == 1 ? 1 : 0) + (v04 == 1 ? 1 : 0) + (v05 == 1 ? 1 : 0) + (v06 == 1 ? 1 : 0) + (v07 == 1 ? 1 : 0) + (v08 == 1 ? 1 : 0) + (v09 == 1 ? 1 : 0) + (v10 == 1 ? 1 : 0) + (v11 == 1 ? 1 : 0) + (v12 == 1 ? 1 : 0) + (v13 == 1 ? 1 : 0) + (v14 == 1 ? 1 : 0) + (v15 == 1 ? 1 : 0) + (v16 == 1 ? 1 : 0)
    int nR = (v01 == -1 ? 1 : 0) + (v02 == -1 ? 1 : 0) + (v03 == -1 ? 1 : 0) + (v04 == -1 ? 1 : 0) + (v05 == -1 ? 1 : 0) + (v06 == -1 ? 1 : 0) + (v07 == -1 ? 1 : 0) + (v08 == -1 ? 1 : 0) + (v09 == -1 ? 1 : 0) + (v10 == -1 ? 1 : 0) + (v11 == -1 ? 1 : 0) + (v12 == -1 ? 1 : 0) + (v13 == -1 ? 1 : 0) + (v14 == -1 ? 1 : 0) + (v15 == -1 ? 1 : 0) + (v16 == -1 ? 1 : 0)
    bool locOK = inDem or bosUp or v16 == 1
    bool moneyOK = v10 == 1 and v11 != -1 and v12 == 1
    bool upTrend = v07 == 1 or v08 == 1
    bool momOK = totalPct >= sigMin * 0.5
    bool trigOK = close > open and (v03 == 1 or v04 == 1)
    bool volOK = rvol >= 0.9
    int hits = (upTrend ? 1 : 0) + (locOK ? 1 : 0) + (momOK ? 1 : 0) + (moneyOK ? 1 : 0) + (trigOK ? 1 : 0) + (volOK ? 1 : 0)
    float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
    float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
    float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
    float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
    bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)
    bool egxOK = liqOk and not chase and not nearLimit
    bool buyA = sigOk and egxOK and locOK and moneyOK and hits >= 5 and totalPct >= sigMin
    bool buyB = sigOk and egxOK and locOK and not buyA and hits >= 4 and totalPct >= sigMin * 0.5
    bool passScr = sigOk and liqOk and totalPct >= sigMin * 0.45 and hits >= 3
    bool proScr = buyA and nG >= minGreen and hits >= minHits
    [totalPct, nG - nR, buyA ? 1 : 0, buyB ? 1 : 0, buyA or buyB ? 1 : 0, proScr ? 1 : 0, passScr ? 1 : 0, hits, nG, nearLimit ? 1 : 0]

[totalPct, nNet, buyA, buyB, buyAny, proScr, passScr, hits, nG, nearLimitF] = f_scr()
bool nearLimit = nearLimitF > 0

color scCol = proScr ? color.lime : buyAny ? color.green : passScr ? color.yellow : totalPct >= 0 ? color.teal : color.red
plot(totalPct, "Score %", color=scCol, linewidth=2)
hline(sigMin, "حد شراء", color=color.new(color.lime, 60))
hline(-sigMin, "حد بيع", color=color.new(color.red, 60))
hline(0, "صفر", color=color.gray)

var table t = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 5)
    table.cell(t, 0, 0, syminfo.ticker, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, proScr ? "PRO" : buyA ? "A" : buyB ? "B" : passScr ? "PASS" : "—", bgcolor=scCol, text_color=color.black, text_size=size.normal)
    table.cell(t, 0, 1, "Score", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(totalPct, "#.#") + "%", text_size=size.small)
    table.cell(t, 0, 2, "Net / 🟢", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(nNet) + " / " + str.tostring(nG), text_size=size.small)
    table.cell(t, 0, 3, "Hits", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(hits) + "/6", text_size=size.small)
    table.cell(t, 0, 4, "Lite", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, "16 صوت · MASTER=100", text_color=color.gray, text_size=size.tiny)

plot(buyAny, "EGXTScr_Buy", display=display.all)
plot(buyA, "EGXTScr_BuyA", display=display.all)
plot(proScr, "EGXTScr_Pro", display=display.all)
plot(passScr, "EGXTScr_Pass", display=display.all)
plot(totalPct, "EGXTScr_Score", display=display.all)
plot(nNet, "EGXTScr_Net", display=display.all)
plot(hits, "EGXTScr_Hits", display=display.all)
plot(nearLimit ? 1 : 0, "EGXTScr_Limit", display=display.all)
plot(1, "EGXTScr", display=display.all)

alertcondition(proScr, "EGX T Scr — Pro", "{{ticker}} EGXTScr Pro")
alertcondition(buyA, "EGX T Scr — A", "{{ticker}} EGXTScr BuyA")

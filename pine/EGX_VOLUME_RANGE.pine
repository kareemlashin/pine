//@version=6
indicator("EGX Volume Range base", shorttitle="EGX VRng", overlay=true, max_tables_count=2, calc_bars_count=5000)

// قاعدة: نطاق + حجم هابط ثم توسع · docs/EGX_VOLUME.md

string G = "Range"
int boxLen = input.int(25, "Range len", minval=10, group=G)
int volDrop = input.int(4, "Vol fall bars", minval=2, group=G)
float expandR = input.float(1.3, "Expand RVOL", group=G)

float hi = ta.highest(high, boxLen)
float lo = ta.lowest(low, boxLen)
float mid = (hi + lo) / 2.0
bool inRange = close < hi * 1.01 and close > lo * 0.99

bool volFall = true
for i = 1 to volDrop
    if volume[i] >= volume[i + 1]
        volFall := false

float rvol = volume / math.max(ta.sma(volume, 20), 1.0)
bool baseOk = inRange and volFall[1]
bool brkUp = baseOk and close > hi and rvol >= expandR
bool brkDn = baseOk and close < lo and rvol >= expandR

plot(hi, "Hi", color=color.new(color.red, 50), linewidth=1)
plot(lo, "Lo", color=color.new(color.lime, 50), linewidth=1)
plot(baseOk ? mid : na, "Mid", color=color.gray, linewidth=1, style=plot.style_circles)

plotshape(brkUp, "R↑", shape.triangleup, location.belowbar, color=color.lime, size=size.small)
plotshape(brkDn, "R↓", shape.triangledown, location.abovebar, color=color.red, size=size.small)

var table t = table.new(position.bottom_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "Range V", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, baseOk ? "BASE" : brkUp ? "BRK" : "—", text_size=size.tiny)

plot(baseOk ? 1 : 0, "EGVRng_Base", display=display.all)
plot(brkUp ? 1 : 0, "EGVRng_BrkUp", display=display.all)
plot(brkDn ? 1 : 0, "EGVRng_BrkDn", display=display.all)

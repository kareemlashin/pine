//@version=6
strategy("EGX Volume Zones — B1/S1 test", shorttitle="EGX VZ ST", overlay=true, pyramiding=0, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=2, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// باك‌تست مرتبط بـ EGX_VOLUME_ZONES.pine — دخول B1 bounce · خروج S1 أو ATR

string G = "إعداد"
int zoneLook = input.int(400, "نافذة zones", minval=80, group=G)
int vpBins = input.int(28, "bins", minval=12, group=G)
float minNetBuy = input.float(52.0, "حد Net buy %", group=G)
int minGrade = input.int(2, "حد Grade B1", minval=1, maxval=3, group=G)
float minRvol = input.float(1.0, "RVOL دخول", group=G)
float minAvgVol = input.float(1000.0, "متوسط حجم", group=G)
bool useConfirm = input.bool(true, "إغلاق الشمعة", group=G)
float slAtr = input.float(1.2, "وقف × ATR", group=G)
float tpAtr = input.float(2.4, "هدف × ATR", group=G)
bool exitOnS1 = input.bool(true, "خروج عند S1 reject", group=G)
bool blockLimitBuy = input.bool(true, "منع شراء قرب halt/LULD", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool useMktHalt100 = input.bool(true, "منع إذا EGX100 ≤ −10%", group=G)

bool barOk = not useConfirm or barstate.isconfirmed
float dPrevClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayChgPct = dPrevClose > 0 ? (close - dPrevClose) / dPrevClose * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimitUp = blockLimitBuy and dPrevClose > 0 and (dayChgPct >= math.min(9.0, haltPct - 1.0) or dayChgPct >= luldPct - 0.25)
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool microLongOk = not nearLimitUp and not mktHalt100

f_buyVol(int off) =>
    float rng = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / rng

f_pxBin(float px, float lo, float step) =>
    int bx = int(math.floor((px - lo) / step))
    math.max(0, math.min(vpBins - 1, bx))

f_b1Zone() =>
    int n = math.min(zoneLook, bar_index)
    float hi = ta.highest(high, n)
    float lo = ta.lowest(low, n)
    float step = (hi - lo) / math.max(vpBins, 1)
    step := step <= syminfo.mintick ? syminfo.mintick : step
    array<float> buyB = array.new_float(vpBins, 0.0)
    float tB = 0.0
    float tS = 0.0
    for i = 0 to n - 1
        float bV = f_buyVol(i)
        float sV = volume[i] - bV
        tB += bV
        tS += sV
        int bi = f_pxBin(close[i], lo, step)
        array.set(buyB, bi, array.get(buyB, bi) + bV)
    float maxB = 0.0
    int b1 = 0
    for b = 0 to vpBins - 1
        float vb = array.get(buyB, b)
        if vb > maxB
            maxB := vb
            b1 := b
    float bLo = lo + b1 * step
    float bHi = lo + (b1 + 1) * step
    float bMid = (bLo + bHi) / 2.0
    float netPct = tB + tS > 0 ? tB / (tB + tS) * 100.0 : 50.0
    float bStr = tB > 0 ? maxB / tB * 100.0 : 0.0
    int touches = 0
    for i = 0 to n - 1
        if low[i] <= bHi and high[i] >= bLo
            touches += 1
    int gr = touches >= 3 and bStr >= 85 ? 3 : touches >= 2 and bStr >= 70 ? 2 : 1
    [bLo, bHi, bMid, netPct, gr, maxB]

f_s1Zone() =>
    int n = math.min(zoneLook, bar_index)
    float hi = ta.highest(high, n)
    float lo = ta.lowest(low, n)
    float step = (hi - lo) / math.max(vpBins, 1)
    step := step <= syminfo.mintick ? syminfo.mintick : step
    array<float> sellB = array.new_float(vpBins, 0.0)
    for i = 0 to n - 1
        float bV = f_buyVol(i)
        float sV = volume[i] - bV
        int si = f_pxBin(open[i], lo, step)
        array.set(sellB, si, array.get(sellB, si) + sV)
    float maxS = 0.0
    int s1 = 0
    for b = 0 to vpBins - 1
        float vs = array.get(sellB, b)
        if vs > maxS
            maxS := vs
            s1 := b
    float sLo = lo + s1 * step
    float sHi = lo + (s1 + 1) * step
    float sMid = (sLo + sHi) / 2.0
    [sLo, sHi, sMid]

[b1Lo, b1Hi, b1Mid, netBuyPct, gradeB1, _] = f_b1Zone()
[s1Lo, s1Hi, s1Mid] = f_s1Zone()

float atr = ta.atr(14)
float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)
bool liqOk = volMa >= minAvgVol
bool inB1 = low <= b1Hi and high >= b1Lo
bool inS1 = low <= s1Hi and high >= s1Lo
bool b1Bounce = inB1 and close > open and rvol >= minRvol and close > b1Mid
bool s1Reject = inS1 and close < open and rvol >= minRvol and close < s1Mid

bool longEntry = barOk and liqOk and microLongOk and b1Bounce and gradeB1 >= minGrade and netBuyPct >= minNetBuy
bool longExit = barOk and (exitOnS1 and s1Reject or close < b1Lo - atr * slAtr * 0.5)

if longEntry and strategy.position_size <= 0
    strategy.entry("B1", strategy.long)
    strategy.exit("B1-X", "B1", stop=close - atr * slAtr, limit=close + atr * tpAtr)

if longExit and strategy.position_size > 0
    strategy.close("B1", comment="S1/SL")

plot(b1Mid, "B1 mid", color=color.new(color.lime, 40), linewidth=2)
plot(s1Mid, "S1 mid", color=color.new(color.red, 40), linewidth=2)

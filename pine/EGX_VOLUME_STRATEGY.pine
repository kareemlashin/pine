//@version=6
strategy("EGX Volume — climax + acc test", shorttitle="EGX VOL ST", overlay=true, pyramiding=0, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=2, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// SC (buy climax) + تراكم · خروج BC أو CMF<0 · docs/EGX_VOLUME.md

string G = "إعداد"
int maLen = input.int(20, "MA vol", group=G)
float rvolIn = input.float(1.8, "RVOL SC", minval=1.2, group=G)
float minCmf = input.float(0.0, "CMF دخول >", group=G)
float slAtr = input.float(1.3, "SL × ATR", group=G)
float tpAtr = input.float(2.0, "TP × ATR", group=G)
bool useConfirm = input.bool(true, "إغلاق", group=G)
bool blockLimitBuy = input.bool(true, "منع شراء قرب halt/LULD", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool useMktHalt100 = input.bool(true, "منع إذا EGX100 ≤ −10%", group=G)

bool barOk = not useConfirm or barstate.isconfirmed
float dPrevClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayChgPct = dPrevClose > 0 ? (close - dPrevClose) / dPrevClose * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimitUp = blockLimitBuy and dPrevClose > 0 and (dayChgPct >= math.min(9.0, haltPct - 1.0) or dayChgPct >= luldPct - 0.25)
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool microLongOk = not nearLimitUp and not mktHalt100
float atr = ta.atr(14)
float volMa = ta.sma(volume, maLen)
float rvol = volume / math.max(volMa, 1.0)
float rng = math.max(high - low, syminfo.mintick)
float cp = (close - low) / rng

float mfm = ((close - low) - (high - close)) / rng
float cmf = ta.sma(mfm * volume, 20) / ta.sma(volume, 20)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)

bool sc = rvol >= rvolIn and cp >= 0.55 and close >= open
bool bc = rvol >= rvolIn and cp <= 0.45 and close <= open
bool acc = cmf > minCmf and obvSl > 0

bool entry = barOk and microLongOk and sc and acc
bool exitSig = barOk and (bc or cmf < -0.05 or close < ta.lowest(low, 5))

if entry and strategy.position_size <= 0
    strategy.entry("V", strategy.long)
    strategy.exit("VX", "V", stop=close - atr * slAtr, limit=close + atr * tpAtr)

if exitSig and strategy.position_size > 0
    strategy.close("V")

plotshape(sc, "SC", shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)

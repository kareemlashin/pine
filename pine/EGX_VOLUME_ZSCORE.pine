//@version=6
indicator("EGX Volume Z-Score", shorttitle="EGX VZ", overlay=false, max_tables_count=2, calc_bars_count=5000)

// Z-score حجم + RVOL · docs/EGX_VOLUME.md

string G = "Z"
int maLen = input.int(20, "MA", group=G)
int stLen = input.int(20, "Stdev", group=G)
float zExt = input.float(2.0, "Extreme Z", step=0.1, group=G)
float zHot = input.float(1.5, "Hot Z", step=0.1, group=G)

float vma = ta.sma(volume, maLen)
float sd = ta.stdev(volume, stLen)
float z = (volume - vma) / math.max(sd, 1.0)
float rvol = volume / math.max(vma, 1.0)

bool extreme = z >= zExt
bool hot = z >= zHot and not extreme
bool cold = z <= -zHot

plot(z, "EGVZ_Z", color=z >= 0 ? color.fuchsia : color.teal, linewidth=2, display=display.all)
plot(rvol, "RVOL", color=color.orange, linewidth=1, display=display.none)
hline(0, "0", color=color.gray)
hline(zExt, "+Ext", color=color.red, linestyle=hline.style_dashed)
hline(-zExt, "-Ext", color=color.lime, linestyle=hline.style_dashed)
hline(zHot, "+Hot", color=color.new(color.orange, 50))

bgcolor(extreme ? color.new(color.red, 88) : hot ? color.new(color.orange, 92) : cold ? color.new(color.teal, 92) : na)

var table t = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 3)
    table.cell(t, 0, 0, "Z-Score", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, extreme ? "EXT" : hot ? "HOT" : cold ? "COLD" : "—", text_size=size.tiny)
    table.cell(t, 0, 1, "Z / RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(z, "#.##") + " / " + str.tostring(rvol, "#.##"), text_size=size.tiny)

plot(extreme ? 1 : 0, "EGVZ_Extreme", display=display.all)
plot(hot ? 1 : 0, "EGVZ_Hot", display=display.all)

alertcondition(extreme, "Vol Z extreme", "Volume Z extreme")

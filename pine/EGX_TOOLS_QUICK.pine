//@version=6
indicator("EGX TOOLS QUICK — سكور + A/B", shorttitle="EGX TQ", overlay=true, max_labels_count=20, max_tables_count=2, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// قرار سريع (~24 صوت) — تقريب EGX_TOOLS_MASTER · إطار D · EGX:XXXX
// كامل 100: EGX_TOOLS_MASTER.pine · docs/EGX_TOOLS.md
// ═══════════════════════════════════════════════════════════════════════════════

string G = "EGX"
string profile = input.string("EGX يومي", "ملف", options=["EGX يومي", "مضاربة", "استثمار"])
float sigMin = profile == "مضاربة" ? 18.0 : profile == "استثمار" ? 25.0 : 20.0
float minVol = profile == "مضاربة" ? 3000.0 : profile == "استثمار" ? 800.0 : 1500.0
bool confirmClose = input.bool(true, "إغلاق الشمعة", group=G)
bool showEma = input.bool(true, "EMA 50/200", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockLimit = input.bool(true, "منع قرب halt/LULD", group=G)

bool sigOk = not confirmClose or barstate.isconfirmed

f_lite() =>
    float ema20 = ta.ema(close, 20)
    float ema50 = ta.ema(close, 50)
    float ema200 = ta.ema(close, 200)
    float rsi = ta.rsi(close, 14)
    [macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
    float volMa = ta.sma(volume, 20)
    float rvol = volume / math.max(volMa, 1.0)
    bool liqOk = volMa >= minVol
    float rng = math.max(high - low, syminfo.mintick)
    float mfm = ((close - low) - (high - close)) / rng
    float cmf = ta.sma(mfm * volume, 20) / ta.sma(volume, 20)
    float ad = ta.accdist
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    [diP, diM, adx] = ta.dmi(14, 14)
    [stLine, stDir] = ta.supertrend(3.0, 10)
    float roc = ta.roc(close, 10)
    float lookHi = ta.highest(high, 80)
    float lookLo = ta.lowest(low, 80)
    float f618 = lookHi - 0.618 * (lookHi - lookLo)
    bool inDem = close <= f618 and close >= lookLo
    bool bosUp = close > ta.highest(high, 20)[1]
    float hi52 = ta.highest(high, 250)
    bool chase = hi52 > 0 and (close - hi52) / hi52 * 100.0 > -3 and rsi > 72
    float atr = ta.atr(14)
    float stopUse = close - atr * 2.0
    float rr = math.max(close - stopUse, syminfo.mintick) > 0 ? 1.5 : na
    int v01 = rsi > 52 and rsi < 68 ? 1 : rsi >= 68 ? 0 : -1
    int v02 = macdH > 0 and macdL > macdS ? 1 : macdH < 0 ? -1 : 0
    int v03 = ta.stoch(close, high, low, 14) > 50 ? 1 : -1
    int v04 = roc > 0 ? 1 : -1
    int v05 = ta.mfi(hlc3, 14) > 50 ? 1 : -1
    int v06 = adx > 22 and diP > diM ? 1 : adx > 22 and diM > diP ? -1 : 0
    int v07 = close > ema20 and ema20 > ema50 and ema50 > ema200 ? 1 : close < ema20 and ema20 < ema50 ? -1 : 0
    int v08 = stDir < 0 ? 1 : -1
    int v09 = close > ta.sar(0.02, 0.02, 0.2) ? 1 : -1
    int v10 = cmf > 0.05 ? 1 : cmf < -0.05 ? -1 : 0
    int v11 = obvSl > 0 ? 1 : obvSl < 0 ? -1 : 0
    int v12 = ad > ta.ema(ad, 20) ? 1 : -1
    int v13 = rvol >= 1.2 and close > open ? 1 : rvol >= 1.5 and close < open ? -1 : 0
    [bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
    int v14 = close > bbMid ? 1 : -1
    int v15 = bosUp ? 1 : close < ta.lowest(low, 20)[1] ? -1 : 0
    int v16 = inDem ? 1 : close > lookHi * 0.98 ? -1 : 0
    int v17 = ta.rsi(close, 2) < 10 ? 1 : ta.rsi(close, 2) > 90 ? -1 : 0
    int v18 = close > ema50 ? 1 : -1
    int v19 = macdH > macdH[1] ? 1 : -1
    int v20 = volume > volMa ? 1 : -1
    int v21 = close > open ? 1 : close < open ? -1 : 0
    int v22 = adx > 18 ? 1 : 0
    int v23 = cmf > 0 and obvSl > 0 ? 1 : cmf < 0 and obvSl < 0 ? -1 : 0
    int v24 = inDem or bosUp ? 1 : 0
    int sumV = v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24
    float totalPct = sumV / 24.0 * 100.0
    int nG = (v01 == 1 ? 1 : 0) + (v02 == 1 ? 1 : 0) + (v03 == 1 ? 1 : 0) + (v04 == 1 ? 1 : 0) + (v05 == 1 ? 1 : 0) + (v06 == 1 ? 1 : 0) + (v07 == 1 ? 1 : 0) + (v08 == 1 ? 1 : 0) + (v09 == 1 ? 1 : 0) + (v10 == 1 ? 1 : 0) + (v11 == 1 ? 1 : 0) + (v12 == 1 ? 1 : 0) + (v13 == 1 ? 1 : 0) + (v14 == 1 ? 1 : 0) + (v15 == 1 ? 1 : 0) + (v16 == 1 ? 1 : 0) + (v17 == 1 ? 1 : 0) + (v18 == 1 ? 1 : 0) + (v19 == 1 ? 1 : 0) + (v20 == 1 ? 1 : 0) + (v21 == 1 ? 1 : 0) + (v22 == 1 ? 1 : 0) + (v23 == 1 ? 1 : 0) + (v24 == 1 ? 1 : 0)
    int nR = (v01 == -1 ? 1 : 0) + (v02 == -1 ? 1 : 0) + (v03 == -1 ? 1 : 0) + (v04 == -1 ? 1 : 0) + (v05 == -1 ? 1 : 0) + (v06 == -1 ? 1 : 0) + (v07 == -1 ? 1 : 0) + (v08 == -1 ? 1 : 0) + (v09 == -1 ? 1 : 0) + (v10 == -1 ? 1 : 0) + (v11 == -1 ? 1 : 0) + (v12 == -1 ? 1 : 0) + (v13 == -1 ? 1 : 0) + (v14 == -1 ? 1 : 0) + (v15 == -1 ? 1 : 0) + (v16 == -1 ? 1 : 0) + (v17 == -1 ? 1 : 0) + (v18 == -1 ? 1 : 0) + (v19 == -1 ? 1 : 0) + (v20 == -1 ? 1 : 0) + (v21 == -1 ? 1 : 0) + (v22 == -1 ? 1 : 0) + (v23 == -1 ? 1 : 0) + (v24 == -1 ? 1 : 0)
    int nNet = nG - nR
    bool locOK = inDem or bosUp or v16 == 1
    bool moneyOK = v10 == 1 and v11 != -1 and v12 == 1
    bool upTrend = v07 == 1 or v08 == 1
    bool momOK = totalPct >= sigMin * 0.5
    bool trigOK = close > open and (v03 == 1 or v04 == 1)
    bool volOK = rvol >= 0.9
    int hits = (upTrend ? 1 : 0) + (locOK ? 1 : 0) + (momOK ? 1 : 0) + (moneyOK ? 1 : 0) + (trigOK ? 1 : 0) + (volOK ? 1 : 0)
    bool rrOK = not na(rr)
    float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
    float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
    float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
    float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
    bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)
    bool egxOK = liqOk and not chase and not nearLimit
    bool buyA = sigOk and egxOK and rrOK and locOK and moneyOK and hits >= 5 and totalPct >= sigMin
    bool buyB = sigOk and egxOK and rrOK and locOK and not buyA and hits >= 4 and totalPct >= sigMin * 0.5
    bool pro = buyA and nG >= 14 and hits >= 5
    [totalPct, nNet, nG, buyA ? 1 : 0, buyB ? 1 : 0, buyA or buyB ? 1 : 0, pro ? 1 : 0, hits, nearLimit ? 1 : 0]

[totalPct, nNet, nG, buyA, buyB, buyAny, pro, hits, nearLimitF] = f_lite()
bool nearLimit = nearLimitF > 0

string dec = buyA ? "🟢 شراء A" : buyB ? "🟡 شراء B" : totalPct >= sigMin ? "↗ قوي" : totalPct <= -sigMin ? "↘ ضعيف" : "⚪ انتظر"

plot(showEma ? ta.ema(close, 50) : na, "EMA50", color=color.orange)
plot(showEma ? ta.ema(close, 200) : na, "EMA200", color=color.new(color.purple, 40))
plotshape(buyA == 1, "A", shape.labelup, location.belowbar, color.green, text="A", size=size.tiny)
plotshape(buyB == 1, "B", shape.labelup, location.belowbar, color.lime, text="B", size=size.tiny)

var table b = table.new(position.bottom_left, 1, 2, border_width=2)
if barstate.islast
    table.clear(b, 0, 0, 0, 1)
    table.cell(b, 0, 0, dec, bgcolor=color.new(color.black, 15), text_color=color.white, text_size=size.large)
    table.cell(b, 0, 1, "Score " + str.tostring(totalPct, "#") + "% · Net " + str.tostring(nNet) + " · 🟢" + str.tostring(nG) + "/24 · Hits " + str.tostring(hits) + "/6", text_color=color.yellow, text_size=size.small)

plot(buyAny, "EGXTQ_Buy", display=display.data_window)
plot(buyA, "EGXTQ_BuyA", display=display.data_window)
plot(pro, "EGXTQ_Pro", display=display.data_window)
plot(totalPct, "EGXTQ_Score", display=display.data_window)
plot(nNet, "EGXTQ_Net", display=display.data_window)
plot(nearLimit ? 1 : 0, "EGXTQ_Limit", display=display.data_window)
plot(1, "EGXTQ", display=display.data_window)

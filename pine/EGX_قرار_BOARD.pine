//@version=6
indicator("EGX قرار — لوحة 12 (ترتيب Rank)", shorttitle="EGX Q Board", overlay=false, max_tables_count=2, calc_bars_count=5000)

// 12 رمز · جدول مرتب حسب Rank · صف «الأول» = أفضل مرشح شراء
// plots: EGXQBD_* · إطار D

string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
string G = "رموز EGX"
string s01 = input.symbol("EGX:COMI", "01", group=G)
string s02 = input.symbol("EGX:SWDY", "02", group=G)
string s03 = input.symbol("EGX:TMGH", "03", group=G)
string s04 = input.symbol("EGX:HRHO", "04", group=G)
string s05 = input.symbol("EGX:FWRY", "05", group=G)
string s06 = input.symbol("EGX:UNIP", "06", group=G)
string s07 = input.symbol("EGX:ETEL", "07", group=G)
string s08 = input.symbol("EGX:OCDI", "08", group=G)
string s09 = input.symbol("EGX:SKPC", "09", group=G)
string s10 = input.symbol("EGX:PHDC", "10", group=G)
string s11 = input.symbol("EGX:ACGC", "11", group=G)
string s12 = input.symbol("EGX:CNIN", "12", group=G)
string bench = input.symbol("EGX:EGX30", "EGX30", group=G)
float minVol = input.float(800.0, "حد حجم", group=G)
float minRankShow = input.float(52.0, "أدنى Rank للعرض", minval=40, maxval=80, group=G)

f_decision() =>
    float atr = ta.atr(14)
    float volMa = ta.sma(volume, 20)
    bool liq = volMa >= minVol
    float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    float acc = math.min(100.0, (cmf > 0 and obvSl > 0 ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0))
    float dist = math.min(100.0, (cmf < 0 and obvSl < 0 ? 35.0 : 0.0))
    float hi = ta.highest(high, 252)
    float lo = ta.lowest(low, 252)
    float pctHi = hi > 0 ? (close - hi) / hi * 100.0 : 0.0
    float rocB = lo > 0 ? (close / lo - 1.0) * 100.0 : 0.0
    bool trap = rocB > 100 and pctHi < -28 and dist >= 38
    float rsi = ta.rsi(close, 14)
    bool chase = pctHi > -3 and rsi > 72
    float dPrevL = close[1]
    float dayPctL = dPrevL > 0 ? (close - dPrevL) / dPrevL * 100.0 : 0.0
    float haltPctL = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
    float luldPctL = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
    bool nearLimit = dayPctL >= math.min(9.0, haltPctL - 1.0) or dayPctL >= luldPctL - 0.25
    float pl = ta.pivotlow(low, 8, 8)
    var float sl = na
    if not na(pl)
        sl := pl
    bool supBr = not na(sl) and close < sl and close[1] >= sl
    float zw = atr * 0.35
    float bTop = nz(sl, low) + zw
    float bBot = nz(sl, low) - zw * 1.2
    bool atZ = low <= bTop and close >= bBot
    bool ret = not na(sl) and low <= sl * 1.006 and close > sl
    int cyc = acc >= 55 ? 4 : 3
    if dist >= 55
        cyc := 9
    if supBr
        cyc := 11
    float br = request.security(bench, timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
    bool rs = ta.roc(close, 20) - br > 0
    float rk = math.min(100.0, acc * 0.45 + (100.0 - dist) * 0.25 + (rs ? 12.0 : 0.0) + (atZ ? 8.0 : 0.0))
    bool squeeze = atr < ta.sma(atr, 14) * 0.85
    float dna = math.min(100.0, (cyc <= 7 ? 15.0 : 0.0) + (acc >= 55 ? 25.0 : 0.0) + (dist < 45 ? 15.0 : 0.0) + (squeeze ? 10.0 : 0.0) + (rs ? 10.0 : 0.0))
    bool buy = liq and acc >= 55 and dist < 50 and cyc >= 4 and cyc <= 7 and (atZ or ret) and not supBr and not chase and not trap and not nearLimit
    bool exit = supBr or dist >= 65 or trap or cyc == 9
    int act = exit ? 0 : buy ? 4 : cyc <= 4 and acc >= 48 ? 2 : 1
    [act, rk, buy ? 1.0 : 0.0, acc, dist, cyc, dna, trap ? 1.0 : 0.0]

f_row(string sym) =>
    request.security(sym, "D", f_decision(), barmerge.gaps_off, barmerge.lookahead_off)

[a1, r1, b1, ac1, d1, c1, dn1, t1] = f_row(s01)
[a2, r2, b2, ac2, d2, c2, dn2, t2] = f_row(s02)
[a3, r3, b3, ac3, d3, c3, dn3, t3] = f_row(s03)
[a4, r4, b4, ac4, d4, c4, dn4, t4] = f_row(s04)
[a5, r5, b5, ac5, d5, c5, dn5, t5] = f_row(s05)
[a6, r6, b6, ac6, d6, c6, dn6, t6] = f_row(s06)
[a7, r7, b7, ac7, d7, c7, dn7, t7] = f_row(s07)
[a8, r8, b8, ac8, d8, c8, dn8, t8] = f_row(s08)
[a9, r9, b9, ac9, d9, c9, dn9, t9] = f_row(s09)
[a10, r10, b10, ac10, d10, c10, dn10, t10] = f_row(s10)
[a11, r11, b11, ac11, d11, c11, dn11, t11] = f_row(s11)
[a12, r12, b12, ac12, d12, c12, dn12, t12] = f_row(s12)

f_sym(int i) =>
    i == 0 ? s01 : i == 1 ? s02 : i == 2 ? s03 : i == 3 ? s04 : i == 4 ? s05 : i == 5 ? s06 : i == 6 ? s07 : i == 7 ? s08 : i == 8 ? s09 : i == 9 ? s10 : i == 10 ? s11 : s12

f_act(int i) =>
    i == 0 ? int(a1) : i == 1 ? int(a2) : i == 2 ? int(a3) : i == 3 ? int(a4) : i == 4 ? int(a5) : i == 5 ? int(a6) : i == 6 ? int(a7) : i == 7 ? int(a8) : i == 8 ? int(a9) : i == 9 ? int(a10) : i == 10 ? int(a11) : int(a12)

f_rk(int i) =>
    i == 0 ? r1 : i == 1 ? r2 : i == 2 ? r3 : i == 3 ? r4 : i == 4 ? r5 : i == 5 ? r6 : i == 6 ? r7 : i == 7 ? r8 : i == 8 ? r9 : i == 9 ? r10 : i == 10 ? r11 : r12

f_buy(int i) =>
    i == 0 ? b1 : i == 1 ? b2 : i == 2 ? b3 : i == 3 ? b4 : i == 4 ? b5 : i == 5 ? b6 : i == 6 ? b7 : i == 7 ? b8 : i == 8 ? b9 : i == 9 ? b10 : i == 10 ? b11 : b12

f_acc(int i) =>
    i == 0 ? ac1 : i == 1 ? ac2 : i == 2 ? ac3 : i == 3 ? ac4 : i == 4 ? ac5 : i == 5 ? ac6 : i == 6 ? ac7 : i == 7 ? ac8 : i == 8 ? ac9 : i == 9 ? ac10 : i == 10 ? ac11 : ac12

f_cyc(int i) =>
    i == 0 ? c1 : i == 1 ? c2 : i == 2 ? c3 : i == 3 ? c4 : i == 4 ? c5 : i == 5 ? c6 : i == 6 ? c7 : i == 7 ? c8 : i == 8 ? c9 : i == 9 ? c10 : i == 10 ? c11 : c12

f_dna(int i) =>
    i == 0 ? dn1 : i == 1 ? dn2 : i == 2 ? dn3 : i == 3 ? dn4 : i == 4 ? dn5 : i == 5 ? dn6 : i == 6 ? dn7 : i == 7 ? dn8 : i == 8 ? dn9 : i == 9 ? dn10 : i == 10 ? dn11 : dn12

f_actTxt(int act) =>
    act == 4 ? "✅" : act == 3 ? "📌" : act == 2 ? "⏳" : act == 0 ? "🛑" : "⛔"

var int[] order = array.new_int(12, 0)
if barstate.isfirst
    for k = 0 to 11
        array.set(order, k, k)

int[] sorted = array.copy(order)
for i = 0 to 10
    for j = 0 to 10 - i
        int ia = array.get(sorted, j)
        int ib = array.get(sorted, j + 1)
        if f_rk(ia) < f_rk(ib)
            array.set(sorted, j, ib)
            array.set(sorted, j + 1, ia)

int leaderIdx = array.get(sorted, 0)
float leaderRank = f_rk(leaderIdx)
int leaderAct = f_act(leaderIdx)
bool leaderBuy = f_buy(leaderIdx) > 0
string leaderSym = f_sym(leaderIdx)

int buyCnt = int(b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12)
bool boardPass = leaderRank >= minRankShow and (leaderBuy or leaderAct >= 2)

var table tb = table.new(position.top_right, 7, 15, bgcolor=color.new(#0d1117, 5), border_width=1)
if barstate.islast
    table.clear(tb, 0, 0, 6, 14)
    table.cell(tb, 0, 0, "#", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, 0, "رمز", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 2, 0, "Rank", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 3, 0, "قرار", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 4, 0, "تجم", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 5, 0, "دورة", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 6, 0, "DNA", text_color=color.gray, text_size=size.tiny)
    for row = 0 to 11
        int ix = array.get(sorted, row)
        int act = f_act(ix)
        float rk = f_rk(ix)
        table.cell(tb, 0, row + 1, str.tostring(row + 1), text_size=size.tiny, text_color=row == 0 ? color.lime : color.gray)
        table.cell(tb, 1, row + 1, f_sym(ix), text_size=size.tiny, text_color=row == 0 ? color.white : color.gray)
        table.cell(tb, 2, row + 1, str.tostring(rk, "#"), text_size=size.tiny, text_color=rk >= 58 ? color.lime : color.white)
        table.cell(tb, 3, row + 1, f_actTxt(act), text_size=size.tiny, text_color=act == 4 ? color.lime : act == 0 ? color.red : color.yellow)
        table.cell(tb, 4, row + 1, str.tostring(f_acc(ix), "#"), text_size=size.tiny)
        table.cell(tb, 5, row + 1, str.tostring(f_cyc(ix), "#"), text_size=size.tiny)
        table.cell(tb, 6, row + 1, str.tostring(f_dna(ix), "#"), text_size=size.tiny, text_color=f_dna(ix) >= 55 ? color.aqua : color.gray)
    table.cell(tb, 0, 13, "★", text_color=color.lime, text_size=size.small)
    table.cell(tb, 1, 13, leaderSym, text_color=color.white, text_size=size.small)
    table.cell(tb, 2, 13, str.tostring(leaderRank, "#"), text_color=color.lime, text_size=size.small)
    table.cell(tb, 3, 13, leaderBuy ? "شراء" : leaderAct == 2 ? "راقب" : "—", text_color=leaderBuy ? color.lime : color.yellow, text_size=size.tiny)
    table.cell(tb, 4, 13, "Buy:" + str.tostring(buyCnt), text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 0, 14, "EGX Q Board", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, 14, "D · Rank↓", text_color=color.gray, text_size=size.tiny)

plot(leaderRank, "EGXQBD_LeaderRank", display=display.data_window)
plot(leaderAct, "EGXQBD_LeaderAct", display=display.data_window)
plot(leaderBuy ? 1 : 0, "EGXQBD_LeaderBuy", display=display.data_window)
plot(buyCnt, "EGXQBD_BuyCount", display=display.data_window)
plot(leaderRank, "EGXQBD_TopRank", display=display.data_window)
plot(boardPass ? 1 : 0, "EGXQBD_Pass", display=display.data_window)
plot(f_dna(leaderIdx), "EGXQBD_LeaderDNA", display=display.data_window)
plot(1, "EGXQBD", display=display.data_window)

alertcondition(leaderBuy, "EGX Board — شراء الأول", "{{ticker}}: Board leader BUY")
alertcondition(buyCnt >= 2, "EGX Board — 2+ شراء", "{{ticker}}: Board multi-buy")

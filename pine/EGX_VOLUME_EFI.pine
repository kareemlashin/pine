//@version=6
indicator("EGX Volume Elder Force Index", shorttitle="EGX VEFI", overlay=false, max_tables_count=2, calc_bars_count=5000)

// EFI = Δclose × volume · docs/EGX_VOLUME.md

string G = "EFI"
int len = input.int(13, "EMA", group=G)
float minAbs = input.float(0.0, "Min |EFI| filter", group=G)

float efiRaw = (close - close[1]) * volume
float efi = ta.ema(efiRaw, len)
float efiNorm = efi / math.max(ta.sma(volume, len) * syminfo.mintick, 1.0)

bool bull = efi > 0 and efi > efi[1] and math.abs(efiNorm) >= minAbs
bool bear = efi < 0 and efi < efi[1] and math.abs(efiNorm) >= minAbs
bool bullX = ta.crossover(efi, 0)

plot(efiNorm, "EGVEFI_Val", color=efi >= 0 ? color.lime : color.red, linewidth=2, display=display.all)
hline(0, "0", color=color.gray)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "EFI", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, bull ? "Bull" : bear ? "Bear" : "—", text_size=size.tiny)

plot(bull ? 1 : 0, "EGVEFI_Bull", display=display.all)
plot(bullX ? 1 : 0, "EGVEFI_XUp", display=display.all)

//@version=6
indicator("EGX Volume Watchlist Rank", shorttitle="EGX Vol WL", overlay=false, max_tables_count=2)

// Watchlist · D — رتبة فوليوم/مناطق · docs/EGX_VOLUME.md
// Filter: EGVWL_Pass = 1 · Sort: EGVWL_Rank desc

string G = "فلتر"
int zoneLook = input.int(400, "نافذة", minval=80, group=G)
float minNet = input.float(52.0, "Net buy %", group=G)
float minRvol = input.float(1.0, "RVOL", group=G)
float minVolMa = input.float(800.0, "متوسط حجم", group=G)

f_bv(int off) =>
    float r = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / r

int bins = 24
int n = math.min(zoneLook, bar_index)
float hi = ta.highest(high, n)
float lo = ta.lowest(low, n)
float step = (hi - lo) / math.max(bins, 1)
step := step <= syminfo.mintick ? syminfo.mintick : step
array<float> buyB = array.new_float(bins, 0.0)
float tB = 0.0
float tS = 0.0
for i = 0 to n - 1
    float bV = f_bv(i)
    tS += volume[i] - bV
    tB += bV
    int bi = int(math.floor((close[i] - lo) / step))
    bi := math.max(0, math.min(bins - 1, bi))
    array.set(buyB, bi, array.get(buyB, bi) + bV)
float maxB = 0.0
int b1i = 0
for b = 0 to bins - 1
    if array.get(buyB, b) > maxB
        maxB := array.get(buyB, b)
        b1i := b
float pad = ta.atr(14) * 0.28
float bLo = lo + b1i * step - pad
float bHi = lo + (b1i + 1) * step + pad
float bMid = lo + (b1i + 0.5) * step
float netPct = tB + tS > 0 ? tB / (tB + tS) * 100.0 : 50.0
float b1Share = tB > 0 ? maxB / tB * 100.0 : 0.0

float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)
bool inB1 = low <= bHi and high >= bLo
bool bounce = inB1 and close > open and close > bMid and rvol >= minRvol

float rank = math.max(0.0, math.min(100.0, netPct * 0.35 + b1Share * 0.25 + (inB1 ? 15.0 : 0.0) + (bounce ? 12.0 : 0.0) + math.min(rvol, 3.0) * 8.0 + (volMa >= minVolMa ? 5.0 : -10.0)))
bool pass = volMa >= minVolMa and netPct >= minNet and rvol >= minRvol and (inB1 or bounce)

var table t = table.new(position.middle_center, 2, 7, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 6)
    table.cell(t, 0, 0, syminfo.ticker, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, str.tostring(rank, "#"), text_color=pass ? color.lime : color.gray, text_size=size.large)
    table.cell(t, 0, 1, "Net / RVOL", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(netPct, "#.#") + " · " + str.tostring(rvol, "#.##"), text_size=size.small)
    table.cell(t, 0, 2, "B1", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(bMid, format.mintick) + (inB1 ? " in" : ""), text_size=size.small)
    table.cell(t, 0, 3, "B1 share", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(b1Share, "#") + "%", text_size=size.small)

plot(rank, "EGVWL_Rank", display=display.all)
plot(pass ? 1 : 0, "EGVWL_Pass", display=display.all)
plot(netPct, "EGVWL_NetBuy", display=display.all)
plot(inB1 ? 1 : 0, "EGVWL_InB1", display=display.all)
plot(bounce ? 1 : 0, "EGVWL_Bounce", display=display.all)

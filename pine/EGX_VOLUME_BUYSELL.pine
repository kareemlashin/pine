//@version=6
indicator("EGX Volume Buy vs Sell — stacked", shorttitle="EGX VBS", overlay=false, max_tables_count=2, calc_bars_count=5000)

// أعمدة شراء/بيع من OHLCV · docs/EGX_VOLUME.md

string G = "إعداد"
int maLen = input.int(20, "MA", group=G)
float minNet = input.float(58.0, "حد Net buy %", group=G)
string egxBoardLim = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockLimitLim = input.bool(true, "منع قرب halt/LULD", group=G)

bool showNet = input.bool(true, "خط Net %", group=G)

float rng = math.max(high - low, syminfo.mintick)
float buyV = volume * (close - low) / rng
float sellV = volume - buyV
float netPct = volume > 0 ? buyV / volume * 100.0 : 50.0
float netMa = ta.sma(netPct, maLen)
float rvol = volume / math.max(ta.sma(volume, maLen), 1.0)

float dPrevLim = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctLim = dPrevLim > 0 ? (close - dPrevLim) / dPrevLim * 100.0 : 0.0
float haltPctLim = egxBoardLim == "SME تميّز" or egxBoardLim == "SME نايل" or egxBoardLim == "غير نشط" ? 5.0 : 10.0
float luldPctLim = egxBoardLim == "غير نشط" ? 5.0 : (egxBoardLim == "SME تميّز" or egxBoardLim == "SME نايل" ? 10.0 : 20.0)
bool nearLimitLim = blockLimitLim and dPrevLim > 0 and (dayPctLim >= math.min(9.0, haltPctLim - 1.0) or dayPctLim >= luldPctLim - 0.25)

bool buyDay = netPct >= minNet and rvol >= 1.0 and close >= open and not nearLimitLim
bool sellDay = netPct <= 100.0 - minNet and rvol >= 1.0 and close <= open

plot(buyV, "Buy vol", style=plot.style_columns, color=color.new(color.lime, 25))
plot(-sellV, "Sell vol", style=plot.style_columns, color=color.new(color.red, 25))
plot(showNet ? netPct - 50.0 : na, "Net%−50", color=color.yellow, linewidth=2)
hline(0, "Bal", color=color.gray)

var table t = table.new(position.top_left, 2, 4, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 3)
    table.cell(t, 0, 0, "Buy/Sell", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(netPct, "#") + "%", text_color=netPct >= 50 ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 1, "Net MA", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(netMa, "#"), text_size=size.tiny)

plot(netPct, "EGVBS_NetPct", display=display.all)
plot(buyDay ? 1 : 0, "EGVBS_BuyDay", display=display.all)
plot(sellDay ? 1 : 0, "EGVBS_SellDay", display=display.all)

plot(nearLimitLim ? 1 : 0, "EGX_NearLimit", display=display.data_window)

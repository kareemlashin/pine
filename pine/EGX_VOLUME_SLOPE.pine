//@version=6
indicator("EGX Volume MA Slope", shorttitle="EGX VSlp", overlay=false, max_tables_count=2, calc_bars_count=5000)

// ميل MA حجم · docs/EGX_VOLUME.md

string G = "Slope"
int maLen = input.int(20, "MA vol", group=G)
int slopeLen = input.int(5, "Slope bars", group=G)
float minSlope = input.float(0.06, "Min slope %/bar", step=0.01, group=G)

float vma = ta.sma(volume, maLen)
float slope = vma[slopeLen] > 0 ? (vma - vma[slopeLen]) / vma[slopeLen] / slopeLen * 100.0 : 0.0
float rvol = volume / math.max(vma, 1.0)

bool rising = slope >= minSlope
bool falling = slope <= -minSlope
bool expandDay = rising and rvol >= 1.1 and close >= open

plot(slope, "EGVSlp_Val", color=slope >= 0 ? color.lime : color.red, linewidth=2, display=display.all)
plot(vma, "Vol MA", color=color.orange, linewidth=1, display=display.none)
hline(0, "0", color=color.gray)

var table t = table.new(position.top_right, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "Vol slope", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(slope, "#.##") + "%", text_size=size.tiny)

plot(rising ? 1 : 0, "EGVSlp_Rising", display=display.all)
plot(expandDay ? 1 : 0, "EGVSlp_ExpandDay", display=display.all)

//@version=6
indicator("EGX قرار — ماسح", shorttitle="EGX قرar Scr", overlay=false, calc_bars_count=5000)

// ماسح فقط — بدون شارت · نفس plots EGXQ_* للفلتر في TradingView
// فلتر: EGXQ_Qarar=1 · للمرآة الكاملة استخدم ST/PRO أو MEGA · EGXQ_ScreenerPro=1 · EGXQ_Action=4

string mode = input.string("PRO موحّد", "نوع", options=["PRO موحّد", "عدّاء استثمار", "EGX يومي", "فلسي EGX"])
bool onClose = input.bool(true, "إغلاق الشمعة", group="EGX")
bool useMktHalt100 = input.bool(true, "EGX100 halt", group="EGX")
bool blockBearQ = input.bool(true, "ضغط EGX30", group="EGX")

bool proMode = mode == "PRO موحّد"
bool runnerMode = proMode or mode == "عدّاء استثمار" or mode == "فلسي EGX"
bool pennyMode = mode == "فلسي EGX"
float effVol = pennyMode ? 400.0 : mode == "EGX يومي" ? 1500.0 : 800.0
float effAcc = pennyMode ? 50.0 : 55.0
float effDist = pennyMode ? 52.0 : 50.0
float effRank = pennyMode ? 55.0 : mode == "EGX يومي" ? 62.0 : 58.0
float effRR = 1.5

bool sigOk = not onClose or barstate.isconfirmed

f_mktTrQ() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc
float mom30Q = request.security("EGX:EGX30", timeframe.period, close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off)
int tr30Q = request.security("EGX:EGX30", timeframe.period, f_mktTrQ(), barmerge.gaps_off, barmerge.lookahead_off)
bool heavySellQ = blockBearQ and mom30Q < -4.0 and tr30Q <= -1
float dayPct100Q = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100Q = useMktHalt100 and dayPct100Q <= -10.0
bool regimeOkQ = not heavySellQ and not mktHalt100Q


float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)
float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)
float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 20) / ta.sma(volume, 20)
float obvSlope = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
bool accOk = cmf > 0 and obvSlope > 0
float acc = math.min(100.0, (accOk ? 40.0 : 0.0) + (cmf > 0 ? 20.0 : 0.0))
float dist = math.min(100.0, (cmf < 0 and obvSlope < 0 ? 40.0 : 0.0))

float hi252 = ta.highest(high, 252)
float lo252 = ta.lowest(low, 252)
float pctHi = hi252 > 0 ? (close - hi252) / hi252 * 100.0 : 0.0
float rocBase = lo252 > 0 ? (close / lo252 - 1.0) * 100.0 : 0.0
bool crashTrap = runnerMode and rocBase > 100 and pctHi < -28 and dist >= 38

var float swingLow = na
if not na(ta.pivotlow(low, 8, 8))
    swingLow := ta.pivotlow(low, 8, 8)
bool supBreak = sigOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retest = sigOk and not na(swingLow) and low <= swingLow * 1.006 and close > swingLow

float buyTop = nz(swingLow, low) + atr * 0.35
float buyBot = nz(swingLow, low) - atr * 0.42
bool atZone = low <= buyTop and close >= buyBot
float rr = (close + atr * 2.5 - (buyTop + buyBot) / 2) / math.max((buyTop + buyBot) / 2 - (buyBot - atr * 0.6), syminfo.mintick)

float dPrevQ = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctQ = dPrevQ > 0 ? (close - dPrevQ) / dPrevQ * 100.0 : 0.0
float haltWarnQ = pennyMode ? 4.5 : 9.0
float luldWarnQ = pennyMode ? 9.75 : 19.75
bool nearLimit = dayPctQ >= haltWarnQ or dayPctQ >= luldWarnQ
bool chase = pctHi > -3 and rsi > 72
bool liqOk = volMa >= effVol

int cycle = acc >= effAcc ? 4 : 3
if dist >= 55
    cycle := 9
if crashTrap
    cycle := 9

float rank = math.min(100.0, acc * 0.5 + (100 - dist) * 0.3 + (atZone ? 20 : 0))
float opp = math.min(100.0, rank * 0.6 + acc * 0.4)

bool canBuy = sigOk and liqOk and regimeOkQ and acc >= effAcc and dist < effDist and (atZone or retest) and not supBreak and not nearLimit and not chase and not crashTrap and rr >= effRR and rank >= effRank
bool mustExit = supBreak or dist >= 65 or crashTrap
bool canWait = sigOk and not canBuy and not mustExit and cycle <= 4 and acc >= 45

int action = mustExit ? 0 : canBuy ? 4 : canWait ? 2 : 1
float atrMa = ta.sma(atr, 14)
bool squeezeOn = atr < atrMa * 0.85
float benchRoc = request.security("EGX:EGX30", timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
bool rsLeader = ta.roc(close, 20) - benchRoc > 0
float rvol252 = volume / math.max(ta.sma(volume, 252), 1.0)

float runnerDna = 0.0
runnerDna += cycle <= 4 ? 18.0 : cycle <= 7 ? 12.0 : 0.0
runnerDna += acc >= 55 ? 22.0 : acc >= 45 ? 12.0 : 0.0
runnerDna += dist < 40 ? 18.0 : dist < 50 ? 10.0 : 0.0
runnerDna += squeezeOn ? 12.0 : 0.0
runnerDna += rvol252 >= 1.1 or rvol >= 1.3 ? 10.0 : 0.0
runnerDna += rsLeader ? 10.0 : 0.0
runnerDna := math.min(100.0, runnerDna)

float breakLvl = ta.highest(high, 15)
bool preBreak = runnerMode and sigOk and (cycle == 3 or cycle == 4) and squeezeOn and acc >= effAcc - 3 and dist < 45 and close > breakLvl * 0.97 and close <= breakLvl * 1.03

bool screenerPass = canBuy and rank >= effRank
bool screenerPro = screenerPass and opp >= 60 and dist < 45
bool screenerUltra = proMode and (screenerPro or canBuy) and runnerDna >= 55 and not crashTrap

plot(action, "EGXQ_Action", color=color.new(color.blue, 0))
plot(canBuy ? 1 : 0, "EGXQ_Buy", color=color.lime)
plot(mustExit ? 1 : 0, "EGXQ_Exit", color=color.red)
plot(screenerPass ? 1 : 0, "EGXQ_Screener", color=color.yellow)
plot(screenerPro ? 1 : 0, "EGXQ_ScreenerPro", color=color.teal)
plot(screenerUltra ? 1 : 0, "EGXQ_ScreenerUltra", color=color.lime)
plot(preBreak ? 1 : 0, "EGXQ_PreBreak", color=color.fuchsia)
plot(runnerMode ? runnerDna : na, "EGXQ_DNA", color=color.aqua)
plot(opp, "EGXQ_Opportunity", color=color.orange)
plot(rank, "EGXQ_Rank", color=color.orange)
plot(acc, "EGXQ_Acc", color=color.green)
plot(dist, "EGXQ_Dist", color=color.red)
plot(cycle, "EGXQ_Cycle", color=color.purple)
plot(crashTrap ? 1 : 0, "EGXQ_CrashTrap", color=color.maroon)
plot(regimeOkQ ? 1 : 0, "EGX_RegimeOk", display=display.all)
plot(1, "EGXQ_Qarar", color=color.gray)

plot(1, "EGXQ_FullMirror", display=display.data_window)

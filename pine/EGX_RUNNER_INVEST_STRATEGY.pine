//@version=6
strategy("EGX عدّاء — اختبار استثمار", shorttitle="EGX عدّاء ST", overlay=true, pyramiding=1, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=3, default_qty_type=strategy.percent_of_equity, default_qty_value=12, initial_capital=100000, currency=currency.EGP)

// مرتبط بـ EGX_RUNNER_INVEST.pine — جزئي 35% + 25% T1 · إضافة دورة 7 · T2 · trail

string G_PROF = "ملف EGX"
string profile = input.string("استثمار عدّاء", "الملف", options=["استثمار عدّاء", "مخصص"], group=G_PROF)

string G_IN = "دخول"
float minAccIn = input.float(58.0, "حد تجميع", group=G_IN)
float maxDistIn = input.float(50.0, "أقصى تصريف للدخول", group=G_IN)
int minCycleIn = input.int(4, "دورة min", minval=3, maxval=8, group=G_IN)
int maxCycleIn = input.int(7, "دورة max", minval=4, maxval=10, group=G_IN)
float minRankIn = input.float(60.0, "حد رتبة", group=G_IN)
float minOppIn = input.float(62.0, "حد فرصة (0=إيقاف)", minval=0, maxval=90, group=G_IN)
float minRRIn = input.float(1.5, "حد R/R", group=G_IN)
int minSetupIn = input.int(7, "حد إعداد /11", minval=5, maxval=11, group=G_IN)
int minGatesIn = input.int(8, "بوابات /10", minval=5, maxval=10, group=G_IN)
float minAvgVolIn = input.float(800.0, "حد حجم", group=G_IN)
bool useConfirm = input.bool(true, "إغلاق الشمعة", group=G_IN)
bool blockBear = input.bool(true, "منع ضغط EGX30", group=G_IN)
bool blockLimit = input.bool(true, "منع قرب halt", group=G_IN)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G_IN)
bool skipSundayBuy = input.bool(false, "لا دخول يوم الأحد", group=G_IN)
int breakConfirmBars = input.int(2, "إغلاقات لتأكيد الاختراق", minval=1, maxval=5, group=G_IN)
bool skipOffHours = input.bool(false, "لا دخول خارج المستمر", group=G_IN)
bool useMktHalt100 = input.bool(true, "منع شراء إذا EGX100 ≤ −10%", group=G_IN)
float riskPctEq = input.float(1.5, "مخاطرة % محفظة", minval=0.5, maxval=3.0, step=0.1, group=G_IN)
float partCapPct = input.float(8.0, "سقف ADV 20 يوم %", minval=2, maxval=15, group=G_IN)
bool useRiskQty = input.bool(true, "حجم = مخاطرة 1–2% + سقف ADV", group=G_IN)
bool blockPostCrash = input.bool(true, "منع ارتداد بعد سقوط", group=G_IN)
bool allowSc = input.bool(true, "دخول SC وايكوف", group=G_IN)
bool allowAdd = input.bool(true, "إضافة دورة 7", group=G_IN)
float addQtyPct = input.float(8.0, "حجم الإضافة % equity", minval=3, maxval=20, group=G_IN)

string G_EX = "خروج (عدّاء)"
float exitDistIn = input.float(65.0, "خروج تصريف ≥", group=G_EX)
bool usePartial1 = input.bool(true, "جزئي 1 عند 35%→T1", group=G_EX)
float partial1Pct = input.float(35.0, "جزئي 1 %", minval=15, maxval=50, group=G_EX)
bool usePartial2 = input.bool(true, "جزئي 2 عند T1", group=G_EX)
float partial2Pct = input.float(25.0, "جزئي 2 %", minval=10, maxval=40, group=G_EX)
bool trimOnCycle8 = input.bool(true, "جني عند Trim (دورة 8/BC)", group=G_EX)
float trimPct = input.float(20.0, "نسبة Trim %", minval=5, maxval=40, group=G_EX)
bool useTrail = input.bool(true, "وقف متحرك بعد جزئي 1", group=G_EX)
float trailMult = input.float(1.5, "متحرك × ATR", minval=0.8, step=0.1, group=G_EX)
string runnerTarget = input.string("T2", "هدف الباقي", options=["T1", "T2", "T3"], group=G_EX)
bool exitOnCycle9 = input.bool(true, "خروج كامل دورة 9", group=G_EX)

string G_MIR = "مرآة ماسح"
bool mirrorBuyPlot = input.bool(true, "plot EGXR_Buy (مرآة)", group=G_MIR)

bool profCustom = profile == "مخصص"
float effMinAcc = profCustom ? minAccIn : 58.0
float effMaxDist = profCustom ? maxDistIn : 50.0
float effExitDist = profCustom ? exitDistIn : 65.0
int effMinCycle = profCustom ? minCycleIn : 4
int effMaxCycle = profCustom ? maxCycleIn : 7
float effMinRank = profCustom ? minRankIn : 60.0
float effMinOpp = profCustom ? minOppIn : 62.0
float effMinRR = profCustom ? minRRIn : 1.5
int effMinSetup = profCustom ? minSetupIn : 7
int effMinGates = profCustom ? minGatesIn : 8
float effMinVol = profCustom ? minAvgVolIn : 800.0

bool barOk = not useConfirm or barstate.isconfirmed

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
bool bullStack = ema9 > ema21 and ema21 > ema50

float wClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
float wEma200 = request.security(syminfo.tickerid, "W", ta.ema(close, 200), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = wClose > wEma50 and wEma50 > wEma200

f_tfBull(string tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)

int mtfScore = 0
mtfScore += f_tfBull("15") ? 1 : -1
mtfScore += f_tfBull("60") ? 1 : -1
mtfScore += f_tfBull("D") ? 1 : -1
mtfScore += f_tfBull("W") ? 1 : -1
bool mtfOk = mtfScore >= 0

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdBull = macdH > 0 and macdL > macdS
float rsi = ta.rsi(close, 14)
float atr = ta.atr(14)

float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= effMinVol
float rvol = volume / math.max(volMa, 1.0)
float rvol252 = volume / math.max(ta.sma(volume, 252), 1.0)

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 20) / ta.sma(volume, 20)
float obv = ta.obv
float obvSlope = ta.linreg(obv, 10, 0) - ta.linreg(obv, 10, 1)
bool accumulating = cmf > 0 and obvSlope > 0

float accPts = (accumulating ? 18.0 : 0.0) + (cmf > 0.05 ? 12.0 : cmf > 0 ? 6.0 : 0.0) + (obvSlope > 0 ? 12.0 : 0.0) + (rvol >= 1.0 and close > open ? 8.0 : 0.0)
float accumScore = math.min(100.0, accPts)

float distPts = (cmf < 0 and obvSlope < 0 ? 18.0 : 0.0) + (rvol >= 1.8 and close < open ? 12.0 : 0.0) + (cmf < -0.05 ? 12.0 : 0.0)
float distRisk = math.min(100.0, distPts)

float spread = high - low
float closePos = spread > syminfo.mintick ? (close - low) / spread : 0.5
bool ultraVol = rvol >= 2.2 or rvol252 >= 2.0
bool wyckSC = allowSc and ultraVol and closePos > 0.55 and low <= ta.lowest(low, 12)
bool wyckBC = ultraVol and closePos < 0.42 and high >= ta.highest(high, 12)

int accBaseBars = 15
float rangeN = ta.highest(high, accBaseBars) - ta.lowest(low, accBaseBars)
float atrMa20 = ta.sma(atr, 20)
bool squeezeOn = atr < atrMa20 * 0.85
bool inBase = rangeN <= atr * 2.2 or squeezeOn

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc

float mom30 = request.security("EGX:EGX30", timeframe.period, close[20] > 0 ? (close / close[20] - 1) * 100 : 0.0, barmerge.gaps_off, barmerge.lookahead_off)
int tr30 = request.security("EGX:EGX30", timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
bool heavySell = mom30 < -4.0 and tr30 <= -1

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctR = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearHaltUp = blockLimit and dPrev > 0 and dayPctR >= math.min(9.0, haltPct - 1.0)
bool atLuldUp = dPrev > 0 and dayPctR >= luldPct - 0.25
bool nearLimit = nearHaltUp or atLuldUp
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool sundaySkip = skipSundayBuy and dayofweek == dayofweek.sunday
int egxSessId = 0
if not na(time(timeframe.period, "1000-1415:23456", "Africa/Cairo"))
    egxSessId := 2
bool sessionPhaseOk = not skipOffHours or not timeframe.isintraday or egxSessId == 2

float hi252 = ta.highest(high, 252)
float lo252 = ta.lowest(low, 252)
float roc252 = lo252 > 0 ? (close / lo252 - 1.0) * 100.0 : na
float pctFromHi = hi252 > 0 ? (close - hi252) / hi252 * 100.0 : na

int pivotLen = 8
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
var float swingLow = na
var float swingHigh = na
if not na(pl)
    swingLow := pl
if not na(ph)
    swingHigh := ph

int structP = 5
float phs = ta.pivothigh(high, structP, structP)
var float actHigh = na
var int structDir = 0
if not na(phs)
    actHigh := phs
bool bullBreak = barOk and not na(actHigh) and close > actHigh and close[1] <= actHigh
if bullBreak
    structDir := 1
    actHigh := na

bool supportBreak = barOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retestSupport = barOk and not na(swingLow) and low <= swingLow * 1.006 and close > swingLow
bool fakeBreakUp = barOk and not na(swingHigh) and high > swingHigh and close < swingHigh and rvol > 1.05
bool rawBreak = bullBreak and rvol >= 1.2
var float brkHoldLvl = na
var int brkHoldBars = 0
if barstate.isconfirmed
    if rawBreak
        brkHoldLvl := nz(swingHigh, close[1])
        brkHoldBars := 1
    else if not na(brkHoldLvl) and close > brkHoldLvl
        brkHoldBars += 1
    else
        brkHoldLvl := na
        brkHoldBars := 0
bool breakConfirmed = barOk and not na(brkHoldLvl) and brkHoldBars >= breakConfirmBars and (rvol >= 1.2 or rvol[1] >= 1.2)
bool breakRetest = retestSupport and structDir == 1 and not fakeBreakUp
bool pullBackReacc = structDir == 1 and close > ema50 and low <= ema21 and close > ema21

float zw = atr * 0.35
float buyTop = nz(swingLow, low) + zw
float buyBot = nz(swingLow, low) - zw * 1.2
bool nearSupport = low <= buyTop and close >= buyBot

bool upTrendC = structDir == 1 and close > ema21
bool extRallyC = upTrendC and close > ema50 + atr * 2.5 and rsi > 62
bool distPhaseC = distRisk >= accumScore + 15 and distRisk >= effExitDist - 5

var int cycle12 = 3
int newCycle12 = cycle12
if breakConfirmed and not upTrendC
    newCycle12 := 5
else if pullBackReacc
    newCycle12 := 7
else if extRallyC
    newCycle12 := 8
else if distPhaseC
    newCycle12 := 9
else if supportBreak
    newCycle12 := 11
else if upTrendC
    newCycle12 := 6
else if inBase and accumScore >= effMinAcc
    newCycle12 := 4
else
    newCycle12 := 3

if barOk
    cycle12 := newCycle12

bool cycleBuyOk = cycle12 >= effMinCycle and cycle12 <= effMaxCycle
bool cycleWatchOk = cycle12 == 3 or cycle12 == 4

float swingRange = nz(swingHigh - swingLow, atr * 4)
float t1 = na(swingHigh) ? close + atr * 2.5 : swingHigh
float t2 = nz(swingLow, close) + swingRange * 1.618
float t3 = nz(swingLow, close) + swingRange * 2.618
float entryPx = (buyTop + buyBot) / 2.0
float stopPx = buyBot - atr * 0.65
float riskPx = math.max(entryPx - stopPx, syminfo.mintick)
float rr = riskPx > 0 ? (t1 - entryPx) / riskPx : na
float tHalf = entryPx + (t1 - entryPx) * 0.35

bool chase = not na(pctFromHi) and pctFromHi > -2.5 and rsi > 74 and cycle12 >= 8
bool postCrashBounce = blockPostCrash and not na(roc252) and roc252 > 80 and pctFromHi < -35

float benchRoc = request.security("EGX:EGX30", timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
bool rsLeader = ta.roc(close, 20) - benchRoc > 0

float score = (bullStack ? 18.0 : 0.0) + (htfBull ? 14.0 : 0.0) + (accumScore >= 50 ? 14.0 : 0.0) + (rsLeader ? 8.0 : 0.0) + (cycleBuyOk ? 10.0 : 0.0)
score := math.min(100.0, score)

int setupHits = 0
setupHits += (htfBull and close > ema50) ? 1 : 0
setupHits += accumScore >= effMinAcc ? 1 : 0
setupHits += distRisk < effMaxDist ? 1 : 0
setupHits += rsLeader ? 1 : 0
setupHits += structDir == 1 or breakConfirmed ? 1 : 0
setupHits += nearSupport or pullBackReacc ? 1 : 0
setupHits += retestSupport or breakRetest ? 1 : 0
setupHits += not na(rr) and rr >= effMinRR ? 1 : 0
setupHits += mtfOk ? 1 : 0
setupHits += rvol >= 1.0 ? 1 : 0
setupHits += cycleBuyOk ? 1 : 0
setupHits += macdBull ? 1 : 0

float rank = score * 0.55 + setupHits / 11.0 * 45.0
float opportunity = math.min(100.0, accumScore * 0.32 + rank * 0.28 + (100.0 - distRisk) * 0.18 + (cycleBuyOk ? 12.0 : 0.0))

bool locationOk = nearSupport or breakRetest or (pullBackReacc and cycle12 == 7) or (breakConfirmed and cycle12 == 5) or (wyckSC and nearSupport)
bool vetoBuy = supportBreak or (blockBear and heavySell) or nearLimit or chase or postCrashBounce or fakeBreakUp or distRisk >= effMaxDist + 10

int gatesPass = (liqOk ? 1 : 0) + (mtfOk ? 1 : 0) + (not na(rr) and rr >= effMinRR ? 1 : 0) + (accumScore >= effMinAcc ? 1 : 0) + (distRisk < effMaxDist ? 1 : 0) + (cycleBuyOk or (allowSc and cycleWatchOk and wyckSC) ? 1 : 0) + (locationOk ? 1 : 0) + (rsLeader or htfBull ? 1 : 0) + (structDir == 1 or breakConfirmed or inBase ? 1 : 0) + (not vetoBuy ? 1 : 0)

bool coreLong = barOk and liqOk and not vetoBuy and accumScore >= effMinAcc and distRisk < effMaxDist and not na(rr) and rr >= effMinRR and setupHits >= effMinSetup and rank >= effMinRank and gatesPass >= effMinGates and (effMinOpp <= 0 or opportunity >= effMinOpp)

bool longEntry = coreLong and (cycleBuyOk or (allowSc and wyckSC and cycleWatchOk)) and locationOk and sessionPhaseOk and not sundaySkip and not mktHalt100
bool addEntry = allowAdd and coreLong and cycle12 == 7 and pullBackReacc and distRisk < 55 and strategy.position_size > 0
bool screenerProMir = longEntry or addEntry or (coreLong and cycle12 <= 4 and accumScore >= 60)

bool trimSig = barOk and trimOnCycle8 and strategy.position_size > 0 and (cycle12 == 8 or wyckBC or (distRisk >= 55 and distRisk < effExitDist and cycle12 >= 6))
bool exitSig = barOk and (supportBreak or distRisk >= effExitDist or fakeBreakUp or (exitOnCycle9 and cycle12 == 9) or (cycle12 == 8 and chase))

float exitLim = runnerTarget == "T3" ? t3 : runnerTarget == "T2" ? t2 : t1

var bool tookP1 = false
var bool tookP2 = false
var float trailStop = na

if strategy.position_size == 0
    tookP1 := false
    tookP2 := false
    trailStop := na

if longEntry and strategy.position_size == 0
    if useRiskQty
        float invQty = math.max(0.5, math.min(15.0, math.min(riskPctEq * close / math.max(close - stopPx, syminfo.mintick), strategy.equity > 0 ? volMa * close * (partCapPct / 100.0) / strategy.equity * 100.0 : 10.0)))
        strategy.entry("INV", strategy.long, qty_percent=invQty)
    else
        strategy.entry("INV", strategy.long)
    tookP1 := false
    tookP2 := false
    trailStop := stopPx

if addEntry and strategy.position_size > 0
    strategy.entry("ADD7", strategy.long, qty_percent=addQtyPct, comment="Add C7")

if strategy.position_size > 0
    if usePartial1 and not tookP1 and high >= tHalf
        strategy.close("INV", qty_percent=partial1Pct, comment="P1")
        strategy.close("ADD7", qty_percent=partial1Pct, comment="P1")
        tookP1 := true
        trailStop := math.max(nz(trailStop, stopPx), entryPx)
    if usePartial2 and tookP1 and not tookP2 and high >= t1
        strategy.close("INV", qty_percent=partial2Pct, comment="P2 T1")
        strategy.close("ADD7", qty_percent=partial2Pct, comment="P2 T1")
        tookP2 := true
    if useTrail and tookP1
        trailStop := math.max(nz(trailStop, stopPx), close - atr * trailMult)
    float exitStop = useTrail and tookP1 and not na(trailStop) ? trailStop : stopPx
    strategy.exit("INV-X", "INV", stop=exitStop, limit=exitLim)
    strategy.exit("ADD-X", "ADD7", stop=exitStop, limit=exitLim)

if trimSig and strategy.position_size > 0
    strategy.close("INV", qty_percent=trimPct, comment="Trim")
    strategy.close("ADD7", qty_percent=trimPct, comment="Trim")

if exitSig and strategy.position_size > 0
    strategy.close_all(comment="Exit runner")

plot(mirrorBuyPlot and longEntry ? 1 : 0, "EGXR_Buy", display=display.data_window)
plot(mirrorBuyPlot and screenerProMir ? 1 : 0, "EGXR_ScreenerPro", display=display.data_window)
plot(longEntry ? 1 : 0, "EGXR_ST_Entry", display=display.data_window)
plot(longEntry ? 1 : 0, "EGXR_ST_CanBuy", display=display.data_window)
plot(addEntry ? 1 : 0, "EGXR_ST_Add", display=display.data_window)
plot(trimSig ? 1 : 0, "EGXR_ST_Trim", display=display.data_window)
plot(exitSig ? 1 : 0, "EGXR_ST_Exit", display=display.data_window)
plot(gatesPass, "EGXR_ST_Gates", display=display.data_window)

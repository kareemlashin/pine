//@version=6
strategy("EGX MI Pro — Strategy Test", shorttitle="EGX MI ST", overlay=true, pyramiding=0, calc_bars_count=5000, initial_capital=100000, currency=currency.EGP, commission_type=strategy.commission.percent, commission_value=0.125, slippage=2, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// نسخة اختبار مستقلة — قواعد مسبقة، لا معايرة «أفضل إعداد تاريخي»
// مرتبطة منطقيًا بـ EGX_MARKET_INTELLIGENCE_PRO.pine (مبسّطة للاختبار)

string G = "═══ إعدادات ═══"
bool useConfirm = input.bool(true, "دخول عند إغلاق الشمعة", group=G)
float minRvol = input.float(1.0, "RVOL أدنى (0=إيقاف)", minval=0.0, step=0.1, group=G)
float minAcc = input.float(50.0, "درجة تجميع أدنى", minval=0, maxval=100, group=G)
float maxDist = input.float(55.0, "درجة تصريف أقصى", minval=0, maxval=100, group=G)
float minRR = input.float(1.3, "R/R أدنى", minval=0.8, step=0.1, group=G)
float minAvgVol = input.float(1500.0, "متوسط حجم أدنى", minval=0, group=G)
bool allowBreakout = input.bool(true, "دخول: اختراق + حجم", group=G)
bool allowRetest = input.bool(true, "دخول: إعادة اختبار", group=G)
bool allowTrend = input.bool(false, "دخول: اتجاه EMA فقط", group=G)
bool blockBearMkt = input.bool(true, "منع إذا EMA200 هابط + ADX", group=G)
float stopAtr = input.float(1.5, "وقف × ATR", minval=0.5, step=0.1, group=G)
float tpR = input.float(2.0, "هدف × مخاطرة", minval=1.0, step=0.25, group=G)
int maxBars = input.int(40, "أقصى bars في الصفقة (0=إيقاف)", minval=0, group=G)
bool blockLimitBuy = input.bool(true, "منع شراء قرب halt/LULD", group=G)
float limitBuyPct = input.float(9.0, "تحذير halt %", minval=3.0, maxval=10.0, step=0.5, group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool useMktHalt100 = input.bool(true, "منع إذا EGX100 ≤ −10%", group=G)
float riskPctEq = input.float(1.5, "مخاطرة % محفظة", minval=0.5, maxval=3.0, step=0.1, group=G)
bool useRiskQty = input.bool(true, "حجم = مخاطرة % + سقف ADV", group=G)
float partCapPct = input.float(8.0, "سقف ADV 20 يوم %", minval=2, maxval=15, group=G)

bool barOk = useConfirm ? barstate.isconfirmed : true

f_pts100(float pts, float ptMax) =>
    ptMax > 0 ? math.min(100.0, math.max(0.0, pts / ptMax * 100.0)) : 0.0

const float ACC_PT_MAX = 45.0
const float DIST_PT_MAX = 30.0

float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float atr = ta.atr(14)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)
bool liqOk = minAvgVol <= 0 or volMa >= minAvgVol

float dPrevClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayChgPct = dPrevClose > 0 ? (close - dPrevClose) / dPrevClose * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
float haltWarnPct = math.min(limitBuyPct, math.max(haltPct - 1.0, haltPct * 0.9))
bool nearLimitUp = blockLimitBuy and dPrevClose > 0 and (dayChgPct >= haltWarnPct or dayChgPct >= luldPct - 0.25)
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool microOk = not nearLimitUp and not mktHalt100

int pL = 5
float pl = ta.pivotlow(low, pL, pL)
float ph = ta.pivothigh(high, pL, pL)
var float lastSL = na
var float lastSH = na
if not na(pl)
    lastSL := pl
if not na(ph)
    lastSH := ph

bool trendUp = ema20 > ema50 and close > ema200
bool bearBlock = blockBearMkt and close < ema200 and adx > 20 and diMinus > diPlus

float rangeHi = ta.highest(high, 15)
bool breakOk = barOk and close > rangeHi[1] and close[1] <= rangeHi[1] and rvol >= 1.15
bool retestOk = barOk and not na(lastSL) and low <= lastSL * 1.005 and close > lastSL

float stop = nz(lastSL, close) - atr * stopAtr
float risk = math.max(close - stop, syminfo.mintick)
float tp = close + risk * tpR
float rr = (tp - close) / risk

// Scores (مختصر)
float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 14) / math.max(ta.sma(volume, 14), 1.0)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
float accRaw = (cmf > 0 ? 15 : 0) + (obvSl > 0 ? 15 : 0) + (retestOk ? 20 : 0)
float distRaw = (cmf < 0 ? 15 : 0) + (obvSl < 0 ? 15 : 0)
float acc = f_pts100(accRaw, ACC_PT_MAX)
float dist = f_pts100(distRaw, DIST_PT_MAX)

bool rvolOk = minRvol <= 0 or rvol >= minRvol
bool scoreOk = acc >= minAcc and dist <= maxDist and rr >= minRR

bool entryBreak = allowBreakout and breakOk and scoreOk and rvolOk and liqOk and not bearBlock and microOk
bool entryRetest = allowRetest and retestOk and trendUp and scoreOk and rvolOk and liqOk and not bearBlock and microOk
bool entryTrend = allowTrend and trendUp and adx > 20 and diPlus > diMinus and scoreOk and liqOk and not bearBlock and microOk

bool enter = entryBreak or entryRetest or entryTrend
float qtyRiskPct = math.min(15.0, riskPctEq * close / math.max(close - stop, syminfo.mintick))
float qtyAdvPct = strategy.equity > 0 ? math.min(20.0, volMa * close * (partCapPct / 100.0) / strategy.equity * 100.0) : qtyRiskPct
float entryQtyPct = math.max(0.5, math.min(qtyRiskPct, qtyAdvPct))

var int barsIn = 0
if strategy.position_size == 0
    barsIn := 0
else
    barsIn += 1

if enter and strategy.position_size == 0
    if useRiskQty
        strategy.entry("Long", strategy.long, qty_percent=entryQtyPct)
    else
        strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=stop, limit=tp)
    if barOk and not na(lastSL) and close < lastSL
        strategy.close("Long", comment="Struct break")
    if maxBars > 0 and barsIn >= maxBars
        strategy.close("Long", comment="Time exit")

plot(ema50, "EMA50", color=color.orange)
plotshape(enter, "Entry", shape.triangleup, location.belowbar, color.lime, size=size.tiny)

//@version=6
strategy("EGX BEST — اختبار", shorttitle="EGX BEST ST", overlay=true, pyramiding=0, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=2, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// مرتبط بـ EGX_BEST.pine — slippage: 2 سائل · 3 متوسط · 5 رقيق (غيّر في strategy())

string G_PROF = "ملف EGX"
string profile = input.string("EGX قياسي", "الملف", options=["EGX قياسي", "مضاربة 15د", "استثمار يومي", "مخصص"], group=G_PROF)

string G_IN = "دخول"
int pivotLen = input.int(8, "محور swing", minval=3, maxval=15, group=G_IN)
int volMaLen = input.int(20, "متوسط حجم", group=G_IN)
float minAvgVolIn = input.float(1500.0, "حد حجم", group=G_IN)
float minRRIn = input.float(1.5, "حد R/R", group=G_IN)
float minScoreIn = input.float(58.0, "حد تقييم", group=G_IN)
int minSetupIn = input.int(7, "حد إعداد /11", minval=0, maxval=11, group=G_IN)
bool useConfirm = input.bool(true, "إغلاق الشمعة", group=G_IN)
bool blockBear = input.bool(true, "منع ضغط EGX30", group=G_IN)
bool blockLimit = input.bool(true, "منع قرب halt", group=G_IN)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G_IN)
bool skipSundayBuy = input.bool(false, "لا دخول يوم الأحد", group=G_IN)
int breakConfirmBars = input.int(2, "إغلاقات لتأكيد الاختراق", minval=1, maxval=5, group=G_IN)
bool skipOffHours = input.bool(false, "لا دخول خارج المستمر", group=G_IN)
bool useMktHalt100 = input.bool(true, "منع شراء إذا EGX100 ≤ −10%", group=G_IN)
float riskPctEq = input.float(1.5, "مخاطرة % محفظة", minval=0.5, maxval=3.0, step=0.1, group=G_IN)
float partCapPct = input.float(8.0, "سقف ADV 20 يوم %", minval=2, maxval=15, group=G_IN)
bool useRiskQty = input.bool(true, "حجم = مخاطرة 1–2% + سقف ADV", group=G_IN)

string G_EX = "خروج"
bool usePartial = input.bool(true, "جزئي 50% عند منتصف T1", group=G_EX)
bool useTrail = input.bool(true, "وقف متحرك بعد جزئي", group=G_EX)
float trailMult = input.float(1.2, "متحرك × ATR", minval=0.5, step=0.1, group=G_EX)

bool profCustom = profile == "مخصص"
float effMinVol = profCustom ? minAvgVolIn : profile == "مضاربة 15د" ? 3000.0 : profile == "استثمار يومي" ? 800.0 : 1500.0
float effMinRR = profCustom ? minRRIn : 1.5
float effMinScore = profCustom ? minScoreIn : profile == "مضاربة 15د" ? 60.0 : 58.0
int effMinSetup = profCustom ? minSetupIn : 7

bool barOk = not useConfirm or barstate.isconfirmed

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
bool bullStack = ema9 > ema21 and ema21 > ema50
bool above200 = close > ema200

float wClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
float wEma200 = request.security(syminfo.tickerid, "W", ta.ema(close, 200), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = wClose > wEma50 and wEma50 > wEma200

f_tfBull(string tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)

int mtfScore = 0
mtfScore += f_tfBull("15") ? 1 : -1
mtfScore += f_tfBull("60") ? 1 : -1
mtfScore += f_tfBull("D") ? 1 : -1
mtfScore += f_tfBull("W") ? 1 : -1
bool mtfOk = mtfScore >= 1

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdBull = macdH > 0 and macdL > macdS
float rsi = ta.rsi(close, 14)
float atr = ta.atr(14)
float volMa = ta.sma(volume, volMaLen)
bool liqOk = volMa >= effMinVol
float rvol = volume / math.max(volMa, 1.0)

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 14) / ta.sma(volume, 14)
float obv = ta.obv
float obvSlope = ta.linreg(obv, 10, 0) - ta.linreg(obv, 10, 1)
bool accumulating = cmf > 0 and obvSlope > 0
bool distributing = cmf < 0 and obvSlope < 0

f_mktMom() =>
    close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc

int tr30 = request.security("EGX:EGX30", timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
float mom30 = request.security("EGX:EGX30", timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off)
float benchRoc = request.security("EGX:EGX30", timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
bool rsLeader = ta.roc(close, 20) - benchRoc > 0
bool heavySell = mom30 < -4.0 and tr30 <= -1

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearHaltUp = blockLimit and dPrev > 0 and dayPct >= math.min(9.0, haltPct - 1.0)
bool atLuldUp = dPrev > 0 and dayPct >= luldPct - 0.25
bool nearLimit = nearHaltUp or atLuldUp
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool sundaySkip = skipSundayBuy and dayofweek == dayofweek.sunday
int egxSessId = 0
if not na(time(timeframe.period, "1000-1415:23456", "Africa/Cairo"))
    egxSessId := 2
bool sessionPhaseOk = not skipOffHours or not timeframe.isintraday or egxSessId == 2

float pl = ta.pivotlow(low, pivotLen, pivotLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
var float swingLow = na
var float swingHigh = na
if not na(pl)
    swingLow := pl
if not na(ph)
    swingHigh := ph

float phs = ta.pivothigh(high, 5, 5)
var float actHigh = na
var int structDir = 0
if not na(phs)
    actHigh := phs
bool bullBreak = barOk and not na(actHigh) and close > actHigh and close[1] <= actHigh
if bullBreak
    structDir := 1
    actHigh := na

bool supportBreak = barOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retestSupport = barOk and not na(swingLow) and low <= swingLow * 1.005 and close > swingLow
bool fakeBreakUp = barOk and not na(swingHigh) and high > swingHigh and close < swingHigh and rvol > 1.05
bool rawBreak = bullBreak and rvol >= 1.2
var float brkHoldLvl = na
var int brkHoldBars = 0
if barstate.isconfirmed
    if rawBreak
        brkHoldLvl := nz(swingHigh, close[1])
        brkHoldBars := 1
    else if not na(brkHoldLvl) and close > brkHoldLvl
        brkHoldBars += 1
    else
        brkHoldLvl := na
        brkHoldBars := 0
bool breakConfirmed = barOk and not na(brkHoldLvl) and brkHoldBars >= breakConfirmBars and (rvol >= 1.2 or rvol[1] >= 1.2)
bool breakRetest = retestSupport and structDir == 1 and not fakeBreakUp

float zw = atr * 0.35
float buyTop = nz(swingLow, low) + zw
float buyBot = nz(swingLow, low) - zw * 1.2
bool inBuyZone = low <= buyTop and high >= buyBot
bool nearSupport = low <= buyTop and close >= buyBot

float swingRange = nz(swingHigh - swingLow, atr * 3)
float t1 = na(swingHigh) ? close + atr * 2 : swingHigh
float t2 = nz(swingLow, close) + swingRange * 1.618
float entryPx = (buyTop + buyBot) / 2.0
float stopPx = buyBot - atr * 0.5
float riskPx = math.max(entryPx - stopPx, syminfo.mintick)
float rr = riskPx > 0 ? (t1 - entryPx) / riskPx : na
float tHalf = entryPx + (t1 - entryPx) * 0.5

float hi252 = ta.highest(high, 252)
bool chase = hi252 > 0 and (close - hi252) / hi252 * 100.0 > -3 and rsi > 72 and not na(rr) and rr < 1.0

float score = 0.0
score += bullStack ? 20.0 : 0.0
score += above200 ? 15.0 : -5.0
score += htfBull ? 15.0 : -10.0
score += macdBull ? 10.0 : 0.0
score += accumulating ? 15.0 : distributing ? -10.0 : 0.0
score += rvol >= 1.0 ? 10.0 : 0.0
score += rsi > 40 and rsi < 70 ? 10.0 : 0.0
score += mtfOk ? 5.0 : -4.0
score += rsLeader ? 5.0 : 0.0
score := math.max(0.0, math.min(100.0, score))

int setupHits = 0
setupHits += bullStack ? 1 : 0
setupHits += htfBull ? 1 : 0
setupHits += macdBull ? 1 : 0
setupHits += accumulating ? 1 : 0
setupHits += rsLeader ? 1 : 0
setupHits += structDir == 1 ? 1 : 0
setupHits += inBuyZone ? 1 : 0
setupHits += retestSupport ? 1 : 0
setupHits += not na(rr) and rr >= effMinRR ? 1 : 0
setupHits += mtfOk ? 1 : 0
setupHits += rvol >= 1.0 ? 1 : 0
setupHits += breakRetest or breakConfirmed ? 1 : 0

bool zoneReady = score >= effMinScore and not na(rr) and rr >= effMinRR and liqOk and not supportBreak and not (blockBear and heavySell) and not nearLimit and not chase
bool longEntry = barOk and zoneReady and setupHits >= effMinSetup and (nearSupport or breakRetest or (inBuyZone and retestSupport)) and sessionPhaseOk and not sundaySkip and not mktHalt100

bool exitSig = barOk and (supportBreak or fakeBreakUp or (close < ema21 and distributing))

var bool tookHalf = false
var float trailStop = na

if strategy.position_size == 0
    tookHalf := false
    trailStop := na

float entryQtyPct = math.max(0.5, math.min(15.0, math.min(riskPctEq * close / math.max(close - stopPx, syminfo.mintick), strategy.equity > 0 ? volMa * close * (partCapPct / 100.0) / strategy.equity * 100.0 : 10.0)))

if longEntry and strategy.position_size == 0
    if useRiskQty
        strategy.entry("L", strategy.long, qty_percent=entryQtyPct)
    else
        strategy.entry("L", strategy.long)
    tookHalf := false
    trailStop := stopPx

if strategy.position_size > 0
    if usePartial and not tookHalf and high >= tHalf
        strategy.close("L", qty_percent=50, comment="50% T1")
        tookHalf := true
        trailStop := math.max(nz(trailStop, stopPx), entryPx)
    if useTrail and tookHalf
        trailStop := math.max(nz(trailStop, stopPx), close - atr * trailMult)
    float exitLim = tookHalf ? t2 : t1
    float exitStop = useTrail and tookHalf and not na(trailStop) ? trailStop : stopPx
    strategy.exit("LX", "L", stop=exitStop, limit=exitLim)

if exitSig and strategy.position_size > 0
    strategy.close("L", comment="Exit signal")

plot(entryPx, "Entry", color=color.new(color.lime, 50), display=display.none)
plot(stopPx, "Stop", color=color.new(color.red, 50), display=display.none)
plot(t1, "T1", color=color.new(color.aqua, 50), display=display.none)

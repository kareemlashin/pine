//@version=6
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"])
indicator("EGX TOOLS × Volume — توافق", shorttitle="EGX TxV", overlay=true, max_tables_count=2, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// شراء Tools lite + B1 فوليوم — EGXTxV_Agree=1 · EGXTxV_Tools · EGXTxV_Vol
// ═══════════════════════════════════════════════════════════════════════════════

float sigMin = input.float(20.0, "Tools Score %", minval=10, maxval=45)
float minVolMa = input.float(1200.0, "متوسط حجم", minval=0)
float volNetBuy = input.float(52.0, "Net buy B1 %", minval=45, maxval=65)
bool onClose = input.bool(true, "إغلاق الشمعة")
bool showB1 = input.bool(true, "خط B1")

bool sigOk = not onClose or barstate.isconfirmed

f_toolsBuy() =>
    float ema50 = ta.ema(close, 50)
    float rsi = ta.rsi(close, 14)
    [macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
    float volMa = ta.sma(volume, 20)
    bool liqOk = volMa >= minVolMa
    float rng = math.max(high - low, syminfo.mintick)
    float cmf = ta.sma(((close - low) - (high - close)) / rng * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    bool bosUp = close > ta.highest(high, 20)[1]
    float lookHi = ta.highest(high, 80)
    float lookLo = ta.lowest(low, 80)
    bool inDem = close <= lookHi - 0.618 * (lookHi - lookLo) and close >= lookLo
    int sc = 0
    sc += rsi > 50 and rsi < 70 ? 1 : -1
    sc += macdH > 0 ? 1 : -1
    sc += close > ema50 ? 1 : -1
    sc += cmf > 0 ? 1 : -1
    sc += obvSl > 0 ? 1 : -1
    sc += bosUp or inDem ? 1 : 0
    float score = sc / 6.0 * 100.0
    bool locOK = inDem or bosUp
    bool moneyOK = cmf > 0 and obvSl > 0
    bool buy = sigOk and liqOk and locOK and moneyOK and score >= sigMin and not nearLimit
    [buy ? 1 : 0, score]

[toolBuy, toolSc] = f_toolsBuy()

f_bv(int off) =>
    float r = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / r

int bins = 24
int zn = math.min(400, bar_index)
float hi = ta.highest(high, zn)
float lo = ta.lowest(low, zn)
float step = (hi - lo) / math.max(bins, 1)
step := step <= syminfo.mintick ? syminfo.mintick : step
array<float> buyB = array.new_float(bins, 0.0)
float tB = 0.0
float tS = 0.0
for i = 0 to zn - 1
    float bV = f_bv(i)
    tS += volume[i] - bV
    tB += bV
    int bi = int(math.floor((close[i] - lo) / step))
    bi := math.max(0, math.min(bins - 1, bi))
    array.set(buyB, bi, array.get(buyB, bi) + bV)
int b1i = 0
float maxB = 0.0
for b = 0 to bins - 1
    if array.get(buyB, b) > maxB
        maxB := array.get(buyB, b)
        b1i := b
float atr = ta.atr(14)
float pad = atr * 0.28
float bMid = lo + (b1i + 0.5) * step
float bLo = lo + b1i * step - pad
float bHi = lo + (b1i + 1) * step + pad
float netP = tB + tS > 0 ? tB / (tB + tS) * 100.0 : 50.0
float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)
bool inB1 = low <= bHi and high >= bLo
bool volBuy = sigOk and (inB1 or (close > bMid and close > open)) and netP >= volNetBuy and rvol >= 1.0
bool agree = toolBuy > 0 and volBuy

plot(showB1 ? bMid : na, "B1", color=color.new(color.lime, 30), linewidth=2)
bgcolor(agree ? color.new(color.lime, 92) : inB1 ? color.new(color.teal, 95) : na)
plotshape(agree, "TxV", shape.diamond, location.belowbar, color.lime, size=size.small)

var table tb = table.new(position.bottom_right, 1, 2, border_width=1)
if barstate.islast
    table.clear(tb, 0, 0, 0, 1)
    table.cell(tb, 0, 0, agree ? "✓ TOOLS × VOL" : toolBuy > 0 ? "Tools فقط" : volBuy ? "Vol فقط" : "—", text_color=agree ? color.lime : color.white, text_size=size.normal)
    table.cell(tb, 0, 1, "Score " + str.tostring(toolSc, "#") + "% · Net " + str.tostring(netP, "#") + "%", text_color=color.yellow, text_size=size.small)

plot(toolBuy, "EGXTxV_Tools", display=display.data_window)
plot(volBuy ? 1 : 0, "EGXTxV_Vol", display=display.data_window)
plot(agree ? 1 : 0, "EGXTxV_Agree", display=display.data_window)
plot(toolSc, "EGXTxV_Score", display=display.data_window)
plot(1, "EGXTxV", display=display.data_window)

alertcondition(agree, "EGX TxV — توافق", "{{ticker}} EGXTxV Agree")

//@version=6
indicator("EGX Volume Wyckoff — SC · BC · VSA", shorttitle="EGX VWyk", overlay=true, max_labels_count=150, max_tables_count=3, calc_bars_count=5000)

// وايكوف / VSA مبسّط — SC · BC · No Supply · No Demand · docs/EGX_VOLUME.md

string G = "VSA"
int volMa = input.int(20, "MA حجم", minval=5, group=G)
float rvolMin = input.float(1.6, "RVOL حد", minval=1.2, step=0.1, group=G)
int rangeLen = input.int(10, "نطاق مقارنة", minval=5, group=G)
bool showTbl = input.bool(true, "جدول", group=G)

float vma = ta.sma(volume, volMa)
float rvol = volume / math.max(vma, 1.0)
float rng = math.max(high - low, syminfo.mintick)
float cp = (close - low) / rng
float spread = rng / math.max(ta.sma(rng, rangeLen), syminfo.mintick)

bool ultra = rvol >= rvolMin
bool sc = ultra and cp >= 0.58 and low <= ta.lowest(low, rangeLen)
bool bc = ultra and cp <= 0.42 and high >= ta.highest(high, rangeLen)
bool noSupply = rvol < 0.7 and cp >= 0.55 and close > open and spread < 0.85
bool noDemand = rvol < 0.7 and cp <= 0.45 and close < open and spread < 0.85
bool stopping = ultra and spread > 1.3 and cp >= 0.5 and cp <= 0.65

string phase = sc ? "SC" : bc ? "BC" : stopping ? "Stop" : noSupply ? "NoSup" : noDemand ? "NoDem" : ultra ? "UltraV" : "—"

plotshape(sc, "SC", shape.triangleup, location.belowbar, color=color.lime, size=size.small, text="SC")
plotshape(bc, "BC", shape.triangledown, location.abovebar, color=color.red, size=size.small, text="BC")
plotshape(noSupply, "NS", shape.circle, location.belowbar, color=color.teal, size=size.tiny, text="NS")
plotshape(noDemand, "ND", shape.circle, location.abovebar, color=color.maroon, size=size.tiny, text="ND")
plotshape(stopping, "ST", shape.diamond, location.belowbar, color=color.yellow, size=size.tiny, text="ST")

bgcolor(sc ? color.new(color.lime, 92) : bc ? color.new(color.red, 92) : na)

var table t = table.new(position.top_left, 2, 4, border_width=1)
if showTbl and barstate.islast
    table.clear(t, 0, 0, 1, 3)
    table.cell(t, 0, 0, "Wyckoff", bgcolor=color.black, text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, phase, text_size=size.tiny)
    table.cell(t, 0, 1, "RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(rvol, "#.##"), text_size=size.tiny)

plot(sc ? 1 : 0, "EGVWk_SC", display=display.data_window)
plot(bc ? 1 : 0, "EGVWk_BC", display=display.data_window)

alertcondition(sc, "EGV SC", "Wyckoff SC")
alertcondition(bc, "EGV BC", "Wyckoff BC")

//@version=6
indicator("EGX قرار — سريع (بانر فقط)", shorttitle="EGX Q!", overlay=true, max_labels_count=20, calc_bars_count=5000)

// نفس منطق EGX_قرar.pine مبسّط — بانr واحد كبير · إطار D · PRO افتراضي

string mode = input.string("PRO موحّد", "نوع", options=["PRO موحّد", "عدّاء استثمار", "فلسي EGX", "EGX يومي"])
bool onClose = input.bool(true, "إغلاق الشمعة", group="EGX")
bool alertTelegram = input.bool(true, "Telegram (alert)", group="EGX")
bool alertJson = input.bool(false, "Webhook JSON", group="EGX")
bool useSession = input.bool(false, "فلتر الجلسة المستمرة 10:00–14:15", group="EGX")
bool inSession = not useSession or (hour >= 10 and hour < 14 or (hour == 14 and minute < 15))

bool proMode = mode == "PRO موحّد"
bool runnerMode = proMode or mode == "عدّاء استثمار" or mode == "فلسي EGX"
bool pennyMode = mode == "فلسي EGX"
float effVol = pennyMode ? 400.0 : mode == "EGX يومي" ? 1500.0 : 800.0
float effAcc = pennyMode ? 50.0 : 55.0
float effDist = pennyMode ? 52.0 : 50.0
float effRank = pennyMode ? 55.0 : mode == "EGX يومي" ? 62.0 : 58.0
float effRR = 1.5

bool sigOk = not onClose or barstate.isconfirmed

float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)
float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= effVol
float rvol = volume / math.max(volMa, 1.0)

float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 20) / ta.sma(volume, 20)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
float acc = math.min(100.0, (cmf > 0 and obvSl > 0 ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0))
float dist = math.min(100.0, (cmf < 0 and obvSl < 0 ? 35.0 : 0.0))

float hi252 = ta.highest(high, 252)
float lo252 = ta.lowest(low, 252)
float pctHi = hi252 > 0 ? (close - hi252) / hi252 * 100.0 : 0.0
float rocBase = lo252 > 0 ? (close / lo252 - 1.0) * 100.0 : 0.0
bool postCrashTrap = runnerMode and rocBase > 100 and pctHi < -28 and dist >= 38

float pl = ta.pivotlow(low, 8, 8)
var float swingLow = na
if not na(pl)
    swingLow := pl
bool supBreak = sigOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retest = sigOk and not na(swingLow) and low <= swingLow * 1.006 and close > swingLow

float buyTop = nz(swingLow, low) + atr * 0.35
float buyBot = nz(swingLow, low) - atr * 0.42
bool atZone = low <= buyTop and close >= buyBot

float t1 = close + atr * 2.5
float entryPx = (buyTop + buyBot) / 2.0
float stopPx = buyBot - atr * 0.6
float rr = (t1 - entryPx) / math.max(entryPx - stopPx, syminfo.mintick)

bool chase = pctHi > -3 and rsi > 72
float dayPctQ = close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0
float haltWarnQ = pennyMode ? 4.5 : 9.0
float luldWarnQ = pennyMode ? 9.75 : 19.75
bool nearLimit = dayPctQ >= haltWarnQ or dayPctQ >= luldWarnQ

int cycle = acc >= effAcc ? 4 : 3
if dist >= 55
    cycle := 9
if supBreak
    cycle := 11

float rank = math.min(100.0, acc * 0.5 + (100.0 - dist) * 0.3 + (atZone ? 15.0 : 0.0))

bool canBuy = sigOk and inSession and liqOk and acc >= effAcc and dist < effDist and (atZone or retest) and not supBreak and not chase and not postCrashTrap and not nearLimit and rr >= effRR and rank >= effRank and (runnerMode ? cycle >= 4 and cycle <= 7 : retest)
bool squeezeOn = atr < ta.sma(atr, 14) * 0.85
float runnerDna = runnerMode ? math.min(100.0, (cycle <= 7 ? 15.0 : 0.0) + (acc >= 55 ? 25.0 : 0.0) + (dist < 45 ? 15.0 : 0.0) + (squeezeOn ? 10.0 : 0.0)) : na
bool quickUltra = runnerMode and canBuy and runnerDna >= 55
bool mustExit = sigOk and (supBreak or dist >= 65 or postCrashTrap or cycle == 9)
bool canWait = sigOk and not canBuy and not mustExit and acc >= 45 and dist < 52

int action = mustExit ? 0 : canBuy ? 4 : canWait ? 2 : 1
string verdict = mustExit ? "🛑 خروج" : postCrashTrap ? "🟠 فخ سقوط" : chase ? "🟠 مطاردة" : canBuy ? "🟢 شراء" : canWait ? "🟡 انتظر منطقة" : "⛔ لا شراء"
string sub = "R" + str.tostring(rank, "#") + " · تجم " + str.tostring(acc, "#") + " · RR " + str.tostring(rr, "#.#") + (runnerMode ? " · DNA " + str.tostring(runnerDna, "#") + (quickUltra ? " Ultra" : "") : "")
color col = canBuy ? color.lime : mustExit ? color.red : canWait ? color.yellow : color.gray

var table ban = table.new(position.bottom_center, 1, 2, bgcolor=color.new(color.black, 8), border_width=2)
if barstate.islast
    table.clear(ban, 0, 0, 0, 1)
    table.cell(ban, 0, 0, syminfo.ticker + "\n" + verdict, bgcolor=color.new(col, 70), text_color=color.white, text_size=size.large)
    table.cell(ban, 0, 1, sub + (runnerMode ? " · دورة " + str.tostring(cycle) : ""), bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.small)

bgcolor(canBuy ? color.new(color.lime, 97) : mustExit ? color.new(color.red, 97) : na)

plot(action, "EGXQ_Action", display=display.data_window)
plot(canBuy ? 1 : 0, "EGXQ_Buy", display=display.data_window)
plot(mustExit ? 1 : 0, "EGXQ_Exit", display=display.data_window)
plot(rank, "EGXQ_Rank", display=display.data_window)
plot(postCrashTrap ? 1 : 0, "EGXQ_CrashTrap", display=display.data_window)
plot(1, "EGXQ_Qarar", display=display.data_window)
plot(1, "EGXQQ_Quick", display=display.data_window)
plot(quickUltra ? 1 : 0, "EGXQ_ScreenerUltra", display=display.data_window)
plot(runnerMode ? runnerDna : na, "EGXQ_DNA", display=display.data_window)

if alertTelegram and sigOk and canBuy
    alert("EGX ✅ " + syminfo.ticker + "\n" + verdict + "\n" + sub + "\nدخول ~" + str.tostring(entryPx, format.mintick) + " SL " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)
if alertTelegram and sigOk and mustExit
    alert("EGX 🛑 " + syminfo.ticker + "\n" + verdict, alert.freq_once_per_bar_close)
if alertJson and sigOk and canBuy
    alert('{"ev":"buy","sym":"' + syminfo.ticker + '","rank":' + str.tostring(rank, "#.#") + ',"dna":' + str.tostring(runnerDna, "#") + ',"entry":' + str.tostring(entryPx, format.mintick) + '}', alert.freq_once_per_bar_close)

alertcondition(quickUltra, "EGX Q! — Ultra", "{{ticker}}: Ultra شراء")
alertcondition(canBuy, "EGX Q! — شراء", "{{ticker}}: {{close}} — شراء")
alertcondition(mustExit, "EGX Q! — خروج", "{{ticker}}: خروج")

//@version=6
indicator("EGX الخلاصة — قرار نهائي", shorttitle="EGX خلاصة", overlay=true, max_labels_count=80, max_lines_count=80, max_boxes_count=20, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// EGX الخلاصة v1.1 — قرار واحد على الشارت (مختصر من docs/EGX_الخلاصة.md)
// منطق: BEST + أولوية primaryDec + بوابات 10 + ماسح Pro
// للتحليل الكامل: pine/EGX_الاخير.pine · باك‌تست: pine/EGX_الخلاصة_STRATEGY.pine
// ماسح خفيف: EGX_SCREENER.pine · فوليوم: EGX_VOLUME_MASTER.pine · docs/EGX_VOLUME.md
// Screener: EGXKh_ScreenerPro = 1 · أو EGXKh_BuyFlag = 1 · EGXKh_Rank ≥ 65
// ═══════════════════════════════════════════════════════════════════════════════

string G_PROF = "═══ ملف EGX ═══"
string profile = input.string("EGX قياسي", "الملف", options=["EGX قياسي", "مضاربة 15د", "استثمار يومي", "جلسة 15/60د", "مخصص"], group=G_PROF)

string G_CORE = "═══ قرار ═══"
int pivotLen = input.int(8, "محور swing", minval=3, maxval=15, group=G_CORE)
int volMaLen = input.int(20, "متوسط حجم", minval=5, group=G_CORE)
float minAvgVolIn = input.float(1500.0, "حد أدنى متوسط حجم", minval=0, group=G_CORE)
float minRRIn = input.float(1.5, "حد R/R", minval=1.0, step=0.1, group=G_CORE)
float minScoreIn = input.float(58.0, "حد تقييم /100", minval=40, maxval=90, group=G_CORE)
float minRankIn = input.float(65.0, "حد رتبة للماسح", minval=0, maxval=100, group=G_CORE)
float minOppIn = input.float(68.0, "حد فرصة Pro", minval=45, maxval=90, group=G_CORE)
int minSetupIn = input.int(7, "حد إعداد (/11)", minval=0, maxval=11, group=G_CORE)
int minGatesIn = input.int(8, "حد بوابات (/10)", minval=0, maxval=10, group=G_CORE)
bool confirmClose = input.bool(true, "قرار عند إغلاق الشمعة", group=G_CORE)
float zoneAtr = input.float(0.35, "عرض منطقة × ATR", minval=0.15, step=0.05, group=G_CORE)
float bottomDropPct = input.float(12.0, "قاع: هبوط % من قمة 252", minval=5.0, step=1.0, group=G_CORE)

string G_VOLZ = "═══ فوليوم B1 (proxy) ═══"
string volMode = input.string("تعزيز فقط", "دمج B1", options=["إيقاف", "تعزيز فقط", "بوابة Pro"], group=G_VOLZ)
int volZoneLook = input.int(400, "نافذة B1", minval=80, maxval=1200, group=G_VOLZ)
float volNetBuyMin = input.float(52.0, "Net buy % ≥", minval=45, maxval=60, group=G_VOLZ)
bool showVolB1Line = input.bool(false, "خط B1 على الشارت", group=G_VOLZ)

string G_EGX = "═══ بورصة EGX ═══"
string mktSym = input.symbol("EGX:EGX30", "مؤشر EGX30", group=G_EGX)
string sectorSym = input.symbol("", "مؤشر قطاع (اختياري)", group=G_EGX)
bool useSectorRs = input.bool(false, "RS vs قطاع في الجدول", group=G_EGX)
bool blockBearMkt = input.bool(true, "منع شراء — ضغط EGX30", group=G_EGX)
bool blockLimitUp = input.bool(true, "منع شراء قرب halt اليومي", group=G_EGX)
float limitPct = input.float(9.0, "تحذير halt %", minval=3, maxval=10, step=0.5, group=G_EGX)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G_EGX)
bool skipSundayBuy = input.bool(false, "لا دخول يوم الأحد", group=G_EGX)
int breakConfirmBars = input.int(2, "إغلاقات لتأكيد الاختراق", minval=1, maxval=5, group=G_EGX)
bool skipOffHours = input.bool(false, "لا دخول خارج المستمر 10:00–14:15", group=G_EGX)
bool useMktHalt100 = input.bool(true, "منع شراء إذا EGX100 ≤ −10%", group=G_EGX)
string mkt100 = input.symbol("EGX:EGX100EWI", "EGX100", group=G_EGX)
bool useEgxSession = input.bool(false, "شراء داخل جلسة EGX فقط", group=G_EGX)
string egxTz = input.string("Africa/Cairo", "المنطقة الزمنية", group=G_EGX)
float riskPctEq = input.float(1.5, "مخاطرة % محفظة", minval=0.5, maxval=3.0, step=0.1, group=G_EGX)
float partCapPct = input.float(8.0, "سقف ADV 20 يوم %", minval=2, maxval=15, group=G_EGX)
float tBillAfterTax = input.float(20.0, "عقبة أذون بعد الضريبة %", minval=0, maxval=40, group=G_EGX)
int holdDaysHurdle = input.int(30, "أفق الاحتفاظ (يوم)", minval=5, maxval=365, group=G_EGX)
bool usdEarner = input.bool(false, "إيراد بالدولار", group=G_EGX)
bool gateHurdle = input.bool(false, "منع إن T1 < أذون", group=G_EGX)
int earningsBars = input.int(0, "أرباح خلال N شموع (0=إيقاف)", minval=0, maxval=60, group=G_EGX)
bool blockEarnings = input.bool(true, "منع قرب الأرباح", group=G_EGX)
float brokerTp = input.float(0.0, "هدف وسيط (0=إيقاف)", minval=0, group=G_EGX)
bool blockAboveTp = input.bool(true, "منع فوق هدف الوسيط", group=G_EGX)

string G_UI = "═══ عرض ═══"
bool beginnerMode = input.bool(false, "وضع مبتدئ (بانر + 3 أرقام فقط)", group=G_UI)
bool showBanner = input.bool(true, "بانر قرار (أسفل يسار)", group=G_UI)
bool showHud = input.bool(true, "لوحة سريعة (أعلى يسار)", group=G_UI)
bool showTable = input.bool(true, "جدول (يمين)", group=G_UI)
bool showMissing = input.bool(true, "صف «شروط ناقصة»", group=G_UI)
bool showLevels = input.bool(true, "دخول · وقف · T1", group=G_UI)
bool showMark = input.bool(true, "علامة عند شراء نهائي", group=G_UI)

bool profCustom = profile == "مخصص"
bool profSession = profile == "جلسة 15/60د"
float effMinVol = profCustom ? minAvgVolIn : profile == "مضاربة 15د" or profSession ? 3000.0 : profile == "استثمار يومي" ? 800.0 : 1500.0
float effMinRR = profCustom ? minRRIn : 1.5
float effMinScore = profCustom ? minScoreIn : profile == "مضاربة 15د" ? 60.0 : 58.0
float effMinRank = profCustom ? minRankIn : profile == "استثمار يومي" ? 60.0 : 65.0
float effMinOpp = profCustom ? minOppIn : profile == "استثمار يومي" ? 62.0 : 68.0
int effMinSetup = profCustom ? minSetupIn : 7
int effMinGates = profCustom ? minGatesIn : 8
bool effSessionFilter = profSession or useEgxSession

bool sigOk = not confirmClose or barstate.isconfirmed
int egxSessId = 0
if not na(time(timeframe.period, "0830-1000:23456", egxTz))
    egxSessId := 1
if not na(time(timeframe.period, "1000-1415:23456", egxTz))
    egxSessId := 2
if not na(time(timeframe.period, "1415-1425:23456", egxTz))
    egxSessId := 3
if not na(time(timeframe.period, "1425-1430:23456", egxTz))
    egxSessId := 4
bool inEgxSession = not effSessionFilter or not timeframe.isintraday or egxSessId >= 1
bool sessionEntryOk = not skipOffHours or not timeframe.isintraday or egxSessId == 2
bool sundaySkip = skipSundayBuy and dayofweek == dayofweek.sunday

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
bool bullStack = ema9 > ema21 and ema21 > ema50
bool bearStack = ema9 < ema21 and ema21 < ema50
bool above200 = close > ema200

float wClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
float wEma200 = request.security(syminfo.tickerid, "W", ta.ema(close, 200), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = wClose > wEma50 and wEma50 > wEma200

f_tfBull(string tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)

int mtfBias = 0
mtfBias += f_tfBull("15") ? 1 : -1
mtfBias += f_tfBull("60") ? 1 : -1
mtfBias += f_tfBull("D") ? 1 : -1
mtfBias += f_tfBull("W") ? 1 : -1
bool mtfOk = mtfBias >= 1

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdBull = macdH > 0 and macdL > macdS
float rsi = ta.rsi(close, 14)
float atr = ta.atr(14)

float volMa = ta.sma(volume, volMaLen)
bool liqOk = volMa >= effMinVol
float rvol = volume / math.max(volMa, 1.0)
bool rvolStrong = rvol >= 1.5

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 14) / ta.sma(volume, 14)
float obv = ta.obv
float obvSlope = ta.linreg(obv, 10, 0) - ta.linreg(obv, 10, 1)
bool accumulating = cmf > 0 and obvSlope > 0
bool distributing = cmf < 0 and obvSlope < 0

float accumScore = math.min(100.0, (accumulating ? 15.0 : 0.0) + (cmf > 0.05 ? 10.0 : 0.0) + (obvSlope > 0 ? 10.0 : 0.0) + (rvol >= 1.0 and close > open ? 10.0 : 0.0))
float distRisk = math.min(100.0, (distributing ? 15.0 : 0.0) + (cmf < -0.05 ? 10.0 : 0.0) + (obvSlope < 0 ? 10.0 : 0.0))

f_khBuyVol(int off) =>
    float r = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / r

f_khB1() =>
    int bins = 24
    int n = math.min(volZoneLook, bar_index)
    float hi = ta.highest(high, n)
    float lo = ta.lowest(low, n)
    float step = (hi - lo) / math.max(bins, 1)
    step := step <= syminfo.mintick ? syminfo.mintick : step
    array<float> buyB = array.new_float(bins, 0.0)
    float tB = 0.0
    float tS = 0.0
    for i = 0 to n - 1
        float bV = f_khBuyVol(i)
        float sV = volume[i] - bV
        tB += bV
        tS += sV
        int bi = int(math.floor((close[i] - lo) / step))
        bi := math.max(0, math.min(bins - 1, bi))
        array.set(buyB, bi, array.get(buyB, bi) + bV)
    float maxB = 0.0
    int b1i = 0
    for b = 0 to bins - 1
        if array.get(buyB, b) > maxB
            maxB := array.get(buyB, b)
            b1i := b
    float p = atr * 0.28
    float bLo = lo + b1i * step - p
    float bHi = lo + (b1i + 1) * step + p
    float bMid = lo + (b1i + 0.5) * step
    float netP = tB + tS > 0 ? tB / (tB + tS) * 100.0 : 50.0
    [bLo, bHi, bMid, netP]

[b1LoKh, b1HiKh, b1MidKh, netBuyVolKh] = volMode == "إيقاف" ? [na, na, na, 50.0] : f_khB1()
bool inB1Kh = volMode != "إيقاف" and low <= b1HiKh and high >= b1LoKh
bool b1BounceKh = volMode != "إيقاف" and inB1Kh and close > open and rvol >= 1.0 and close > b1MidKh
bool volProOk = volMode != "إيقاف" and (inB1Kh or b1BounceKh) and netBuyVolKh >= volNetBuyMin and distRisk < 55
bool volBoost = volMode == "تعزيز فقط" and volProOk

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc

f_mktMom() =>
    close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0

int tr30 = request.security(mktSym, timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
float mom30 = request.security(mktSym, timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off)
float benchRoc = request.security(mktSym, timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
bool rsLeader = ta.roc(close, 20) - benchRoc > 0
float sectorRoc = useSectorRs and sectorSym != "" ? request.security(sectorSym, timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : na
float rsSector = useSectorRs and not na(sectorRoc) ? ta.roc(close, 20) - sectorRoc : na
bool rsSectorLeader = useSectorRs and not na(rsSector) and rsSector > 0
bool heavySell = mom30 < -4.0 and tr30 <= -1
bool bearRegimeBlock = blockBearMkt and heavySell

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
float haltWarnPct = math.min(limitPct, math.max(haltPct - 1.0, haltPct * 0.9))
bool nearHaltUp = blockLimitUp and dPrev > 0 and dayPct >= haltWarnPct
bool atLuldUp = dPrev > 0 and dayPct >= luldPct - 0.25
bool nearLimitUp = nearHaltUp or atLuldUp
float dayPct100 = useMktHalt100 ? request.security(mkt100, "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool regimeOkKh = not bearRegimeBlock and not mktHalt100

float dHi = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
float dLo = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)
float dCl = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float pp = (dHi + dLo + dCl) / 3.0
float s1 = 2.0 * pp - dHi

float pl = ta.pivotlow(low, pivotLen, pivotLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
var float swingLow = na
var float swingHigh = na
if not na(pl)
    swingLow := pl
if not na(ph)
    swingHigh := ph

int structP = 5
float phs = ta.pivothigh(high, structP, structP)
var float actHigh = na
var int structDir = 0
if not na(phs)
    actHigh := phs
bool bullBreak = sigOk and not na(actHigh) and close > actHigh and close[1] <= actHigh
if bullBreak
    structDir := 1
    actHigh := na

bool supportBreak = sigOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retestSupport = sigOk and not na(swingLow) and low <= swingLow * 1.005 and close > swingLow
bool fakeBreakUp = sigOk and not na(swingHigh) and high > swingHigh and close < swingHigh and rvol > 1.05
bool rawBreak = bullBreak and rvol >= 1.2
var float brkHoldLvl = na
var int brkHoldBars = 0
if barstate.isconfirmed
    if rawBreak
        brkHoldLvl := nz(swingHigh, close[1])
        brkHoldBars := 1
    else if not na(brkHoldLvl) and close > brkHoldLvl
        brkHoldBars += 1
    else
        brkHoldLvl := na
        brkHoldBars := 0
bool breakConfirmed = sigOk and not na(brkHoldLvl) and brkHoldBars >= breakConfirmBars and (rvol >= 1.2 or rvol[1] >= 1.2)
bool breakRetest = retestSupport and structDir == 1 and not fakeBreakUp

float zw = atr * zoneAtr
float buyTop = nz(swingLow, low) + zw
float buyBot = nz(swingLow, low) - zw * 1.2
float sellBot = nz(swingHigh, high) - zw
float sellTop = nz(swingHigh, high) + zw * 1.2
bool inBuyZone = low <= buyTop and high >= buyBot
bool nearSupport = low <= buyTop and close >= buyBot
bool nearResist = high >= sellBot and close <= sellTop
bool nearDaySup = low <= s1 * 1.002 and close <= pp * 1.002
bool nearVwapBand = timeframe.isintraday and low <= ta.vwap(hlc3) and close >= ta.vwap(hlc3) - atr * 0.35

float swingRange = nz(swingHigh - swingLow, atr * 3)
float t1 = na(swingHigh) ? close + atr * 1.5 : swingHigh
float entryPx = (buyTop + buyBot) / 2.0
float stopPx = buyBot - atr * 0.5
float riskPx = math.max(entryPx - stopPx, syminfo.mintick)
float rr = riskPx > 0 ? (t1 - entryPx) / riskPx : na
float tHalf = entryPx + (t1 - entryPx) * 0.5

float hi252 = ta.highest(high, 252)
float dropFromHi = hi252 > 0 ? (hi252 - close) / hi252 * 100.0 : 0.0
bool extended52 = hi252 > 0 and (close - hi252) / hi252 * 100.0 > -3.0
bool chaseWarn = extended52 and rsi > 72 and not na(rr) and rr < 1.0

bool sellingClimax = rvol >= 1.8 and (close - low) >= (high - low) * 0.55 and close >= open
bool bottomZone = dropFromHi >= bottomDropPct and nearSupport
bool bottomConfirm = sigOk and bottomZone and (sellingClimax or retestSupport) and not distributing

float score = 0.0
score += bullStack ? 20.0 : bearStack ? -10.0 : 0.0
score += above200 ? 15.0 : -5.0
score += htfBull ? 15.0 : -10.0
score += macdBull ? 10.0 : 0.0
score += accumulating ? 15.0 : distributing ? -10.0 : 0.0
score += rvol >= 1.0 ? 10.0 : 0.0
score += rsi > 40 and rsi < 70 ? 10.0 : 0.0
score += mtfOk ? 5.0 : -4.0
score += rsLeader ? 5.0 : 0.0
score += accumScore >= 35 ? 5.0 : 0.0
score += distRisk >= 35 ? -8.0 : 0.0
score += volBoost ? 6.0 : 0.0
score += b1BounceKh ? 4.0 : 0.0
score := math.max(0.0, math.min(100.0, score))

int setupHits = 0
setupHits += bullStack ? 1 : 0
setupHits += htfBull ? 1 : 0
setupHits += macdBull ? 1 : 0
setupHits += accumulating ? 1 : 0
setupHits += rsLeader ? 1 : 0
setupHits += structDir == 1 ? 1 : 0
setupHits += inBuyZone ? 1 : 0
setupHits += retestSupport ? 1 : 0
setupHits += not na(rr) and rr >= effMinRR ? 1 : 0
setupHits += mtfOk ? 1 : 0
setupHits += rvolStrong or rvol >= 1.0 ? 1 : 0
setupHits += breakRetest or breakConfirmed ? 1 : 0
setupHits += volProOk ? 1 : 0

string setupTier = setupHits >= 9 ? "A" : setupHits >= 7 ? "B" : setupHits >= 5 ? "C" : "D"
int setupTierNum = setupTier == "A" ? 4 : setupTier == "B" ? 3 : setupTier == "C" ? 2 : 1
bool setupOk = effMinSetup <= 0 or setupHits >= effMinSetup

float egxRank = math.max(0.0, math.min(100.0, score * 0.55 + mtfBias * 3.0 + setupHits / 11.0 * 25.0))

float opportunity = math.max(0.0, math.min(100.0, score * 0.35 + setupHits / 11.0 * 100.0 * 0.25 + accumScore * 0.2 + (not na(rr) ? math.min(100.0, rr / 3.0 * 100.0) * 0.12 : 0.0) + (mtfOk ? 8.0 : 0.0)))
bool oppStrong = opportunity >= effMinOpp and setupHits >= 7 and distRisk < 55

bool buyZoneActive = not supportBreak and liqOk and mtfOk and score >= 55 and not na(rr) and rr >= effMinRR and mtfBias >= 0 and score >= effMinScore and distRisk < 65 and not bearRegimeBlock and not nearLimitUp and not chaseWarn

bool gateEntry = nearSupport or breakRetest or nearDaySup or (nearVwapBand and inBuyZone) or retestSupport and inBuyZone
int gatesPass = (liqOk ? 1 : 0) + (mtfOk ? 1 : 0) + (mtfBias >= 0 ? 1 : 0) + (not na(rr) and rr >= effMinRR ? 1 : 0) + (setupOk ? 1 : 0) + (not bearRegimeBlock ? 1 : 0) + (not chaseWarn ? 1 : 0) + (distRisk < 65 ? 1 : 0) + (accumScore >= 40 ? 1 : 0) + (gateEntry ? 1 : 0)
bool gatesOk = effMinGates <= 0 or gatesPass >= effMinGates

float t1PctH = close > 0 ? (t1 - close) / close * 100.0 : 0.0
bool hurdleOk = not gateHurdle or usdEarner or t1PctH >= tBillAfterTax * holdDaysHurdle / 365.0
bool earningsOk = not blockEarnings or earningsBars <= 0 or earningsBars > 5
bool tpOk = not blockAboveTp or brokerTp <= 0 or close < brokerTp * 0.98
bool microOk = inEgxSession and sessionEntryOk and not sundaySkip and not mktHalt100 and hurdleOk and earningsOk and tpOk
bool buyConfluence = sigOk and buyZoneActive and setupOk and gateEntry and not bearRegimeBlock and not nearLimitUp and not chaseWarn and microOk

bool sellConfluence = sigOk and score <= 42 and bearStack and (nearResist or distributing) and distRisk >= 40

string primaryDec = supportBreak ? "🔴 كسر دعم" : chaseWarn and not buyConfluence ? "🟠 مطاردة" : bottomConfirm and buyConfluence and b1BounceKh ? "🟢 قاع+B1↑" : bottomConfirm and buyConfluence ? "🟢 قاع+شراء" : bottomConfirm ? "🟢 قاع — تأكيد" : buyConfluence and b1BounceKh ? "🟢 شراء B1↑" : buyConfluence ? "🟢 شراء" : breakConfirmed ? "🟢 اختراق" : sellConfluence ? "🟠 حذر/مقاومة" : volProOk and buyZoneActive ? "🟡 B1 — جاهز" : buyZoneActive and gatesPass >= 8 ? "🟡 جاهز — انتظر لمس" : score >= effMinScore ? "🟡 تراكم/مضاربة" : score >= 50 ? "⚪ راقب" : "⚪ ضعيف"
color decCol = supportBreak ? color.red : buyConfluence or bottomConfirm ? color.lime : chaseWarn or sellConfluence or nearLimitUp ? color.orange : buyZoneActive ? color.yellow : color.gray

string actionFinal = supportBreak or sellConfluence ? "تجنّب / خروج" : buyConfluence ? "تنفيذ — شراء" : nearLimitUp or chaseWarn or bearRegimeBlock ? "لا شراء" : buyZoneActive and gatesPass >= 8 ? "انتظر تأكيد مكان" : "لا فعل"

bool screenerPass = buyConfluence and egxRank >= effMinRank and setupTierNum >= 3 and not na(rr) and rr >= effMinRR and liqOk and gatesOk
bool screenerPro = screenerPass and oppStrong and gatesPass >= effMinGates and (volMode != "بوابة Pro" or volProOk)
bool screenerVolPro = screenerPro and volProOk

int finalCode = buyConfluence ? 5 : breakConfirmed ? 4 : buyZoneActive and gatesPass >= 8 ? 3 : score >= 50 ? 2 : supportBreak ? 0 : 1

string missingTxt = ""
missingTxt += bullStack ? "" : "· EMA "
missingTxt += htfBull ? "" : "· HTF "
missingTxt += macdBull ? "" : "· MACD "
missingTxt += accumulating ? "" : "· تجم "
missingTxt += rsLeader ? "" : "· RS30 "
missingTxt += setupOk ? "" : "· إعداد "
missingTxt += not na(rr) and rr >= effMinRR ? "" : "· R/R "
missingTxt += mtfOk ? "" : "· MTF "
missingTxt += gateEntry ? "" : "· منطقة "
missingTxt += not bearRegimeBlock ? "" : "· سوق "
missingTxt += not nearLimitUp ? "" : "· halt/LULD "
missingTxt += not chaseWarn ? "" : "· مطاردة "
missingTxt += inEgxSession ? "" : "· جلسة "
missingTxt += liqOk ? "" : "· حجم "
missingTxt += volMode == "إيقاف" or volProOk ? "" : "· B1 "
if missingTxt == ""
    missingTxt := "— جاهز تقريباً"

bool effBanner = showBanner and not beginnerMode
bool effHud = showHud and not beginnerMode
bool effTable = showTable and not beginnerMode
bool effLevels = showLevels and not beginnerMode

plot(effLevels ? entryPx : na, "دخول", color=color.new(color.lime, 45), style=plot.style_linebr)
plot(effLevels ? stopPx : na, "وقف", color=color.new(color.red, 35), linewidth=2, style=plot.style_linebr)
plot(effLevels ? t1 : na, "T1", color=color.new(color.aqua, 30), style=plot.style_linebr)
plot(showVolB1Line and volMode != "إيقاف" ? b1MidKh : na, "B1 vol", color=color.new(color.teal, 45), linewidth=2, style=plot.style_linebr)

plotshape(showMark and buyConfluence, "شراء نهائي", shape.circle, location.belowbar, color.lime, size=size.normal, text="شراء")

var table hud = table.new(position.top_left, 1, 4, bgcolor=color.new(color.black, 82), border_width=1)
if effHud and barstate.islast
    table.clear(hud, 0, 0, 0, 3)
    table.cell(hud, 0, 0, primaryDec, bgcolor=color.new(decCol, 75), text_color=color.white, text_size=size.normal)
    table.cell(hud, 0, 1, actionFinal, text_color=actionFinal == "تنفيذ — شراء" ? color.lime : color.yellow, text_size=size.small)
    table.cell(hud, 0, 2, "R" + str.tostring(egxRank, "#") + " · " + setupTier + " · R/R " + str.tostring(rr, "#.#") + " · بوابات " + str.tostring(gatesPass) + "/10", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 0, 3, screenerPro ? "✓ ماسح Pro" : screenerPass ? "✓ ماسح" : "—", text_color=screenerPro or screenerPass ? color.lime : color.gray, text_size=size.tiny)

var table tbl = table.new(position.top_right, 2, 14, bgcolor=color.new(color.black, 85), border_width=1)
if effTable and barstate.islast
    table.clear(tbl, 0, 0, 1, 13)
    table.cell(tbl, 0, 0, "EGX الخلاصة", text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, 0, profile, text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, "قرار", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 1, primaryDec, text_color=decCol, text_size=size.small)
    table.cell(tbl, 0, 2, "فعل", text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 2, actionFinal, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "تقييم / فرصة", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(score, "#") + " · Opp " + str.tostring(opportunity, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "إعداد", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, setupTier + " " + str.tostring(setupHits) + "/11", text_color=setupTier == "A" or setupTier == "B" ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 5, "فوليوم", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 5, "RVOL " + str.tostring(rvol, "#.##") + " · Net " + str.tostring(netBuyVolKh, "#") + "% · B1 " + (inB1Kh ? "✓" : "—"), text_color=inB1Kh ? color.lime : color.white, text_size=size.tiny)
    table.cell(tbl, 0, 6, "EGX30 / يوم", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 6, (heavySell ? "ضغط" : "OK") + " · " + str.tostring(dayPct, "#.#") + "%", text_color=heavySell or nearLimitUp ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 7, "دخول / وقف / T1", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 7, str.tostring(entryPx, format.mintick) + " · " + str.tostring(stopPx, format.mintick) + " · " + str.tostring(t1, format.mintick), text_color=color.lime, text_size=size.tiny)
    table.cell(tbl, 0, 8, "جني 50%", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 8, str.tostring(tHalf, format.mintick), text_color=color.yellow, text_size=size.tiny)
    table.cell(tbl, 0, 9, "Veto", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 9, (supportBreak ? "كسر " : "") + (nearLimitUp ? "halt " : "") + (chaseWarn ? "مطاردة " : "") + (bearRegimeBlock ? "سوق " : "") + (not liqOk ? "حجم" : liqOk and not supportBreak and not nearLimitUp and not chaseWarn and not bearRegimeBlock ? "—" : ""), text_color=color.orange, text_size=size.tiny)
    table.cell(tbl, 0, 10, "اختراق", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 10, breakConfirmed ? "مؤكد" : breakRetest ? "retest" : "—", text_color=breakConfirmed ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 11, "ماسح", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 11, screenerPro ? "Pro ✓" : screenerPass ? "Pass ✓" : "—", text_color=screenerPro ? color.lime : color.gray, text_size=size.tiny)
    if showMissing
        table.cell(tbl, 0, 12, "ناقص", text_color=color.gray, text_size=size.tiny)
        table.cell(tbl, 1, 12, missingTxt, text_color=color.orange, text_size=size.tiny)
    if useSectorRs and not na(rsSector)
        table.cell(tbl, 0, 13, "RS قطاع", text_color=color.gray, text_size=size.tiny)
        table.cell(tbl, 1, 13, str.tostring(rsSector, "#.#") + "% " + (rsSectorLeader ? "↑" : "↓"), text_color=rsSectorLeader ? color.lime : color.orange, text_size=size.tiny)

var table begBanner = table.new(position.bottom_left, 1, 2, bgcolor=color.new(color.black, 5), border_width=2)
if beginnerMode and showBanner and barstate.islast
    table.clear(begBanner, 0, 0, 0, 1)
    table.cell(begBanner, 0, 0, primaryDec, bgcolor=color.new(decCol, 72), text_color=color.white, text_size=size.large)
    table.cell(begBanner, 0, 1, "R" + str.tostring(egxRank, "#") + " · R/R " + str.tostring(rr, "#.#") + " · " + actionFinal, bgcolor=color.new(color.gray, 88), text_color=color.yellow, text_size=size.normal)

var table banner = table.new(position.bottom_left, 1, 3, bgcolor=color.new(color.black, 5), border_width=2)
if effBanner and barstate.islast
    table.clear(banner, 0, 0, 0, 2)
    table.cell(banner, 0, 0, primaryDec + "  →  " + actionFinal, bgcolor=color.new(decCol, 72), text_color=color.white, text_size=size.large)
    table.cell(banner, 0, 1, "دخول " + str.tostring(entryPx, format.mintick) + " · وقف " + str.tostring(stopPx, format.mintick) + " · R/R " + str.tostring(rr, "#.##"), bgcolor=color.new(color.gray, 86), text_color=color.white, text_size=size.small)
    table.cell(banner, 0, 2, "T1 " + str.tostring(t1, format.mintick) + " · 50% " + str.tostring(tHalf, format.mintick) + " · بوابات " + str.tostring(gatesPass) + "/10 · Opp " + str.tostring(opportunity, "#"), bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=size.tiny)

plot(buyConfluence ? 1 : 0, "EGXKh_BuyFlag", display=display.data_window)
plot(egxRank, "EGXKh_Rank", display=display.data_window)
plot(rr, "EGXKh_RR", display=display.data_window)
plot(setupHits, "EGXKh_SetupHits", display=display.data_window)
plot(setupTierNum, "EGXKh_SetupTier", display=display.data_window)
plot(gatesPass, "EGXKh_GatesPass", display=display.data_window)
plot(opportunity, "EGXKh_Opportunity", display=display.data_window)
plot(screenerPass ? 1 : 0, "EGXKh_ScreenerPass", display=display.data_window)
plot(screenerPro ? 1 : 0, "EGXKh_ScreenerPro", display=display.data_window)
plot(finalCode, "EGXKh_FinalCode", display=display.data_window)
plot(1, "EGXKh", display=display.data_window)
plot(accumScore, "EGXKh_AccScore", display=display.data_window)
plot(distRisk, "EGXKh_DistRisk", display=display.data_window)
plot(supportBreak ? 1 : 0, "EGXKh_SupportBreak", display=display.data_window)
plot(nearLimitUp ? 1 : 0, "EGXKh_LimitBlock", display=display.data_window)
plot(mktHalt100 ? 1 : 0, "EGXKh_MktHalt100", display=display.data_window)
plot(regimeOkKh ? 1 : 0, "EGX_RegimeOk", display=display.all)
plot(egxSessId, "EGXKh_SessId", display=display.data_window)
plot(sundaySkip ? 1 : 0, "EGXKh_SundaySkip", display=display.data_window)
plot(hurdleOk ? 1 : 0, "EGXKh_HurdleOk", display=display.data_window)
plot(math.min(15.0, riskPctEq * close / math.max(close - stopPx, syminfo.mintick)), "EGXKh_PosPctRisk", display=display.data_window)
plot(chaseWarn ? 1 : 0, "EGXKh_ChaseWarn", display=display.data_window)
plot(volProOk ? 1 : 0, "EGXKh_VolPro", display=display.data_window)
plot(inB1Kh ? 1 : 0, "EGXKh_InB1", display=display.data_window)
plot(netBuyVolKh, "EGXKh_NetBuyVol", display=display.data_window)
plot(b1BounceKh ? 1 : 0, "EGXKh_B1Bounce", display=display.data_window)
plot(screenerVolPro ? 1 : 0, "EGXKh_VolScreenerPro", display=display.data_window)

alertcondition(buyConfluence and b1BounceKh, "EGX خلاصة — شراء B1", "EGX الخلاصة: 🟢 شراء + B1 bounce")
alertcondition(buyConfluence, "EGX خلاصة — شراء نهائي", "EGX الخلاصة: 🟢 شراء — راجع الدخول والوقف")
alertcondition(screenerPro, "EGX خلاصة — ماسح Pro", "EGX الخلاصة: نجاح ماسح Pro")
alertcondition(supportBreak, "EGX خلاصة — كسر دعم", "EGX الخلاصة: 🔴 كسر دعم — تجنّب")
alertcondition(chaseWarn and sigOk, "EGX خلاصة — مطاردة", "EGX الخلاصة: 🟠 مطاردة — لا شراء")

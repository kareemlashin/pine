//@version=6
indicator("EGX TOOLS — Rank 6", shorttitle="EGX T WL", overlay=false, max_tables_count=2, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// 6 رموز — Score lite (D) · EGXTTWL_* · MASTER كامل: EGX_TOOLS_MASTER
// ═══════════════════════════════════════════════════════════════════════════════

string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
string G = "رموز"
string s1 = input.symbol("EGX:COMI", "1", group=G)
string s2 = input.symbol("EGX:SWDY", "2", group=G)
string s3 = input.symbol("EGX:TMGH", "3", group=G)
string s4 = input.symbol("EGX:ETEL", "4", group=G)
string s5 = input.symbol("EGX:FWRY", "5", group=G)
string s6 = input.symbol("EGX:HRHO", "6", group=G)
float minVol = input.float(800.0, "حد حجم (lite)", minval=0, group=G)

f_pack() =>
    float ema20 = ta.ema(close, 20)
    float ema50 = ta.ema(close, 50)
    float rsi = ta.rsi(close, 14)
    [macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
    float volMa = ta.sma(volume, 20)
    float rvol = volume / math.max(volMa, 1.0)
    bool liqOk = volMa >= minVol
    float rng = math.max(high - low, syminfo.mintick)
    float cmf = ta.sma(((close - low) - (high - close)) / rng * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    [stLine, stDir] = ta.supertrend(3.0, 10)
    bool bosUp = close > ta.highest(high, 20)[1]
    float lookHi = ta.highest(high, 80)
    float lookLo = ta.lowest(low, 80)
    bool inDem = close <= lookHi - 0.618 * (lookHi - lookLo) and close >= lookLo
    int sc = 0
    sc += rsi > 50 and rsi < 70 ? 1 : rsi >= 70 ? 0 : -1
    sc += macdH > 0 ? 1 : -1
    sc += close > ema50 ? 1 : -1
    sc += stDir < 0 ? 1 : -1
    sc += cmf > 0 ? 1 : -1
    sc += obvSl > 0 ? 1 : -1
    sc += bosUp or inDem ? 1 : 0
    sc += rvol >= 1.0 ? 1 : 0
    float score = sc / 8.0 * 100.0
    bool buy = liqOk and score >= 25 and cmf > 0 and (inDem or bosUp) and not nearLimit
    bool buyA = buy and score >= 50 and sc >= 5
    [score, buy ? 1 : 0, buyA ? 1 : 0, rvol]

f_snap(string sym) =>
    [sc, bu, ba, rv] = request.security(sym, "D", f_pack(), barmerge.gaps_off, barmerge.lookahead_off)
    [sym, sc, bu, ba, rv]

[s1n, sc1, bu1, ba1, rv1] = f_snap(s1)
[s2n, sc2, bu2, ba2, rv2] = f_snap(s2)
[s3n, sc3, bu3, ba3, rv3] = f_snap(s3)
[s4n, sc4, bu4, ba4, rv4] = f_snap(s4)
[s5n, sc5, bu5, ba5, rv5] = f_snap(s5)
[s6n, sc6, bu6, ba6, rv6] = f_snap(s6)

var table wl = table.new(position.top_right, 5, 8, bgcolor=color.new(#0d1117, 5), border_width=1)
if barstate.islast
    table.clear(wl, 0, 0, 4, 7)
    table.cell(wl, 0, 0, "رمز", bgcolor=color.new(#161b22, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(wl, 1, 0, "Score", bgcolor=color.new(#161b22, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(wl, 2, 0, "Buy", bgcolor=color.new(#161b22, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(wl, 3, 0, "A", bgcolor=color.new(#161b22, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(wl, 4, 0, "RVOL", bgcolor=color.new(#161b22, 0), text_color=color.gray, text_size=size.tiny)
    table.cell(wl, 0, 1, s1, text_color=color.white, text_size=size.tiny)
    table.cell(wl, 1, 1, str.tostring(sc1, "#"), text_color=sc1 >= 50 ? color.lime : color.white, text_size=size.tiny)
    table.cell(wl, 2, 1, bu1 ? "✓" : "—", text_color=bu1 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 3, 1, ba1 ? "A" : "—", text_color=ba1 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 4, 1, str.tostring(rv1, "#.##"), text_size=size.tiny)
    table.cell(wl, 0, 2, s2, text_color=color.white, text_size=size.tiny)
    table.cell(wl, 1, 2, str.tostring(sc2, "#"), text_color=sc2 >= 50 ? color.lime : color.white, text_size=size.tiny)
    table.cell(wl, 2, 2, bu2 ? "✓" : "—", text_color=bu2 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 3, 2, ba2 ? "A" : "—", text_color=ba2 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 4, 2, str.tostring(rv2, "#.##"), text_size=size.tiny)
    table.cell(wl, 0, 3, s3, text_color=color.white, text_size=size.tiny)
    table.cell(wl, 1, 3, str.tostring(sc3, "#"), text_color=sc3 >= 50 ? color.lime : color.white, text_size=size.tiny)
    table.cell(wl, 2, 3, bu3 ? "✓" : "—", text_color=bu3 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 3, 3, ba3 ? "A" : "—", text_color=ba3 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 4, 3, str.tostring(rv3, "#.##"), text_size=size.tiny)
    table.cell(wl, 0, 4, s4, text_color=color.white, text_size=size.tiny)
    table.cell(wl, 1, 4, str.tostring(sc4, "#"), text_color=sc4 >= 50 ? color.lime : color.white, text_size=size.tiny)
    table.cell(wl, 2, 4, bu4 ? "✓" : "—", text_color=bu4 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 3, 4, ba4 ? "A" : "—", text_color=ba4 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 4, 4, str.tostring(rv4, "#.##"), text_size=size.tiny)
    table.cell(wl, 0, 5, s5, text_color=color.white, text_size=size.tiny)
    table.cell(wl, 1, 5, str.tostring(sc5, "#"), text_color=sc5 >= 50 ? color.lime : color.white, text_size=size.tiny)
    table.cell(wl, 2, 5, bu5 ? "✓" : "—", text_color=bu5 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 3, 5, ba5 ? "A" : "—", text_color=ba5 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 4, 5, str.tostring(rv5, "#.##"), text_size=size.tiny)
    table.cell(wl, 0, 6, s6, text_color=color.white, text_size=size.tiny)
    table.cell(wl, 1, 6, str.tostring(sc6, "#"), text_color=sc6 >= 50 ? color.lime : color.white, text_size=size.tiny)
    table.cell(wl, 2, 6, bu6 ? "✓" : "—", text_color=bu6 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 3, 6, ba6 ? "A" : "—", text_color=ba6 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(wl, 4, 6, str.tostring(rv6, "#.##"), text_size=size.tiny)
    table.cell(wl, 0, 7, "TOOLS WL", text_color=color.gray, text_size=size.tiny)
    table.cell(wl, 1, 7, "lite · D", text_color=color.gray, text_size=size.tiny)

plot(sc1, "EGXTTWL_Score1", display=display.data_window)
plot(ba1, "EGXTTWL_BuyA1", display=display.data_window)
plot(1, "EGXTTWL", display=display.data_window)

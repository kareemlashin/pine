int nRed = (v01 == -1 ? 1 : 0) + (v02 == -1 ? 1 : 0) + (v03 == -1 ? 1 : 0) + (v04 == -1 ? 1 : 0) + (v05 == -1 ? 1 : 0) + (v06 == -1 ? 1 : 0) + (v07 == -1 ? 1 : 0) + (v08 == -1 ? 1 : 0) + (v09 == -1 ? 1 : 0) + (v10 == -1 ? 1 : 0) + (v11 == -1 ? 1 : 0) + (v12 == -1 ? 1 : 0) + (v13 == -1 ? 1 : 0) + (v14 == -1 ? 1 : 0) + (v15 == -1 ? 1 : 0) + (v16 == -1 ? 1 : 0) + (v17 == -1 ? 1 : 0) + (v18 == -1 ? 1 : 0) + (v19 == -1 ? 1 : 0) + (v20 == -1 ? 1 : 0) + (v21 == -1 ? 1 : 0) + (v22 == -1 ? 1 : 0) + (v23 == -1 ? 1 : 0) + (v24 == -1 ? 1 : 0) + (v25 == -1 ? 1 : 0) + (v26 == -1 ? 1 : 0) + (v27 == -1 ? 1 : 0) + (v28 == -1 ? 1 : 0) + (v29 == -1 ? 1 : 0) + (v30 == -1 ? 1 : 0) + (v31 == -1 ? 1 : 0) + (v32 == -1 ? 1 : 0) + (v33 == -1 ? 1 : 0) + (v34 == -1 ? 1 : 0) + (v35 == -1 ? 1 : 0) + (v36 == -1 ? 1 : 0) + (v37 == -1 ? 1 : 0) + (v38 == -1 ? 1 : 0) + (v39 == -1 ? 1 : 0) + (v40 == -1 ? 1 : 0) + (v41 == -1 ? 1 : 0) + (v42 == -1 ? 1 : 0) + (v43 == -1 ? 1 : 0) + (v44 == -1 ? 1 : 0) + (v45 == -1 ? 1 : 0) + (v46 == -1 ? 1 : 0) + (v47 == -1 ? 1 : 0) + (v48 == -1 ? 1 : 0) + (v49 == -1 ? 1 : 0) + (v50 == -1 ? 1 : 0) + (v51 == -1 ? 1 : 0) + (v52 == -1 ? 1 : 0) + (v53 == -1 ? 1 : 0) + (v54 == -1 ? 1 : 0) + (v55 == -1 ? 1 : 0) + (v56 == -1 ? 1 : 0) + (v57 == -1 ? 1 : 0) + (v58 == -1 ? 1 : 0) + (v59 == -1 ? 1 : 0) + (v60 == -1 ? 1 : 0) + (v61 == -1 ? 1 : 0) + (v62 == -1 ? 1 : 0) + (v63 == -1 ? 1 : 0) + (v64 == -1 ? 1 : 0) + (v65 == -1 ? 1 : 0) + (v66 == -1 ? 1 : 0) + (v67 == -1 ? 1 : 0) + (v68 == -1 ? 1 : 0) + (v69 == -1 ? 1 : 0) + (v70 == -1 ? 1 : 0) + (v71 == -1 ? 1 : 0) + (v72 == -1 ? 1 : 0) + (v73 == -1 ? 1 : 0) + (v74 == -1 ? 1 : 0) + (v75 == -1 ? 1 : 0) + (v76 == -1 ? 1 : 0) + (v77 == -1 ? 1 : 0) + (v78 == -1 ? 1 : 0) + (v79 == -1 ? 1 : 0) + (v80 == -1 ? 1 : 0) + (v81 == -1 ? 1 : 0) + (v82 == -1 ? 1 : 0) + (v83 == -1 ? 1 : 0) + (v84 == -1 ? 1 : 0) + (v85 == -1 ? 1 : 0) + (v86 == -1 ? 1 : 0) + (v87 == -1 ? 1 : 0) + (v88 == -1 ? 1 : 0) + (v89 == -1 ? 1 : 0) + (v90 == -1 ? 1 : 0) + (v91 == -
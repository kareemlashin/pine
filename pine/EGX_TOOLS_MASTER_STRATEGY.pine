// ─── خطة صفقة ───
float stopUse = (not na(lastL) and lastL < close) ? math.max(lastL - 0.25 * atr, close - 3.5 * atr) : close - atr * atrMult
stopUse := math.min(stopUse, close - 0.5 * atr)
float riskPS = math.max(close - stopUse, syminfo.mintick)
float t1 = close + 1.5 * riskPS
float t2 = close + 3.0 * riskPS
float rr = riskPS > 0 ? (t1 - close) / riskPS : na
float shares = math.min(math.floor(capital * riskPct / 100.0 / riskPS), math.floor(capital / close))
bool chase = hi52 > 0 and (close - hi52) / hi52 * 100.0 > -3 and rsi > 72
bool rrOK = not na(rr) and rr >= minRR
bool egxOK = liqOk and not nearLimit and not bearBlock and not chase and not mktHalt100 and not sundaySkip and sessionOk
bool upTrend = v31 == 1 or (close > ema50 and ema50 > ema200)
bool locOK = v71 == 1 or v91 == 1 or v69 == 1 or inDem or sweepLo
bool momOK = pctA >= 20 or totalPct >= sigMin
bool moneyOK = v37 == 1 and v38 != -1
bool trigOK = close > open and (v04 == 1 or v03 == 1 or v62 == 1)
bool volOK = rvol >= 0.9
int hits = (upTrend ? 1 : 0) + (locOK ? 1 : 0) + (momOK ? 1 : 0) + (moneyOK ? 1 : 0) + (trigOK ? 1 : 0) + (volOK ? 1 : 0)
bool scoreDn = ta.crossunder(totalPct, -sigMin)
bool chFlip = chDir == -1 and chDir[1] == 1
bool supportBreak = bosDn
bool buyA = sigOk and egxOK and rrOK and locOK and moneyOK and hits >= 5 and totalPct >= sigMin and (not useHtfBuy or htfBull)
bool buyB = sigOk and egxOK and rrOK and locOK and not buyA and hits >= 4 and totalPct >= sigMin * 0.5
bool buySignal = buyA or buyB
bool exitSig = sigOk and (chFlip or dvState == -1 or scoreDn or supportBreak or (v37 == -1 and close < open and rsi > 70))

var bool tookHalf = false
var float trailStop = na
var float posStop = na
var float posT1 = na
var float posT2 = na
float tHalf = close + 0.5 * (t1 - close)

if strategy.position_size == 0
    tookHalf := false
    trailStop := na

if buySignal and strategy.position_size == 0
    float tQty = math.max(0.5, math.min(15.0, riskPct * close / math.max(close - stopUse, syminfo.mintick)))
    if useRiskQty
        strategy.entry("L", strategy.long, qty_percent=tQty)
    else
        strategy.entry("L", strategy.long)
    tookHalf := false
    posStop := stopUse
    posT1 := t1
    posT2 := t2
    trailStop := stopUse

if strategy.position_size > 0
    float useStop = nz(posStop, stopUse)
    float useT1 = nz(posT1, t1)
    float useT2 = nz(posT2, t2)
    float useHalf = nz(posStop, close) + (useT1 - nz(posStop, close)) * 0.5
    if usePartial and not tookHalf and high >= useHalf
        strategy.close("L", qty_percent=50, comment="50% T1")
        tookHalf := true
        trailStop := math.max(nz(trailStop, useStop), strategy.position_avg_price)
    if useTrail and tookHalf
        trailStop := math.max(nz(trailStop, useStop), close - atr * trailMult)
    float exitLim = tookHalf ? useT2 : useT1
    float exitStop = useTrail and tookHalf and not na(trailStop) ? trailStop : useStop
    strategy.exit("LX", "L", stop=exitStop, limit=exitLim)

if exitSig and strategy.position_size > 0
    strategy.close("L", comment="Exit signal")

plot(stopUse, "Stop", color=color.new(color.red, 50), display=display.none)
plot(t1, "T1", color=color.new(color.aqua, 50), display=display.none)
plot(buySignal ? 1 : 0, "EGXT_Buy", display=display.data_window)
plot(totalPct, "EGXT_Score", display=display.data_window)

//@version=6
indicator("EGX Volume CLV — close location", shorttitle="EGX VCLV", overlay=false, max_tables_count=2, calc_bars_count=5000)

// CLV × volume تراكم · docs/EGX_VOLUME.md

string G = "CLV"
int maLen = input.int(20, "MA", group=G)

float clv = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float clvVol = clv * volume
var float cum = 0.0
cum += clvVol
float cumMa = ta.sma(cum, maLen)
float barScore = ta.sma(clvVol, maLen)

bool bull = cum > cumMa and barScore > 0
bool bear = cum < cumMa and barScore < 0

plot(cum, "Cum CLV×V", color=cum >= cumMa ? color.lime : color.red, linewidth=2)
plot(cumMa, "MA", color=color.gray, linewidth=1)
plot(barScore, "Bar MA", color=color.orange, linewidth=1)

var table t = table.new(position.top_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "CLV×V", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(clv * 100.0, "#") + "% CLV", text_size=size.tiny)

plot(bull ? 1 : 0, "EGVCLV_Bull", display=display.all)
plot(clv * 100.0, "EGVCLV_Pct", display=display.all)

//@version=6
strategy("EGX Volume MASTER — PRO test", shorttitle="EGX VM ST", overlay=true, pyramiding=0, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=2, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// باك‌تست = إشارة PRO من EGX_VOLUME_MASTER.pine (B1 bounce + grade + net buy + R/R)

string G = "إعداد"
int zoneLook = input.int(400, "نافذة zones", minval=80, group=G)
int vpBins = input.int(32, "bins", group=G)
float slAtr = input.float(1.1, "وقف × ATR", group=G)
float rrMin = input.float(1.5, "حد R/R", group=G)
float minNetBuy = input.float(52.0, "Net buy %", group=G)
int minGrade = input.int(2, "Grade B1", minval=1, maxval=3, group=G)
float minAvgVol = input.float(1000.0, "متوسط حجم", group=G)
bool blockDist = input.bool(true, "منع دخول عند تصريف", group=G)
bool exitS1 = input.bool(true, "خروج S1 reject", group=G)
bool allowShort = input.bool(false, "PRO-S — فقط إن كان السهم EGX30", group=G)
bool isEgx30Short = input.bool(false, "هذا السهم من EGX30 (بيع مكشوف مسموح)", group=G)
float minNetSell = input.float(48.0, "Net buy % للـ short", group=G)
bool useConfirm = input.bool(true, "إغلاق الشمعة", group=G)
bool blockLimitBuy = input.bool(true, "منع شراء قرب halt/LULD", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool useMktHalt100 = input.bool(true, "منع إذا EGX100 ≤ −10%", group=G)

bool barOk = not useConfirm or barstate.isconfirmed

float dPrevClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayChgPct = dPrevClose > 0 ? (close - dPrevClose) / dPrevClose * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimitUp = blockLimitBuy and dPrevClose > 0 and (dayChgPct >= math.min(9.0, haltPct - 1.0) or dayChgPct >= luldPct - 0.25)
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool microLongOk = not nearLimitUp and not mktHalt100

f_buyVol(int off) =>
    float r = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / r

f_pxBin(float px, float lo, float step) =>
    int b = int(math.floor((px - lo) / step))
    math.max(0, math.min(vpBins - 1, b))

f_profile() =>
    int n = math.min(zoneLook, bar_index)
    float hi = ta.highest(high, n)
    float lo = ta.lowest(low, n)
    float step = (hi - lo) / math.max(vpBins, 1)
    step := step <= syminfo.mintick ? syminfo.mintick : step
    array<float> buyB = array.new_float(vpBins, 0.0)
    array<float> sellB = array.new_float(vpBins, 0.0)
    float tB = 0.0
    float tS = 0.0
    for i = 0 to n - 1
        float bV = f_buyVol(i)
        float sV = volume[i] - bV
        tB += bV
        tS += sV
        int bi = f_pxBin(close[i], lo, step)
        int si = f_pxBin(open[i], lo, step)
        array.set(buyB, bi, array.get(buyB, bi) + bV)
        array.set(sellB, si, array.get(sellB, si) + sV)
    float maxB = 0.0
    int b1i = 0
    float maxS = 0.0
    int s1i = 0
    for b = 0 to vpBins - 1
        if array.get(buyB, b) > maxB
            maxB := array.get(buyB, b)
            b1i := b
        if array.get(sellB, b) > maxS
            maxS := array.get(sellB, b)
            s1i := b
    float pad = ta.atr(14) * 0.28
    float bLo = lo + b1i * step - pad
    float bHi = lo + (b1i + 1) * step + pad
    float sLo = lo + s1i * step - pad
    float sHi = lo + (s1i + 1) * step + pad
    float bMid = lo + (b1i + 0.5) * step
    float sMid = lo + (s1i + 0.5) * step
    [tB, tS, maxB, bLo, bHi, bMid, sLo, sHi, sMid]

[tBuy, tSell, maxB, b1Lo, b1Hi, b1Mid, s1Lo, s1Hi, s1Mid] = f_profile()

float atr = ta.atr(14)
float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)
bool liqOk = volMa >= minAvgVol
float netBuyPct = tBuy + tSell > 0 ? tBuy / (tBuy + tSell) * 100.0 : 50.0

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 20) / ta.sma(volume, 20)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
bool distributing = cmf < -0.03 and obvSl < 0

bool inB1 = low <= b1Hi and high >= b1Lo
bool inS1 = low <= s1Hi and high >= s1Lo
bool b1Bounce = inB1 and close > open and rvol >= 1.0 and close > b1Mid
bool s1Reject = inS1 and close < open and rvol >= 1.0 and close < s1Mid

int touches = 0
for i = 1 to math.min(zoneLook, bar_index) - 1
    if low[i] <= b1Hi and high[i] >= b1Lo
        touches += 1
int grade = touches >= 3 and tBuy > 0 and maxB / tBuy * 100.0 >= 85 ? 3 : touches >= 2 and tBuy > 0 and maxB / tBuy * 100.0 >= 70 ? 2 : 1

float entry = b1Mid
float stop = b1Lo - atr * slAtr
float t1 = s1Mid
float risk = math.max(entry - stop, syminfo.mintick)
float rr = risk > 0 ? (t1 - entry) / risk : na

bool proLong = barOk and liqOk and microLongOk and b1Bounce and grade >= minGrade and netBuyPct >= minNetBuy and not na(rr) and rr >= rrMin and (not blockDist or not distributing)
bool exitLong = barOk and exitS1 and s1Reject
bool proShort = allowShort and isEgx30Short and barOk and liqOk and s1Reject and netBuyPct <= minNetSell and distributing
float shortStop = s1Hi + atr * slAtr
float shortTgt = b1Mid

if proLong and strategy.position_size <= 0
    strategy.entry("PRO", strategy.long)
    strategy.exit("X", "PRO", stop=stop, limit=t1)

if exitLong and strategy.position_size > 0
    strategy.close("PRO", comment="S1")

if proShort and strategy.position_size == 0
    strategy.entry("PRO-S", strategy.short)
    strategy.exit("XS", "PRO-S", stop=shortStop, limit=shortTgt)

plot(b1Mid, "B1", color=color.lime)
plot(s1Mid, "S1", color=color.red)

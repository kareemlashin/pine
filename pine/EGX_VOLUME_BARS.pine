//@version=6
indicator("EGX Volume Bars — top N marked", shorttitle="EGX VBars", overlay=true, max_labels_count=300, max_tables_count=2, calc_bars_count=5000)

// أكبر N شموع حجم على الشارت · buy/sell % · docs/EGX_VOLUME.md

string G = "إعداد"
int scan = input.int(500, "مسح", minval=50, maxval=2000, group=G)
int topN = input.int(10, "أكبر N", minval=3, maxval=15, group=G)
bool showRank = input.bool(true, "رتبة % على الشمعة", group=G)

f_pick(int n) =>
    array<int> out = array.new_int()
    int lim = math.min(scan, bar_index - 1)
    for rank = 0 to n - 1
        float best = -1.0
        int off = -1
        for i = 1 to lim
            bool used = false
            for u = 0 to array.size(out) - 1
                if array.get(out, u) == i
                    used := true
            if not used and volume[i] > best
                best := volume[i]
                off := i
        if off >= 0
            array.push(out, off)
    out

array<int> tops = f_pick(topN)

int rankNow = 0
for i = 0 to array.size(tops) - 1
    if array.get(tops, i) == 0
        rankNow := i + 1

if barstate.islast
    for i = 0 to array.size(tops) - 1
        int off = array.get(tops, i)
        float bp = (close[off] - low[off]) / math.max(high[off] - low[off], syminfo.mintick) * 100.0
        label.new(bar_index - off, high[off], "#" + str.tostring(i + 1) + "\n" + str.tostring(volume[off], "#") + "\nB" + str.tostring(bp, "#") + "%", style=label.style_label_down, color=color.new(i == 0 ? color.orange : color.gray, 20), textcolor=color.white, size=size.tiny)

plotshape(showRank and rankNow == 1, "Top1", shape.square, location=location.belowbar, color=color.orange, size=size.small, text="1")
plotshape(showRank and rankNow > 1, "TopN", shape.square, location=location.belowbar, color=color.gray, size=size.tiny)

var table t = table.new(position.top_right, 4, 12, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 3, 11)
    table.cell(t, 0, 0, "#", bgcolor=color.black, text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 1, 0, "bars", bgcolor=color.black, text_size=size.tiny)
    table.cell(t, 2, 0, "V", bgcolor=color.black, text_size=size.tiny)
    table.cell(t, 3, 0, "Buy%", bgcolor=color.black, text_size=size.tiny)
    for i = 0 to math.min(topN - 1, array.size(tops) - 1)
        int off = array.get(tops, i)
        int row = i + 1
        float bp = (close[off] - low[off]) / math.max(high[off] - low[off], syminfo.mintick) * 100.0
        table.cell(t, 0, row, str.tostring(i + 1), text_size=size.tiny)
        table.cell(t, 1, row, str.tostring(off), text_color=color.gray, text_size=size.tiny)
        table.cell(t, 2, row, str.tostring(volume[off], "#"), text_color=color.fuchsia, text_size=size.tiny)
        table.cell(t, 3, row, str.tostring(bp, "#"), text_size=size.tiny)

plot(rankNow > 0 ? rankNow : na, "EGVBars_Rank", display=display.data_window)

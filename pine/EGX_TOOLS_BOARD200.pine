//@version=6
indicator("EGX TOOLS — لوحة 200/294", shorttitle="T294", overlay=false, max_tables_count=4, calc_bars_count=5000)

// 8★ + 32 دوّar · مرآة EGX_افضل_فرص_BOARD200 · Screener: EGX_TOOLS_OPP
// plots: EGXTTB200_* · regen: ./scripts/sync_all_boards.sh

int MAX = 294
string G = "═══ لوحة ═══"
string preset = input.string("مخصص", "Preset", options=["مخصص", "كبار 294", "عدّاء 200", "فلاتر off"], group=G)
string uniS = input.string("200", "الكون", options=["200", "294"], group=G)
int TOTAL = int(str.tonumber(uniS))
string bench = input.symbol("EGX:EGX30", "EGX30", group=G)
bool chartIs30 = input.bool(true, "الشارت EGX30 (=40 مسح/bar)", group=G)
float minVol = input.float(800.0, "حد حجم", group=G)
float sigMin = input.float(20.0, "Tools Score %", minval=10, maxval=50, group=G)
int showTop = input.int(50, "عرض Top N", minval=5, maxval=100, group=G)
float minRR = input.float(1.5, "حد R/R للعرض", minval=1.0, maxval=4.0, step=0.1, group=G)
bool useRRFlt = input.bool(true, "فلتر R/R", group=G)
bool useDistFlt = input.bool(true, "فلتر Dist<55", group=G)
float minRVOL = input.float(1.0, "حد RVOL للعرض", minval=0.5, maxval=3.0, step=0.1, group=G)
bool useRvolFlt = input.bool(false, "فلتر RVOL", group=G)
int showBuy = input.int(25, "جدول شراء/حار", minval=0, maxval=40, group=G)
int showProTbl = input.int(12, "جدول Pro", minval=0, maxval=20, group=G)
int showRS = input.int(10, "جدول RS20", minval=0, maxval=20, group=G)
bool sortBuyOnly = input.bool(true, "الجانبي = Buy فقط (إلا حار)", group=G)
string sortMode = input.string("Rank", "ترتيب الرئيسي", options=["فرصة", "Rank", "RS20", "RVOL", "R/R"], group=G)
bool alertLeadChg = input.bool(true, "تنبيه تغيّر ★", group=G)
float minLeadOppDelta = input.float(0.0, "★: حد فرق Opp للتبديل (0=إيقاف)", minval=0, maxval=15, step=1, group=G)
float minRankShow = input.float(55.0, "حد Rank", minval=0, maxval=80, group=G)
float minProRank = input.float(68.0, "حد Pro", minval=55, maxval=85, group=G)
bool hideWeak = input.bool(false, "إخفاء تحت حد Rank", group=G)
bool onlyBuy = input.bool(false, "شراء فقط", group=G)
bool onlyPro = input.bool(false, "Pro فقط (Pass+Pro Tools)", group=G)
bool onlyPass = input.bool(false, "Pass فقط", group=G)
bool onlyHotPro = input.bool(false, "HotPro فقط", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockBear = input.bool(true, "منع ضغط EGX30 على Buy", group=G)
bool useMktHalt100 = input.bool(true, "منع شراء إذا EGX100 ≤ −10%", group=G)
bool resetDaily = input.bool(false, "مسح كاش عند يوم جديد", group=G)
bool showPinInPro = input.bool(true, "★ المثبتة في جدول Pro", group=G)

string Gexp = "═══ Top10 / قطاع ═══"
bool top10Diversify = input.bool(true, "Top10 تنويع قطاع (≤2)", group=Gexp)
int maxPerSector = input.int(2, "حد/قطاع", minval=1, maxval=5, group=Gexp)
string sectorFlt = input.string("الكل", "فلتر قطاع", options=["الكل", "بنوك", "عقار", "اتصالات", "صناعة", "غذاء/زراعة", "خدمات"], group=Gexp)
string profile = input.string("EGX قياسي", "ملف (≈ Screener)", options=["EGX قياسي", "مضاربة 15د", "استثمار يومي"], group=G)
bool confirmClose = input.bool(true, "كاش عند إغلاق الشمعة", group=G)
float minRankIn = input.float(65.0, "حد Rank", minval=40, maxval=90, group=G)
int minSetupIn = input.int(7, "حد إعداد /11", minval=0, maxval=11, group=G)
bool blockLimit = input.bool(true, "منع قرب halt (Buy)", group=G)
bool blockChase = input.bool(true, "منع مطاردة", group=G)
bool skipSundayBuy = input.bool(false, "لا شراء يوم الأحد", group=G)
bool compactUI = input.bool(false, "واجهة مدمجة (جدول رئيسي+Pro)", group=G)
bool showSector = input.bool(false, "عمود قطاع", group=G)
bool showTop10Copy = input.bool(true, "صف نسخ Top10", group=G)
int minReadyAlert = input.int(88, "حد Ready% للتنبيه", minval=50, maxval=100, group=G)
int batchOffset = input.int(0, "إزاحة دفعة (شارت 2)", minval=0, maxval=15, group=G)
string tfHint = input.string("15", "إطار الشارت (المنطق D)", options=["D", "240", "60", "15"], group=G)

float effMinVol = preset == "عدّاء 200" ? 400.0 : preset == "كبار 294" ? 1500.0 : profile == "مضاربة 15د" ? 3000.0 : profile == "استثمار يومي" ? 800.0 : minVol
float effMinRank = profile == "استثمار يومي" ? 60.0 : minRankIn
float effMinToolScr = profile == "استثمار يومي" ? 62.0 : minProRank
int effMinSetup = profile == "مضاربة 15د" ? 7 : minSetupIn
bool effRRFlt = preset == "فلاتر off" ? false : useRRFlt
bool effDistFlt = preset == "فلاتر off" ? false : useDistFlt
bool effRvolFlt = preset == "فلاتر off" ? false : useRvolFlt

string Gpin = "═══ مثبتة (كل bar) ═══"
int pinN = input.int(6, "عدد ★ المثبتة", minval=0, maxval=8, group=Gpin)
string p01 = input.symbol("EGX:COMI", "★01", group=Gpin)
string p02 = input.symbol("EGX:SWDY", "★02", group=Gpin)
string p03 = input.symbol("EGX:UNIP", "★03", group=Gpin)
string p04 = input.symbol("EGX:CNIN", "★04", group=Gpin)
string p05 = input.symbol("EGX:TMGH", "★05", group=Gpin)
string p06 = input.symbol("EGX:HRHO", "★06", group=Gpin)
string p07 = input.symbol("EGX:FWRY", "★07", group=Gpin)
string p08 = input.symbol("EGX:ETEL", "★08", group=Gpin)

int PIN_SLOTS = 8
int pinUse = math.min(pinN, PIN_SLOTS)
int SLOTMAX = chartIs30 ? 40 : 39
int ROT = math.max(0, SLOTMAX - PIN_SLOTS)
int BATCHES = ROT > 0 ? int(math.ceil(TOTAL / ROT)) : 1

f_pin(int p) =>
    p == 0 ? p01 : p == 1 ? p02 : p == 2 ? p03 : p == 3 ? p04 : p == 4 ? p05 : p == 5 ? p06 : p == 6 ? p07 : p08

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc

float mom30 = chartIs30 ? (close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0) : request.security(bench, "D", close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off)
int tr30 = chartIs30 ? f_mktTr() : request.security(bench, "D", f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
bool heavySell = mom30 < -4.0 and tr30 <= -1
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool regimeOk = (not blockBear or not heavySell) and not mktHalt100


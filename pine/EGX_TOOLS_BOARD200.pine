f_sym(int g) =>
    g < 38 ? f_b0(g) : g < 76 ? f_b1(g - 38) : g < 114 ? f_b2(g - 76) : g < 152 ? f_b3(g - 114) : g < 190 ? f_b4(g - 152) : g < 228 ? f_b5(g - 190) : g < 266 ? f_b6(g - 228) : g < 304 ? f_b7(g - 266) : ""

f_secTag(string symFull) =>
    string t = str.replace(symFull, "EGX:", "")
    switch t
        "COMI" => "بنك"
        "QNBE" => "بنك"
        "HDBK" => "بنك"
        "ADIB" => "بنك"
        "CIEB" => "بنك"
        "ABUK" => "بنك"
        "SAUD" => "بنك"
        "TMGH" => "عقار"
        "PHDC" => "عقار"
        "MNHD" => "عقار"
        "OCDI" => "عقار"
        "HELI" => "عقار"
        "SWDY" => "صناع"
        "ETEL" => "اتصالات"
        "FWRY" => "تكنول"
        "HRHO" => "استثمار"
        "EGAL" => "حديد"
        "MFPC" => "أسمدة"
        "ORAS" => "صناع"
        "SCTS" => "صناع"
        "IRON" => "حديد"
        "JUFO" => "غذاء"
        "EAST" => "غذاء"
        "CANA" => "غذاء"
        "UNIP" => "أسمدة"
        "EFID" => "غذاء"
        "GPPL" => "غذاء"
        "EMFD" => "استثمار"
        "CCAP" => "استثمار"
        "EXPA" => "عقار"
        "PHAR" => "خدمات"
        "GBCO" => "بنك"
        "VALU" => "تكنول"
        "EFIH" => "تكنول"
        "CNIN" => "استثمار"
        "ALCN" => "صناع"
        "BTFH" => "صناع"
        => "—"

f_secOk(string symFull) =>
    if sectorFlt == "الكل"
        true
    else
        string tag = f_secTag(symFull)
        sectorFlt == "بنوك" ? tag == "بنك" : sectorFlt == "عقار" ? tag == "عقار" : sectorFlt == "اتصالات" ? tag == "اتصالات" : sectorFlt == "صناعة" ? (tag == "صناع" or tag == "حديد" or tag == "أسمدة") : sectorFlt == "غذاء/زراعة" ? tag == "غذاء" : sectorFlt == "خدمات" ? (tag == "استثمار" or tag == "تكنول") : true

// مرآة EGX_افضل_فرص.pine (D) — بدون regime السوق (يُطبَّق في f_cache)

f_tools() =>
    bool sigOk = not confirmClose or barstate.isconfirmed
    float ema20 = ta.ema(close, 20)
    float ema50 = ta.ema(close, 50)
    float ema200 = ta.ema(close, 200)
    float rsi = ta.rsi(close, 14)
    [macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
    float volMa = ta.sma(volume, 20)
    bool liqOk = volMa >= effMinVol
    float rvol = volume / math.max(volMa, 1.0)
    float rng = math.max(high - low, syminfo.mintick)
    float cmf = ta.sma(((close - low) - (high - close)) / rng * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    [diP, diM, adx] = ta.dmi(14, 14)
    [_, stDir] = ta.supertrend(3.0, 10)
    float lookHi = ta.highest(high, 80)
    float lookLo = ta.lowest(low, 80)
    bool inDem = close <= lookHi - 0.618 * (lookHi - lookLo) and close >= lookLo
    bool bosUp = close > ta.highest(high, 20)[1]
    float hi252 = ta.highest(high, 252)
    bool chase = hi252 > 0 and (close - hi252) / hi252 * 100.0 > -3.0 and rsi > 72
    float dPrev = close[1]
    float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
    float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
    float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
    bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)
    int v01 = rsi > 52 and rsi < 68 ? 1 : rsi >= 68 ? 0 : -1
    int v02 = macdH > 0 and macdL > macdS ? 1 : macdH < 0 ? -1 : 0
    int v03 = ta.stoch(close, high, low, 14) > 50 ? 1 : -1
    int v04 = ta.roc(close, 10) > 0 ? 1 : -1
    int v05 = ta.mfi(hlc3, 14) > 50 ? 1 : -1
    int v06 = adx > 22 and diP > diM ? 1 : adx > 22 and diM > diP ? -1 : 0
    int v07 = close > ema20 and ema20 > ema50 and ema50 > ema200 ? 1 : close < ema20 and ema20 < ema50 ? -1 : 0
    int v08 = stDir < 0 ? 1 : -1
    int v10 = cmf > 0.05 ? 1 : cmf < -0.05 ? -1 : 0
    int v11 = obvSl > 0 ? 1 : obvSl < 0 ? -1 : 0
    int v12 = ta.accdist > ta.ema(ta.accdist, 20) ? 1 : -1
    int v15 = bosUp ? 1 : close < ta.lowest(low, 20)[1] ? -1 : 0
    int v16 = inDem ? 1 : close > lookHi * 0.98 ? -1 : 0
    float tech = (v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v10 + v11 + v12 + v15 + v16) / 13.0 * 100.0
    int nG = (v01 == 1 ? 1 : 0) + (v02 == 1 ? 1 : 0) + (v03 == 1 ? 1 : 0) + (v04 == 1 ? 1 : 0) + (v05 == 1 ? 1 : 0) + (v06 == 1 ? 1 : 0) + (v07 == 1 ? 1 : 0) + (v08 == 1 ? 1 : 0) + (v10 == 1 ? 1 : 0) + (v11 == 1 ? 1 : 0) + (v12 == 1 ? 1 : 0) + (v15 == 1 ? 1 : 0) + (v16 == 1 ? 1 : 0)
    int nR = (v01 == -1 ? 1 : 0) + (v02 == -1 ? 1 : 0) + (v03 == -1 ? 1 : 0) + (v04 == -1 ? 1 : 0) + (v05 == -1 ? 1 : 0) + (v06 == -1 ? 1 : 0) + (v07 == -1 ? 1 : 0) + (v08 == -1 ? 1 : 0) + (v10 == -1 ? 1 : 0) + (v11 == -1 ? 1 : 0) + (v12 == -1 ? 1 : 0) + (v15 == -1 ? 1 : 0) + (v16 == -1 ? 1 : 0)
    float accScore = nG / 13.0 * 100.0
    float distRisk = nR / 13.0 * 100.0
    bool locOK = inDem or bosUp or v16 == 1
    bool moneyOK = v10 == 1 and v11 != -1 and v12 == 1
    bool upTrend = v07 == 1 or v08 == 1
    bool momOK = tech >= sigMin * 0.5
    bool trigOK = close > open and (v03 == 1 or v04 == 1)
    bool volOK = rvol >= 0.9
    int setupHits = (upTrend ? 1 : 0) + (locOK ? 1 : 0) + (momOK ? 1 : 0) + (moneyOK ? 1 : 0) + (trigOK ? 1 : 0) + (volOK ? 1 : 0)
    float pl = ta.pivotlow(low, 8, 8)
    var float swingLow = na
    if not na(pl)
        swingLow := pl
    bool supportBreak = sigOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
    float atr = ta.atr(14)
    float zw = atr * 0.35
    bool nearSupport = not na(swingLow) and low <= nz(swingLow, low) + zw and close >= nz(swingLow, low) - zw * 1.2
    float ph = ta.pivothigh(high, 8, 8)
    var float swingHigh = na
    if not na(ph)
        swingHigh := ph
    float t1 = na(swingHigh) ? close + atr * 1.5 : swingHigh
    float entryPx = close
    float stopPx = nz(swingLow, close) - zw * 1.2 - atr * 0.5
    float riskPx = math.max(entryPx - stopPx, syminfo.mintick)
    float rr = riskPx > 0 ? (t1 - entryPx) / riskPx : 0.0
    float roc20 = ta.roc(close, 20)
    float benchRocL = request.security(bench, "D", ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
    bool rsLeader = roc20 - benchRocL > 0
    setupHits += rsLeader ? 1 : 0
    float rank = math.max(0.0, math.min(100.0, tech * 0.55 + setupHits / 7.0 * 30.0 + (rsLeader ? 8.0 : 0.0) + (rvol >= 1.2 ? 7.0 : 0.0)))
    float opportunity = math.max(0.0, math.min(100.0, tech * 0.55 + setupHits / 7.0 * 100.0 * 0.35 + math.min(100.0, rr / 3.0 * 100.0) * 0.15 + (rsLeader ? 5.0 : 0.0)))
    bool chaseOk = not blockChase or not chase
    bool buyRaw = sigOk and liqOk and not supportBreak and setupHits >= effMinSetup and rr >= minRR and (nearSupport or bosUp or inDem) and tech >= sigMin and chaseOk and not nearLimit and distRisk < 65
    bool passRaw = buyRaw and rank >= effMinRank and opportunity >= 58.0
    bool proRaw = passRaw and opportunity >= effMinToolScr and setupHits >= 6 and accScore >= 45 and distRisk < 50
    int cycle12 = distRisk >= 55 ? 9 : supportBreak ? 11 : accScore >= 55 and nearSupport ? 4 : bosUp ? 6 : 3
    int action = supportBreak or nearLimit ? 0 : proRaw or buyRaw ? 3 : passRaw or (setupHits >= 6 and opportunity >= 58) ? 2 : 1
    [opportunity, rank, tech, buyRaw ? 1.0 : 0.0, passRaw ? 1.0 : 0.0, proRaw ? 1.0 : 0.0, setupHits, rvol, roc20, accScore, distRisk, rr, dayPct, action, cycle12, chase ? 1.0 : 0.0, nearLimit ? 1.0 : 0.0]
float benchRoc = chartIs30 ? ta.roc(close, 20) : request.security(bench, "D", ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)

f_fetch(string s) =>
    request.security(s, "D", f_tools(), barmerge.gaps_off, barmerge.lookahead_off)

var float[] oppC = array.new_float(MAX, na)
var float[] rkC = array.new_float(MAX, na)
var float[] techC = array.new_float(MAX, na)
var float[] buyC = array.new_float(MAX, 0.0)
var float[] passC = array.new_float(MAX, 0.0)
var int[] stC = array.new_int(MAX, 0)
var int[] actC = array.new_int(MAX, 0)
var float[] rvC = array.new_float(MAX, na)
var float[] rsC = array.new_float(MAX, na)
var float[] accC = array.new_float(MAX, na)
var float[] dayC = array.new_float(MAX, na)
var float[] rrC = array.new_float(MAX, na)
var float[] distC = array.new_float(MAX, na)
var bool[] okC = array.new_bool(MAX, false)
var bool[] proC = array.new_bool(MAX, false)
var bool[] spikeC = array.new_bool(MAX, false)
var bool[] hotProC = array.new_bool(MAX, false)
var int[] ageC = array.new_int(MAX, 999)
var int[] updBarC = array.new_int(MAX, 0)

var int lastUni = 0
if barstate.isfirst or lastUni != TOTAL
    lastUni := TOTAL
    for ci = 0 to MAX - 1
        array.set(okC, ci, false)
        array.set(oppC, ci, na)

if resetDaily and ta.change(time("D")) != 0
    for ci = 0 to MAX - 1
        array.set(okC, ci, false)
        array.set(oppC, ci, na)

f_gi(string sym) =>
    int found = -1
    for g = 0 to TOTAL - 1
        if f_sym(g) == sym
            found := g
    found

f_cache(int gi, float opp, float rank, float tech, float buR, float paR, float prR, float st, float rv, float roc20, float ac, float ds, float rrv, float dp, int act, float ch, float lim) =>
    if gi >= 0 and gi < TOTAL
        float rs = roc20 - benchRoc
        bool sundayBlock = skipSundayBuy and dayofweek == dayofweek.sunday
        bool mktBlock = not regimeOk or mktHalt100 or sundayBlock
        bool buyOk = buR > 0 and not mktBlock
        bool passOk = paR > 0 and not mktBlock
        bool proOk = prR > 0 and not mktBlock
        int actAdj = mktBlock ? 0 : heavySell ? math.min(act, 1) : act
        bool hotP = proOk and rv >= 1.2 and rs > 0
        array.set(oppC, gi, opp)
        array.set(rkC, gi, rank)
        array.set(techC, gi, tech)
        array.set(buyC, gi, buyOk ? 1.0 : 0.0)
        array.set(passC, gi, passOk ? 1.0 : 0.0)
        array.set(stC, gi, int(st))
        array.set(actC, gi, actAdj)
        array.set(rvC, gi, rv)
        array.set(rsC, gi, rs)
        array.set(accC, gi, ac)
        array.set(dayC, gi, dp)
        array.set(rrC, gi, rrv)
        array.set(distC, gi, ds)
        array.set(proC, gi, proOk)
        array.set(spikeC, gi, rv >= 2.0)
        array.set(hotProC, gi, hotP)
        array.set(okC, gi, true)
        array.set(updBarC, gi, bar_index)
        array.set(ageC, gi, 0)

bool cacheTick = not confirmClose or barstate.isconfirmed

int batch = (int(bar_index % BATCHES) + batchOffset) % BATCHES
int bStart = batch * ROT

if cacheTick
    for p = 0 to PIN_SLOTS - 1
        string ps = p < pinUse ? f_pin(p) : bench
        [opp, rank, tech, buR, paR, prR, st, rv, roc20, ac, ds, rrv, dp, act, cyc, ch, lim] = f_fetch(ps)
        if p < pinUse
            f_cache(f_gi(f_pin(p)), opp, rank, tech, buR, paR, prR, st, rv, roc20, ac, ds, rrv, dp, act, ch, lim)
    for slot = 0 to ROT - 1
        int gi = bStart + slot
        string sym = gi < TOTAL ? f_sym(gi) : bench
        [opp, rank, tech, buR, paR, prR, st, rv, roc20, ac, ds, rrv, dp, act, cyc, ch, lim] = f_fetch(sym)
        if gi < TOTAL
            f_cache(gi, opp, rank, tech, buR, paR, prR, st, rv, roc20, ac, ds, rrv, dp, act, ch, lim)

for ai = 0 to TOTAL - 1
    if array.get(okC, ai)
        int ub = array.get(updBarC, ai)
        array.set(ageC, ai, bar_index - ub)

f_sortVal(int ix) =>
    sortMode == "Rank" ? array.get(rkC, ix) : sortMode == "RS20" ? array.get(rsC, ix) : sortMode == "RVOL" ? array.get(rvC, ix) : sortMode == "R/R" ? array.get(rrC, ix) : array.get(oppC, ix)

int[] ord = array.new_int(TOTAL, 0)
for k = 0 to TOTAL - 1
    array.set(ord, k, k)
for i = 0 to TOTAL - 2
    for j = 0 to TOTAL - 2 - i
        int ia = array.get(ord, j)
        int ib = array.get(ord, j + 1)
        float oa = array.get(okC, ia) ? f_sortVal(ia) : -1e10
        float ob = array.get(okC, ib) ? f_sortVal(ib) : -1e10
        if oa < ob
            array.set(ord, j, ib)
            array.set(ord, j + 1, ia)

int[] vis = array.new_int()
for k = 0 to TOTAL - 1
    int ix = array.get(ord, k)
    if not array.get(okC, ix)
        continue
    float op = array.get(oppC, ix)
    bool bu = array.get(buyC, ix) > 0
    if hideWeak and op < minRankShow
        continue
    if onlyBuy and not bu
        continue
    if onlyPro and not array.get(proC, ix)
        continue
    if onlyPass and array.get(passC, ix) <= 0
        continue
    if onlyHotPro and not array.get(hotProC, ix)
        continue
    if effRRFlt and array.get(rrC, ix) < minRR
        continue
    if effDistFlt and array.get(distC, ix) >= 55
        continue
    if effRvolFlt and array.get(rvC, ix) < minRVOL
        continue
    if not f_secOk(f_sym(ix))
        continue
    array.push(vis, ix)

int nVis = array.size(vis)
int rows = math.min(showTop, nVis)
int leader = nVis > 0 ? array.get(vis, 0) : 0
float leaderScore = nVis > 0 ? array.get(oppC, leader) : 0.0
bool leaderBuy = nVis > 0 and array.get(buyC, leader) > 0
string leaderSym = nVis > 0 ? f_sym(leader) : "—"

int buyCnt = 0
int hotCnt = 0
int proCnt = 0
int passCnt = 0
int spikeCnt = 0
int liveCnt = 0
for i = 0 to TOTAL - 1
    if array.get(okC, i)
        liveCnt += 1
        buyCnt += array.get(buyC, i) > 0 ? 1 : 0
        hotCnt += array.get(oppC, i) >= minRankShow ? 1 : 0
        proCnt += array.get(proC, i) ? 1 : 0
        passCnt += array.get(passC, i) > 0 ? 1 : 0
        spikeCnt += array.get(spikeC, i) ? 1 : 0

int hotProCnt = 0
for i = 0 to TOTAL - 1
    if array.get(okC, i) and array.get(hotProC, i)
        hotProCnt += 1

float sumOppLive = 0.0
float sumOppSq = 0.0
for i = 0 to TOTAL - 1
    if array.get(okC, i)
        float oL = array.get(oppC, i)
        sumOppLive += oL
        sumOppSq += oL * oL
float meanOppLive = liveCnt > 0 ? sumOppLive / liveCnt : 0.0
float varOppLive = liveCnt > 1 ? sumOppSq / liveCnt - meanOppLive * meanOppLive : 0.0
float oppDispersion = math.sqrt(math.max(0.0, varOppLive))
int breadthPct = liveCnt > 0 ? int(buyCnt * 100 / liveCnt) : 0
int heatPct = liveCnt > 0 ? int(hotCnt * 100 / liveCnt) : 0

int readyPct = TOTAL > 0 ? int(math.min(100, liveCnt * 100 / TOTAL)) : 0
int minReady = int(TOTAL * minReadyAlert / 100.0)
bool readyAlert = readyPct >= minReadyAlert
int barsToFull = readyPct >= 100 ? 0 : math.max(0, BATCHES - 1 - batch)
int[] buyOrd = array.new_int()
for i = 0 to TOTAL - 1
    if not array.get(okC, i)
        continue
    bool buI = array.get(buyC, i) > 0
    if sortBuyOnly and not buI
        continue
    if not sortBuyOnly and array.get(oppC, i) < minRankShow
        continue
    array.push(buyOrd, i)
for i = 0 to array.size(buyOrd) - 2
    for j = 0 to array.size(buyOrd) - 2 - i
        int ia = array.get(buyOrd, j)
        int ib = array.get(buyOrd, j + 1)
        if array.get(oppC, ia) < array.get(oppC, ib)
            array.set(buyOrd, j, ib)
            array.set(buyOrd, j + 1, ia)
int buyRows = math.min(showBuy, array.size(buyOrd))

int[] proOrd = array.new_int()
for i = 0 to TOTAL - 1
    if array.get(okC, i) and array.get(proC, i)
        array.push(proOrd, i)
for i = 0 to array.size(proOrd) - 2
    for j = 0 to array.size(proOrd) - 2 - i
        int ia = array.get(proOrd, j)
        int ib = array.get(proOrd, j + 1)
        if array.get(oppC, ia) < array.get(oppC, ib)
            array.set(proOrd, j, ib)
            array.set(proOrd, j + 1, ia)
int proRows = math.min(showProTbl, array.size(proOrd))

int[] rsOrd = array.new_int()
for i = 0 to TOTAL - 1
    if array.get(okC, i) and array.get(rsC, i) > 0
        array.push(rsOrd, i)
for i = 0 to array.size(rsOrd) - 2
    for j = 0 to array.size(rsOrd) - 2 - i
        int ia = array.get(rsOrd, j)
        int ib = array.get(rsOrd, j + 1)
        if array.get(rsC, ia) < array.get(rsC, ib)
            array.set(rsOrd, j, ib)
            array.set(rsOrd, j + 1, ia)
int rsRows = math.min(showRS, array.size(rsOrd))

float top2Rank = nVis > 1 ? array.get(oppC, array.get(vis, 1)) : na
float top3Rank = nVis > 2 ? array.get(oppC, array.get(vis, 2)) : na
float top4Rank = nVis > 3 ? array.get(oppC, array.get(vis, 3)) : na
float top5Rank = nVis > 4 ? array.get(oppC, array.get(vis, 4)) : na
float top6Rank = nVis > 5 ? array.get(oppC, array.get(vis, 5)) : na
float top7Rank = nVis > 6 ? array.get(oppC, array.get(vis, 6)) : na
float top8Rank = nVis > 7 ? array.get(oppC, array.get(vis, 7)) : na
float top9Rank = nVis > 8 ? array.get(oppC, array.get(vis, 8)) : na
float top10Rank = nVis > 9 ? array.get(oppC, array.get(vis, 9)) : na
float leaderRR = nVis > 0 ? array.get(rrC, leader) : na
float leaderRS = nVis > 0 ? array.get(rsC, leader) : na

var string lastLead = ""
var string leadH1 = ""
var string leadH2 = ""
var string leadH3 = ""
var float lastLeadOpp = na
bool leadOppOk = minLeadOppDelta <= 0 or leaderScore >= nz(lastLeadOpp, leaderScore) + minLeadOppDelta
bool leadChg = alertLeadChg and barstate.isconfirmed and leaderSym != lastLead and str.length(lastLead) > 0 and readyAlert and leadOppOk
if barstate.isconfirmed and leaderSym != lastLead
    leadH3 := leadH2
    leadH2 := leadH1
    leadH1 := lastLead
    lastLead := leaderSym
    lastLeadOpp := leaderScore

string top10Line = ""
int topAdded = 0
int secB = 0
int secR = 0
int secT = 0
int secI = 0
int secF = 0
int secS = 0
if showTop10Copy and nVis > 0
    for ti = 0 to nVis - 1
        if topAdded >= 10
            break
        int tix = array.get(vis, ti)
        string ts = f_sym(tix)
        string tag = f_secTag(ts)
        if top10Diversify
            int scN = tag == "بنك" ? secB : tag == "عقار" ? secR : tag == "اتصالات" ? secT : tag == "صناع" or tag == "حديد" or tag == "أسمدة" ? secI : tag == "تكنول" or tag == "استثمار" ? secS : secF
            if scN >= maxPerSector
                continue
            if tag == "بنك"
                secB += 1
            else if tag == "عقار"
                secR += 1
            else if tag == "اتصالات"
                secT += 1
            else if tag == "صناع" or tag == "حديد" or tag == "أسمدة"
                secI += 1
            else if tag == "تكنول" or tag == "استثمار"
                secS += 1
            else
                secF += 1
        top10Line += topAdded == 0 ? ts : ", " + ts
        topAdded += 1
bool leaderHotPro = nVis > 0 and array.get(hotProC, leader)
bool leaderComposite = leaderBuy and leaderRS > 0 and leaderRR >= minRR and readyAlert

var table tb = table.new(position.top_right, 13, 94, bgcolor=color.new(#0d1117, 4), border_width=1)
var table tbB = table.new(position.bottom_right, 4, 42, bgcolor=color.new(#0d1117, 8), border_width=1)
var table tbP = table.new(position.bottom_left, 4, 22, bgcolor=color.new(#0d1117, 8), border_width=1)
var table tbRS = table.new(position.top_left, 5, 22, bgcolor=color.new(#0d1117, 8), border_width=1)
if barstate.islast
    int footExtra = showTop10Copy and str.length(top10Line) > 0 ? 1 : 0
    int lastR = math.max(rows + 4 + footExtra, 5)
    table.clear(tb, 0, 0, 12, lastR)
    color hdr = color.new(#0d3b2e, 8)
    table.cell(tb, 0, 0, "#", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, 0, showSector ? "رمز·ق" : "رمز", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 2, 0, "Rank", bgcolor=hdr, text_color=color.white, text_size=size.tiny)
    table.cell(tb, 3, 0, "Rank", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 4, 0, "Hits", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 5, 0, "R/R", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 6, 0, "RVOL", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 7, 0, "RS20", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 8, 0, "يوم%", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 9, 0, "Dist", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 10, 0, "Age", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 11, 0, "تجم", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 12, 0, "Act", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
    if rows == 0
        table.cell(tb, 1, 1, readyPct < 50 ? "جاري المسح " + str.tostring(readyPct) + "%" : "لا مرشح — خفّف الفلاتر", text_color=color.orange, text_size=size.small)
        table.cell(tb, 2, 1, preset, text_color=color.gray, text_size=size.tiny)
    if rows > 0
        for row = 0 to rows - 1
            int ix = array.get(vis, row)
            float op = array.get(oppC, ix)
            bool bu = array.get(buyC, ix) > 0
            float dp = array.get(dayC, ix)
            color oc = op >= 68 ? color.lime : op >= minRankShow ? color.yellow : color.gray
            table.cell(tb, 0, row + 1, str.tostring(row + 1), text_size=size.tiny, text_color=row == 0 ? color.lime : color.gray)
            string symLbl = f_sym(ix)
            if showSector
                symLbl := str.replace(symLbl, "EGX:", "") + "·" + f_secTag(f_sym(ix))
            int ageR = array.get(ageC, ix)
            table.cell(tb, 1, row + 1, symLbl, text_size=size.tiny, text_color=row == 0 ? color.white : color.silver)
            table.cell(tb, 2, row + 1, str.tostring(op, "#"), text_size=size.tiny, text_color=oc)
            table.cell(tb, 3, row + 1, str.tostring(array.get(rkC, ix), "#"), text_size=size.tiny, text_color=array.get(rkC, ix) >= effMinRank ? color.lime : color.white)
            table.cell(tb, 4, row + 1, str.tostring(array.get(stC, ix)) + "/7", text_size=size.tiny)
            table.cell(tb, 5, row + 1, str.tostring(array.get(rrC, ix), "#.#"), text_size=size.tiny)
            table.cell(tb, 6, row + 1, str.tostring(array.get(rvC, ix), "#.##"), text_size=size.tiny)
            table.cell(tb, 7, row + 1, str.tostring(array.get(rsC, ix), "#.#") + "%", text_size=size.tiny, text_color=array.get(rsC, ix) > 0 ? color.lime : color.orange)
            table.cell(tb, 8, row + 1, str.tostring(dp, "#.#") + "%", text_size=size.tiny, text_color=dp >= 9 ? color.orange : dp > 0 ? color.lime : color.gray)
            table.cell(tb, 9, row + 1, str.tostring(array.get(distC, ix), "#"), text_size=size.tiny, text_color=array.get(distC, ix) >= 55 ? color.orange : color.gray)
            table.cell(tb, 10, row + 1, str.tostring(ageR), text_size=size.tiny, text_color=ageR <= BATCHES ? color.gray : color.orange)
            table.cell(tb, 11, row + 1, str.tostring(array.get(accC, ix), "#"), text_size=size.tiny, text_color=array.get(accC, ix) >= 50 ? color.lime : color.gray)
            int ax = array.get(actC, ix)
            string stTxt = array.get(proC, ix) ? "Pro" : bu ? "Buy" : array.get(passC, ix) > 0 ? "Pass" : op >= minRankShow ? "Hot" : "—"
            color stCol = array.get(proC, ix) ? color.aqua : bu ? color.lime : color.gray
            table.cell(tb, 12, row + 1, str.tostring(ax) + " " + stTxt, text_size=size.tiny, text_color=stCol)
    table.cell(tb, 0, rows + 1, "★", text_color=color.lime, text_size=size.small)
    table.cell(tb, 1, rows + 1, leaderSym, text_color=color.white, text_size=size.small)
    table.cell(tb, 2, rows + 1, str.tostring(leaderScore, "#"), text_color=color.lime, text_size=size.small)
    table.cell(tb, 3, rows + 1, "دفعة " + str.tostring(batch + 1) + "/" + str.tostring(BATCHES), text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 4, rows + 1, "شراء " + str.tostring(buyCnt), text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 5, rows + 1, "Buy " + str.tostring(buyCnt) + " Pass " + str.tostring(passCnt) + " Pro " + str.tostring(proCnt), text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 6, rows + 1, str.tostring(liveCnt) + "/" + str.tostring(TOTAL) + " · " + str.tostring(pinUse) + "★+" + str.tostring(ROT), text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 7, rows + 1, barsToFull > 0 ? "~" + str.tostring(barsToFull) + " شمعة" : "مسح ✓", text_color=barsToFull > 0 ? color.orange : color.lime, text_size=size.tiny)
    table.cell(tb, 8, rows + 1, "R/R≥1.5", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 0, rows + 2, "TOOLS " + str.tostring(TOTAL), text_color=color.aqua, text_size=size.tiny)
    table.cell(tb, 1, rows + 2, "مسح · " + str.tostring(readyPct) + "%", text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 2, rows + 2, sortMode + " · شارت " + tfHint + " · منطق D", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 3, rows + 2, (heavySell ? "ضغط EGX30 · " : "") + "Spike " + str.tostring(spikeCnt) + " · HotPro " + str.tostring(hotProCnt), text_color=heavySell ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tb, 0, rows + 3, "★ سابق", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, rows + 3, str.length(leadH1) > 0 ? leadH1 + " ← " + leadH2 : "—", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 2, rows + 3, profile, text_color=color.aqua, text_size=size.tiny)
    table.cell(tb, 3, rows + 3, "Breadth " + str.tostring(breadthPct) + "% · Heat " + str.tostring(heatPct) + "% · σ " + str.tostring(oppDispersion, "#.#"), text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 4, rows + 3, sectorFlt, text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 5, rows + 3, "Desk: OppMeta+Mega", text_color=color.aqua, text_size=size.tiny)
    table.cell(tb, 6, rows + 3, "Scr Pro·RS·Limit", text_color=color.gray, text_size=size.tiny)
    if showTop10Copy and str.length(top10Line) > 0
        table.cell(tb, 0, rows + 4, "Top10", text_color=color.yellow, text_size=size.tiny)
        table.cell(tb, 1, rows + 4, top10Line, text_color=color.white, text_size=size.tiny)
    if showRS > 0 and not compactUI
        table.clear(tbRS, 0, 0, 4, math.max(rsRows + 1, 2))
        table.cell(tbRS, 0, 0, "RS20", bgcolor=hdr, text_color=color.lime, text_size=size.tiny)
        table.cell(tbRS, 1, 0, "رمز", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        table.cell(tbRS, 2, 0, "فارق%", bgcolor=hdr, text_color=color.white, text_size=size.tiny)
        table.cell(tbRS, 3, 0, "فرصة", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        table.cell(tbRS, 4, 0, "RVOL", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        if rsRows > 0
            for row = 0 to rsRows - 1
                int ix = array.get(rsOrd, row)
                table.cell(tbRS, 0, row + 1, str.tostring(row + 1), text_size=size.tiny, text_color=color.lime)
                table.cell(tbRS, 1, row + 1, f_sym(ix), text_size=size.tiny, text_color=color.white)
                table.cell(tbRS, 2, row + 1, str.tostring(array.get(rsC, ix), "#.#") + "%", text_size=size.tiny, text_color=color.lime)
                table.cell(tbRS, 3, row + 1, str.tostring(array.get(oppC, ix), "#"), text_size=size.tiny)
                table.cell(tbRS, 4, row + 1, str.tostring(array.get(rvC, ix), "#.##"), text_size=size.tiny, text_color=array.get(spikeC, ix) ? color.yellow : color.gray)
        else
            table.cell(tbRS, 1, 1, "—", text_color=color.gray, text_size=size.tiny)
    if showProTbl > 0
        int pinRows = showPinInPro ? pinUse : 0
        int pLast = pinRows + proRows + 1
        table.clear(tbP, 0, 0, 3, math.max(pLast, 2))
        table.cell(tbP, 0, 0, showPinInPro ? "★/Pro" : "Pro", bgcolor=hdr, text_color=color.aqua, text_size=size.tiny)
        table.cell(tbP, 1, 0, "رمز", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        table.cell(tbP, 2, 0, "Rank", bgcolor=hdr, text_color=color.white, text_size=size.tiny)
        table.cell(tbP, 3, 0, "R/R", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        int tRow = 1
        if pinRows > 0
            for p = 0 to pinRows - 1
                int pg = f_gi(f_pin(p))
                string pSym = f_pin(p)
                table.cell(tbP, 0, tRow, "★", text_size=size.tiny, text_color=color.yellow)
                table.cell(tbP, 1, tRow, pSym, text_size=size.tiny, text_color=color.white)
                if pg >= 0 and array.get(okC, pg)
                    table.cell(tbP, 2, tRow, str.tostring(array.get(oppC, pg), "#"), text_size=size.tiny, text_color=color.lime)
                    table.cell(tbP, 3, tRow, str.tostring(array.get(rrC, pg), "#.#"), text_size=size.tiny)
                else
                    table.cell(tbP, 2, tRow, "…", text_size=size.tiny, text_color=color.gray)
                    table.cell(tbP, 3, tRow, "—", text_size=size.tiny)
                tRow += 1
        if proRows > 0
            for row = 0 to proRows - 1
                int ix = array.get(proOrd, row)
                table.cell(tbP, 0, tRow, str.tostring(row + 1), text_size=size.tiny, text_color=color.aqua)
                table.cell(tbP, 1, tRow, f_sym(ix), text_size=size.tiny, text_color=color.white)
                table.cell(tbP, 2, tRow, str.tostring(array.get(oppC, ix), "#"), text_size=size.tiny, text_color=color.lime)
                table.cell(tbP, 3, tRow, str.tostring(array.get(rrC, ix), "#.#"), text_size=size.tiny)
                tRow += 1
        if pinRows == 0 and proRows == 0
            table.cell(tbP, 1, 1, "—", text_color=color.gray, text_size=size.tiny)
    if showBuy > 0 and not compactUI
        table.clear(tbB, 0, 0, 3, math.max(buyRows + 1, 2))
        table.cell(tbB, 0, 0, sortBuyOnly ? "شراء" : "حار", bgcolor=hdr, text_color=color.lime, text_size=size.tiny)
        table.cell(tbB, 1, 0, "رمز", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        table.cell(tbB, 2, 0, "Rank", bgcolor=hdr, text_color=color.white, text_size=size.tiny)
        table.cell(tbB, 3, 0, "R/R·RVOL", bgcolor=hdr, text_color=color.gray, text_size=size.tiny)
        if buyRows > 0
            for row = 0 to buyRows - 1
                int ix = array.get(buyOrd, row)
                table.cell(tbB, 0, row + 1, str.tostring(row + 1), text_size=size.tiny, text_color=color.lime)
                table.cell(tbB, 1, row + 1, f_sym(ix), text_size=size.tiny, text_color=color.white)
                table.cell(tbB, 2, row + 1, str.tostring(array.get(oppC, ix), "#"), text_size=size.tiny, text_color=color.lime)
                table.cell(tbB, 3, row + 1, str.tostring(array.get(rrC, ix), "#.#") + "·" + str.tostring(array.get(rvC, ix), "#.##"), text_size=size.tiny)
        else
            table.cell(tbB, 1, 1, "—", text_color=color.gray, text_size=size.tiny)

plot(nVis > 0 ? leader + 1 : 0, "EGXTTB200_LeaderIdx", display=display.data_window)
plot(leaderScore, "EGXTTB200_LeaderScore", display=display.data_window)
plot(top2Rank, "EGXTTB200_Top2Score", display=display.data_window)
plot(top3Rank, "EGXTTB200_Top3Score", display=display.data_window)

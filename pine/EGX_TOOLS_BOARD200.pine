plot(top5Rank, "EGXTTB200_Top5Score", display=display.data_window)
plot(top6Rank, "EGXTTB200_Top6Score", display=display.data_window)
plot(top7Rank, "EGXTTB200_Top7Score", display=display.data_window)
plot(top8Rank, "EGXTTB200_Top8Score", display=display.data_window)
plot(top9Rank, "EGXTTB200_Top9Score", display=display.data_window)
plot(top10Rank, "EGXTTB200_Top10Score", display=display.data_window)
plot(leaderRR, "EGXTTB200_LeaderRR", display=display.data_window)
plot(leaderRS, "EGXTTB200_LeaderRS", display=display.data_window)
plot(leadChg ? 1 : 0, "EGXTTB200_LeadChg", display=display.data_window)
plot(leaderBuy ? 1 : 0, "EGXTTB200_LeaderBuy", display=display.data_window)
plot(buyCnt, "EGXTTB200_BuyCount", display=display.data_window)
plot(liveCnt, "EGXTTB200_Live", display=display.data_window)
plot(batch + 1, "EGXTTB200_Batch", display=display.data_window)
plot(TOTAL, "EGXTTB200_Universe", display=display.data_window)
plot(proCnt, "EGXTTB200_ProCount", display=display.data_window)
plot(passCnt, "EGXTTB200_PassCount", display=display.data_window)
plot(hotCnt, "EGXTTB200_HotCount", display=display.data_window)
plot(readyPct, "EGXTTB200_ReadyPct", display=display.data_window)
plot(heavySell ? 1 : 0, "EGXTTB200_MktBear", display=display.data_window)
plot(regimeOk ? 1 : 0, "EGXTTB200_RegimeOk", display=display.data_window)
plot(mktHalt100 ? 1 : 0, "EGXTTB200_MktHalt100", display=display.data_window)
plot(spikeCnt, "EGXTTB200_SpikeCount", display=display.data_window)
plot(breadthPct, "EGXTTB200_Breadth", display=display.data_window)
plot(heatPct, "EGXTTB200_Heat", display=display.data_window)
plot(oppDispersion, "EGXTTB200_Dispersion", display=display.data_window)
plot(nVis, "EGXTTB200_VisCount", display=display.data_window)
plot(nVis > 0 and array.get(passC, leader) > 0 ? 1 : 0, "EGXTTB200_Pass", display=display.data_window)
plot(nVis > 0 ? array.get(actC, leader) : 0, "EGXTTB200_LeaderAction", display=display.data_window)
plot(nVis > 0 ? array.get(distC, leader) : na, "EGXTTB200_LeaderDist", display=display.data_window)
plot(nVis > 0 ? array.get(rkC, leader) : na, "EGXTTB200_LeaderRank", display=display.data_window)
plot(hotProCnt, "EGXTTB200_HotProCount", display=display.data_window)
plot(leaderComposite ? 1 : 0, "EGXTTB200_LeaderComposite", display=display.data_window)
plot(leaderHotPro ? 1 : 0, "EGXTTB200_LeaderHotPro", display=display.data_window)
plot(minReadyAlert, "EGXTTB200_MinReadyPct", display=display.data_window)
plot(1, "EGXTTB200", display=display.data_window)

alertcondition(leaderComposite, "TOOLS — Leader Buy+RS+R/R", "{{ticker}} TOOLS leader composite")
alertcondition(leaderHotPro and readyAlert, "TOOLS — Leader HotPro", "{{ticker}} TOOLS leader hot pro")
alertcondition(leaderBuy and readyAlert, "TOOLS — شراء الأول (Ready%)", "{{ticker}} TOOLS leader BUY")
alertcondition(proCnt >= 1 and readyAlert, "TOOLS — Pro في الكون", "{{ticker}} TOOLS Pro hit")
alertcondition(buyCnt >= 3 and readyAlert, "TOOLS — 3+ شراء", "{{ticker}} TOOLS multi-buy")
alertcondition(readyPct >= 100, "TOOLS — مسح 100%", "{{ticker}} TOOLS scan complete")
alertcondition(leadChg, "TOOLS — ★ Leader تغيّر", "{{ticker}} TOOLS new leader")
alertcondition(spikeCnt >= 5 and readyAlert, "TOOLS — 5+ Vol Spike", "{{ticker}} TOOLS vol spike")
alertcondition(nVis >= 10 and readyAlert, "TOOLS — 10+ مرشح", "{{ticker}} TOOLS deep list")
alertcondition(hotProCnt >= 1 and readyAlert, "TOOLS — HotPro (Pro+RS+RVOL)", "{{ticker}} TOOLS HotPro")
alertcondition(proCnt >= 2 and spikeCnt >= 2 and readyAlert, "TOOLS — Spike+Pro", "{{ticker}} TOOLS spike pro")
alertcondition(leaderBuy and readyAlert and regimeOk, "TOOLS — Leader Buy + Regime", "{{ticker}} TOOLS leader regime")
alertcondition(passCnt >= 5 and readyAlert, "TOOLS — 5+ Pass", "{{ticker}} TOOLS pass breadth")
alertcondition(breadthPct >= 15 and readyAlert and regimeOk, "TOOLS — Breadth 15%+", "{{ticker}} TOOLS buy breadth")

//@version=6
strategy("EGX TOOLS Opp — باك‌تست", shorttitle="T Opp ST", overlay=true, pyramiding=0, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=3, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// مرآة EGX_TOOLS_OPP (lite13) · دخول Pro / A / Pass · إطار D موصى

string G = "ملف"
string entryMode = input.string("Pro", "دخول", options=["Pro", "A", "Pass"], group=G)
bool useConfirm = input.bool(true, "إغلاق الشمعة", group=G)
float sigMin = input.float(20.0, "Score %", minval=10, maxval=50, group=G)
float minRank = input.float(55.0, "Rank Pro", minval=30, maxval=90, group=G)
int minHits = input.int(5, "Hits Pro", minval=3, maxval=6, group=G)
float minVol = input.float(1500.0, "حد حجم", group=G)
float atrMult = input.float(2.0, "وقف × ATR", group=G)
bool blockBear = input.bool(true, "منع ضغط EGX30", group=G)
bool blockLimit = input.bool(true, "منع halt/LULD", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool useMktHalt100 = input.bool(true, "EGX100 ≤ −10%", group=G)
bool skipSundayBuy = input.bool(false, "لا دخول الأحد", group=G)
bool useEgxSession = input.bool(false, "جلسة مستمر فقط", group=G)
string bench = input.symbol("EGX:EGX30", "EGX30", group=G)

bool sigOk = not useConfirm or barstate.isconfirmed

f_sess() =>
    int id = 0
    if not na(time(timeframe.period, "1000-1415:23456", "Africa/Cairo"))
        id := 2
    id
bool sessionOk = not useEgxSession or not timeframe.isintraday or f_sess() == 2
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool sundaySkip = skipSundayBuy and dayofweek == dayofweek.sunday

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc
float mom30 = request.security(bench, timeframe.period, close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off)
int tr30 = request.security(bench, timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
bool bearMkt = blockBear and mom30 < -4.0 and tr30 <= -1

float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float wClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = wClose > wEma50
float rsi = ta.rsi(close, 14)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= minVol
float rvol = volume / math.max(volMa, 1.0)
float rng = math.max(high - low, syminfo.mintick)
float cmf = ta.sma(((close - low) - (high - close)) / rng * volume, 20) / ta.sma(volume, 20)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
[diP, diM, adx] = ta.dmi(14, 14)
[_, stDir] = ta.supertrend(3.0, 10)
float lookHi = ta.highest(high, 80)
float lookLo = ta.lowest(low, 80)
bool inDem = close <= lookHi - 0.618 * (lookHi - lookLo) and close >= lookLo
bool bosUp = close > ta.highest(high, 20)[1]
float hi252 = ta.highest(high, 252)
bool chase = hi252 > 0 and (close - hi252) / hi252 * 100.0 > -3 and rsi > 72
float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimit and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)

int v01 = rsi > 52 and rsi < 68 ? 1 : rsi >= 68 ? 0 : -1
int v02 = macdH > 0 and macdL > macdS ? 1 : macdH < 0 ? -1 : 0
int v03 = ta.stoch(close, high, low, 14) > 50 ? 1 : -1
int v04 = ta.roc(close, 10) > 0 ? 1 : -1
int v05 = ta.mfi(hlc3, 14) > 50 ? 1 : -1
int v06 = adx > 22 and diP > diM ? 1 : adx > 22 and diM > diP ? -1 : 0
int v07 = close > ema20 and ema20 > ema50 and ema50 > ema200 ? 1 : close < ema20 and ema20 < ema50 ? -1 : 0
int v08 = stDir < 0 ? 1 : -1
int v10 = cmf > 0.05 ? 1 : cmf < -0.05 ? -1 : 0
int v11 = obvSl > 0 ? 1 : obvSl < 0 ? -1 : 0
int v12 = ta.accdist > ta.ema(ta.accdist, 20) ? 1 : -1
int v15 = bosUp ? 1 : close < ta.lowest(low, 20)[1] ? -1 : 0
int v16 = inDem ? 1 : close > lookHi * 0.98 ? -1 : 0
float score = (v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v10 + v11 + v12 + v15 + v16) / 13.0 * 100.0
int nG = (v01 == 1 ? 1 : 0) + (v02 == 1 ? 1 : 0) + (v03 == 1 ? 1 : 0) + (v04 == 1 ? 1 : 0) + (v05 == 1 ? 1 : 0) + (v06 == 1 ? 1 : 0) + (v07 == 1 ? 1 : 0) + (v08 == 1 ? 1 : 0) + (v10 == 1 ? 1 : 0) + (v11 == 1 ? 1 : 0) + (v12 == 1 ? 1 : 0) + (v15 == 1 ? 1 : 0) + (v16 == 1 ? 1 : 0)
bool locOK = inDem or bosUp or v16 == 1
bool moneyOK = v10 == 1 and v11 != -1 and v12 == 1
bool upTrend = v07 == 1 or v08 == 1
bool momOK = score >= sigMin * 0.5
bool trigOK = close > open and (v03 == 1 or v04 == 1)
bool volOK = rvol >= 0.9
int hits = (upTrend ? 1 : 0) + (locOK ? 1 : 0) + (momOK ? 1 : 0) + (moneyOK ? 1 : 0) + (trigOK ? 1 : 0) + (volOK ? 1 : 0)
float benchRoc = request.security(bench, timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
float rank = math.max(0.0, math.min(100.0, score * 0.55 + hits / 6.0 * 100.0 * 0.30 + nG / 13.0 * 100.0 * 0.15 + (ta.roc(close, 20) - benchRoc > 0 ? 5.0 : 0.0)))
bool egxOK = liqOk and not chase and not nearLimit and not bearMkt and not mktHalt100 and not sundaySkip and sessionOk
bool buyA = sigOk and egxOK and locOK and moneyOK and hits >= 5 and score >= sigMin
bool passSig = sigOk and egxOK and score >= sigMin * 0.45 and hits >= 3
bool proSig = buyA and rank >= minRank and hits >= minHits and nG >= 10 and htfBull
bool entrySig = entryMode == "Pro" ? proSig : entryMode == "Pass" ? passSig : buyA

float atr = ta.atr(14)
float stopPx = close - atr * atrMult
float t1 = close + 1.5 * (close - stopPx)
bool exitSig = cmf < 0 and obvSl < 0 and close < open or ta.crossunder(score, -sigMin)

if entrySig and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if strategy.position_size > 0
    strategy.exit("LX", "L", stop=stopPx, limit=t1)
if exitSig and strategy.position_size > 0
    strategy.close("L", comment="Exit")

plot(proSig ? 1 : 0, "EGXTTOppST_Pro", display=display.data_window)
plot(buyA ? 1 : 0, "EGXTTOppST_BuyA", display=display.data_window)
plot(1, "EGXTTOppST", display=display.data_window)

//@version=6
strategy("EGX TOOLS Lite STR — A/B", shorttitle="T Lite STR", overlay=true, pyramiding=0, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=3, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// مرآة EGX_TOOLS_OPP (lite) · ليس MASTER 100
// ═══════════════════════════════════════════════════════════════════════════════

float sigMin = input.float(20.0, "Score %", minval=10, maxval=45)
float minVol = input.float(1200.0, "متوسط حجم")
float atrMult = input.float(2.0, "وقف × ATR")
bool useAOnly = input.bool(true, "دخول A فقط")
bool onClose = input.bool(true, "إغلاق")
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"])
bool blockLimit = input.bool(true, "منع قرب halt/LULD")

bool sigOk = not onClose or barstate.isconfirmed

float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float rsi = ta.rsi(close, 14)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= minVol
float rvol = volume / math.max(volMa, 1.0)
float rng = math.max(high - low, syminfo.mintick)
float cmf = ta.sma(((close - low) - (high - close)) / rng * volume, 20) / ta.sma(volume, 20)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
[stLine, stDir] = ta.supertrend(3.0, 10)
bool inDem = close <= ta.highest(high, 80) - 0.618 * (ta.highest(high, 80) - ta.lowest(low, 80)) and close >= ta.lowest(low, 80)
bool bosUp = close > ta.highest(high, 20)[1]
float hi252 = ta.highest(high, 250)
bool chase = hi252 > 0 and (close - hi252) / hi252 * 100.0 > -3 and rsi > 72
float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)

int sumV = (rsi > 52 and rsi < 68 ? 1 : -1) + (macdH > 0 ? 1 : -1) + (close > ema50 ? 1 : -1) + (stDir < 0 ? 1 : -1) + (cmf > 0 ? 1 : -1) + (obvSl > 0 ? 1 : -1) + (bosUp or inDem ? 1 : 0)
float score = sumV / 7.0 * 100.0
bool locOK = inDem or bosUp
bool moneyOK = cmf > 0 and obvSl > 0
int hits = (close > ema50 ? 1 : 0) + (locOK ? 1 : 0) + (score >= sigMin * 0.5 ? 1 : 0) + (moneyOK ? 1 : 0) + (close > open ? 1 : 0) + (rvol >= 0.9 ? 1 : 0)
bool egxOK = liqOk and not chase and not nearLimit
bool buyA = sigOk and egxOK and locOK and moneyOK and hits >= 5 and score >= sigMin
bool buyB = sigOk and egxOK and locOK and not buyA and hits >= 4 and score >= sigMin * 0.5
bool entry = useAOnly ? buyA : buyA or buyB

float atr = ta.atr(14)
float stopPx = close - atr * atrMult
float t1 = close + 1.5 * (close - stopPx)

bool exitSig = cmf < 0 and obvSl < 0 and close < open or ta.crossunder(score, -sigMin)

if entry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=stopPx, limit=t1)
if exitSig and strategy.position_size > 0
    strategy.close("Long")

plotshape(entry, "Buy", shape.triangleup, location.belowbar, color.lime, size=size.small)

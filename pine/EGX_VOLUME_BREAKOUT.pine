//@version=6
indicator("EGX Volume Breakout — range + RVOL", shorttitle="EGX VBrk", overlay=true, max_lines_count=30, max_tables_count=2, calc_bars_count=5000)

// كسر نطاق مع تأكيد حجم · docs/EGX_VOLUME.md

string G = "Break"
int boxLen = input.int(20, "نطاق", minval=10, maxval=60, group=G)
float minRvol = input.float(1.25, "RVOL", group=G)
float minVolMa = input.float(800.0, "Min avg vol", group=G)
bool showBox = input.bool(true, "خطوط النطاق", group=G)

float hi = ta.highest(high, boxLen)[1]
float lo = ta.lowest(low, boxLen)[1]
float volMa = ta.sma(volume, 20)
float rvol = volume / math.max(volMa, 1.0)

bool brkUp = close > hi and rvol >= minRvol and volMa >= minVolMa
bool brkDn = close < lo and rvol >= minRvol and volMa >= minVolMa
bool fakeUp = high > hi and close <= hi and rvol >= minRvol
bool fakeDn = low < lo and close >= lo and rvol >= minRvol

plot(showBox ? hi : na, "RangeHi", color=color.new(color.red, 40), linewidth=1)
plot(showBox ? lo : na, "RangeLo", color=color.new(color.lime, 40), linewidth=1)
plotshape(brkUp, "Brk↑", shape.triangleup, location.belowbar, color=color.lime, size=size.small, text="V↑")
plotshape(brkDn, "Brk↓", shape.triangledown, location.abovebar, color=color.red, size=size.small, text="V↓")
plotshape(fakeUp, "Fake↑", shape.xcross, location.abovebar, color=color.orange, size=size.tiny)
plotshape(fakeDn, "Fake↓", shape.xcross, location.belowbar, color=color.orange, size=size.tiny)

var table t = table.new(position.bottom_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "Breakout", bgcolor=color.black, text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, brkUp ? "UP" : brkDn ? "DN" : "—", text_size=size.tiny)
    table.cell(t, 0, 1, "RVOL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(rvol, "#.##"), text_size=size.tiny)

plot(brkUp ? 1 : 0, "EGVBrk_Up", display=display.all)
plot(brkDn ? 1 : 0, "EGVBrk_Dn", display=display.all)
plot((brkUp or brkDn) ? rvol : na, "EGVBrk_RVOL", display=display.all)

alertcondition(brkUp, "Vol brk up", "Volume breakout up")
alertcondition(brkDn, "Vol brk dn", "Volume breakout down")

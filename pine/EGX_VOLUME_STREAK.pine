//@version=6
indicator("EGX Volume Streak — rising V days", shorttitle="EGX VStr", overlay=false, max_tables_count=2, calc_bars_count=5000)

// سلسلة أيام حجم متصاعد · docs/EGX_VOLUME.md

string G = "Streak"
int minStreak = input.int(3, "Min streak", minval=2, maxval=8, group=G)
float minRvol = input.float(1.0, "RVOL each day", group=G)
bool upOnly = input.bool(true, "Up closes only", group=G)

bool stepOk = volume > volume[1] and volume / math.max(ta.sma(volume, 20), 1.0) >= minRvol and (not upOnly or close > open)

var int streak = 0
if stepOk
    streak += 1
else
    streak := 0

bool pass = streak >= minStreak

plot(streak, "EGVStr_Count", color=pass ? color.lime : color.gray, linewidth=2, display=display.all)
plot(volume, "V", style=plot.style_columns, color=color.new(color.fuchsia, 65))

var table t = table.new(position.top_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "Streak", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(streak), text_color=pass ? color.lime : color.white, text_size=size.large)

plot(pass ? 1 : 0, "EGVStr_Pass", display=display.all)

string GRP_ANAL = "09f — Ichimoku · ORB · Kelly · مؤشرات"
string GRP_ALERT = "11 — تنبيهات متقدمة"
bool   i_showIchi = input.bool(true, "Ichimoku (سحابة)", group=GRP_ANAL)

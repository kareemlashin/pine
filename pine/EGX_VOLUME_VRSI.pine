//@version=6
indicator("EGX Volume RSI", shorttitle="EGX VRSI", overlay=false, max_tables_count=2, calc_bars_count=5000)

// RSI على الحجم · docs/EGX_VOLUME.md

string G = "VRSI"
int len = input.int(14, "RSI", group=G)
float os = input.float(30.0, "Oversold", group=G)
float ob = input.float(70.0, "Overbought", group=G)

float vrsi = ta.rsi(volume, len)
float rvol = volume / math.max(ta.sma(volume, 20), 1.0)

bool acc = vrsi < os and rvol >= 1.0 and close >= open
bool dist = vrsi > ob and rvol >= 1.0 and close <= open

plot(vrsi, "EGVVRSI_Val", color=color.teal, linewidth=2, display=display.all)
hline(ob, "OB", color=color.red, linestyle=hline.style_dashed)
hline(os, "OS", color=color.lime, linestyle=hline.style_dashed)
hline(50, "50", color=color.gray)

var table t = table.new(position.top_left, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "Vol RSI", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(vrsi, "#"), text_size=size.small)

plot(acc ? 1 : 0, "EGVVRSI_Acc", display=display.all)
plot(dist ? 1 : 0, "EGVVRSI_Dist", display=display.all)

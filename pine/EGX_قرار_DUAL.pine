//@version=6
indicator("EGX قرar + عدّاء — توافق", shorttitle="EGX Q×R", overlay=true, max_tables_count=2, calc_bars_count=5000)

// مقارنة إشارة قرar (EGXQ) vs عدّاء (EGXR) على نفس السهم · D
// rBuy ≈ EGXR_Buy (RUNNER investBuy thresholds)
// plots: EGXQDR_Agree · EGXQDR_QBuy · EGXQDR_RBuy

string mode = input.string("PRO موحّد", "قرar", options=["PRO موحّد", "عدّاء استثمار", "فلسي EGX"])
bool onClose = input.bool(true, "إغلاق الشمعة", group="EGX")
bool useMktHalt100 = input.bool(true, "EGX100 halt", group="EGX")
bool blockBearQ = input.bool(true, "ضغط EGX30", group="EGX")

bool proMode = mode == "PRO موحّد"
bool runnerMode = proMode or mode == "عدّاء استثمار" or mode == "فلسي EGX"
bool pennyMode = mode == "فلسي EGX"
float effVol = pennyMode ? 400.0 : 800.0
float effAcc = pennyMode ? 50.0 : 55.0
float effDist = pennyMode ? 52.0 : 50.0
float effRank = pennyMode ? 55.0 : 58.0
float effRR = 1.5
int effGates = 7

bool sigOk = not onClose or barstate.isconfirmed
f_mktTrD() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc
float mom30D = request.security("EGX:EGX30", timeframe.period, close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off)
int tr30D = request.security("EGX:EGX30", timeframe.period, f_mktTrD(), barmerge.gaps_off, barmerge.lookahead_off)
bool heavySellD = blockBearQ and mom30D < -4.0 and tr30D <= -1
float dayPct100D = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100D = useMktHalt100 and dayPct100D <= -10.0
bool regimeOkD = not heavySellD and not mktHalt100D


float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)
float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= effVol
float rvol = volume / math.max(volMa, 1.0)

float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 20) / ta.sma(volume, 20)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
bool accOk = cmf > 0 and obvSl > 0
float acc = math.min(100.0, (accOk ? 40.0 : 0.0) + (cmf > 0 ? 20.0 : 0.0) + (obvSl > 0 ? 15.0 : 0.0))
float dist = math.min(100.0, (cmf < 0 and obvSl < 0 ? 40.0 : 0.0))

float hi252 = ta.highest(high, 252)
float lo252 = ta.lowest(low, 252)
float pctHi = hi252 > 0 ? (close - hi252) / hi252 * 100.0 : 0.0
float rocB = lo252 > 0 ? (close / lo252 - 1.0) * 100.0 : 0.0
bool crashTrap = runnerMode and rocB > 100 and pctHi < -28 and dist >= 38

var float sl = na
if not na(ta.pivotlow(low, 8, 8))
    sl := ta.pivotlow(low, 8, 8)
bool supBr = sigOk and not na(sl) and close < sl and close[1] >= sl
float zw = atr * 0.35
bool atZ = low <= nz(sl, low) + zw and close >= nz(sl, low) - zw * 1.2
bool ret = sigOk and not na(sl) and low <= sl * 1.006 and close > sl
bool chase = pctHi > -3 and rsi > 72

float dPrevQ = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctQ = dPrevQ > 0 ? (close - dPrevQ) / dPrevQ * 100.0 : 0.0
float haltPctQ = pennyMode ? 5.0 : 10.0
float luldPctQ = pennyMode ? 10.0 : 20.0
bool nearLimit = dayPctQ >= math.min(9.0, haltPctQ - 1.0) or dayPctQ >= luldPctQ - 0.25

int cycle = acc >= effAcc ? 4 : 3
if dist >= 55
    cycle := 9
if supBr
    cycle := 11

bool rs = ta.roc(close, 20) - request.security("EGX:EGX30", timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off) > 0
float rank = math.min(100.0, acc * 0.45 + (100.0 - dist) * 0.25 + (rs ? 12.0 : 0.0))
float rr = (close + atr * 2.5 - close) / math.max(atr, syminfo.mintick)

bool qBuy = sigOk and liqOk and acc >= effAcc and dist < effDist and (atZ or ret) and not supBr and not chase and not crashTrap and rank >= effRank and (runnerMode ? cycle >= 4 and cycle <= 7 : ret) and not nearLimit

float rDna = math.min(100.0, (cycle <= 7 ? 15.0 : 0.0) + (acc >= 55 ? 25.0 : 0.0) + (dist < 45 ? 15.0 : 0.0) + (rs ? 10.0 : 0.0))
bool rBuy = sigOk and runnerMode and acc >= 58 and dist < 50 and cycle >= 4 and cycle <= 7 and (atZ or ret) and rDna >= 55 and not crashTrap and not supBr and liqOk and rs


bool agree = qBuy and rBuy and regimeOkD
bool conflict = qBuy != rBuy and (qBuy or rBuy)
int recAction = agree ? 4 : conflict ? 2 : qBuy ? 3 : rBuy ? 3 : crashTrap ? 0 : 1
string recTxt = recAction == 4 ? "✅ تنفيذ — Q×R" : recAction == 0 ? "🛑 خروج/فخ" : recAction == 2 ? "⚠️ تعارض — انتظر" : recAction == 3 ? "⏳ طرف واحد" : "⛔ لا"
color recCol = recAction == 4 ? color.lime : recAction == 0 ? color.red : recAction == 2 ? color.orange : color.yellow
bool qOnly = qBuy and not rBuy
bool rOnly = rBuy and not qBuy

var table tb = table.new(position.top_left, 2, 5, bgcolor=color.new(#0d1117, 10), border_width=1)
if barstate.islast
    table.clear(tb, 0, 0, 1, 4)
    table.cell(tb, 0, 0, "EGX Q×R", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 0, syminfo.ticker, text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 0, 1, "قرar", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, 1, qBuy ? "✅ شراء" : "—", text_color=qBuy ? color.lime : color.gray, text_size=size.small)
    table.cell(tb, 0, 2, "عدّاء", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, 2, rBuy ? "✅ BUY" : "—", text_color=rBuy ? color.teal : color.gray, text_size=size.small)
    table.cell(tb, 0, 3, "DNA/R", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, 3, str.tostring(rDna, "#") + " · R" + str.tostring(rank, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(tb, 0, 4, agree ? "🟢 توافق" : conflict ? "🟠 اختلاف" : "⚪", text_color=agree ? color.lime : conflict ? color.orange : color.gray, text_size=size.tiny)

bgcolor(agree ? color.new(color.lime, 97) : qOnly ? color.new(color.green, 98) : rOnly ? color.new(color.teal, 98) : na)

plotshape(agree, "Agree", shape.circle, location.belowbar, color.lime, size=size.tiny)
plotshape(qOnly, "Q only", shape.triangleup, location.belowbar, color.green, size=size.tiny, text="Q")
plotshape(rOnly, "R only", shape.triangleup, location.belowbar, color.teal, size=size.tiny, text="R")

plot(qBuy ? 1 : 0, "EGXQDR_QBuy", display=display.data_window)
plot(rBuy ? 1 : 0, "EGXQDR_RBuy", display=display.data_window)
plot(agree ? 1 : 0, "EGXQDR_Agree", display=display.data_window)
plot(conflict ? 1 : 0, "EGXQDR_Conflict", display=display.data_window)
plot(rDna, "EGXQDR_DNA", display=display.data_window)

bool showBanner = input.bool(true, "بانر Q×R", group="EGX")
var table ban = table.new(position.bottom_left, 1, 4, bgcolor=color.new(color.black, 12), border_width=2)
if showBanner and barstate.islast
    table.clear(ban, 0, 0, 0, 3)
    table.cell(ban, 0, 0, recTxt, bgcolor=color.new(recCol, 78), text_color=color.white, text_size=size.normal)
    table.cell(ban, 0, 1, "Q " + (qBuy ? "Buy✓" : "—") + " · R " + (rBuy ? "Buy✓" : "—") + " · DNA " + str.tostring(rDna, "#"), bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(ban, 0, 2, agree ? "توافق" : conflict ? "تعارض" : "—", bgcolor=color.new(color.gray, 90), text_color=agree ? color.lime : conflict ? color.orange : color.gray, text_size=size.tiny)
    table.cell(ban, 0, 3, crashTrap ? "CrashTrap" : "OK", bgcolor=color.new(color.gray, 92), text_color=crashTrap ? color.red : color.gray, text_size=size.tiny)

plot(recAction, "EGXQDR_RecommendedAction", display=display.data_window)

plot(1, "EGXQDR", display=display.data_window)

alertcondition(agree, "EGX Q×R — توافق شراء", "{{ticker}}: Q+R agree BUY")
alertcondition(qOnly, "EGX Q×R — قرar فقط", "{{ticker}}: Q buy only")

plot(regimeOkD ? 1 : 0, "EGX_RegimeOk", display=display.all)

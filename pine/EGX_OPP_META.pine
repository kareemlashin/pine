//@version=6
indicator("EGX Opp × Meta — ماسح مركّب", shorttitle="Opp×Meta", overlay=false, calc_bars_count=5000)

// EGXOppMeta_Pro = 1 · EGXOppMeta_Triple = 1 · Opp من EGX_افضل_فرص + Meta من EGX_META_SCREENER
// Filter: EGXOppMeta_Pro · EGXOppMeta_OppScore↓

string G = "Opp"
float minOppIn = input.float(68.0, "حد فرصة Pro", minval=40, maxval=90, group=G)
float minRankIn = input.float(65.0, "حد Rank", minval=40, maxval=90, group=G)
int minSetupIn = input.int(7, "إعداد /11", minval=0, maxval=11, group=G)
float minRRIn = input.float(1.5, "R/R", minval=1.0, step=0.1, group=G)
bool confirmClose = input.bool(true, "إغلاق الشمعة", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockLimit = input.bool(true, "منع halt/LULD", group=G)
bool blockBear = input.bool(true, "منع ضغط EGX30", group=G)
bool useMktHalt100 = input.bool(true, "منع إذا EGX100 ≤ −10%", group=G)

string Gm = "Meta"
float volNetBuy = input.float(52.0, "Net buy B1 %", group=Gm)
float minQAcc = input.float(55.0, "قرار: تجم", group=Gm)
bool reqTriple = input.bool(false, "يتطلب Triple Meta", group=Gm)

bool sigOk = not confirmClose or barstate.isconfirmed
float effMinVol = 1500.0

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
bool bullStack = ema9 > ema21 and ema21 > ema50
bool above200 = close > ema200
float wClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = wClose > wEma50
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdBull = macdH > 0 and macdL > macdS
float rsi = ta.rsi(close, 14)
float atr = ta.atr(14)
float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= effMinVol
float rvol = volume / math.max(volMa, 1.0)
float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 14) / ta.sma(volume, 14)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
bool accumulating = cmf > 0 and obvSl > 0
bool distributing = cmf < 0 and obvSl < 0
float accScore = math.min(100.0, (accumulating ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0) + (obvSl > 0 ? 15.0 : 0.0))
float distRisk = math.min(100.0, (distributing ? 40.0 : 0.0) + (cmf < 0 ? 15.0 : 0.0))

float benchRoc = request.security("EGX:EGX30", timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
bool rsLeader = ta.roc(close, 20) - benchRoc > 0

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    sc += close > e20 ? 1 : -1
    sc += e20 > e50 ? 1 : -1
    sc
float mom30 = request.security("EGX:EGX30", timeframe.period, close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off)
int tr30 = request.security("EGX:EGX30", timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off)
bool heavySell = mom30 < -4.0 and tr30 <= -1
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool regimeOk = (not blockBear or not heavySell) and not mktHalt100

float pl = ta.pivotlow(low, 8, 8)
float ph = ta.pivothigh(high, 8, 8)
var float swingLow = na
var float swingHigh = na
if not na(pl)
    swingLow := pl
if not na(ph)
    swingHigh := ph
bool supportBreak = sigOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retestSupport = sigOk and not na(swingLow) and low <= swingLow * 1.005 and close > swingLow
float zw = atr * 0.35
float buyTop = nz(swingLow, low) + zw
float buyBot = nz(swingLow, low) - zw * 1.2
bool inZone = low <= buyTop and high >= buyBot
bool nearSupport = low <= buyTop and close >= buyBot
float phs = ta.pivothigh(high, 5, 5)
var float actHigh = na
var int structDir = 0
if not na(phs)
    actHigh := phs
bool bullBreak = sigOk and not na(actHigh) and close > actHigh and close[1] <= actHigh
if bullBreak
    structDir := 1
    actHigh := na
bool fakeBreak = sigOk and not na(swingHigh) and high > swingHigh and close < swingHigh and rvol > 1.05
bool rawBreak = bullBreak and rvol >= 1.2
var float brkHoldLvl = na
var int brkHoldBars = 0
if barstate.isconfirmed
    if rawBreak
        brkHoldLvl := nz(swingHigh, close[1])
        brkHoldBars := 1
    else if not na(brkHoldLvl) and close > brkHoldLvl
        brkHoldBars += 1
    else
        brkHoldLvl := na
        brkHoldBars := 0
bool breakConfirmed = sigOk and not na(brkHoldLvl) and brkHoldBars >= 2 and (rvol >= 1.2 or rvol[1] >= 1.2)
bool breakRetest = retestSupport and structDir == 1 and not fakeBreak
float t1 = na(swingHigh) ? close + atr * 1.5 : swingHigh
float entryPx = (buyTop + buyBot) / 2.0
float stopPx = buyBot - atr * 0.5
float riskPx = math.max(entryPx - stopPx, syminfo.mintick)
float rr = riskPx > 0 ? (t1 - entryPx) / riskPx : na
float hi252 = ta.highest(high, 252)
bool chase = hi252 > 0 and (close - hi252) / hi252 * 100.0 > -3.0 and rsi > 72
float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)

float score = 0.0
score += bullStack ? 20.0 : 0.0
score += above200 ? 15.0 : -5.0
score += htfBull ? 15.0 : -10.0
score += macdBull ? 10.0 : 0.0
score += accumulating ? 15.0 : distributing ? -10.0 : 0.0
score += rvol >= 1.0 ? 10.0 : 0.0
score += rsi > 40 and rsi < 70 ? 10.0 : 0.0
score += rsLeader ? 5.0 : 0.0
score += accScore >= 55 ? 5.0 : 0.0
score += distRisk >= 55 ? -8.0 : 0.0
score := math.max(0.0, math.min(100.0, score))

int setupHits = 0
setupHits += bullStack ? 1 : 0
setupHits += htfBull ? 1 : 0
setupHits += macdBull ? 1 : 0
setupHits += accumulating ? 1 : 0
setupHits += rsLeader ? 1 : 0
setupHits += structDir == 1 ? 1 : 0
setupHits += inZone ? 1 : 0
setupHits += not na(rr) and rr >= minRRIn ? 1 : 0
setupHits += rvol >= 1.0 ? 1 : 0
setupHits += breakRetest or breakConfirmed ? 1 : 0
setupHits += accScore >= 50 ? 1 : 0

float rank = math.max(0.0, math.min(100.0, score * 0.55 + setupHits / 11.0 * 30.0 + (rsLeader ? 8.0 : 0.0) + (rvol >= 1.2 ? 7.0 : 0.0)))
float opportunity = math.max(0.0, math.min(100.0, score * 0.45 + setupHits / 11.0 * 100.0 * 0.35 + math.min(100.0, nz(rr, 0.0) / 3.0 * 100.0) * 0.20))
bool buyFlag = sigOk and liqOk and not supportBreak and setupHits >= minSetupIn and not na(rr) and rr >= minRRIn and (nearSupport or breakRetest or breakConfirmed) and score >= 55 and regimeOk and not chase and not nearLimit and distRisk < 65 and not mktHalt100
bool pass = buyFlag and rank >= minRankIn and opportunity >= 58
bool oppPro = pass and opportunity >= minOppIn and setupHits >= 7 and accScore >= 50 and distRisk < 50

f_bv(int off) =>
    float r = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / r
int bins = 24
int n = math.min(400, bar_index)
float hi = ta.highest(high, n)
float lo = ta.lowest(low, n)
float step = (hi - lo) / math.max(bins, 1)
step := step <= syminfo.mintick ? syminfo.mintick : step
array<float> buyB = array.new_float(bins, 0.0)
float tB = 0.0
float tS = 0.0
for i = 0 to n - 1
    float bV = f_bv(i)
    tS += volume[i] - bV
    tB += bV
    int bi = int(math.floor((close[i] - lo) / step))
    bi := math.max(0, math.min(bins - 1, bi))
    array.set(buyB, bi, array.get(buyB, bi) + bV)
float maxB = 0.0
int b1i = 0
for b = 0 to bins - 1
    if array.get(buyB, b) > maxB
        maxB := array.get(buyB, b)
        b1i := b
float pad = atr * 0.28
float bLo = lo + b1i * step - pad
float bHi = lo + (b1i + 1) * step + pad
float bMid = lo + (b1i + 0.5) * step
float netP = tB + tS > 0 ? tB / (tB + tS) * 100.0 : 50.0
bool inB1 = low <= bHi and high >= bLo
bool b1Bounce = inB1 and close > open and rvol >= 1.0 and close > bMid
float distLite = cmf < 0 and obvSl < 0 ? 55.0 : 35.0
bool volPro = (inB1 or b1Bounce) and netP >= volNetBuy and distLite < 55
float accQ = math.min(100.0, (accumulating ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0))
float distQ = math.min(100.0, (cmf < 0 and obvSl < 0 ? 35.0 : 0.0))
bool qBuy = sigOk and liqOk and accQ >= minQAcc and distQ < 50 and nearSupport and not supportBreak
bool akhirPro = buyFlag and rank >= minRankIn and not na(rr) and rr >= minRRIn and accumulating
bool triple = akhirPro and volPro and qBuy
bool metaPro = reqTriple ? triple : akhirPro and volPro
bool oppMetaPro = oppPro and metaPro and regimeOk

plot(opportunity, "EGXOppMeta_OppScore", display=display.all)
plot(rank, "EGXOppMeta_Rank", display=display.all)
plot(oppPro ? 1 : 0, "EGXOppMeta_OppPro", display=display.all)
plot(metaPro ? 1 : 0, "EGXOppMeta_MetaPro", display=display.all)
plot(triple ? 1 : 0, "EGXOppMeta_Triple", display=display.all)
plot(oppMetaPro ? 1 : 0, "EGXOppMeta_Pro", display=display.all)
plot(buyFlag ? 1 : 0, "EGXOppMeta_Buy", display=display.all)
plot(regimeOk ? 1 : 0, "EGX_RegimeOk", display=display.all)
plot(mktHalt100 ? 1 : 0, "EGXOppMeta_MktHalt100", display=display.all)
plot(1, "EGXOppMeta", display=display.all)

alertcondition(oppMetaPro, "Opp×Meta — Pro", "{{ticker}} EGXOppMeta Pro")
alertcondition(oppMetaPro and not oppMetaPro[1], "Opp×Meta — Pro جديد", "{{ticker}} EGXOppMeta Pro new")

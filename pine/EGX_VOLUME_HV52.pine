//@version=6
indicator("EGX Volume vs 52w high", shorttitle="EGX VH52", overlay=false, max_tables_count=2, calc_bars_count=5000)

// V / أعلى حجم ~252 يوم · docs/EGX_VOLUME.md

string G = "52w"
int len = input.int(252, "High vol lookback", minval=60, group=G)
float minRatio = input.float(0.75, "Hot ratio", step=0.05, group=G)

float vHi = ta.highest(volume, len)
float ratio = volume / math.max(vHi, 1.0)
float rvol = volume / math.max(ta.sma(volume, 20), 1.0)

bool nearHigh = ratio >= minRatio
bool record = volume >= vHi * 0.98

plot(ratio * 100.0, "V/Hi%", color=color.orange, linewidth=2, display=display.none)
plot(rvol, "RVOL", color=color.teal, linewidth=1, display=display.none)
hline(minRatio * 100.0, "Hot%", color=color.lime, linestyle=hline.style_dashed)

var table t = table.new(position.top_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "Vs 52w V", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, record ? "REC" : nearHigh ? "NEAR" : "—", text_size=size.tiny)

plot(nearHigh ? 1 : 0, "EGVH52_Near", display=display.all)
plot(record ? 1 : 0, "EGVH52_Record", display=display.all)
plot(ratio, "EGVH52_Ratio", display=display.all)

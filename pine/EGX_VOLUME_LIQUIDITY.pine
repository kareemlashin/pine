//@version=6
indicator("EGX Volume Liquidity — turnover · tier", shorttitle="EGX VLiq", overlay=false, max_tables_count=3, calc_bars_count=5000)

// سيولة EGX: متوسط حجم · turnover · Amihud proxy · docs/EGX_VOLUME.md

string G = "EGX"
float minTier1 = input.float(3000.0, "Tier1 avg vol", group=G)
float minTier2 = input.float(1500.0, "Tier2", group=G)
float minTier3 = input.float(500.0, "Tier3", group=G)
int maLen = input.int(20, "MA vol", group=G)

float volMa = ta.sma(volume, maLen)
float volMa60 = ta.sma(volume, 60)
float dollarVol = volume * close
float dollarMa = ta.sma(dollarVol, maLen)

float mcap = nz(syminfo.shares_outstanding, 0) * close
float turnover = mcap > 0 ? volMa * close / mcap * 100.0 : na

float ret = math.abs(ta.roc(close, 1))
float amihud = dollarVol > 0 ? ret / dollarVol * 1e6 : na
float amihudMa = ta.sma(amihud, maLen)

string tier = volMa >= minTier1 ? "T1" : volMa >= minTier2 ? "T2" : volMa >= minTier3 ? "T3" : "T4-Risk"
bool liqOk = volMa >= minTier2

color tCol = tier == "T1" ? color.lime : tier == "T2" ? color.teal : tier == "T3" ? color.orange : color.red
plot(volMa, "Avg Vol", color=color.yellow, linewidth=2)
plot(dollarMa, "Avg $Vol", color=color.orange, linewidth=1, scale=scale.right)
plot(volume, "V", style=plot.style_columns, color=color.new(tCol, 60))

var table t = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 5)
    table.cell(t, 0, 0, "Liquidity", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, tier, text_color=tCol, text_size=size.small)
    table.cell(t, 0, 1, "Vol MA", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(volMa, "#"), text_size=size.tiny)
    table.cell(t, 0, 2, "Vol MA60", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(volMa60, "#"), text_size=size.tiny)
    table.cell(t, 0, 3, "Turnover%", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(turnover, "#.###"), text_size=size.tiny)
    table.cell(t, 0, 4, "Amihud×1e6", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(amihudMa, "#.##"), text_size=size.tiny)

plot(liqOk ? 1 : 0, "EGVLiq_OK", display=display.all)
plot(tier == "T1" ? 4 : tier == "T2" ? 3 : tier == "T3" ? 2 : 1, "EGVLiq_Tier", display=display.all)

//@version=6
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"])
indicator("EGX قرar — Presets (12)", shorttitle="EGX Q Preset", overlay=false, max_tables_count=1, calc_bars_count=5000)

// 3 قوائm ثابتة — بدون inputs رموز · EGXQBD20_* للماسح

string preset = input.string("عدّاء EGX", "قائمة", options=["عدّاء EGX", "EGX30 كبار", "فلسي / سيولة", "قطاعات EGX (بنوك/عقار/اتصالات)"])

string p01 = preset == "قطاعات EGX (بنوك/عقار/اتصالات)" ? "EGX:COMI" : preset == "عدّاء EGX" ? "EGX:UNIP" : preset == "EGX30 كبار" ? "EGX:COMI" : "EGX:UNIP"
string p02 = preset == "قطاعات EGX (بنوك/عقار/اتصالات)" ? "EGX:ADIB" : preset == "عدّاء EGX" ? "EGX:CNIN" : preset == "EGX30 كبار" ? "EGX:SWDY" : "EGX:CNIN"
string p03 = preset == "قطاعات EGX (بنوك/عقار/اتصالات)" ? "EGX:TMGH" : preset == "عدّاء EGX" ? "EGX:AMER" : preset == "EGX30 كبار" ? "EGX:TMGH" : "EGX:AMER"
string p04 = preset == "قطاعات EGX (بنوك/عقار/اتصالات)" ? "EGX:ETEL" : preset == "عدّاء EGX" ? "EGX:CIRA" : preset == "EGX30 كبار" ? "EGX:HRHO" : "EGX:ACGC"
string p05 = preset == "قطاعات EGX (بنوك/عقار/اتصالات)" ? "EGX:HRHO" : preset == "عدّاء EGX" ? "EGX:PHDC" : preset == "EGX30 كبار" ? "EGX:FWRY" : "EGX:PHDC"
string p06 = preset == "قطاعات EGX (بنوك/عقار/اتصالات)" ? "EGX:SWDY" : preset == "عدّاء EGX" ? "EGX:SKPC" : preset == "EGX30 كبار" ? "EGX:ETEL" : "EGX:OCDI"
string p07 = preset == "عدّاء EGX" ? "EGX:OCDI" : preset == "EGX30 كبار" ? "EGX:OCDI" : "EGX:SKPC"
string p08 = preset == "عدّاء EGX" ? "EGX:MFPC" : preset == "EGX30 كبار" ? "EGX:SKPC" : "EGX:EGTS"
string p09 = preset == "عدّاء EGX" ? "EGX:ORWE" : preset == "EGX30 كبار" ? "EGX:PHDC" : "EGX:ABUK"
string p10 = preset == "عدّاء EGX" ? "EGX:ESRS" : preset == "EGX30 كبار" ? "EGX:ACGC" : "EGX:MFPC"
string p11 = preset == "عدّاء EGX" ? "EGX:MNHD" : preset == "EGX30 كبار" ? "EGX:CNIN" : "EGX:ORWE"
string p12 = preset == "عدّاء EGX" ? "EGX:EGTS" : preset == "EGX30 كبار" ? "EGX:ABUK" : "EGX:ESRS"

int N = 12
string bench = "EGX:EGX30"
float minVol = preset == "فلسي / سيولة" ? 400.0 : 800.0

f_decision() =>
    float atr = ta.atr(14)
    float volMa = ta.sma(volume, 20)
    bool liq = volMa >= minVol
    float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    float acc = math.min(100.0, (cmf > 0 and obvSl > 0 ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0))
    float dist = math.min(100.0, (cmf < 0 and obvSl < 0 ? 35.0 : 0.0))
    float hi = ta.highest(high, 252)
    float lo = ta.lowest(low, 252)
    float pctHi = hi > 0 ? (close - hi) / hi * 100.0 : 0.0
    float rocB = lo > 0 ? (close / lo - 1.0) * 100.0 : 0.0
    bool trap = rocB > 100 and pctHi < -28 and dist >= 38
    float rsi = ta.rsi(close, 14)
    bool chase = pctHi > -3 and rsi > 72
    float dPrevL = close[1]
    float dayPctL = dPrevL > 0 ? (close - dPrevL) / dPrevL * 100.0 : 0.0
    float haltPctL = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
    float luldPctL = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
    bool nearLimit = dayPctL >= math.min(9.0, haltPctL - 1.0) or dayPctL >= luldPctL - 0.25
    float pl = ta.pivotlow(low, 8, 8)
    var float sl = na
    if not na(pl)
        sl := pl
    bool supBr = not na(sl) and close < sl and close[1] >= sl
    float zw = atr * 0.35
    bool atZ = low <= nz(sl, low) + zw and close >= nz(sl, low) - zw * 1.2
    bool ret = not na(sl) and low <= sl * 1.006 and close > sl
    int cyc = acc >= 55 ? 4 : 3
    if dist >= 55
        cyc := 9
    float br = request.security(bench, timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
    bool rs = ta.roc(close, 20) - br > 0
    float rk = math.min(100.0, acc * 0.45 + (100.0 - dist) * 0.25 + (rs ? 12.0 : 0.0) + (atZ ? 8.0 : 0.0))
    bool buy = liq and acc >= 55 and dist < 50 and cyc >= 4 and cyc <= 7 and (atZ or ret) and not supBr and not chase and not trap and not nearLimit
    [rk, buy ? 1.0 : 0.0, acc]

f_sym(int i) =>
    i == 0 ? p01 : i == 1 ? p02 : i == 2 ? p03 : i == 3 ? p04 : i == 4 ? p05 : i == 5 ? p06 : i == 6 ? p07 : i == 7 ? p08 : i == 8 ? p09 : i == 9 ? p10 : i == 10 ? p11 : p12

f_row(int i) =>
    request.security(f_sym(i), "D", f_decision(), barmerge.gaps_off, barmerge.lookahead_off)

float[] rkA = array.new_float(N, 0.0)
float[] buyA = array.new_float(N, 0.0)
for i = 0 to N - 1
    [rk, bu, _ac] = f_row(i)
    array.set(rkA, i, rk)
    array.set(buyA, i, bu)

int leader = 0
float topRk = array.get(rkA, 0)
for i = 1 to N - 1
    if array.get(rkA, i) > topRk
        topRk := array.get(rkA, i)
        leader := i

bool leaderBuy = array.get(buyA, leader) > 0
int buyCnt = 0
for i = 0 to N - 1
    buyCnt := buyCnt + (array.get(buyA, i) > 0 ? 1 : 0)

var table t = table.new(position.top_right, 3, 6, bgcolor=color.new(#0d1117, 8), border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 2, 5)
    table.cell(t, 0, 0, "Preset", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 0, preset, text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 0, 1, "★", text_color=color.lime, text_size=size.small)
    table.cell(t, 1, 1, f_sym(leader), text_color=color.white, text_size=size.small)
    table.cell(t, 2, 1, str.tostring(topRk, "#"), text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 2, "Buy", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, leaderBuy ? "نعم" : "لا", text_color=leaderBuy ? color.lime : color.gray, text_size=size.tiny)
    table.cell(t, 2, 2, "Σ" + str.tostring(buyCnt), text_size=size.tiny)
    for row = 0 to 2
        int ix = row
        table.cell(t, 0, row + 3, f_sym(ix), text_size=size.tiny, text_color=color.gray)
        table.cell(t, 1, row + 3, str.tostring(array.get(rkA, ix), "#"), text_size=size.tiny)
        table.cell(t, 2, row + 3, array.get(buyA, ix) > 0 ? "B" : "—", text_size=size.tiny, text_color=array.get(buyA, ix) > 0 ? color.lime : color.gray)

plot(topRk, "EGXQBD20_LeaderRank", display=display.data_window)
plot(leaderBuy ? 1 : 0, "EGXQBD20_LeaderBuy", display=display.data_window)
plot(buyCnt, "EGXQBD20_BuyCount", display=display.data_window)
plot(leaderBuy or topRk >= 55 ? 1 : 0, "EGXQBD20_Pass", display=display.data_window)
plot(1, "EGXQBD20", display=display.data_window)

alertcondition(leaderBuy, "EGX Preset — شراء الأول", "{{ticker}} preset leader BUY")

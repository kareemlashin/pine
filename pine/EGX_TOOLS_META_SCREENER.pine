//@version=6
indicator("EGX TOOLS Meta — 100 + Vol + قرار", shorttitle="EGX T Meta", overlay=false, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// ماسح ثلاثي: Tools Pro · Vol B1 · Q-lite — إطار D
// EGXTMeta_Triple=1 · EGXTMeta_ToolsPro · EGXTMeta_VolPro · EGXTMeta_QBuy
// كامل 100: EGX_TOOLS_MASTER · مركّب أخير: EGX_META_SCREENER
// ═══════════════════════════════════════════════════════════════════════════════

string G = "عتبات"
float sigMin = input.float(20.0, "Tools Score %", minval=10, maxval=50, group=G)
int minGreen = input.int(12, "🟢 lite Pro", minval=8, maxval=16, group=G)
int minHits = input.int(5, "Hits Tools", minval=3, maxval=6, group=G)
float minVolMa = input.float(1500.0, "متوسط حجم", group=G)
float volNetBuy = input.float(52.0, "Net buy B1 %", group=G)
float minQAcc = input.float(55.0, "قرار: تجم", group=G)
bool onClose = input.bool(true, "إغلاق الشمعة", group=G)
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
bool blockLimit = input.bool(true, "منع قرب halt/LULD", group=G)

bool sigOk = not onClose or barstate.isconfirmed

// ─── Tools lite (16 صوت) ───
f_tools() =>
    float ema20 = ta.ema(close, 20)
    float ema50 = ta.ema(close, 50)
    float ema200 = ta.ema(close, 200)
    float rsi = ta.rsi(close, 14)
    [macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
    float volMa = ta.sma(volume, 20)
    float rvol = volume / math.max(volMa, 1.0)
    bool liqOk = volMa >= minVolMa
    float rng = math.max(high - low, syminfo.mintick)
    float cmf = ta.sma(((close - low) - (high - close)) / rng * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    [diP, diM, adx] = ta.dmi(14, 14)
    [stLine, stDir] = ta.supertrend(3.0, 10)
    float lookHi = ta.highest(high, 80)
    float lookLo = ta.lowest(low, 80)
    bool inDem = close <= lookHi - 0.618 * (lookHi - lookLo) and close >= lookLo
    bool bosUp = close > ta.highest(high, 20)[1]
    float hi52 = ta.highest(high, 250)
    bool chase = hi52 > 0 and (close - hi52) / hi52 * 100.0 > -3 and rsi > 72
    int v01 = rsi > 52 and rsi < 68 ? 1 : rsi >= 68 ? 0 : -1
    int v02 = macdH > 0 and macdL > macdS ? 1 : macdH < 0 ? -1 : 0
    int v03 = ta.stoch(close, high, low, 14) > 50 ? 1 : -1
    int v04 = ta.roc(close, 10) > 0 ? 1 : -1
    int v05 = ta.mfi(hlc3, 14) > 50 ? 1 : -1
    int v06 = adx > 22 and diP > diM ? 1 : adx > 22 and diM > diP ? -1 : 0
    int v07 = close > ema20 and ema20 > ema50 and ema50 > ema200 ? 1 : close < ema20 and ema20 < ema50 ? -1 : 0
    int v08 = stDir < 0 ? 1 : -1
    int v09 = close > ta.sar(0.02, 0.02, 0.2) ? 1 : -1
    int v10 = cmf > 0.05 ? 1 : cmf < -0.05 ? -1 : 0
    int v11 = obvSl > 0 ? 1 : obvSl < 0 ? -1 : 0
    int v12 = ta.accdist > ta.ema(ta.accdist, 20) ? 1 : -1
    int v13 = rvol >= 1.2 and close > open ? 1 : 0
    [bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
    int v14 = close > bbMid ? 1 : -1
    int v15 = bosUp ? 1 : close < ta.lowest(low, 20)[1] ? -1 : 0
    int v16 = inDem ? 1 : close > lookHi * 0.98 ? -1 : 0
    int sumV = v01 + v02 + v03 + v04 + v05 + v06 + v07 + v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15 + v16
    float score = sumV / 16.0 * 100.0
    int nG = (v01 == 1 ? 1 : 0) + (v02 == 1 ? 1 : 0) + (v03 == 1 ? 1 : 0) + (v04 == 1 ? 1 : 0) + (v05 == 1 ? 1 : 0) + (v06 == 1 ? 1 : 0) + (v07 == 1 ? 1 : 0) + (v08 == 1 ? 1 : 0) + (v09 == 1 ? 1 : 0) + (v10 == 1 ? 1 : 0) + (v11 == 1 ? 1 : 0) + (v12 == 1 ? 1 : 0) + (v13 == 1 ? 1 : 0) + (v14 == 1 ? 1 : 0) + (v15 == 1 ? 1 : 0) + (v16 == 1 ? 1 : 0)
    bool locOK = inDem or bosUp or v16 == 1
    bool moneyOK = v10 == 1 and v11 != -1 and v12 == 1
    bool upTrend = v07 == 1 or v08 == 1
    bool momOK = score >= sigMin * 0.5
    bool trigOK = close > open and (v03 == 1 or v04 == 1)
    bool volOK = rvol >= 0.9
    int hits = (upTrend ? 1 : 0) + (locOK ? 1 : 0) + (momOK ? 1 : 0) + (moneyOK ? 1 : 0) + (trigOK ? 1 : 0) + (volOK ? 1 : 0)
    bool egxOK = liqOk and not chase
    bool buyA = sigOk and egxOK and locOK and moneyOK and hits >= minHits and score >= sigMin
    bool toolsPro = buyA and nG >= minGreen and hits >= minHits
    bool accumulating = cmf > 0 and obvSl > 0
    [score, buyA ? 1 : 0, toolsPro ? 1 : 0, hits, cmf, obvSl, accumulating ? 1 : 0, rvol]

[toolSc, toolBuy, toolsPro, toolHits, cmf, obvSl, accI, rvol] = f_tools()
bool accumulating = accI > 0

float pl = ta.pivotlow(low, 8, 8)
var float sl = na
if not na(pl)
    sl := pl
float atr = ta.atr(14)
float zw = atr * 0.35
bool nearSupport = low <= nz(sl, low) + zw and close >= nz(sl, low) - zw * 1.2
bool supportBreak = sigOk and not na(sl) and close < sl and close[1] >= sl

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimit and dPrev > 0 and (dayPct >= math.min(9.0, haltPct - 1.0) or dayPct >= luldPct - 0.25)

// ─── Vol B1 ───
f_bv(int off) =>
    float r = math.max(high[off] - low[off], syminfo.mintick)
    volume[off] * (close[off] - low[off]) / r

int bins = 24
int n = math.min(400, bar_index)
float hi = ta.highest(high, n)
float lo = ta.lowest(low, n)
float step = (hi - lo) / math.max(bins, 1)
step := step <= syminfo.mintick ? syminfo.mintick : step
array<float> buyB = array.new_float(bins, 0.0)
float tB = 0.0
float tS = 0.0
for i = 0 to n - 1
    float bV = f_bv(i)
    tS += volume[i] - bV
    tB += bV
    int bi = int(math.floor((close[i] - lo) / step))
    bi := math.max(0, math.min(bins - 1, bi))
    array.set(buyB, bi, array.get(buyB, bi) + bV)
float maxB = 0.0
int b1i = 0
for b = 0 to bins - 1
    if array.get(buyB, b) > maxB
        maxB := array.get(buyB, b)
        b1i := b
float pad = atr * 0.28
float bLo = lo + b1i * step - pad
float bHi = lo + (b1i + 1) * step + pad
float bMid = lo + (b1i + 0.5) * step
float netP = tB + tS > 0 ? tB / (tB + tS) * 100.0 : 50.0
bool inB1 = low <= bHi and high >= bLo
bool b1Bounce = inB1 and close > open and rvol >= 1.0 and close > bMid
float distLite = cmf < 0 and obvSl < 0 ? 55.0 : 35.0
bool volPro = (inB1 or b1Bounce) and netP >= volNetBuy and distLite < 55

// ─── Q-lite ───
float accQ = math.min(100.0, (accumulating ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0))
float distQ = math.min(100.0, (cmf < 0 and obvSl < 0 ? 35.0 : 0.0))
bool qBuy = sigOk and toolSc >= sigMin * 0.4 and accQ >= minQAcc and distQ < 50 and nearSupport and not supportBreak and not nearLimit

bool triple = toolsPro > 0 and volPro and qBuy

var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 4)
    table.cell(t, 0, 0, "T Meta", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, triple ? "TRIPLE" : toolsPro > 0 ? "T-Pro" : volPro ? "Vol" : "—", bgcolor=triple ? color.lime : color.new(color.gray, 40), text_size=size.small)
    table.cell(t, 0, 1, "Score", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(toolSc, "#") + "% · " + str.tostring(toolHits) + "/6", text_size=size.tiny)
    table.cell(t, 0, 2, "Vol Net", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(netP, "#") + "%", text_size=size.tiny)

plot(toolsPro, "EGXTMeta_ToolsPro", display=display.all)
plot(volPro ? 1 : 0, "EGXTMeta_VolPro", display=display.all)
plot(qBuy ? 1 : 0, "EGXTMeta_QBuy", display=display.all)
plot(triple ? 1 : 0, "EGXTMeta_Triple", display=display.all)
plot(nearLimit ? 1 : 0, "EGXTMeta_Limit", display=display.all)
plot(toolBuy, "EGXTMeta_ToolsBuy", display=display.all)
plot(toolSc, "EGXTMeta_Score", display=display.all)
plot(1, "EGXTMeta", display=display.all)

alertcondition(triple, "EGX T Meta — Triple", "{{ticker}} EGXTMeta Triple")

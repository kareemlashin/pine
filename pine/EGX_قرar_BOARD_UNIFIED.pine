//@version=6
indicator("EGX قرar — محفظة موحّدة (6/12/20/30/40)", shorttitle="EGX Q Port", overlay=false, max_tables_count=3, calc_bars_count=5000)

// ي replaces: WATCHLIST + BOARD + BOARD20 + PRESETS (مصدر واحد)
// EGXQWL_* · EGXQBD20_* · LeaderChange · PosPct محفظة

int MAX = 40
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G)
string G = "محفظة"
string symCountS = input.string("20", "عدد الرموز", options=["6", "12", "20", "30", "40"])
int symCount = int(str.tonumber(symCountS))
string preset = input.string("مخصص", "Preset", options=["مخصص", "عدّاء EGX", "EGX30 كبار", "فلسي / سيولة"])
string s01 = input.symbol("EGX:COMI", "01", group=G)
string s02 = input.symbol("EGX:SWDY", "02", group=G)
string s03 = input.symbol("EGX:TMGH", "03", group=G)
string s04 = input.symbol("EGX:HRHO", "04", group=G)
string s05 = input.symbol("EGX:FWRY", "05", group=G)
string s06 = input.symbol("EGX:UNIP", "06", group=G)
string s07 = input.symbol("EGX:ETEL", "07", group=G)
string s08 = input.symbol("EGX:OCDI", "08", group=G)
string s09 = input.symbol("EGX:SKPC", "09", group=G)
string s10 = input.symbol("EGX:PHDC", "10", group=G)
string s11 = input.symbol("EGX:ACGC", "11", group=G)
string s12 = input.symbol("EGX:CNIN", "12", group=G)
string s13 = input.symbol("EGX:AMER", "13", group=G)
string s14 = input.symbol("EGX:CIRA", "14", group=G)
string s15 = input.symbol("EGX:ESRS", "15", group=G)
string s16 = input.symbol("EGX:MFPC", "16", group=G)
string s17 = input.symbol("EGX:ORWE", "17", group=G)
string s18 = input.symbol("EGX:MNHD", "18", group=G)
string s19 = input.symbol("EGX:EGTS", "19", group=G)
string s20 = input.symbol("EGX:ABUK", "20", group=G)
string s21 = input.symbol("EGX:EMFD", "21", group=G)
string s22 = input.symbol("EGX:EFIH", "22", group=G)
string s23 = input.symbol("EGX:ADIB", "23", group=G)
string s24 = input.symbol("EGX:QNBE", "24", group=G)
string s25 = input.symbol("EGX:HDBK", "25", group=G)
string s26 = input.symbol("EGX:EAST", "26", group=G)
string s27 = input.symbol("EGX:ORAS", "27", group=G)
string s28 = input.symbol("EGX:JUFO", "28", group=G)
string s29 = input.symbol("EGX:GBCO", "29", group=G)
string s30 = input.symbol("EGX:CIEB", "30", group=G)
string s31 = input.symbol("EGX:CSAG", "31", group=G)
string s32 = input.symbol("EGX:DOMT", "32", group=G)
string s33 = input.symbol("EGX:HELI", "33", group=G)
string s34 = input.symbol("EGX:CCAP", "34", group=G)
string s35 = input.symbol("EGX:EXPA", "35", group=G)
string s36 = input.symbol("EGX:ICLE", "36", group=G)
string s37 = input.symbol("EGX:ISMA", "37", group=G)
string s38 = input.symbol("EGX:RAYA", "38", group=G)
string s39 = input.symbol("EGX:EGAL", "39", group=G)
string s40 = input.symbol("EGX:SUGR", "40", group=G)
string bench = input.symbol("EGX:EGX30", "EGX30", group=G)
int showTop = input.int(12, "عرض Top N", minval=4, maxval=40)
float posCap = input.float(12.0, "سقف % لكل سهم", minval=5, maxval=20)
bool alertLeaderChg = input.bool(true, "تنبيه تغيّر ★", group=G)

float benchRoc = request.security(bench, "D", ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off)

f_preset(int i) =>
    string p = preset == "عدّاء EGX" ? (i == 0 ? "EGX:UNIP" : i == 1 ? "EGX:CNIN" : i == 2 ? "EGX:AMER" : i == 3 ? "EGX:CIRA" : i == 4 ? "EGX:PHDC" : i == 5 ? "EGX:SKPC" : i == 6 ? "EGX:OCDI" : i == 7 ? "EGX:MFPC" : i == 8 ? "EGX:ORWE" : i == 9 ? "EGX:ESRS" : i == 10 ? "EGX:MNHD" : i == 11 ? "EGX:EGTS" : i == 12 ? "EGX:AMER" : i == 13 ? "EGX:CIRA" : i == 14 ? "EGX:ESRS" : i == 15 ? "EGX:MFPC" : i == 16 ? "EGX:ORWE" : i == 17 ? "EGX:MNHD" : i == 18 ? "EGX:EGTS" : "EGX:ABUK") : preset == "EGX30 كبار" ? (i == 0 ? "EGX:COMI" : i == 1 ? "EGX:SWDY" : i == 2 ? "EGX:TMGH" : i == 3 ? "EGX:HRHO" : i == 4 ? "EGX:FWRY" : i == 5 ? "EGX:ETEL" : i == 6 ? "EGX:OCDI" : i == 7 ? "EGX:SKPC" : i == 8 ? "EGX:PHDC" : i == 9 ? "EGX:ACGC" : i == 10 ? "EGX:CNIN" : i == 11 ? "EGX:ABUK" : "EGX:COMI") : preset == "فلسي / سيولة" ? (i == 0 ? "EGX:UNIP" : i == 1 ? "EGX:CNIN" : i == 2 ? "EGX:AMER" : i == 3 ? "EGX:ACGC" : "EGX:PHDC") : ""
    p

f_sym(int i) =>
    string pr = f_preset(i)
    pr != "" ? pr : i == 0 ? s01 : i == 1 ? s02 : i == 2 ? s03 : i == 3 ? s04 : i == 4 ? s05 : i == 5 ? s06 : i == 6 ? s07 : i == 7 ? s08 : i == 8 ? s09 : i == 9 ? s10 : i == 10 ? s11 : i == 11 ? s12 : i == 12 ? s13 : i == 13 ? s14 : i == 14 ? s15 : i == 15 ? s16 : i == 16 ? s17 : i == 17 ? s18 : i == 18 ? s19 : i == 19 ? s20 : i == 20 ? s21 : i == 21 ? s22 : i == 22 ? s23 : i == 23 ? s24 : i == 24 ? s25 : i == 25 ? s26 : i == 26 ? s27 : i == 27 ? s28 : i == 28 ? s29 : i == 29 ? s30 : i == 30 ? s31 : i == 31 ? s32 : i == 32 ? s33 : i == 33 ? s34 : i == 34 ? s35 : i == 35 ? s36 : i == 36 ? s37 : i == 37 ? s38 : i == 38 ? s39 : s40

float minVol = preset == "فلسي / سيولة" ? 400.0 : 800.0

f_decision() =>
    float atr = ta.atr(14)
    float volMa = ta.sma(volume, 20)
    bool liq = volMa >= minVol
    float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 20) / ta.sma(volume, 20)
    float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
    float acc = math.min(100.0, (cmf > 0 and obvSl > 0 ? 40.0 : 0.0) + (cmf > 0 ? 15.0 : 0.0))
    float dist = math.min(100.0, (cmf < 0 and obvSl < 0 ? 35.0 : 0.0))
    float hi = ta.highest(high, 252)
    float lo = ta.lowest(low, 252)
    float pctHi = hi > 0 ? (close - hi) / hi * 100.0 : 0.0
    float rocB = lo > 0 ? (close / lo - 1.0) * 100.0 : 0.0
    bool trap = rocB > 100 and pctHi < -28 and dist >= 38
    float rsi = ta.rsi(close, 14)
    bool chase = pctHi > -3 and rsi > 72
    float dPrevL = close[1]
    float dayPctL = dPrevL > 0 ? (close - dPrevL) / dPrevL * 100.0 : 0.0
    float haltPctL = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
    float luldPctL = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
    bool nearLimit = dayPctL >= math.min(9.0, haltPctL - 1.0) or dayPctL >= luldPctL - 0.25
    var float sl = na
    if not na(ta.pivotlow(low, 8, 8))
        sl := ta.pivotlow(low, 8, 8)
    bool supBr = not na(sl) and close < sl and close[1] >= sl
    float zw = atr * 0.35
    bool atZ = low <= nz(sl, low) + zw and close >= nz(sl, low) - zw * 1.2
    bool ret = not na(sl) and low <= sl * 1.006 and close > sl
    int cyc = acc >= 55 ? 4 : 3
    if dist >= 55
        cyc := 9
    bool rs = ta.roc(close, 20) - benchRoc > 0
    float rk = math.min(100.0, acc * 0.45 + (100.0 - dist) * 0.25 + (rs ? 12.0 : 0.0) + (atZ ? 8.0 : 0.0))
    float dna = math.min(100.0, (cyc <= 7 ? 15.0 : 0.0) + (acc >= 55 ? 25.0 : 0.0) + (dist < 45 ? 15.0 : 0.0) + (rs ? 10.0 : 0.0))
    bool buy = liq and acc >= 55 and dist < 50 and cyc >= 4 and cyc <= 7 and (atZ or ret) and not supBr and not chase and not trap and not nearLimit
    int act = supBr or trap ? 0 : buy ? 4 : 2
    [act, rk, buy ? 1.0 : 0.0, dna]

f_row(int i) =>
    request.security(f_sym(i), "D", f_decision(), barmerge.gaps_off, barmerge.lookahead_off)

int N = math.min(symCount, MAX)
float[] rkA = array.new_float(N, 0.0)
float[] buyA = array.new_float(N, 0.0)
for i = 0 to N - 1
    [ac, rk, bu, dn] = f_row(i)
    array.set(rkA, i, rk)
    array.set(buyA, i, bu)

int[] sorted = array.new_int(N, 0)
for k = 0 to N - 1
    array.set(sorted, k, k)
for i = 0 to N - 2
    for j = 0 to N - 2 - i
        int ia = array.get(sorted, j)
        int ib = array.get(sorted, j + 1)
        if array.get(rkA, ia) < array.get(rkA, ib)
            array.set(sorted, j, ib)
            array.set(sorted, j + 1, ia)

int leader = array.get(sorted, 0)
string leaderSym = f_sym(leader)
float leaderRk = array.get(rkA, leader)
bool leaderBuy = array.get(buyA, leader) > 0

int buyCnt = 0
for i = 0 to N - 1
    buyCnt := buyCnt + (array.get(buyA, i) > 0 ? 1 : 0)
float pctEach = buyCnt > 0 ? math.min(posCap, 100.0 / buyCnt) : na

var string lastLead = ""
bool leadChg = barstate.isconfirmed and leaderSym != lastLead and str.length(lastLead) > 0
if barstate.isconfirmed
    lastLead := leaderSym

if alertLeaderChg and leadChg
    alert("EGX ★ Leader → " + leaderSym + " R" + str.tostring(leaderRk, "#"), alert.freq_once_per_bar_close)

int rows = math.min(showTop, N)
var table tb = table.new(position.top_right, 5, 44, border_width=1)
if barstate.islast
    table.clear(tb, 0, 0, 4, rows + 2)
    table.cell(tb, 0, 0, "Q Port", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 0, preset, text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 2, 0, "N=" + str.tostring(N), text_size=size.tiny)
    for row = 0 to rows - 1
        int ix = array.get(sorted, row)
        table.cell(tb, 0, row + 1, str.tostring(row + 1), text_size=size.tiny)
        table.cell(tb, 1, row + 1, f_sym(ix), text_size=size.tiny, text_color=row == 0 ? color.lime : color.white)
        table.cell(tb, 2, row + 1, str.tostring(array.get(rkA, ix), "#"), text_size=size.tiny)
        table.cell(tb, 3, row + 1, array.get(buyA, ix) > 0 ? "B" : "—", text_color=array.get(buyA, ix) > 0 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tb, 0, rows + 1, "★", text_color=color.lime, text_size=size.small)
    table.cell(tb, 1, rows + 1, leaderSym, text_size=size.small)
    table.cell(tb, 2, rows + 1, "Buy:" + str.tostring(buyCnt), text_size=size.tiny)
    table.cell(tb, 3, rows + 1, not na(pctEach) ? "≈" + str.tostring(pctEach, "#.#") + "%/سهم" : "—", text_size=size.tiny)
    table.cell(tb, 0, rows + 2, "حد Pine", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 1, rows + 2, "40 رمز · 270 Screener", text_color=color.gray, text_size=size.tiny)

plot(leaderRk, "EGXQBD20_LeaderRank", display=display.data_window)
plot(leaderBuy ? 1 : 0, "EGXQBD20_LeaderBuy", display=display.data_window)
plot(buyCnt, "EGXQBD20_BuyCount", display=display.data_window)
plot(leadChg ? 1 : 0, "EGXQWL_LeaderChange", display=display.data_window)
plot(pctEach, "EGXQWL_PosPctEach", display=display.data_window)
plot(buyCnt > 0 ? 1 : 0, "EGXQWL_Pass", display=display.data_window)
plot(1, "EGXQWL", display=display.data_window)

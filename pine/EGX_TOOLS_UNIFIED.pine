//@version=6
indicator("EGX TOOLS Unified — فني + Vol + Tools", shorttitle="EGX T Uni", overlay=false, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// EGXUni + Tools lite · Filter: EGXTUni_Pro=1 · EGXTUni_Pass=1
// ═══════════════════════════════════════════════════════════════════════════════

string profile = input.string("EGX قياسي", "ملف", options=["EGX قياسي", "مضاربة 15د", "استثمار يومي"])
float minVolRank = input.float(60.0, "Vol Rank", minval=40, maxval=90)
float minToolRank = input.float(55.0, "Tools Rank", minval=30, maxval=90)
float sigMin = input.float(20.0, "Tools Score %", minval=10, maxval=45)
int minHits = input.int(5, "Tools Hits Pro", minval=3, maxval=6)
bool confirmClose = input.bool(true, "إغلاق")
string bench = input.symbol("EGX:EGX30", "EGX30")
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"])
bool blockLimit = input.bool(true, "منع قرب halt/LULD")

bool sigOk = not confirmClose or barstate.isconfirmed
float effMinVol = profile == "مضاربة 15د" ? 3000.0 : profile == "استثمار يومي" ? 800.0 : 1500.0

// ─── فني (مختصر) ───
float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
bool bullStack = ema9 > ema21 and ema21 > ema50
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdBull = macdH > 0 and macdL > macdS
float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= effMinVol
float rvol = volume / math.max(volMa, 1.0)
float cmf = ta.sma(((close - low) - (high - close)) / math.max(high - low, syminfo.mintick) * volume, 14) / ta.sma(volume, 14)
float obvSl = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
bool accumulating = cmf > 0 and obvSl > 0
float techRank = math.min(100.0, (bullStack ? 25.0 : 0.0) + (macdBull ? 15.0 : 0.0) + (accumulating ? 20.0 : 0.0) + (rvol >= 1.0 ? 15.0 : 0.0))
bool techPass = techRank >= 50 and liqOk

// ─── Vol rank ───
float pct = ta.percentrank(volume, 500)
float z = (volume - volMa) / math.max(ta.stdev(volume, 20), 1.0)
float volRankScore = math.min(100.0, pct * 0.35 + math.min(rvol, 3.0) / 3.0 * 100.0 * 0.35 + (cmf > 0 ? 15.0 : 0.0) + (obvSl > 0 ? 15.0 : 0.0))
bool volPass = volRankScore >= minVolRank

// ─── Tools lite ───
float ema20 = ta.ema(close, 20)
float ema200 = ta.ema(close, 200)
float rsi = ta.rsi(close, 14)
[diP, diM, adx] = ta.dmi(14, 14)
[stLine, stDir] = ta.supertrend(3.0, 10)
bool inDem = close <= ta.highest(high, 80) - 0.618 * (ta.highest(high, 80) - ta.lowest(low, 80)) and close >= ta.lowest(low, 80)
bool bosUp = close > ta.highest(high, 20)[1]
int sc = 0
sc += rsi > 52 and rsi < 68 ? 1 : -1
sc += macdH > 0 ? 1 : -1
sc += close > ema50 ? 1 : -1
sc += stDir < 0 ? 1 : -1
sc += cmf > 0 ? 1 : -1
sc += obvSl > 0 ? 1 : -1
sc += bosUp or inDem ? 1 : 0
sc += rvol >= 1.0 ? 1 : 0
float toolScore = sc / 8.0 * 100.0
bool locOK = inDem or bosUp
bool moneyOK = cmf > 0 and obvSl > 0
int hits = (close > ema50 ? 1 : 0) + (locOK ? 1 : 0) + (toolScore >= sigMin * 0.5 ? 1 : 0) + (moneyOK ? 1 : 0) + (close > open ? 1 : 0) + (rvol >= 0.9 ? 1 : 0)
float toolRank = math.min(100.0, toolScore * 0.6 + hits / 6.0 * 40.0)
bool toolBuyA = sigOk and liqOk and locOK and moneyOK and hits >= minHits and toolScore >= sigMin
bool toolPass = toolRank >= minToolRank * 0.85 and hits >= 3

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctU = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPctU = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPctU = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimit and dPrev > 0 and (dayPctU >= math.min(9.0, haltPctU - 1.0) or dayPctU >= luldPctU - 0.25)
bool chase = ta.highest(high, 252) > 0 and (close - ta.highest(high, 252)) / ta.highest(high, 252) * 100.0 > -3 and rsi > 72
bool noVeto = not nearLimit and not chase and liqOk

bool uniPass = sigOk and noVeto and techPass and toolPass and volPass
bool uniPro = uniPass and toolBuyA and techRank >= 60 and volRankScore >= minVolRank + 5 and toolRank >= minToolRank

float uniScore = techRank * 0.30 + volRankScore * 0.30 + toolRank * 0.40

var table t = table.new(position.middle_center, 2, 6, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 5)
    table.cell(t, 0, 0, syminfo.ticker, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, uniPro ? "T-Uni Pro" : uniPass ? "Pass" : "—", text_color=uniPro ? color.lime : uniPass ? color.yellow : color.gray, text_size=size.normal)
    table.cell(t, 0, 1, "Tech/Vol/Tools", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(techRank, "#") + " / " + str.tostring(volRankScore, "#") + " / " + str.tostring(toolRank, "#"), text_size=size.small)
    table.cell(t, 0, 2, "Hits · Score", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(hits) + "/6 · " + str.tostring(toolScore, "#") + "%", text_size=size.small)
    table.cell(t, 0, 3, "UniScore", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(uniScore, "#"), text_color=uniPro ? color.lime : color.white, text_size=size.small)

plot(techRank, "EGXTUni_Tech", display=display.all)
plot(volRankScore, "EGXTUni_VolRank", display=display.all)
plot(toolRank, "EGXTUni_ToolRank", display=display.all)
plot(toolScore, "EGXTUni_ToolScore", display=display.all)
plot(uniScore, "EGXTUni_Score", display=display.all)
plot(uniPass ? 1 : 0, "EGXTUni_Pass", display=display.all)
plot(uniPro ? 1 : 0, "EGXTUni_Pro", display=display.all)
plot(toolBuyA ? 1 : 0, "EGXTUni_ToolsBuyA", display=display.all)
plot(1, "EGXTUni", display=display.all)

alertcondition(uniPro, "EGX T Uni — Pro", "{{ticker}} EGXTUni Pro")

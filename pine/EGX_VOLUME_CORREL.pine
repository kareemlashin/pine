//@version=6
indicator("EGX Volume Correlation — |ΔP| vs V", shorttitle="EGX VCor", overlay=false, max_tables_count=2, calc_bars_count=5000)

// ارتباط حركة سعر وحجم · docs/EGX_VOLUME.md

string G = "Correl"
int len = input.int(20, "Window", minval=10, group=G)
float minCor = input.float(0.45, "Min |corr|", step=0.05, group=G)

float absRet = math.abs(ta.roc(close, 1))
float vNorm = volume / math.max(ta.sma(volume, len), 1.0)
float cor = ta.correlation(absRet, vNorm, len)

bool sync = cor >= minCor
bool weak = cor <= -minCor

plot(cor, "EGVCor_Val", color=cor >= 0 ? color.lime : color.red, linewidth=2, display=display.all)
hline(minCor, "+", color=color.gray, linestyle=hline.style_dashed)
hline(-minCor, "-", color=color.gray, linestyle=hline.style_dashed)
hline(0, "0", color=color.gray)

var table t = table.new(position.top_right, 2, 2, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 1)
    table.cell(t, 0, 0, "Cor |ΔP|,V", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(cor, "#.##"), text_size=size.tiny)

plot(sync ? 1 : 0, "EGVCor_Sync", display=display.all)
plot(weak ? 1 : 0, "EGVCor_Weak", display=display.all)

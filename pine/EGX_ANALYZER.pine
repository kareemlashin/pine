bgcolor(showDecBg and not uiClear ? (accumulating ? color.new(color.green, 92) : distributing ? color.new(color.red, 92) : na) : na)
bgcolor(useEgxSession and inEgxSession and not showDecBg ? color.new(color.blue, 97) : na, title="جلسة EGX")
bgcolor(showCycleBg and not uiClear and useCycle12 and cycle12 >= 6 and cycle12 <= 8 ? color.new(color.green, 97) : showCycleBg and not uiClear and useCycle12 and (cycle12 == 9 or cycle12 == 11) ? color.new(color.red, 97) : na)

var string patSummary = "—"
var string dnaSummary = "—"
var string preRallyTxt = "—"
var int preRallyMatch = 0
var float preRallyRvPre = na
var float patMed20 = na
var label lblV1 = na
var label lblV2 = na
var label lblV3 = na

f_patFeat(int off) =>
    float atrO = atr[off]
    float rvO = volMa[off] > 0 ? volume[off] / volMa[off] : 1.0
    float supO = lastSwingLow[off]
    float distSup = not na(supO) and atrO > 0 ? (close[off] - supO) / atrO : 0.0
    [distSup, rvO, rsi[off]]

f_patSimPct(int off) =>
    [d0, r0, x0] = f_patFeat(0)
    [d1, r1, x1] = f_patFeat(off)
    float sim = 100.0
    sim -= math.min(40.0, math.abs(d0 - d1) * 15.0)
    sim -= math.min(35.0, math.abs(r0 - r1) * 12.0)
    sim -= math.min(25.0, math.abs(x0 - x1) * 0.8)
    math.max(0.0, sim)

f_fwdPct(int off, int n) =>
    off >= n and off < bar_index ? (close[off - n] - close[off]) / close[off] * 100.0 : na

if barstate.islast
    patSummary := "—"
    dnaSummary := "—"
    if usePatSim
        int lbPat = math.min(patLook, bar_index - 25)
        lbPat := math.max(lbPat, 25)
        int nPat = 0
        float sum20 = 0.0
        array<float> ret20s = array.new_float()
        for off = 12 to lbPat
            if f_patSimPct(off) >= patMinSim
                float f20 = f_fwdPct(off, 20)
                if not na(f20)
                    nPat += 1
                    sum20 += f20
                    array.push(ret20s, f20)
        if nPat >= 3
            array.sort(ret20s, order.ascending)
            patMed20 := array.get(ret20s, int(array.size(ret20s) / 2))
            patSummary := "n=" + str.tostring(nPat) + " · وسيط+20 " + str.tostring(patMed20, "#.#") + "% · μ " + str.tostring(sum20 / nPat, "#.#") + "%"
        else
            patMed20 := na
            patSummary := f_txt("عينة تشابه غير كافية", "")
    if useDnaLite
        int spanDna = bar_index - nz(lastSwingLowBar, bar_index)
        dnaSummary := not na(lastSwingLow) ? "قاع " + str.tostring(spanDna) + "ش · مدى " + str.tostring(swingRange / math.max(close, syminfo.mintick) * 100.0, "#.#") + "%" : "—"
    preRallyTxt := "—"
    preRallyMatch := 0
    preRallyRvPre := na
    if usePreRally
        int lbRally = math.min(patLook, bar_index - 45)
        lbRally := math.max(lbRally, 45)
        int nRally = 0
        int nMatch = 0
        float sumRvPre = 0.0
        for off = 30 to lbRally
            if not na(pls[off])
                float f40 = f_fwdPct(off, 40)
                if not na(f40) and f40 >= 10.0
                    nRally += 1
                    float rvPre = 0.0
                    int cnt = 0
                    for k = 0 to 9
                        if volMa[off + k] > 0
                            rvPre += volume[off + k] / volMa[off + k]
                            cnt += 1
                    rvPre := cnt > 0 ? rvPre / cnt : na
                    sumRvPre += nz(rvPre)
                    if f_patSimPct(off) >= patMinSim - 5.0
                        nMatch += 1
        float avgRvPre = nRally > 0 ? sumRvPre / nRally : na
        preRallyMatch := nMatch
        preRallyRvPre := avgRvPre
        preRallyTxt := nRally >= 3 ? f_txt("موجات +10%/40ش n=", "") + str.tostring(nRally) + f_txt(" RVOL قبل ~", "") + str.tostring(avgRvPre, "#.##") + f_txt(" | تشابه ", "") + str.tostring(nMatch) + f_txt(" | RVOL ", "") + str.tostring(rvol, "#.##") : f_txt("قبل موجة: عينة غير كافية", "")

bool preRallySig = usePreRally and buyZoneActive and atSupport and cycle12 >= 4 and cycle12 <= 7 and accumScore100 >= 55 and rvol >= 1.1 and not na(preRallyRvPre) and preRallyMatch >= 1 and rvol >= preRallyRvPre * 0.75

var table topVolTbl = table.new(position.bottom_center, 5, 8, border_width=1)
var string topVolSummary = "—"

if barstate.islast and (showTopVol or showTable)
    int scanLenTv = math.min(volScanLenTop, bar_index - 1)
    scanLenTv := math.max(scanLenTv, 1)
    array<int> pickedTv = array.new_int()
    int ranksTv = math.min(topVolN, 7)
    topVolSummary := "—"
    if effShowTopVolTbl
        table.clear(topVolTbl, 0, 0, 4, 7)
        color vHdr = color.new(color.black, 15)
        table.cell(topVolTbl, 0, 0, f_txt("أعلى حجم", "Top vol"), bgcolor=vHdr, text_color=color.yellow, text_size=size.small)
        table.cell(topVolTbl, 1, 0, str.tostring(scanLenTv) + f_txt(" ش", " b"), bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
        table.cell(topVolTbl, 2, 0, f_txt("سعر", "Px"), bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
        table.cell(topVolTbl, 3, 0, "RVOL", bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
        table.cell(topVolTbl, 4, 0, showVolFwdCol ? "+20ش" : "—", bgcolor=vHdr, text_color=color.white, text_size=size.tiny)
    label.delete(lblV1)
    label.delete(lblV2)
    label.delete(lblV3)
    lblV1 := na
    lblV2 := na
    lblV3 := na
    for rank = 0 to ranksTv - 1
        float bestV = -1.0
        int bestOff = -1
        for off = 1 to scanLenTv
            bool used = false
            for u = 0 to array.size(pickedTv) - 1
                if array.get(pickedTv, u) == off
                    used := true
            if not used and volume[off] > bestV
                bestV := volume[off]
                bestOff := off
        int row = rank + 1
        if bestOff > 0 and row <= 7
            array.push(pickedTv, bestOff)
            float vAvgAt = ta.sma(volume, volMaLen)[bestOff]
            float rAt = vAvgAt > 0 ? volume[bestOff] / vAvgAt : na
            float fwd20v = f_fwdPct(bestOff, 20)
            if rank == 0
                topVolSummary := str.tostring(bestOff) + f_txt("ش ", "b ") + "V" + str.tostring(volume[bestOff], "#") + " RVOL" + str.tostring(rAt, "#.#") + (showVolFwdCol and not na(fwd20v) ? " +20:" + str.tostring(fwd20v, "#.#") + "%" : "")
            if markVolV123 and rank == 0
                lblV1 := label.new(bar_index - bestOff, high[bestOff], "ح1", style=label.style_label_down, color=color.new(color.fuchsia, 20), textcolor=color.white, size=size.tiny)
            else if markVolV123 and rank == 1
                lblV2 := label.new(bar_index - bestOff, high[bestOff], "ح2", style=label.style_label_down, color=color.new(color.fuchsia, 35), textcolor=color.white, size=size.tiny)
            else if markVolV123 and rank == 2
                lblV3 := label.new(bar_index - bestOff, high[bestOff], "ح3", style=label.style_label_down, color=color.new(color.fuchsia, 50), textcolor=color.white, size=size.tiny)
            if effShowTopVolTbl
                table.cell(topVolTbl, 0, row, "#" + str.tostring(rank + 1) + " " + str.tostring(bestOff) + f_txt("ش", "b"), text_color=color.white, text_size=size.tiny)
                table.cell(topVolTbl, 1, row, str.tostring(volume[bestOff], "#"), text_color=color.white, text_size=size.tiny)
                table.cell(topVolTbl, 2, row, str.tostring(close[bestOff], format.mintick), text_color=color.white, text_size=size.tiny)
                table.cell(topVolTbl, 3, row, str.tostring(rAt, "#.##"), text_color=color.fuchsia, text_size=size.tiny)
                table.cell(topVolTbl, 4, row, showVolFwdCol and not na(fwd20v) ? str.tostring(fwd20v, "#.#") + "%" : "—", text_color=not na(fwd20v) and fwd20v > 0 ? color.lime : color.gray, text_size=size.tiny)

var table tbl = table.new(position.top_right, 2, 48, bgcolor=color.new(color.black, 85), border_width=1)

if showTable and barstate.islast
    table.clear(tbl, 0, 0, 1, 47)
    table.cell(tbl, 0, 0, f_txt("EGX محلل v6.6", "EGX محلل v6.6"), text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, 0, tradeMode, text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, f_txt("قرار", "Decision"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 1, primaryDec, text_color=decCol, text_size=size.small)
    table.cell(tbl, 0, 2, f_txt("التقييم", "Score"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(score, "#") + " | م" + str.tostring(scoreSpec, "#") + " س" + str.tostring(scoreInv, "#") + " Δ" + str.tostring(scoreMom, "#"), text_color=score >= 70 ? color.lime : score >= 50 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 3, f_txt("رتبة / إعداد", "Rank / Setup"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(egxRank, "#") + " · " + setupTier + " (" + str.tostring(setupHits) + "/11)" + (effSetupGate and not setupOk ? " ✗" : "") + " · " + egxProfile, text_color=setupTier == "A" ? color.lime : setupTier == "B" ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 4, f_txt("EGX/عالمي", "EGX/Global"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 4, globTxt + " (" + str.tostring(globBull) + ")", text_color=globBull >= 5 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 5, f_txt("R/R → T1", "R/R → T1"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(rrRatio, "#.##") + "x", text_color=rrRatio >= minRR ? color.lime : color.orange, text_size=size.small)
    table.cell(tbl, 0, 6, f_txt("أطر متعددة", "MTF"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 6, mtfTxt, text_color=mtfBullOk ? color.lime : mtfBearWarn ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 7, f_txt("اتجاه أعلى · ADX", "HTF · ADX"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 7, (htfBull ? "↑HTF" : "↓HTF") + " ADX" + str.tostring(adx, "#") + " " + (macdBull ? "MACD+" : "MACD-"), text_color=htfBull and adxStrong ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 8, f_txt("فوليوم", "Volume"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 8, (isHistMaxVol or atLookbackVolHigh ? "قمة" : volSpike ? "قفزة" : "عادي") + " P" + str.tostring(volPctRank, "#"), text_color=isHistMaxVol ? color.yellow : volSpike ? color.fuchsia : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 9, f_txt("دعم/قاع", "Support"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 9, supportBreak ? "كسر" : bottomConfirm ? "قاع✓" : atSupport ? "عند دعم" : "—", text_color=supportBreak ? color.red : bottomConfirm ? color.aqua : atSupport ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 10, f_txt("RSI / مذبذبات", "RSI / Osc"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 10, "RSI " + str.tostring(rsi, "#.#") + " · CCI " + str.tostring(cci, "#") + " · %R " + str.tostring(willR, "#"), text_color=cciOsBounce or willROversold ? color.aqua : color.white, text_size=size.tiny)
    table.cell(tbl, 0, 11, f_txt("موجي", "Wave"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 11, waveHint + " · إلغ " + str.tostring(waveInv, format.mintick), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 12, f_txt("زمني", "Time"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 12, gannAlign ? "Gann+" : cycleAlign ? "دورة" : str.tostring(barsSinceLow) + " ش", text_color=gannAlign or cycleAlign ? color.aqua : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 13, f_txt("52 أسبوع", "52W"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 13, str.tostring(pctFromLo, "#.#") + "%↑قاع " + str.tostring(pctFromHi, "#.#") + "%↓قمة", text_color=near52Lo ? color.lime : extended52 ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 14, f_txt("دخول / وقف", "Entry / SL"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 14, str.tostring(entryIdeal, format.mintick) + " · " + str.tostring(stopLoss, format.mintick), text_color=color.lime, text_size=size.tiny)
    table.cell(tbl, 0, 15, f_txt("أهداف", "Targets"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 15, tgtPack, text_color=color.aqua, text_size=size.tiny)
    table.cell(tbl, 0, 16, f_txt("أهداف %", "Targets %"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 16, tgtPct + " · " + clusterTxt, text_color=targetCluster ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 17, f_txt("إشارة", "Signal"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 17, screenerPro ? f_txt("✓ احترافي", "✓ Pro") : screenerPass ? f_txt("✓ ماسح", "✓ Screener") : buyConfluence ? "✓ شراء" : earlyBuyHint ? "? مبكر" : sellConfluence ? "⚠ مقاومة" : score >= 50 ? "راقب" : "ضعيف", text_color=screenerPro or screenerPass ? color.lime : buyConfluence ? color.lime : earlyBuyHint ? color.yellow : sellConfluence ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 0, 18, f_txt("MFI / RVOL", "MFI / RVOL"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 18, str.tostring(mfi, "#") + " · RV " + str.tostring(rvol, "#.##") + (useMultiRvol ? "/" + str.tostring(rvol252, "#.#") : "") + "x" + (rvol252Climax ? "!" : ""), text_color=mfiAccum ? color.lime : rvolStrong ? color.fuchsia : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 19, f_txt("سيولة EGX", "EGX liq"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 19, liqTier + (na(liqPct) ? "" : " " + str.tostring(liqPct, "#.##") + "%"), text_color=liqTier == "عالي" or liqTier == "جيد" ? color.lime : liqTier == "ضعيف" ? color.red : color.orange, text_size=size.tiny)
    table.cell(tbl, 0, 20, f_txt("Wyckoff", "Wyckoff"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 20, sellingClimax ? "تجم SC" : buyingClimax ? "تصريف BC" : "—", text_color=sellingClimax ? color.lime : buyingClimax ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 21, f_txt("RS EGX30/70", "RS EGX30/70"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 21, (rsLeader ? "+" : "") + str.tostring(rsSpread, "#.#") + "%" + (useRs70 ? " ·70 " + str.tostring(rsSpread70, "#.#") + "%" : ""), text_color=rsLeader ? color.lime : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 22, f_txt("هيكل", "Structure"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 22, structEvent, text_color=structDir == 1 ? color.teal : structDir == -1 ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 23, f_txt("POC | AVWAP", "POC | AVWAP"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 23, str.tostring(pocProxy, format.mintick) + " | " + str.tostring(avwap, format.mintick), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 24, f_txt("نقاط محورية", "Pivots"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 24, "محور " + str.tostring(pp, format.mintick) + " · د2/م2 " + str.tostring(s2, format.mintick) + "/" + str.tostring(r2, format.mintick), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 25, f_txt("Stoch / منطقة", "Stoch / Zone"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 25, "K" + str.tostring(stochK, "#") + " · " + (retestSupport ? "إعادة↑" : retestResist ? "إعادة↓" : inDemandZone ? "طلب" : inSupplyZone ? "عرض" : "—"), text_color=retestSupport ? color.lime : retestResist ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 26, f_txt("MTF / بيانات", "MTF / data"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 26, "Σ" + str.tostring(mtfBias) + " · " + str.tostring(mtfBulls) + "/" + str.tostring(mtfCount) + (dataThin ? " · ⚠حجم" : ""), text_color=mtfBullOk ? color.lime : mtfBearWarn ? color.red : dataThin ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 27, f_txt("تنفيذ EGX", "EGX exec"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 27, (not liqOk ? "⚠ حجم منخفض" : "سيولة OK") + " · عمولة ~0.125%", text_color=not liqOk ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 28, f_txt("د1 | م1", "S1 | R1"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 28, str.tostring(s1, format.mintick) + " | " + str.tostring(r1, format.mintick), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 29, f_txt("تجم / تصريف", "Acc / Dist"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 29, accDistTxt, text_color=accumScore100 >= 55 and distRisk100 < 45 ? color.lime : distRisk100 >= 55 ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 30, f_txt("اختراق", "Breakout"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 30, breakState + (squeezeOn ? " · تماسك" : ""), text_color=breakConfirmed or breakRetest ? color.lime : breakFailed ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 31, f_txt("Ichi / هبوط", "Ichi / Down"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 31, ichiTxt + (useWavePhase ? " · مر" + str.tostring(wavePhaseId) : "") + (chaseWarn ? " · !مطاردة" : "") + (inEgxSession ? " · جلسة✓" : ""), text_color=ichiBull ? color.lime : ichiBear ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 32, f_txt("الفرصة", "Opportunity"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 32, useOppScore ? str.tostring(opportunity, "#") + " · " + oppClass : "—", text_color=useOppScore and opportunity >= oppBuyMin ? color.lime : useOppScore and opportunity >= oppBuyMin - 10 ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 33, f_txt("خطط دخول", "Entry plans"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 33, planPackShort, text_color=showEntryPlans ? color.white : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 34, f_txt("أعلى حجم #1", "Top vol #1"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 34, topVolSummary, text_color=color.fuchsia, text_size=size.tiny)
    table.cell(tbl, 0, 35, f_txt("DCA×3", "DCA3"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 35, showEntryPlans ? str.tostring(planDca3, format.mintick) + " (200EMA)" : "—", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 36, f_txt("دورة 12", "Cycle 12"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 36, cycle12Txt + (cycleHint != "—" ? " · " + cycleHint : ""), text_color=cycle12 >= 4 and cycle12 <= 7 ? color.lime : cycle12 >= 9 ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 37, f_txt("دراسة الحدث", "Event study"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 37, eventStudyTxt, text_color=not na(fwd60Pct) and fwd60Pct > 0 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 38, f_txt("نظام السوق", "Regime"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 38, regimeName + " · " + mktPackTxt, text_color=heavySellMkt ? color.red : broadUpMkt ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 39, f_txt("كيلي / حجم", "Kelly"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 39, kellyTxt + (bearRegimeBlock ? " · منع شراء" : ""), text_color=not na(kellyPct) and kellyPct >= 5 ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 40, f_txt("تشابه تاريخي", "Pattern"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 40, patSummary, text_color=color.aqua, text_size=size.tiny)
    table.cell(tbl, 0, 41, f_txt("DNA موجي", "DNA"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 41, dnaSummary, text_color=color.white, text_size=size.tiny)
    if showBuyGatesRow
        table.cell(tbl, 0, 42, f_txt("بوابات شراء", "Buy gates"), text_color=color.gray, text_size=size.tiny)
        table.cell(tbl, 1, 42, gatesTxt + " · " + lvlStrengthTxt, text_color=gatesPass >= 8 ? color.lime : gatesPass >= 6 ? color.yellow : color.gray, text_size=size.tiny)
    if showOppBreakRow
        table.cell(tbl, 0, 43, f_txt("توزيع فرصة", "Opp mix"), text_color=color.gray, text_size=size.tiny)
        table.cell(tbl, 1, 43, oppBreakTxt, text_color=color.white, text_size=size.tiny)
    if showPreRallyRow
        table.cell(tbl, 0, 44, f_txt("قبل موجة", "Pre-rally"), text_color=color.gray, text_size=size.tiny)
        table.cell(tbl, 1, 44, usePreRally ? preRallyTxt : "—", text_color=preRallyMatch >= 1 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 45, f_txt("إلغاء / سيناريو", "Invalidate"), text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 45, invalidateTxt, text_color=color.orange, text_size=size.tiny)
    table.cell(tbl, 0, 46, f_txt("توصية", "Action"), text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 46, actionTxt + " · " + sessionHudTxt, text_color=actionCode == 3 ? color.lime : actionCode == 2 ? color.yellow : actionCode == 0 ? color.red : color.gray, text_size=size.tiny)
    if showGateMatrix
        table.cell(tbl, 0, 47, f_txt("مصفوفة بوابات", "Gate matrix"), text_color=color.gray, text_size=size.tiny)
        table.cell(tbl, 1, 47, gatesMatrixTxt, text_color=gatesPass >= 8 ? color.lime : color.gray, text_size=size.tiny)

var table quickHud = table.new(position.top_left, 1, 9, bgcolor=color.new(color.black, 82), border_width=1)

if effShowQuickHud and barstate.islast
    table.clear(quickHud, 0, 0, 0, 8)
    table.cell(quickHud, 0, 0, primaryDec, bgcolor=color.new(decCol, 80), text_color=color.white, text_size=size.small)
    table.cell(quickHud, 0, 1, "رتبة " + str.tostring(egxRank, "#") + " · " + setupTier + " · " + str.tostring(score, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(quickHud, 0, 2, (useOppScore ? "فرصة " + str.tostring(opportunity, "#") + " " + oppClass : "—"), text_color=color.yellow, text_size=size.tiny)
    table.cell(quickHud, 0, 3, gatesTxt + " · R/R " + str.tostring(rrRatio, "#.#"), text_color=gatesPass >= 8 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(quickHud, 0, 4, (useCycle12 ? cycle12Txt : "—") + " · " + breakState, text_color=color.aqua, text_size=size.tiny)
    table.cell(quickHud, 0, 5, screenerPro ? "✓ ماسح Pro" : screenerPassGates ? "✓ ماسح" : screenerPass ? "◐ ماسح" : "—", text_color=screenerPro or screenerPassGates ? color.lime : color.gray, text_size=size.tiny)
    table.cell(quickHud, 0, 6, kellyTxt, text_color=color.gray, text_size=size.tiny)
    table.cell(quickHud, 0, 7, actionTxt, text_color=actionCode == 3 ? color.lime : actionCode == 2 ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(quickHud, 0, 8, sessionHudTxt, text_color=inEgxSession ? color.aqua : color.gray, text_size=size.tiny)

var table mmPanel = table.new(position.middle_left, 2, 8, bgcolor=color.new(color.black, 88), border_width=1)
// mmPanel: middle_left — يُخفى في الوضع الواضح عند تفعيل الجدول الرئيسي

if effShowMm and barstate.islast
    table.clear(mmPanel, 0, 0, 1, 7)
    table.cell(mmPanel, 0, 0, f_txt("سيناريوهات", "MM"), bgcolor=color.new(#1a237e, 10), text_color=color.yellow, text_size=size.small)
    table.cell(mmPanel, 1, 0, syminfo.ticker, bgcolor=color.new(#1a237e, 10), text_color=color.white, text_size=size.tiny)
    table.cell(mmPanel, 0, 1, f_txt("أساس", "Base"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 1, scenBase, text_color=color.white, text_size=size.tiny)
    table.cell(mmPanel, 0, 2, f_txt("صاعد", "Bull"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 2, scenBull, text_color=color.lime, text_size=size.tiny)
    table.cell(mmPanel, 0, 3, f_txt("هابط", "Bear"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 3, scenBear, text_color=scenBear != "—" ? color.orange : color.gray, text_size=size.tiny)
    table.cell(mmPanel, 0, 4, f_txt("إلغاء", "Inv"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 4, invalidateTxt, text_color=color.red, text_size=size.tiny)
    table.cell(mmPanel, 0, 5, f_txt("مستويات", "Lvls"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 5, lvlStrengthTxt + " · " + kellyTxt, text_color=color.aqua, text_size=size.tiny)
    table.cell(mmPanel, 0, 6, f_txt("توصية", "Action"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 6, actionTxt, text_color=actionCode == 3 ? color.lime : actionCode == 2 ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(mmPanel, 0, 7, f_txt("بوابات", "Gates"), text_color=color.gray, text_size=size.tiny)
    table.cell(mmPanel, 1, 7, showGateMatrix ? gatesMatrixTxt : gatesTxt, text_color=gatesPass >= 8 ? color.lime : color.gray, text_size=size.tiny)

var table banner = table.new(position.bottom_right, 1, 8, bgcolor=color.new(color.black, 10), border_width=2)

if effShowBanner and barstate.islast
    table.clear(banner, 0, 0, 0, 7)
    table.cell(banner, 0, 0, "EGX — " + primaryDec, bgcolor=color.new(decCol, 75), text_color=color.white, text_size=size.large)
    table.cell(banner, 0, 1, "رتبة " + str.tostring(egxRank, "#") + " · " + setupTier + " · تقييم " + str.tostring(score, "#") + " · R/R " + str.tostring(rrRatio, "#.#"), bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(banner, 0, 2, "مضاربة " + (specOk ? "✓" : "—") + " (" + str.tostring(scoreSpec, "#") + ") · استثمار " + (invOk ? "✓" : "—") + " (" + str.tostring(scoreInv, "#") + ")", bgcolor=color.new(color.gray, 88), text_color=color.white, text_size=size.tiny)
    table.cell(banner, 0, 3, (useMktRegime ? regimeName + " · " : "") + globTxt + " · " + mtfTxt + " · " + breakState, bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=size.tiny)
    table.cell(banner, 0, 4, waveHint + " · " + structEvent + " · " + (useCycle12 ? cycle12Txt : gannAlign ? "Gann" : str.tostring(barsSinceLow) + " شموع"), bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=size.tiny)
    table.cell(banner, 0, 5, tgtPct + " · " + clusterTxt, bgcolor=color.new(color.green, 88), text_color=color.white, text_size=size.tiny)
    table.cell(banner, 0, 6, accDistTxt + " · " + (useWavePhase ? wavePhaseTxt : "") + (chaseWarn ? " · مطاردة!" : "") + (trailOn ? " · وقف متحرك" : ""), bgcolor=color.new(color.gray, 92), text_color=color.white, text_size=size.tiny)
    table.cell(banner, 0, 7, (useOppScore ? "فرصة " + str.tostring(opportunity, "#") + " " + oppClass + " · " : "") + (showEntryPlans ? planPackShort : ""), bgcolor=color.new(color.rgb(40, 35, 20), 80), text_color=color.yellow, text_size=size.tiny)

plot(score, "EGX_Score", display=display.data_window)
plot(scoreSpec, "EGX_ScoreSpec", display=display.data_window)
plot(scoreInv, "EGX_ScoreInv", display=display.data_window)
plot(nearLimit ? 1 : 0, "EGX_NearLimit", display=display.data_window)
plot(buyConfluence ? 1 : 0, "EGX_BuyFlag", display=display.data_window)
plot(rsSpread, "EGX_RS_Spread", display=display.data_window)
plot(rrRatio, "EGX_RR", display=display.data_window)
plot(globBull, "EGX_GlobBull", display=display.data_window)
plot(mtfBias, "EGX_MtfBias", display=display.data_window)
plot(bottomConfirm ? 1 : 0, "EGX_BottomFlag", display=display.data_window)
plot(targetCluster ? 1 : 0, "EGX_ClusterFlag", display=display.data_window)
plot(supportBreak ? 1 : 0, "EGX_SupportBreak", display=display.data_window)
plot(orbBreakUp ? 1 : 0, "EGX_ORB_Up", display=display.data_window)
plot(egxRank, "EGX_Rank", display=display.data_window)
plot(setupHits, "EGX_SetupHits", display=display.data_window)
plot(scoreMom, "EGX_ScoreMom", display=display.data_window)
plot(setupTierNum, "EGX_SetupTier", display=display.data_window)
plot(trailOn ? 1 : 0, "EGX_TrailOn", display=display.data_window)
plot(screenerPass ? 1 : 0, "EGX_ScreenerPass", display=display.data_window)
plot(screenerPro ? 1 : 0, "EGX_ScreenerPro", display=display.data_window)
plot(useAccDistScore ? accumScore100 : na, "EGX_AccScore", display=display.data_window)
plot(useAccDistScore ? distRisk100 : na, "EGX_DistRisk", display=display.data_window)
plot(breakStateNum, "EGX_BreakState", display=display.data_window)
plot(breakConfirmed ? 1 : 0, "EGX_BreakConfirm", display=display.data_window)
plot(useWavePhase ? wavePhaseId : na, "EGX_WavePhase", display=display.data_window)
plot(chaseWarn ? 1 : 0, "EGX_ChaseWarn", display=display.data_window)
plot(useMultiRvol ? rvol252 : na, "EGX_RVOL252", display=display.data_window)
plot(useOppScore ? opportunity : na, "EGX_Opportunity", display=display.data_window)
plot(useKelly ? kellyPct : na, "EGX_KellyPct", display=display.data_window)
plot(useMktRegime ? trMkt30 : na, "EGX_RegimeTr30", display=display.data_window)
plot(useMktRegime ? regimeIdNum : na, "EGX_RegimeId", display=display.data_window)
plot(usePatSim ? patMed20 : na, "EGX_PatMed20", display=display.data_window)
plot(useCycle12 ? cycle12 : na, "EGX_Cycle12", display=display.data_window)
plot(oppStrong ? 1 : 0, "EGX_OppStrong", display=display.data_window)
plot(oppScrOk and useOppScore and minScreenerOpp > 0 ? 1 : 0, "EGX_OppScreenerOk", display=display.data_window)
plot(gatesPass, "EGX_GatesPass", display=display.data_window)
plot(screenerPassGates ? 1 : 0, "EGX_ScreenerPassGates", display=display.data_window)
plot(bearRegimeBlock ? 1 : 0, "EGX_BearRegimeBlock", display=display.data_window)
plot(supStr, "EGX_SupStr", display=display.data_window)
plot(resStr, "EGX_ResStr", display=display.data_window)
plot(actionCode, "EGX_ActionCode", display=display.data_window)
plot(usePreRally ? preRallyMatch : na, "EGX_PreRallyMatch", display=display.data_window)
plot(usePreRally ? preRallyRvPre : na, "EGX_PreRallyRvPre", display=display.data_window)
plot(preRallySig ? 1 : 0, "EGX_PreRallySig", display=display.data_window)
plot(inEgxSession ? 1 : 0, "EGX_InSession", display=display.data_window)

plot(showHistSr ? histResSr : na, "مقاومة تاريخية", color=color.new(color.red, 75), linewidth=1, style=plot.style_linebr)
plot(showHistSr ? histSupSr : na, "دعم تاريخي", color=color.new(color.green, 75), linewidth=1, style=plot.style_linebr)
plot(showSwingSr and not na(lastSwingLow) ? lastSwingLow : na, "دعم محور", color=supStr >= 65 ? color.new(color.lime, 25) : supStr >= 45 ? color.new(color.green, 45) : color.new(color.green, 70), linewidth=supStr >= 60 ? 2 : 1, style=plot.style_linebr)
plot(showSwingSr and not na(lastSwingHigh) ? lastSwingHigh : na, "مقاومة محور", color=resStr >= 65 ? color.new(color.red, 25) : resStr >= 45 ? color.new(color.orange, 45) : color.new(color.red, 70), linewidth=resStr >= 60 ? 2 : 1, style=plot.style_linebr)

alertcondition(buyConfluence, title="EGX منطقة شراء", message="EGX: منطقة شراء محتملة — راجع الشارت")
alertcondition(oppStrong and sigOk, title="EGX فرصة قوية", message="EGX: فرصة قوية + إعداد B+")
alertcondition(useOppScore and opportunity >= oppBuyMin and setupHits >= 7 and sigOk, title="EGX فرصة", message="EGX: فرصة فوق العتبة + إعداد B+")
alertcondition(useCycle12 and cycle12 == 4 and sigOk, title="EGX دورة 4", message="EGX: مرحلة 4 تجميع")
alertcondition(useCycle12 and cycle12 == 5 and breakConfirmed, title="EGX دورة 5", message="EGX: مرحلة 5 اختراق أولي")
alertcondition(screenerPass and sigOk, title="EGX نجاح الماسح", message="EGX: نجاح الماسح — رتبة/إعداد/R/R + شراء")
alertcondition(screenerPro and sigOk, title="EGX ماسح احترافي", message="EGX: ماسح Pro — نجاح + فرصة قوية + دورة")
alertcondition(setupHits >= 9 and buyZoneActive, title="EGX إعداد A", message="EGX: جودة إعداد A (9+/11)")
alertcondition(egxRank >= 70 and sigOk, title="EGX Rank عالي", message="EGX: Rank فوق 70")
alertcondition(sellConfluence, title="EGX مقاومة", message="EGX: مقاومة / حذر")
alertcondition(bullChochSig and sigOk, title="EGX CHoCH صاعد", message="EGX: CHoCH صاعد")
alertcondition(bearChochSig and sigOk, title="EGX CHoCH هابط", message="EGX: CHoCH هابط")
alertcondition(isHistMaxVol and sigOk, title="EGX أقصى حجم", message="EGX: حجم تاريخي")
alertcondition(accumulating and volSpike and sigOk, title="EGX تجميع + Spike", message="EGX: تجميع + قفزة حجم")
alertcondition(sellingClimax and sigOk, title="EGX ذروة بيع", message="EGX: SC — انتظر تأكيد")
alertcondition(rvolStrong and sigOk, title="EGX RVOL قوي", message="EGX: RVOL فوق العتبة")
alertcondition(fvgBull and sigOk, title="EGX FVG صاعد", message="EGX: فجوة FVG صاعدة")
alertcondition(gannAlign and buyZoneActive, title="EGX Gann + إعداد", message="EGX: نافذة Gann مع setup")
alertcondition(obvBullDiv and sigOk, title="EGX OBV تباعد+", message="EGX: تباعد OBV صاعد")
alertcondition(supportBreak, title="EGX كسر دعم", message="EGX: كسر دعم محوري")
alertcondition(bottomConfirm, title="EGX قاع", message="EGX: قاع محتمل مع تأكيد")
alertcondition(globBull >= 5 and sigOk, title="EGX توافق عالمي", message="EGX: توافق EGX/عالمي")
alertcondition(hitT1, title="EGX وصول T1", message="EGX: السعر لمس الهدف الأول")
alertcondition(hitSL, title="EGX وقف", message="EGX: لمس مستوى وقف الدعم")
alertcondition(rsiBullDiv and sigOk, title="EGX RSI تباعد+", message="EGX: تباعد RSI صاعد")
alertcondition(targetCluster and buyZoneActive, title="EGX توافق أهداف", message="EGX: تجميع أهداف قرب بعض")
alertcondition(retestSupport and buyZoneActive, title="EGX إعادة اختبار دعم", message="EGX: إعادة اختبار دعم مع setup")
alertcondition(earlyBuyHint, title="EGX تلميح مبكر", message="EGX: إعداد مبكر — انتظر الإغلاق")
alertcondition(mtfBearWarn and supportBreak, title="EGX MTF + كسر", message="EGX: كسر مع MTF سلبي")
alertcondition(hitHalf, title="EGX جني 50%", message="EGX: لمس جني 50%")
alertcondition(hitT2, title="EGX هدف 2", message="EGX: لمس الهدف 2")
alertcondition(hitT3, title="EGX هدف 3", message="EGX: لمس الهدف 3")
alertcondition(hitTrail, title="EGX وقف متحرك", message="EGX: لمس الوقف المتحرك")
alertcondition(orbBreakUp and sigOk, title="EGX كسر ORB", message="EGX: كسر نطاق الافتتاح صاعد")
alertcondition(inEgxSession and buyConfluence, title="EGX جلسة + شراء", message="EGX: إعداد شراء داخل جلسة EGX")
alertcondition(cciOsBounce and sigOk, title="EGX CCI ارتداد", message="EGX: CCI خروج من تشبّع بيع")
alertcondition(willROversold and atSupport and sigOk, title="EGX %R تشبّع بيع", message="EGX: Williams %R تشبّع بيع عند دعم")
alertcondition(breakConfirmed, title="EGX اختراق مؤكد", message="EGX: اختراق مؤكد + RVOL")
alertcondition(breakRetest and buyZoneActive, title="EGX إعادة اختبار اختراق", message="EGX: إعادة اختبار بعد اختراق")
alertcondition(breakFailed, title="EGX فشل اختراق", message="EGX: فشل اختراق (اختراق وهمي)")
alertcondition(gapUp and sigOk, title="EGX فجوة صعود", message="EGX: فجوة صاعدة")
alertcondition(useAccDistScore and accumScore100 >= 60 and distRisk100 < 40 and sigOk, title="EGX تجميع قوي", message="EGX: تجميع قوي نسبياً")
alertcondition(chaseWarn and sigOk, title="EGX مطاردة", message="EGX: تحذير مطاردة — R/R ضعيف قرب القمة")
alertcondition(breakWatch and sigOk, title="EGX مراقبة تماسك", message="EGX: تماسك + قرب مقاومة")
alertcondition(gatesPass >= 9 and buyZoneActive and sigOk, title="EGX بوابات 9/10", message="EGX: بوابات شراء 9/10 — راقب إشارة التأكيد")
alertcondition(screenerPassGates and sigOk, title="EGX ماسح + بوابات", message="EGX: نجاح الماسح مع بوابات الشراء")
alertcondition(preRallySig and sigOk, title="EGX قبل موجة", message="EGX: تشابه قبل موجة + RVOL + تجميع")
alertcondition(usePreRally and preRallyMatch >= 2 and buyZoneActive and sigOk, title="EGX تشابه موجات", message="EGX: عدة تشابهات تاريخية قبل موجات +10%")
alertcondition(actionCode == 3 and sigOk, title="EGX توصية شراء", message="EGX: توصية تنفيذ شراء — راجع وقف/أهداف")
alertcondition(actionCode == 0 and sigOk, title="EGX تجنب", message="EGX: تجنب الدخول — كسر أو نظام سلبي")
plot(cci, "EGX_CCI", display=display.data_window)
plot(willR, "EGX_WillR", display=display.data_window)

f_alertJson(string evt) =>
    '{"event":"' + evt + '","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","rank":' + str.tostring(egxRank, "#.##") + ',"score":' + str.tostring(score, "#.##") + ',"opp":' + str.tostring(opportunity, "#") + ',"cycle":' + str.tostring(cycle12) + ',"regime":' + str.tostring(regimeIdNum) + ',"kelly":' + str.tostring(kellyPct, "#.#") + ',"gates":' + str.tostring(gatesPass) + ',"action":' + str.tostring(actionCode) + ',"acc":' + str.tostring(accumScore100, "#") + ',"dist":' + str.tostring(distRisk100, "#") + ',"break":"' + breakState + '","setup":"' + setupTier + '","hits":' + str.tostring(setupHits) + ',"rr":' + str.tostring(rrRatio, "#.##") + ',"entry":' + str.tostring(entryIdeal, format.mintick) + ',"stop":' + str.tostring(stopLoss, format.mintick) + ',"t1":' + str.tostring(t1, format.mintick) + ',"glob":' + str.tostring(globBull) + ',"pr_match":' + str.tostring(preRallyMatch) + ',"pr_rvol":' + str.tostring(preRallyRvPre, "#.##") + ',"sup_str":' + str.tostring(supStr, "#") + ',"inv":"' + invalidateTxt + '","bull":"' + scenBull + '","actionTxt":"' + actionTxt + '"}'

if useDynAlert and sigOk
    if alertOnBuy and buyConfluence
        alert(f_alertJson("buy"), alert.freq_once_per_bar_close)
    if alertOnScreener and screenerPass
        alert(f_alertJson("screener"), alert.freq_once_per_bar_close)

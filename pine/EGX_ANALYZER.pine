plotshape(showDetailMarks and sigOk and retestResist and not markSl and not markSel, title="إعادة مقاومة", style=shape.cross, location=location.abovebar, color=color.orange, size=size.tiny, text="RT")
plotshape(effOrbMarks and showDetailMarks and sigOk and orbBreakUp and not markBuy, title="ORB صعود", style=shape.triangleup, location=location.belowbar, color=color.fuchsia, size=size.tiny, text="ORB")
plotshape(effOrbMarks and showDetailMarks and sigOk and orbBreakDn and not markSl, title="ORB هبوط", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.tiny, text="ORB")

plotshape(effStructMarks and showDetailMarks and sigOk and bullBreak and not bullChochSig and not markBuy and not markBo, title="BOS صعود", style=shape.labelup, location=location.belowbar, color=color.teal, size=size.tiny, text="↑BOS")
plotshape(effStructMarks and showDetailMarks and sigOk and bullChochSig and not markBuy, title="CHoCH صعود", style=shape.labelup, location=location.belowbar, color=color.lime, size=size.tiny, text="↗CH")
plotshape(effStructMarks and showDetailMarks and sigOk and bearBreak and not bearChochSig and not markSl, title="BOS هبوط", style=shape.labeldown, location=location.abovebar, color=color.maroon, size=size.tiny, text="↓BOS")
plotshape(effStructMarks and showDetailMarks and sigOk and bearChochSig and not markSl, title="CHoCH هبوط", style=shape.labeldown, location=location.abovebar, color=color.orange, size=size.tiny, text="↘CH")

//@version=6
indicator("EGX محلل | مضاربة + استثمار | فني زمني موجي فوليوم", shorttitle="EGX محلل", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100, calc_bars_count=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// ⚠ LEGACY — استخدم pine/EGX_الاخير.pine · docs/legacy/README.md
// ⭐ النسخة النهائية الموحّدة: pine/EGX_الاخير.pine (+ EGX_الاخير_STRATEGY.pine)
// النسخة الموحّدة (سوق Regime + DNA + أنماط + فلتر): pine/EGX_CYCLE_MASTER.pine
// EGX Analyzer v6.6 — توصية تنفيذ · مصفوفة بوابات · فيبonacci · جلسة EGX
// Screener (TradingView): filter EGX_ScreenerPass = 1
//   أو يدوياً: EGX_BuyFlag=1 · EGX_SetupTier≥3 · EGX_Rank≥65 · EGX_RR≥1.5
//   Acc/Dist: EGX_AccScore≥60 · EGX_DistRisk<40 · EGX_BreakState=4 (confirmed)
//   Opportunity: EGX_Opportunity≥68 · EGX_Cycle12 in 4–7 (Standard profile)
//   Pro scan: EGX_ScreenerPro = 1 (Pass + OppStrong + Cycle)
// Profile «EGX Standard»: minVol 1500 · Setup≥B · confirm close · Rank≥65
// ═══════════════════════════════════════════════════════════════════════════════

string G_EGX_SET = "═══ ضبط EGX جاهز ═══"
string egxProfile = input.string("EGX قياسي (موصى)", "الملف", options=["EGX قياسي (موصى)", "EGX مضاربة 15د", "EGX استثمار يومي", "مخصص — من المدخلات"], group=G_EGX_SET)

string G_STYLE = "═══ أسلوب التداول ═══"
string tradeMode = input.string("مضاربة + استثمار", "الوضع", options=["مضاربة", "استثمار", "مضاربة + استثمار"], group=G_STYLE)
string htfTf = input.timeframe("W", "إطار الاتجاه (استثمار)", group=G_STYLE)
string mtfTf = input.timeframe("D", "إطار التأكيد", group=G_STYLE)

string G_TA = "═══ فني ═══"
int lenFast = input.int(9, "EMA سريع", minval=1, group=G_TA)
int lenMid = input.int(21, "EMA متوسط", minval=1, group=G_TA)
int lenSlow = input.int(50, "EMA بطيء", minval=1, group=G_TA)
int lenTrend = input.int(200, "EMA اتجاه", minval=1, group=G_TA)
int rsiLen = input.int(14, "RSI", minval=2, group=G_TA)
int macdFast = input.int(12, "MACD سريع", group=G_TA)
int macdSlow = input.int(26, "MACD بطيء", group=G_TA)
int macdSig = input.int(9, "MACD إشارة", group=G_TA)
int adxLen = input.int(14, "ADX", minval=2, group=G_TA)
float atrMult = input.float(1.5, "ATR مضاعف وقف/هدف", minval=0.5, step=0.1, group=G_TA)
bool useAdx = input.bool(true, "ADX في التقييم", group=G_TA)
bool showIchi = input.bool(false, "إيشيموكو (Tenkan/Kijun/سحابة)", group=G_TA)
bool useIchiScore = input.bool(true, "إيشيموكو في التقييم", group=G_TA)

string G_VOL = "═══ فوليوم ═══"
int volLookback = input.int(252, "نافذة أقصى حجم تاريخي", minval=50, group=G_VOL)
float volSpikeMult = input.float(2.0, "قفزة: حجم > × المتوسط", minval=1.2, step=0.1, group=G_VOL)
int volMaLen = input.int(20, "متوسط الحجم", minval=5, group=G_VOL)
int adLen = input.int(14, "CMF / A/D فترة", minval=5, group=G_VOL)
float bigTradePct = input.float(95.0, "نسبة مئوية حجم×سعر (صفقات كبيرة)", minval=80, maxval=99, group=G_VOL)
bool useWyckoff = input.bool(true, "Wyckoff SC/BC (VSA)", group=G_VOL)
bool useEgxLiq = input.bool(true, "سيولة EGX (قيمة/قيمة سوقية)", group=G_VOL)
bool useObvDiv = input.bool(true, "تباعد OBV (مبسّط)", group=G_VOL)
bool useRsiDiv = input.bool(true, "تباعد RSI (مبسّط)", group=G_VOL)
bool useMfi = input.bool(true, "MFI في التقييم", group=G_VOL)
bool useCci = input.bool(true, "CCI في التقييم", group=G_VOL)
bool useWillR = input.bool(true, "Williams %R (نسبة)", group=G_VOL)

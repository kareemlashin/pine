bool showTopVol = input.bool(true, "جدول أعلى حجم (أسفل)", group=G_VOL)
int topVolN = input.int(5, "أعلى N حجم", minval=3, maxval=7, group=G_VOL)
int volScanLenTop = input.int(252, "مسح Top حجم (bars)", minval=60, maxval=2000, group=G_VOL)


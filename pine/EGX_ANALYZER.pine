string egxTz = input.string("Africa/Cairo", "المنطقة الزمنية", group=G_EGX)
float minAvgVol = input.float(1500.0, "حد أدنى متوسط حجم (Custom)", minval=0.0, group=G_VOL)
bool showDemandSupply = input.bool(true, "صناديق طلب/عرض", group=G_STRUCT)
float zoneAtrMult = input.float(0.35, "عرض منطقة ×ATR", minval=0.15, step=0.05, group=G_STRUCT)

string G_VWAP = "═══ VWAP ═══"
bool showVwap = input.bool(true, "VWAP من آخر قاع", group=G_VWAP)
bool showSessionVwap = input.bool(true, "VWAP جلسة (داخل اليوم)", group=G_VWAP)
float vwapStdev = input.float(1.0, "VWAP ±σ", minval=0.5, step=0.25, group=G_VWAP)

string G_DEC = "═══ قرار ═══"
float minScoreSpec = input.float(58.0, "حد مضاربة", minval=40, maxval=90, group=G_DEC)
float minScoreInv = input.float(60.0, "حد استثمار", minval=40, maxval=90, group=G_DEC)
float minRR = input.float(1.5, "حد R/R للشراء", minval=1.0, step=0.1, group=G_DEC)
bool confirmOnly = input.bool(true, "إشارات عند إغلاق الشمعة", group=G_DEC)
float chaseRsiMax = input.float(72.0, "تحذير مطاردة RSI >", minval=65, maxval=85, group=G_DEC)
float chaseRrBelow = input.float(1.0, "تحذير مطاردة R/R <", minval=0.5, step=0.1, group=G_DEC)
bool blockChaseBuy = input.bool(false, "منع BUY عند مطarدة", group=G_DEC)
string egxBoard = input.string("نشط (EGX100)", "لوحة EGX", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G_DEC)
bool blockLimitBuy = input.bool(true, "منع قرب halt/LULD", group=G_DEC)

string G_UI = "═══ عرض ═══"
string uiLayout = input.string("واضح (بدون تداخل)", "تخطيط اللوحات", options=["واضح (بدون تداخل)", "كامل (كل اللوحات)"], group=G_UI)
bool uiClear = uiLayout == "واضح (بدون تداخل)"
bool showBuyZone = input.bool(true, "صندوق منطقة شراء", group=G_UI)
bool showSellZone = input.bool(false, "صندوق مقاومة (هابط)", group=G_UI)
bool showTargets = input.bool(true, "خطوط أهداف", group=G_UI)
bool showTable = input.bool(true, "جدول ملخص (يمين)", group=G_UI)
bool showBanner = input.bool(false, "بانر قرار (أسفل يمين)", group=G_UI)
bool showVolMarks = input.bool(true, "علامات فوليوم", group=G_UI)
bool showPocLine = input.bool(true, "POC تقريبي (أعلى حجم)", group=G_UI)
bool showDecBg = input.bool(true, "خلفية حسب التجميع/التصريف", group=G_UI)
float tgtClusterAtr = input.float(0.6, "تجميع أهداف (×ATR)", minval=0.2, group=G_UI)
bool showWaveInv = input.bool(true, "خط إلغاء موجي", group=G_UI)
bool showEarlyHint = input.bool(false, "تلميح مبكر (غير مؤكد)", group=G_UI)
bool useSetupGate = input.bool(true, "شراء: إعداد ≥ ب (7/11)", group=G_UI)
bool showQuickHud = input.bool(true, "لوحة سريعة (أعلى يسار)", group=G_UI)
bool effShowBanner = showBanner and (not uiClear or not showQuickHud)
bool effShowQuickHud = showQuickHud and (not uiClear or not showTable)
bool effShowMm = showMmPanel and (not uiClear or not showTable)
bool effShowTopVolTbl = showTopVol and (not uiClear or not showTable) and not effShowBanner
bool effDemandSupply = showDemandSupply and (not uiClear or not showBuyZone)
bool effStructMarks = showBosChoch and (not uiClear or not showTable)
bool effFvgMarks = showFvg and (not uiClear or not showBuyZone)
bool effGapMarks = showGaps and not uiClear
bool effOrbMarks = showOrb and not uiClear
bool showKeyMarksOnly = input.bool(true, "علامات أساسية فقط (بدون تكديس)", group=G_UI)
bool showBuyGatesRow = input.bool(true, "صف بوابات الشراء (جدول)", group=G_UI)
bool showOppBreakRow = input.bool(true, "صف توزيع الفرصة (جدول)", group=G_UI)
bool showGateMatrix = input.bool(true, "مصفوفة البوابات (✓/✗)", group=G_UI)
bool showFibRetrace = input.bool(false, "خطوط فيبonacci 38.2/50% (تراجع)", group=G_UI)
string G_SCR = "═══ فلتر Screener ═══"
float minScreenerRank = input.float(65.0, "أدنى رتبة", minval=0, maxval=100, step=1, group=G_SCR)
int minScreenerTier = input.int(3, "أدنى إعداد (4=أ…1=د)", minval=1, maxval=4, group=G_SCR)
float minScreenerRR = input.float(1.5, "أدنى R/R", minval=1.0, step=0.1, group=G_SCR)
bool requireBuyForScreener = input.bool(true, "يتطلب إشارة شراء", group=G_SCR)
float minScreenerOpp = input.float(0.0, "أدنى فرصة (0=إيقاف)", minval=0, maxval=100, step=1, group=G_SCR)
int minScreenerCycle = input.int(0, "أدنى دورة 12 (0=إيقاف)", minval=0, maxval=12, group=G_SCR)
int maxScreenerCycle = input.int(0, "أقصى دورة 12 (0=إيقاف)", minval=0, maxval=12, group=G_SCR)
float minScreenerGates = input.float(8.0, "أدنى بوابات شراء (/10، 0=إيقاف)", minval=0, maxval=10, step=1, group=G_SCR)
bool screenerRequireOppStrong = input.bool(false, "فرصة قوية فقط", group=G_SCR)
bool showHistSr = input.bool(false, "خطوط S/R تاريخي", group=G_BREAK)
bool showSwingSr = input.bool(true, "محور swing (لون = قوة)", group=G_BREAK)
bool showPreRallyRow = input.bool(true, "صف قبل موجة (جدول)", group=G_UI)
bool showPartialTp = input.bool(true, "خط جني 50% → ه1", group=G_UI)
bool showEmaPlots = input.bool(true, "خطوط EMA", group=G_UI)
bool showBearTgt = input.bool(true, "أهداف هبوط (تحذير)", group=G_UI)
bool showTrailStop = input.bool(true, "وقف متحرك بعد T1", group=G_UI)
float trailAtrMult = input.float(1.2, "وقف متحرك ×ATR", minval=0.5, step=0.1, group=G_UI)
bool showOrb = input.bool(true, "نطاق الافتتاح (داخل اليوم)", group=G_EGX)
int orbBars = input.int(6, "ORB — أول N شموع", minval=3, maxval=15, group=G_EGX)

string G_ALERT = "═══ تنبيهات / Webhook ═══"
bool useDynAlert = input.bool(false, "تنبيه JSON (webhook)", group=G_ALERT)
bool alertOnBuy = input.bool(true, "JSON عند شراء", group=G_ALERT)
bool alertOnScreener = input.bool(true, "JSON عند نجاح الماسح", group=G_ALERT)

bool profCustom = egxProfile == "مخصص — من المدخلات"
bool profScalp = egxProfile == "EGX مضاربة 15د"
bool profInv = egxProfile == "EGX استثمار يومي"
float effMinVol = profCustom ? minAvgVol : profScalp ? 3000.0 : profInv ? 800.0 : 1500.0
float effMinScoreSpec = profCustom ? minScoreSpec : profScalp ? 60.0 : 58.0
float effMinScoreInv = profCustom ? minScoreInv : profInv ? 62.0 : 60.0
float effMinRR = profCustom ? minRR : 1.5
bool effSetupGate = profCustom ? useSetupGate : true
bool effConfirm = profCustom ? confirmOnly : true
float effScrRank = profCustom ? minScreenerRank : profInv ? 60.0 : 65.0
int effScrTier = profCustom ? minScreenerTier : profScalp ? 3 : 3
float effScrRR = profCustom ? minScreenerRR : 1.5
float effScrOpp = profCustom ? minScreenerOpp : profInv ? 62.0 : 68.0
int effScrCycleMin = profCustom ? minScreenerCycle : profInv ? 3 : 4
int effScrCycleMax = profCustom ? maxScreenerCycle : 7
float effScrGates = profCustom ? minScreenerGates : profScalp ? 9.0 : 8.0

f_txt(string ar, string en) =>
    ar

f_setupHits() =>
    int h = 0
    h += bullStack ? 1 : 0
    h += htfBull ? 1 : 0
    h += macdBull ? 1 : 0
    h += accumulating ? 1 : 0
    h += rsLeader ? 1 : 0
    h += structDir == 1 ? 1 : 0
    h += inDemandZone ? 1 : 0
    h += retestSupport ? 1 : 0
    h += rrRatio >= effMinRR ? 1 : 0
    h += globBull >= 5 ? 1 : 0
    h += mtfBullOk ? 1 : 0
    h += volSpike or rvolStrong ? 1 : 0
    h

bool sigOk = not effConfirm or barstate.isconfirmed

// ─── EMAs ───
float emaF = ta.ema(close, lenFast)
float emaM = ta.ema(close, lenMid)
float emaS = ta.ema(close, lenSlow)
float emaT = ta.ema(close, lenTrend)

bool bullStack = emaF > emaM and emaM > emaS
bool bearStack = emaF < emaM and emaM < emaS
bool above200 = close > emaT

float htfClose = request.security(syminfo.tickerid, htfTf, close, barmerge.gaps_off, barmerge.lookahead_off)
float htfEma50 = request.security(syminfo.tickerid, htfTf, ta.ema(close, lenSlow), barmerge.gaps_off, barmerge.lookahead_off)
float htfEma200 = request.security(syminfo.tickerid, htfTf, ta.ema(close, lenTrend), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = htfClose > htfEma50 and htfEma50 > htfEma200

float mtfRsi = request.security(syminfo.tickerid, mtfTf, ta.rsi(close, rsiLen), barmerge.gaps_off, barmerge.lookahead_off)

f_tfBias(string tf) =>
    float c = request.security(syminfo.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    float e = request.security(syminfo.tickerid, tf, ta.ema(close, lenMid), barmerge.gaps_off, barmerge.lookahead_off)
    c > e ? 1 : c < e ? -1 : 0

int mtfBias = 0
int mtf15 = useMtfSync ? f_tfBias("15") : 0
int mtf60 = useMtfSync ? f_tfBias("60") : 0
int mtfD = useMtfSync ? f_tfBias("D") : 0
int mtfW = useMtfSync ? f_tfBias("W") : 0
int mtfM = useMtfSync and useMtfMonth ? f_tfBias("M") : 0
mtfBias := mtf15 + mtf60 + mtfD + mtfW + mtfM
string mtfTxt = useMtfSync ? "15:" + str.tostring(mtf15) + " 60:" + str.tostring(mtf60) + " D:" + str.tostring(mtfD) + " W:" + str.tostring(mtfW) + (useMtfMonth ? " M:" + str.tostring(mtfM) : "") : "—"
int mtfCount = useMtfSync ? (useMtfMonth ? 5 : 4) : 0
bool mtfBullOk = not useMtfSync or mtfBias >= 1
bool mtfBearWarn = useMtfSync and mtfBias <= -2

float benchRoc = request.security(benchSym, timeframe.period, ta.roc(close, rsLen), barmerge.gaps_off, barmerge.lookahead_off)
float bench70Roc = useRs70 ? request.security(benchSym70, timeframe.period, ta.roc(close, rsLen), barmerge.gaps_off, barmerge.lookahead_off) : na
float stockRoc = ta.roc(close, rsLen)
float rsSpread = stockRoc - benchRoc
float rsSpread70 = useRs70 and not na(bench70Roc) ? stockRoc - bench70Roc : na
bool rsLeader = rsSpread > 0
bool rsLeader70 = useRs70 and not na(rsSpread70) and rsSpread70 > 0

float rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
bool macdBull = macdHist > 0 and macdLine > macdSignal
bool rsiOkSpec = rsi > 40 and rsi < 70
bool rsiOkInv = rsi > 35 and rsi < 65

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
bool adxStrong = adx > 20 and diPlus > diMinus
bool adxBear = adx > 20 and diMinus > diPlus

float atr = ta.atr(14)

[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
[stLine, stDir] = ta.supertrend(stFactor, stAtrLen)
float stochK = ta.sma(ta.stoch(close, high, low, 14), 3)

float ichiTen = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2.0
float ichiKij = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2.0
float ichiSpanA = (ichiTen + ichiKij) / 2.0
float ichiSpanB = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2.0
float cloudTop = math.max(ichiSpanA[26], ichiSpanB[26])
float cloudBot = math.min(ichiSpanA[26], ichiSpanB[26])
bool ichiBull = close > cloudTop
bool ichiBear = close < cloudBot
string ichiTxt = ichiBull ? f_txt("فوق سحابة", "Above cloud") : ichiBear ? f_txt("تحت سحابة", "Below cloud") : f_txt("داخل سحابة", "In cloud")

bool inEgxSession = useEgxSession and not na(time(timeframe.period, "1000-1430:23456", egxTz))

float volMa = ta.sma(volume, volMaLen)
bool dataThin = minAvgVol > 0 and volMa < minAvgVol
bool volSpike = volume > volMa * volSpikeMult
float volHistMax = ta.highest(volume, volLookback)
bool isHistMaxVol = volume >= volHistMax and bar_index > volLookback

float dollarVol = volume * close
float dvThreshold = ta.percentile_nearest_rank(dollarVol, volLookback, bigTradePct)
bool bigTradeBar = dollarVol >= dvThreshold and volume > 0

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float mfv = mfm * volume
float cmf = ta.sma(mfv, adLen) / ta.sma(volume, adLen)

float ad = ta.cum(mfm * volume)
float adSlope = ad - ad[adLen]
bool accumulating = cmf > 0 and adSlope > 0
bool distributing = cmf < 0 and adSlope < 0

float obv = ta.obv
float obvMa = ta.sma(obv, 20)
float obvSlope = ta.linreg(obv, 10, 0) - ta.linreg(obv, 10, 1)
bool obvBullDiv = useObvDiv and low < low[5] and obv > obv[5] and close > open
bool obvBearDiv = useObvDiv and high > high[5] and obv < obv[5] and close < open
bool rsiBullDiv = useRsiDiv and low < low[5] and rsi > rsi[5]
bool rsiBearDiv = useRsiDiv and high > high[5] and rsi < rsi[5]
float mfi = ta.mfi(hlc3, 14)
bool mfiAccum = useMfi and mfi > 50 and mfi < 80
bool mfiDist = useMfi and mfi < 50 and mfi > 20
float cci = ta.cci(hlc3, cciLen)
bool cciBull = useCci and cci > -100 and cci < 100 and cci > cci[1]
bool cciBear = useCci and cci > 100
bool cciOsBounce = useCci and cci[1] < -100 and cci > -100
float willR = ta.wpr(14)
bool willRBull = useWillR and willR > -80 and willR < -20
bool willROversold = useWillR and willR <= -80

float rvol = volume / math.max(volMa, 1.0)
float rvol60 = useMultiRvol ? volume / math.max(ta.sma(volume, 60), 1.0) : na
float rvol252 = useMultiRvol ? volume / math.max(ta.sma(volume, math.min(volLookback, 252)), 1.0) : na
bool rvol252Climax = useMultiRvol and rvol252 >= volSpikeMult
bool rvolStrong = rvol >= volSpikeMult or rvol252Climax
float volLookbackHigh = ta.highest(volume, volLookback)
bool atLookbackVolHigh = volume >= volLookbackHigh * 0.98 and bar_index > volLookback
float volPctRank = ta.percentrank(volume, volLookback)

float mcap = nz(syminfo.shares_outstanding, 0) * close
float turnover = volMa * close
float liqPct = mcap > 0 ? turnover / mcap * 100 : na
string liqTier = na(liqPct) ? "غ/م" : liqPct >= 0.5 ? "عالي" : liqPct >= 0.1 ? "جيد" : liqPct >= 0.03 ? "متوسط" : "ضعيف"

float hi252 = ta.highest(high, wk252)
float lo252 = ta.lowest(low, wk252)
float pctFromHi = hi252 > 0 ? (close - hi252) / hi252 * 100 : na
float pctFromLo = lo252 > 0 ? (close - lo252) / lo252 * 100 : na
bool near52Lo = not na(pctFromLo) and pctFromLo < 8
bool extended52 = not na(pctFromHi) and pctFromHi > -3

float dHi = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
float dLo = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)
float dCl = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float pp = (dHi + dLo + dCl) / 3.0
float r1 = 2.0 * pp - dLo
float s1 = 2.0 * pp - dHi
float r2 = pp + (dHi - dLo)
float s2 = pp - (dHi - dLo)

f_tfBull(string tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, lenSlow), barmerge.gaps_off, barmerge.lookahead_off)

int mtfBulls = 0
if useMtfSync
    mtfBulls += f_tfBull("15") ? 1 : 0
    mtfBulls += f_tfBull("60") ? 1 : 0
    mtfBulls += f_tfBull("D") ? 1 : 0
    mtfBulls += f_tfBull("W") ? 1 : 0
    mtfBulls += useMtfMonth and f_tfBull("M") ? 1 : 0

int globBull = 0
globBull += bullStack ? 1 : bearStack ? -1 : 0
globBull += macdBull ? 1 : -1
globBull += close > pp ? 1 : close < pp ? -1 : 0
globBull += close > stLine ? 1 : -1
globBull += rsLeader ? 1 : -1
globBull += accumulating ? 1 : distributing ? -1 : 0
globBull += useMtfSync and mtfBulls >= 3 ? 1 : useMtfSync and mtfBulls <= 1 ? -1 : 0
globBull += useIchiScore and ichiBull ? 1 : useIchiScore and ichiBear ? -1 : 0
globBull += close > bbMid ? 1 : close < bbMid ? -1 : 0
string globTxt = globBull >= 5 ? f_txt("توافق EGX/عالمي ↑", "EGX/global sync ↑") : globBull <= -2 ? f_txt("سلبي ↓", "Bearish ↓") : f_txt("مختلط", "Mixed")

f_mktTr() =>
    int sc = 0
    float e20 = ta.ema(close, 20)
    float e50 = ta.ema(close, 50)
    float e100 = ta.ema(close, 100)
    sc += close > e20 ? 1 : close < e20 ? -1 : 0
    sc += e20 > e50 ? 1 : e20 < e50 ? -1 : 0
    sc += e50 > e100 ? 1 : e50 < e100 ? -1 : 0
    sc

f_mktMom() =>
    close[20] > 0 ? (close / close[20] - 1.0) * 100.0 : 0.0

int trMkt30 = useMktRegime ? request.security(mktSym30, timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off) : 0
float momMkt30 = useMktRegime ? request.security(mktSym30, timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off) : 0.0
int trMkt70 = useMktRegime ? request.security(mktSym70, timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off) : 0
float momMkt70 = useMktRegime ? request.security(mktSym70, timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off) : 0.0
int trMkt100 = useMktRegime ? request.security(mktSym100, timeframe.period, f_mktTr(), barmerge.gaps_off, barmerge.lookahead_off) : 0
float momMkt100 = useMktRegime ? request.security(mktSym100, timeframe.period, f_mktMom(), barmerge.gaps_off, barmerge.lookahead_off) : 0.0

bool heavySellMkt = useMktRegime and momMkt30 < -4.0 and momMkt70 < -3.0 and trMkt30 <= -1
bool broadUpMkt = useMktRegime and trMkt30 >= 1 and trMkt70 >= 0 and trMkt100 >= 0
bool narrowUpMkt = useMktRegime and trMkt30 >= 2 and trMkt70 <= 0
string regimeName = not useMktRegime ? "—" : heavySellMkt ? f_txt("ضغط بيعي على المؤشرات", "") : broadUpMkt ? f_txt("صاعد — اتساع (proxy 70/100)", "") : narrowUpMkt ? f_txt("صاعد ضيق (30 فقط)", "") : trMkt30 >= 1 ? f_txt("صاعد معتدل", "") : trMkt30 <= -1 ? f_txt("نظام هابط", "") : f_txt("عرضي / مختلط", "")
bool bearRegimeBlock = useMktRegime and blockBuyBearRegime and heavySellMkt
string mktPackTxt = useMktRegime ? "30·" + str.tostring(trMkt30) + " 70·" + str.tostring(trMkt70) + " 100·" + str.tostring(trMkt100) + " | " + str.tostring(momMkt30, "#.#") + "/" + str.tostring(momMkt70, "#.#") + "%" : "—"

bool newSess = ta.change(time("D")) != 0
var float orbH = na
var float orbL = na
var int sessBar = 0
if newSess
    orbH := high
    orbL := low
    sessBar := 0
else
    sessBar += 1
if sessBar < orbBars
    orbH := math.max(orbH, high)
    orbL := math.min(orbL, low)
bool orbReady = sessBar >= orbBars
bool orbBreakUp = orbReady and timeframe.isintraday and close > orbH and close[1] <= orbH
bool orbBreakDn = orbReady and timeframe.isintraday and close < orbL and close[1] >= orbL

float spread = high - low
float closePos = spread > syminfo.mintick ? (close - low) / spread : 0.5
bool ultraVol = volume > volMa * (volSpikeMult + 0.5)
bool sellingClimax = useWyckoff and ultraVol and closePos > 0.55 and low <= ta.lowest(low, 10)
bool buyingClimax = useWyckoff and ultraVol and closePos < 0.45 and high >= ta.highest(high, 10)

int hvnOff = ta.highestbars(volume, volLookback)
float pocProxy = hvnOff >= 0 and bar_index > volLookback ? hlc3[hvnOff] : na

bool fvgBull = showFvg and low > high[2] and close > open
bool fvgBear = showFvg and high < low[2] and close < open
float fvgBullTop = low
float fvgBullBot = high[2]
float fvgBearTop = low[2]
float fvgBearBot = high

int pivotLen = math.max(3, math.min(15, int(zzDepth / 2) + int(zzDev / 5)))
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float ph = ta.pivothigh(high, pivotLen, pivotLen)

var float lastSwingLow = na
var float lastSwingHigh = na
var int lastSwingLowBar = na
var int lastSwingHighBar = na
var int barsSinceLow = 0

var float zzPrevPrice = na
var int zzPrevBar = na
var int zzDir = 0
var line zzSeg = na

if not na(pl)
    lastSwingLow := pl
    lastSwingLowBar := bar_index - pivotLen
    barsSinceLow := 0
    if showZzLine and not na(zzPrevBar)
        line.delete(zzSeg)
        zzSeg := line.new(zzPrevBar, zzPrevPrice, lastSwingLowBar, pl, color=color.new(color.aqua, 30), width=2)
    zzPrevPrice := pl
    zzPrevBar := lastSwingLowBar
    zzDir := -1
else
    barsSinceLow += 1

if not na(ph)
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - pivotLen
    if showZzLine and not na(zzPrevBar)
        line.delete(zzSeg)
        zzSeg := line.new(zzPrevBar, zzPrevPrice, lastSwingHighBar, ph, color=color.new(color.orange, 30), width=2)
    zzPrevPrice := ph
    zzPrevBar := lastSwingHighBar
    zzDir := 1

float zw = atr * zoneAtrMult
float supportZoneTop = nz(lastSwingLow, low) + zw
float supportZoneBot = nz(lastSwingLow, low) - zw * 1.2
float resistZoneBot = nz(lastSwingHigh, high) - zw
float resistZoneTop = nz(lastSwingHigh, high) + zw * 1.2

float zoneWidth = atr * zoneAtrMult
float demandLo = na(lastSwingLow) ? na : lastSwingLow - zoneWidth
float demandHi = na(lastSwingLow) ? na : lastSwingLow + zoneWidth
float supplyLo = na(lastSwingHigh) ? na : lastSwingHigh - zoneWidth
float supplyHi = na(lastSwingHigh) ? na : lastSwingHigh + zoneWidth
bool retestSupport = sigOk and not na(lastSwingLow) and low <= lastSwingLow * 1.005 and close > lastSwingLow
bool retestResist = sigOk and not na(lastSwingHigh) and high >= lastSwingHigh * 0.995 and close < lastSwingHigh
bool inDemandZone = not na(demandLo) and not na(demandHi) and low <= demandHi and high >= demandLo
bool inSupplyZone = not na(supplyLo) and not na(supplyHi) and low <= supplyHi and high >= supplyLo
bool supportBreak = sigOk and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
var float avSumPV = 0.0
var float avSumV = 0.0
var float avSumP2V = 0.0
var int avAnchor = na

if not na(pl)
    avAnchor := bar_index - pivotLen
    avSumPV := 0.0
    avSumV := 0.0
    avSumP2V := 0.0

if not na(avAnchor) and bar_index >= avAnchor
    float tp = hlc3
    avSumPV += tp * volume
    avSumV += volume
    avSumP2V += tp * tp * volume

float avwap = avSumV > 0 ? avSumPV / avSumV : na
float avVar = avSumV > 0 ? math.max(avSumP2V / avSumV - avwap * avwap, 0) : 0.0
float avSd = math.sqrt(avVar)
float avUpper = avwap + avSd * vwapStdev
float avLower = avwap - avSd * vwapStdev

float phs = ta.pivothigh(high, structPivot, structPivot)
float pls = ta.pivotlow(low, structPivot, structPivot)
var float activeHigh = na
var float activeLow = na
var int structDir = 0
var string structEvent = "—"

if not na(phs)
    activeHigh := phs
if not na(pls)
    activeLow := pls

bool bullBreak = not na(activeHigh) and close > activeHigh and close[1] <= activeHigh
bool bearBreak = not na(activeLow) and close < activeLow and close[1] >= activeLow
bool bullChochSig = false
bool bearChochSig = false

if bullBreak
    structEvent := structDir >= 0 ? "BOS ↑" : "تغيّر ↑"
    bullChochSig := structDir < 0
    structDir := 1
    activeHigh := na
if bearBreak
    structEvent := structDir <= 0 ? "BOS ↓" : "تغيّر ↓"
    bearChochSig := structDir > 0
    structDir := -1
    activeLow := na

bool gapUp = low > high[1]
bool gapDown = high < low[1]
bool volUpNoProgress = rvol > 1.5 and math.abs(close - open) < atr * 0.15
float histResSr = ta.highest(high, srLookback)
float histSupSr = ta.lowest(low, srLookback)
bool swingBreakUp = sigOk and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bool fakeBreakUp = sigOk and not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh and rvol > 1.05
bool fakeBreakDn = sigOk and not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow and rvol > 1.05
float atrMa20 = ta.sma(atr, 20)
bool squeezeOn = atr < atrMa20 * squeezePct
bool rangeContract = ta.highest(high, consolLen) - ta.lowest(low, consolLen) < (ta.highest(high, consolLen * 2) - ta.lowest(low, consolLen * 2)) * 0.55
bool volUpTight = rvol > 1.2 and math.abs(close - open) < atr * 0.22
bool failedLow = not na(lastSwingLow) and low <= lastSwingLow * 1.008 and close > lastSwingLow
float consolHi = ta.highest(high, consolLen)
bool nearRes = not na(lastSwingHigh) and high >= lastSwingHigh * 0.985 and close < lastSwingHigh

float accPts = 0.0
accPts += rangeContract ? 12.0 : 0.0
accPts += squeezeOn ? 8.0 : 0.0
accPts += volUpTight ? 14.0 : 0.0
accPts += failedLow ? 12.0 : 0.0
accPts += retestSupport ? 10.0 : 0.0
accPts += fakeBreakDn ? 8.0 : 0.0
accPts += cmf > 0.05 ? 8.0 : 0.0
accPts += obvSlope > 0 ? 8.0 : 0.0
accPts += accumulating ? 10.0 : 0.0
accPts += obvBullDiv ? 6.0 : 0.0
float accumScore100 = useAccDistScore ? math.min(100.0, accPts) : na

float distPts = 0.0
distPts += fakeBreakUp ? 14.0 : 0.0
distPts += volUpNoProgress and close < open ? 12.0 : 0.0
distPts += retestResist and rvol > 1.2 ? 10.0 : 0.0
distPts += distributing ? 10.0 : 0.0
distPts += cmf < -0.05 ? 8.0 : 0.0
distPts += obvSlope < 0 ? 8.0 : 0.0
distPts += obvBearDiv ? 6.0 : 0.0
distPts += buyingClimax ? 8.0 : 0.0
distPts += supportBreak ? 16.0 : 0.0
float distRisk100 = useAccDistScore ? math.min(100.0, distPts) : na
string accDistTxt = useAccDistScore ? "تجم " + str.tostring(accumScore100, "#") + " · تصريف " + str.tostring(distRisk100, "#") : "—"

bool breakConfirmed = useBreakEngine and sigOk and (bullBreak or swingBreakUp) and (rvol >= 1.2 or rvol252Climax or volSpike)
bool breakFailed = useBreakEngine and fakeBreakUp
bool breakRetest = useBreakEngine and sigOk and retestSupport and structDir == 1 and not breakFailed
bool breakEarly = useBreakEngine and (bullBreak or swingBreakUp) and not sigOk
bool breakWatch = useBreakEngine and squeezeOn and nearRes and rangeContract
string breakState = breakFailed ? f_txt("فشل اختراق", "Failed BO") : breakConfirmed ? f_txt("اختراق مؤكد", "Confirmed BO") : breakRetest ? f_txt("إعادة اختبار", "Retest") : breakEarly ? f_txt("اختراق مبكر", "Early BO") : breakWatch ? f_txt("مراقبة تماسك", "Watch squeeze") : "—"
int breakStateNum = breakFailed ? 5 : breakConfirmed ? 4 : breakRetest ? 3 : breakEarly ? 2 : breakWatch ? 1 : 0

bool dnTrendC = close < emaS and emaS < emaT and structDir <= 0
bool dnSlowC = dnTrendC and adx < adx[5] and rangeContract
bool inBaseC = rangeContract and squeezeOn and math.abs(close - emaS) < atr * 1.2
bool accPhaseC = inBaseC and useAccDistScore and accumScore100 >= distRisk100 + 8 and cmf > 0
bool initBreakC = breakConfirmed
bool upTrendC = structDir == 1 and close > emaS and close > emaF
bool pullBackC = upTrendC and close < emaF and close > emaS and low > nz(lastSwingLow, emaT)
bool extRallyC = upTrendC and close > emaS + atr * 3 and rsi > 62
bool distPhaseC = useAccDistScore and distRisk100 >= accumScore100 + 12 and (retestResist or close > hi252 * 0.97)
bool weakTrendC = upTrendC and close < emaF and adx < 20
bool structBreakC = supportBreak or bearBreak
bool newDnC = structBreakC and close < emaS

var int cycle12 = 3
var int cycle12Bars = 0
int newCycle12 = cycle12
if dnTrendC and not dnSlowC
    newCycle12 := 1
else if dnSlowC
    newCycle12 := 2
else if accPhaseC
    newCycle12 := 4
else if inBaseC
    newCycle12 := 3
else if initBreakC and not upTrendC
    newCycle12 := 5
else if pullBackC
    newCycle12 := 7
else if extRallyC
    newCycle12 := 8
else if distPhaseC
    newCycle12 := 9
else if weakTrendC
    newCycle12 := 10
else if structBreakC and cycle12 <= 10
    newCycle12 := 11
else if newDnC
    newCycle12 := 12
else if upTrendC
    newCycle12 := 6

f_cycleName(int st) =>
    st == 1 ? f_txt("1 هبوط", "1 Decline") : st == 2 ? f_txt("2 تباطؤ", "2 Slow dn") : st == 3 ? f_txt("3 قاعدة", "3 Base") : st == 4 ? f_txt("4 تجميع", "4 Accum") : st == 5 ? f_txt("5 اختراق", "5 Break") : st == 6 ? f_txt("6 صاعد", "6 Up") : st == 7 ? f_txt("7 إعادة تجميع", "7 Re-acc") : st == 8 ? f_txt("8 ممتد", "8 Extended") : st == 9 ? f_txt("9 تصريف", "9 Dist") : st == 10 ? f_txt("10 ضعف", "10 Weak") : st == 11 ? f_txt("11 كسر", "11 Break") : f_txt("12 هابط", "12 New dn")

if sigOk
    if newCycle12 != cycle12
        cycle12 := newCycle12
        cycle12Bars := 0
    else
        cycle12Bars += 1

string cycle12Txt = useCycle12 ? f_cycleName(cycle12) + " · " + str.tostring(cycle12Bars) + f_txt("ش", "b") : "—"
string cycleHint = cycle12 == 3 ? f_txt("RVOL↑", "RVOL↑") : cycle12 == 4 ? f_txt("BOS↑+حجم", "BOS↑ vol") : cycle12 == 9 ? f_txt("حذر تصريف", "Dist risk") : "—"

var int lastClimaxOff = -1
var float lastClimaxRvol = na
if sigOk and (isHistMaxVol or rvol252Climax or volSpike and rvol > 2.0)
    lastClimaxOff := 0
    lastClimaxRvol := rvol
else if lastClimaxOff >= 0 and lastClimaxOff < 120
    lastClimaxOff += 1

float fwd60Pct = lastClimaxOff > 0 and lastClimaxOff <= 60 ? (close - close[lastClimaxOff]) / close[lastClimaxOff] * 100.0 : na
string eventStudyTxt = showEventStudy and lastClimaxOff >= 0 and lastClimaxOff <= 25 ? f_txt("بعد ", "After ") + str.tostring(lastClimaxOff) + f_txt("ش ", "b ") + str.tostring(fwd60Pct, "#.#") + "% RV" + str.tostring(lastClimaxRvol, "#.#") : "—"

var int waveCount = 0
var string waveHint = "—"
var string wavePhase = "—"

if not na(pl)
    waveCount += 1
    int wMod = waveCount % 5
    waveHint := wMod == 1 ? "موجة 1؟" : wMod == 2 ? "موجة 2؟" : wMod == 3 ? "موجة 3؟" : wMod == 4 ? "موجة 4؟" : "موجة 5؟"
    wavePhase := wMod == 3 ? "اندفاع؟" : wMod == 2 or wMod == 4 ? "تصحيح" : "بداية/نهاية"

if not na(ph)
    waveCount += 1

float zzDevPx = close * (zzDev / 100.0)
var float pctZzExt = high
var int pctZzDir = 1
var int pctZzLeg = 0
if pctZzDir == 1
    pctZzExt := math.max(pctZzExt, high)
    if pctZzExt - low >= zzDevPx
        pctZzDir := -1
        pctZzLeg += 1
        pctZzExt := low
else
    pctZzExt := math.min(pctZzExt, low)
    if high - pctZzExt >= zzDevPx
        pctZzDir := 1
        pctZzLeg += 1
        pctZzExt := high
int pctWMod = pctZzLeg % 5
string pctWaveHint = pctWMod == 1 ? f_txt("موجة 1؟", "Wave 1?") : pctWMod == 2 ? f_txt("موجة 2؟", "Wave 2?") : pctWMod == 3 ? f_txt("موجة 3؟", "Wave 3?") : pctWMod == 4 ? f_txt("موجة 4؟", "Wave 4?") : f_txt("موجة 5؟", "Wave 5?")
if usePctZzHint
    waveHint := pctWaveHint

bool timeWindow = barsSinceLow >= minBarsSinceLow and barsSinceLow <= cycleBars * 2
bool cycleAlign = barsSinceLow % cycleBars <= 2 or (cycleBars - barsSinceLow % cycleBars) <= 2

f_gannHit(int b) =>
    bool hit = false
    for g in array.from(9, 18, 27, 45, 90)
        if math.abs(b - g) <= gannTol
            hit := true
            break
    hit

bool gannAlign = useGann and f_gannHit(barsSinceLow)

bool specOk = bullStack and macdBull and rsiOkSpec and (volSpike or rvolStrong)
bool invOk = above200 and htfBull and rsiOkInv and accumulating
bool modeSpec = tradeMode == "مضاربة" or tradeMode == "مضاربة + استثمار"
bool modeInv = tradeMode == "استثمار" or tradeMode == "مضاربة + استثمار"

f_score(bool forInv) =>
    float s = 0.0
    s += close > emaM ? 10 : 0
    s += bullStack ? 15 : bearStack ? -10 : 0
    s += above200 ? 15 : forInv ? -8 : -5
    s += htfBull ? 15 : -10
    s += macdBull ? 10 : 0
    s += accumulating ? 15 : distributing ? -15 : 0
    s += volSpike or isHistMaxVol or rvolStrong ? 10 : 0
    s += sellingClimax and accumulating ? 10 : buyingClimax ? -10 : 0
    s += useEgxLiq and not na(liqPct) and liqPct >= 0.1 ? 5 : useEgxLiq and not na(liqPct) and liqPct < 0.03 ? -10 : 0
    s += rsLeader ? 8 : -5
    s += structDir == 1 ? 7 : structDir == -1 ? -7 : 0
    s += not na(avwap) and close <= avLower ? 5 : not na(avwap) and close <= avwap ? 3 : 0
    s += fvgBull ? 5 : fvgBear ? -5 : 0
    s += timeWindow ? 5 : 0
    s += cycleAlign or gannAlign ? 5 : 0
    s += mtfRsi > 45 and mtfRsi < 65 ? 5 : 0
    s += useAdx and adxStrong ? 5 : useAdx and adxBear ? -5 : 0
    s += near52Lo and forInv ? 8 : near52Lo ? 4 : 0
    s += extended52 and not forInv ? -5 : 0
    s += obvBullDiv ? 6 : obvBearDiv ? -6 : 0
    s += rsiBullDiv ? 5 : rsiBearDiv ? -5 : 0
    s += mfiAccum ? 4 : mfiDist ? -4 : 0
    s += cciBull ? 4 : cciBear ? -5 : 0
    s += cciOsBounce ? 6 : 0
    s += willRBull ? 3 : willROversold and forInv ? 4 : willROversold ? 2 : 0
    s += close >= s1 and close <= pp ? 4 : 0
    s += retestSupport ? 8 : 0
    s += inDemandZone ? 5 : 0
    s += retestResist ? -6 : 0
    s += inSupplyZone ? -4 : 0
    s += useMtfSync and mtfBulls >= 3 ? 5 : useMtfSync and mtfBulls <= 1 ? -4 : 0
    s += dataThin ? -8 : 0
    s += stDir < 0 ? -3 : 3
    s += orbBreakUp and not forInv ? 6 : orbBreakDn ? -5 : 0
    s += useIchiScore and ichiBull ? 5 : useIchiScore and ichiBear ? -5 : 0
    s += inEgxSession and not forInv and volSpike ? 2 : 0
    s += useAccDistScore and accumScore100 >= 55 ? 5 : useAccDistScore and accumScore100 >= 40 ? 2 : 0
    s += useAccDistScore and distRisk100 >= 55 ? -8 : useAccDistScore and distRisk100 >= 40 ? -4 : 0
    s += breakConfirmed ? 6 : breakRetest ? 4 : breakFailed ? -7 : 0
    s += useRs70 and rsLeader70 ? 3 : useRs70 and not na(rsSpread70) and rsSpread70 < 0 ? -3 : 0
    s += useCycle12 and cycle12 >= 4 and cycle12 <= 7 ? 5 : useCycle12 and cycle12 >= 9 ? -6 : 0
    math.max(0, math.min(100, s))

float score = f_score(false)
float scoreSpec = score
float scoreInv = f_score(true)

float swingRange = nz(lastSwingHigh - lastSwingLow, atr * 3)
float fib618 = nz(lastSwingLow, close) + swingRange * 0.618
float fib100 = nz(lastSwingLow, close) + swingRange * 1.0
float fib1618 = nz(lastSwingLow, close) + swingRange * 1.618
float fib2618 = nz(lastSwingLow, close) + swingRange * 2.618
float measT = nz(lastSwingHigh, close) + swingRange
float histRes = ta.highest(high, volLookback)

f_pick3(float ref, float a, float b, float c, float d, float e, float f, float g) =>
    float o1 = na
    float o2 = na
    float o3 = na
    string s1 = "—"
    string s2 = "—"
    string s3 = "—"
    for k = 0 to 6
        float v = k == 0 ? a : k == 1 ? b : k == 2 ? c : k == 3 ? d : k == 4 ? e : k == 5 ? f : g
        string nm = k == 0 ? "Fib618" : k == 1 ? "Fib100" : k == 2 ? "Fib1618" : k == 3 ? "Meas" : k == 4 ? "Hist" : k == 5 ? "R1" : "R2"
        if not na(v) and v > ref
            if na(o1) or v < o1
                o3 := o2
                s3 := s2
                o2 := o1
                s2 := s1
                o1 := v
                s1 := nm
            else if na(o2) or v < o2
                o3 := o2
                s3 := s2
                o2 := v
                s2 := nm
            else if na(o3) or v < o3
                o3 := v
                s3 := nm
    [o1, o2, o3, s1, s2, s3]

[pickT1, pickT2, pickT3, srcT1, srcT2, srcT3] = f_pick3(close, fib618, fib100, fib1618, measT, histRes, r1, r2)
float t1 = na(pickT1) ? close + atr * atrMult : pickT1
float t2 = na(pickT2) ? fib2618 : pickT2
float t3 = na(pickT3) ? close + atr * atrMult * 3.0 : pickT3
string lblT1src = na(pickT1) ? "ATR" : srcT1
string lblT2src = na(pickT2) ? "Fib262" : srcT2
string lblT3src = na(pickT3) ? "ATR" : srcT3
float pctT1 = close > 0 ? (t1 - close) / close * 100.0 : na
float pctT2 = close > 0 ? (t2 - close) / close * 100.0 : na
float pctT3 = close > 0 ? (t3 - close) / close * 100.0 : na
bool targetCluster = math.abs(t2 - t1) <= atr * tgtClusterAtr or math.abs(t3 - t2) <= atr * tgtClusterAtr or math.abs(t1 - r1) <= atr * tgtClusterAtr
string clusterTxt = targetCluster ? f_txt("توافق أهداف ✓", "Target cluster ✓") : "—"
string tgtPct = "+" + str.tostring(pctT1, "#.#") + "% / +" + str.tostring(pctT2, "#.#") + "% / +" + str.tostring(pctT3, "#.#") + "%"
string tgtPack = "T1 " + str.tostring(t1, format.mintick) + "(" + lblT1src + ") T2 " + str.tostring(t2, format.mintick) + "(" + lblT2src + ") T3 " + str.tostring(t3, format.mintick) + "(" + lblT3src + ")" + (targetCluster ? " ⊕" : "")

float entryIdeal = (supportZoneTop + supportZoneBot) / 2
float stopLoss = supportZoneBot - atr * 0.5
float risk = math.max(entryIdeal - stopLoss, syminfo.mintick)
float reward = math.max(t1 - entryIdeal, syminfo.mintick)
float rrRatio = reward / risk
float tHalf = entryIdeal + (t1 - entryIdeal) * 0.5

bool chaseWarn = extended52 and rsi > chaseRsiMax and rrRatio < chaseRrBelow
float dropFromHi = hi252 > 0 ? (hi252 - close) / hi252 * 100.0 : 0.0
bool atSupport = low <= nz(lastSwingLow, s1) + atr * 0.45 and close >= nz(lastSwingLow, s1)
bool bottomZone = dropFromHi >= bottomDropPct and atSupport
bool bottomConfirm = sigOk and bottomZone and (sellingClimax or bullChochSig or obvBullDiv) and not distributing

int wavePhaseId = 1
string wavePhaseTxt = f_txt("1 هابط", "1 Down")
if useWavePhase
    if supportBreak
        wavePhaseId := 8
        wavePhaseTxt := f_txt("8 فشل", "8 Fail")
    else if chaseWarn
        wavePhaseId := 7
        wavePhaseTxt := f_txt("7 ممتد", "7 Extended")
    else if breakConfirmed and bullStack and htfBull
        wavePhaseId := 6
        wavePhaseTxt := f_txt("6 صاعد", "6 Up")
    else if breakRetest or breakEarly or breakConfirmed
        wavePhaseId := 5
        wavePhaseTxt := f_txt("5 اختراق", "5 Break")
    else if breakWatch or (accumScore100 >= 50 and squeezeOn)
        wavePhaseId := 4
        wavePhaseTxt := f_txt("4 استعداد", "4 Ready")
    else if bottomConfirm or (accumScore100 >= 45 and atSupport)
        wavePhaseId := 3
        wavePhaseTxt := f_txt("3 تجميع", "3 Acc")
    else if near52Lo and rangeContract
        wavePhaseId := 2
        wavePhaseTxt := f_txt("2 قاعدة", "2 Base")
    else
        wavePhaseId := bearStack ? 1 : 2
        wavePhaseTxt := bearStack ? f_txt("1 هابط", "1 Down") : f_txt("2 قاعدة", "2 Base")

float waveInv = nz(lastSwingLow, stopLoss) - atr * 0.35
float investStop = showWaveInv ? waveInv : stopLoss

f_pick3Dn(float ref, float a, float b, float c, float d, float e) =>
    float o1 = na
    float o2 = na
    float o3 = na
    for k = 0 to 4
        float v = k == 0 ? a : k == 1 ? b : k == 2 ? c : k == 3 ? d : e
        if not na(v) and v < ref
            if na(o1) or v > o1
                o3 := o2
                o2 := o1
                o1 := v
            else if na(o2) or v > o2
                o3 := o2
                o2 := v
            else if na(o3) or v > o3
                o3 := v
    [o1, o2, o3]

float fib382 = nz(lastSwingHigh, close) - swingRange * 0.382
float fib500 = nz(lastSwingHigh, close) - swingRange * 0.5
[dn1, dn2, dn3] = f_pick3Dn(close, s1, s2, fib382, investStop, waveInv)
string bearPack = showBearTgt ? "↓ " + str.tostring(dn1, format.mintick) + " · " + str.tostring(dn2, format.mintick) + " · " + str.tostring(dn3, format.mintick) : "—"

float planConsEntry = entryIdeal
float planConsStop = stopLoss
float planEarlyEntry = not na(demandLo) ? demandLo : close
float planEarlyStop = not na(demandLo) ? demandLo - atr * 0.8 : close - atr * 2.0
float planDca1 = fib382
float planDca2 = nz(demandLo, emaM)
float planDca3 = emaT
float riskCons = math.max(planConsEntry - planConsStop, syminfo.mintick)
float rrCons = riskCons > 0 ? (t1 - planConsEntry) / riskCons : na
float riskEarly = math.max(planEarlyEntry - planEarlyStop, syminfo.mintick)
float rrEarly = riskEarly > 0 ? (t1 - planEarlyEntry) / riskEarly : na
string planPackShort = showEntryPlans ? f_txt("مح ", "C ") + str.tostring(planConsEntry, format.mintick) + " R/R" + str.tostring(rrCons, "#.#") + " · " + f_txt("مب ", "E ") + str.tostring(planEarlyEntry, format.mintick) + " · DCA " + str.tostring(planDca1, format.mintick) + "/" + str.tostring(planDca2, format.mintick) : "—"

float dPrevAn = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPctAn = dPrevAn > 0 ? (close - dPrevAn) / dPrevAn * 100.0 : 0.0
float haltPctAn = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPctAn = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearLimit = blockLimitBuy and dPrevAn > 0 and (dayPctAn >= math.min(9.0, haltPctAn - 1.0) or dayPctAn >= luldPctAn - 0.25)

bool liqOk = volMa >= effMinVol
bool buyZoneActive = not supportBreak and liqOk and mtfBullOk and score >= 55 and rrRatio >= effMinRR and globBull >= 0 and (modeSpec and specOk and scoreSpec >= effMinScoreSpec or modeInv and invOk and scoreInv >= effMinScoreInv or score >= 70)
int setupHits = f_setupHits()
string setupTier = setupHits >= 9 ? "A" : setupHits >= 7 ? "B" : setupHits >= 5 ? "C" : "D"
int setupTierNum = setupTier == "A" ? 4 : setupTier == "B" ? 3 : setupTier == "C" ? 2 : 1
bool setupOk = not effSetupGate or setupHits >= 7
bool nearSupport = low <= supportZoneTop and close >= supportZoneBot
bool nearVwapBand = not na(avLower) and low <= avLower and close >= avLower - atr * 0.3
bool nearDaySup = showDayPiv and close <= pp and low <= s1 * 1.002
bool buyConfluence = sigOk and buyZoneActive and setupOk and not bearRegimeBlock and not nearLimit and not (blockChaseBuy and chaseWarn) and (nearSupport or nearVwapBand or nearDaySup or retestSupport and inDemandZone or breakRetest)
bool earlyBuyHint = showEarlyHint and not sigOk and buyZoneActive and (nearSupport or inDemandZone) and score >= effMinScoreSpec
bool hitT1 = sigOk and high >= t1 and high[1] < t1
bool hitT2 = sigOk and high >= t2 and high[1] < t2
bool hitT3 = sigOk and high >= t3 and high[1] < t3
bool hitHalf = sigOk and high >= tHalf and high[1] < tHalf
bool hitSL = sigOk and low <= stopLoss and low[1] > stopLoss

bool sellZoneActive = score <= 42 and bearStack and (close < emaM or distributing)
bool nearResist = high >= resistZoneBot and close <= resistZoneTop
bool sellConfluence = sigOk and sellZoneActive and nearResist

var float trailStop = na
var bool trailOn = false
if buyConfluence
    trailOn := true
    trailStop := na(trailStop) ? stopLoss : trailStop
if supportBreak or sellConfluence
    trailOn := false
    trailStop := na
if trailOn and showTrailStop
    float cand = close - atr * trailAtrMult
    trailStop := math.max(nz(trailStop, stopLoss), cand)
    if hitT1
        trailStop := math.max(trailStop, entryIdeal)
bool hitTrail = sigOk and trailOn and not na(trailStop) and low <= trailStop and low[1] > trailStop

float scoreMom = score - nz(score[5], score)
float egxRank = math.max(0, math.min(100, score * 0.55 + globBull * 8.0 + mtfBias * 3.0 + (buyConfluence ? 15.0 : buyZoneActive ? 8.0 : 0.0) + (bottomConfirm ? 6.0 : 0.0) + (breakConfirmed ? 6.0 : breakRetest ? 4.0 : 0.0) - (supportBreak ? 20.0 : 0.0) - (chaseWarn ? 10.0 : 0.0) + (useMktRegime and broadUpMkt ? 4.0 : useMktRegime and heavySellMkt ? -8.0 : 0.0)))

float winProbK = math.max(0.35, math.min(0.72, setupHits / 11.0 * 0.55 + egxRank / 100.0 * 0.25))
float kellyRaw = rrRatio > 0 ? (winProbK * rrRatio - (1.0 - winProbK)) / rrRatio : 0.0
float kellyPct = useKelly ? math.max(0.0, math.min(25.0, kellyRaw * 100.0)) : na
string kellyTxt = useKelly ? "كيلي " + str.tostring(kellyPct, "#.#") + "% · احتمال≈" + str.tostring(winProbK * 100.0, "#") + "%" : "—"

float sTrendO = score
float sVolO = useAccDistScore ? math.max(0.0, math.min(100.0, accumScore100 * 0.55 + (100.0 - distRisk100) * 0.25 + (rvolStrong ? 20.0 : rvol >= 1.0 ? 10.0 : 0.0))) : 50.0
float sBreakO = breakConfirmed ? 88.0 : breakRetest ? 72.0 : breakWatch ? 48.0 : breakFailed ? 15.0 : 35.0
float sEntryO = setupHits >= 9 ? 85.0 : setupHits >= 7 ? 72.0 : inDemandZone ? 56.0 : atSupport ? 48.0 : 32.0
float sTimeO = timeWindow or gannAlign or cycleAlign ? 65.0 : 45.0
float sWaveO = useWavePhase and wavePhaseId >= 4 and wavePhaseId <= 6 ? 68.0 : useWavePhase and wavePhaseId == 3 ? 62.0 : 40.0
float sRRO = math.min(100.0, rrRatio / 3.0 * 100.0)
float sMktO = useMktRegime ? (broadUpMkt ? 75.0 : narrowUpMkt ? 55.0 : heavySellMkt ? 20.0 : trMkt30 >= 1 ? 62.0 : 45.0) : 50.0
float opportunity = useOppScore ? math.max(0.0, math.min(100.0, sTrendO * 0.20 + sVolO * 0.16 + sEntryO * 0.14 + sBreakO * 0.11 + sTimeO * 0.07 + sWaveO * 0.06 + sRRO * 0.16 + sMktO * 0.10)) : na
string oppClass = not useOppScore ? "—" : opportunity >= oppBuyMin and setupHits >= 7 and distRisk100 < 55 ? f_txt("فرصة قوية", "Strong opp") : opportunity >= oppBuyMin - 8 and distRisk100 < 65 ? f_txt("تأكيد", "Confirm") : distRisk100 >= 70 ? f_txt("مخاطرة", "High risk") : opportunity < 40 ? f_txt("ضعيفة", "Weak") : f_txt("مراقبة", "Watch")
bool oppScrOk = minScreenerOpp <= 0 or not useOppScore or opportunity >= effScrOpp
bool oppStrong = useOppScore and opportunity >= oppBuyMin and setupHits >= 7 and distRisk100 < 55
bool cycleScrOk = not useCycle12 or (effScrCycleMin <= 0 and effScrCycleMax <= 0) or (cycle12 >= effScrCycleMin and (effScrCycleMax <= 0 or cycle12 <= effScrCycleMax))
bool screenerPass = not supportBreak and liqOk and setupTierNum >= effScrTier and egxRank >= effScrRank and rrRatio >= effScrRR and oppScrOk and cycleScrOk and (not screenerRequireOppStrong or oppStrong) and not bearRegimeBlock and (requireBuyForScreener ? buyConfluence : buyZoneActive)
bool screenerPro = screenerPass and oppStrong and cycleScrOk

int regimeIdNum = not useMktRegime ? 0 : heavySellMkt ? 1 : broadUpMkt ? 5 : narrowUpMkt ? 3 : trMkt30 >= 1 ? 4 : trMkt30 <= -1 ? 2 : 6
float supStr = not na(lastSwingLow) ? (retestSupport ? 72.0 : atSupport ? 58.0 : close > lastSwingLow ? 42.0 : 25.0) : 0.0
float resStr = not na(lastSwingHigh) ? (retestResist ? 72.0 : nearRes ? 55.0 : close < lastSwingHigh ? 38.0 : 25.0) : 0.0
string lvlStrengthTxt = "دعم " + str.tostring(supStr, "#") + " · مقاومة " + str.tostring(resStr, "#")

string scenBase = regimeName + " · " + (useCycle12 ? f_cycleName(cycle12) : waveHint) + " · تجم" + str.tostring(accumScore100, "#")
string scenBull = breakConfirmed or breakRetest ? f_txt("صاعد: ", "") + breakState + " · R/R " + str.tostring(rrRatio, "#.#") : cycle12 >= 6 and cycle12 <= 8 ? f_txt("صاعد: امتداد دورة", "") : opportunity >= oppBuyMin ? f_txt("صاعد: فرصة ", "") + str.tostring(opportunity, "#") : "—"
string scenBear = supportBreak ? f_txt("هابط: كسر دعم", "") : breakFailed ? f_txt("هابط: فشل اختراق", "") : distRisk100 >= 65 ? f_txt("هابط: تصريف ", "") + str.tostring(distRisk100, "#") : sellConfluence ? f_txt("هابط: مقاومة", "") : "—"
string invalidateTxt = supportBreak ? f_txt("إلغاء عند ", "") + str.tostring(stopLoss, format.mintick) : breakFailed ? f_txt("إلغاء: اختراق وهمي", "") : chaseWarn ? f_txt("إلغاء: مطاردة", "") : f_txt("إلغاء موجي ", "") + str.tostring(waveInv, format.mintick)

bool gateLiq = liqOk
bool gateMtf = mtfBullOk
bool gateGlob = globBull >= 0
bool gateRR = rrRatio >= effMinRR
bool gateSetup = setupOk
bool gateRegime = not bearRegimeBlock
bool gateChase = not blockChaseBuy or not chaseWarn
bool gateDist = not useAccDistScore or distRisk100 < 65
bool gateCycle = not useCycle12 or (cycle12 >= 3 and cycle12 <= 8 and cycle12 != 9)
bool gateEntry = nearSupport or nearVwapBand or nearDaySup or breakRetest or retestSupport and inDemandZone
int gatesPass = (gateLiq ? 1 : 0) + (gateMtf ? 1 : 0) + (gateGlob ? 1 : 0) + (gateRR ? 1 : 0) + (gateSetup ? 1 : 0) + (gateRegime ? 1 : 0) + (gateChase ? 1 : 0) + (gateDist ? 1 : 0) + (gateCycle ? 1 : 0) + (gateEntry ? 1 : 0)
bool gatesScrOk = effScrGates <= 0 or gatesPass >= int(effScrGates)
bool screenerPassGates = screenerPass and gatesScrOk
string gatesTxt = str.tostring(gatesPass) + "/10 " + (buyConfluence ? "✓" : gatesPass >= 8 and buyZoneActive ? "◐" : "—")
string gatesMatrixTxt = (gateLiq ? "✓" : "✗") + "س·" + (gateMtf ? "✓" : "✗") + "م·" + (gateGlob ? "✓" : "✗") + "ع·" + (gateRR ? "✓" : "✗") + "ر·" + (gateSetup ? "✓" : "✗") + "إ·" + (gateRegime ? "✓" : "✗") + "ن·" + (gateChase ? "✓" : "✗") + "ط·" + (gateDist ? "✓" : "✗") + "ت·" + (gateCycle ? "✓" : "✗") + "د·" + (gateEntry ? "✓" : "✗") + "خ"
string sessionHudTxt = useEgxSession ? (inEgxSession ? "جلسة EGX — مفتوحة" : "خارج جلسة EGX") : "—"
int actionCode = buyConfluence ? 3 : supportBreak or bearRegimeBlock or distRisk100 >= 75 ? 0 : gatesPass >= int(effScrGates) and buyZoneActive ? 2 : score >= 50 ? 1 : 0
string actionTxt = actionCode == 3 ? "🟢 تنفيذ شراء (إشارة)" : actionCode == 2 ? "🟡 جاهز — انتظر إغلاق/تأكيد" : actionCode == 1 ? "⚪ راقب القائمة" : "🔴 تجنب / انتظر"
string oppBreakTxt = useOppScore ? "ات" + str.tostring(sTrendO, "#") + "·ف" + str.tostring(sVolO, "#") + "·د" + str.tostring(sEntryO, "#") + "·اخ" + str.tostring(sBreakO, "#") + "·ز" + str.tostring(sTimeO, "#") + "·م" + str.tostring(sWaveO, "#") + "·R" + str.tostring(sRRO, "#") + "·س" + str.tostring(sMktO, "#") : "—"

string primaryDec = supportBreak ? f_txt("🔴 كسر دعم", "🔴 Support break") : chaseWarn and not buyConfluence ? f_txt("🟠 مطاردة", "🟠 Chase") : bottomConfirm and buyConfluence ? f_txt("🟢 قاع+شراء", "🟢 Bottom+buy") : bottomConfirm ? f_txt("🟢 قاع — تأكيد", "🟢 Bottom confirm") : buyConfluence ? f_txt("🟢 شراء", "🟢 Buy") : breakConfirmed ? f_txt("🟢 اختراق", "🟢 Breakout") : sellConfluence ? f_txt("🟠 حذر/مقاومة", "🟠 Caution/resist") : scoreSpec >= minScoreSpec and specOk ? f_txt("🟡 مضاربة", "🟡 Scalp") : scoreInv >= minScoreInv and invOk ? f_txt("🟡 تراكم", "🟡 Accumulate") : score >= 50 ? f_txt("⚪ راقب", "⚪ Watch") : f_txt("⚪ ضعيف", "⚪ Weak")
color decCol = supportBreak ? color.red : buyConfluence or bottomConfirm ? color.lime : sellConfluence ? color.orange : score >= 55 ? color.yellow : color.gray
bool chartKeyBar = buyConfluence or breakConfirmed or supportBreak or bottomConfirm or chaseWarn or sellConfluence or breakFailed
bool showDetailMarks = not showKeyMarksOnly or not chartKeyBar
bool effVolMark = showVolMarks and showDetailMarks
bool markBuy = sigOk and buyConfluence
bool markBo = sigOk and not markBuy and breakConfirmed
bool markBottom = sigOk and not markBuy and not markBo and bottomConfirm
bool markSl = sigOk and supportBreak
bool markSel = sigOk and not markSl and sellConfluence
bool markChase = sigOk and not markSl and not markSel and chaseWarn
bool markFailBo = sigOk and not markSl and not markSel and not markChase and breakFailed

// ─── Plots ───
plot(showBB ? bbMid : na, "BB", color=color.new(color.gray, 65))
plot(showBB ? bbUp : na, "BB+", color=color.new(color.blue, 75))
plot(showBB ? bbLo : na, "BB-", color=color.new(color.blue, 75))

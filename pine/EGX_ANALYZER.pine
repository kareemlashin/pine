string G_EGX = "═══ بورصة EGX ═══"
string benchSym = input.symbol("EGX:EGX30", "مؤشر مقارنة RS", group=G_EGX)
string benchSym70 = input.symbol("EGX:EGX70EWI", "RS vs EGX70 (اتساع)", group=G_EGX)

//@version=6
indicator("EGX Volume Ease of Movement", shorttitle="EGX VEOM", overlay=false, max_tables_count=2, calc_bars_count=5000)

// EOM — سهولة الحركة vs حجم · docs/EGX_VOLUME.md

string G = "EOM"
int len = input.int(14, "Smooth", minval=3, group=G)
float div = input.float(10000.0, "Scale div", group=G)

float midMove = ((high + low) / 2.0) - ((high[1] + low[1]) / 2.0)
float box = volume / math.max(high - low, syminfo.mintick)
float eomRaw = box > 0 ? midMove / box : 0.0
float eom = ta.sma(eomRaw, len)
float eomMa = ta.sma(eom, len)

bool easyUp = eom > 0 and eom > eomMa and volume < ta.sma(volume, 20)
bool hardUp = eom > 0 and eom < eomMa and volume > ta.sma(volume, 20) * 1.3

plot(eom * div, "EGVEOM_Val", color=eom >= 0 ? color.lime : color.red, linewidth=2, display=display.all)
plot(eomMa * div, "EOM MA", color=color.yellow, linewidth=1, display=display.none)
hline(0, "0", color=color.gray)

var table t = table.new(position.top_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "EOM", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, easyUp ? "Easy↑" : hardUp ? "Heavy↑" : "—", text_size=size.tiny)

plot(easyUp ? 1 : 0, "EGVEOM_EasyUp", display=display.all)

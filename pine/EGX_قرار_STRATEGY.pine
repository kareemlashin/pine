//@version=6
strategy("EGX قرار — اختبار", shorttitle="EGX قرار ST", overlay=true, pyramiding=1, calc_bars_count=5000, commission_type=strategy.commission.percent, commission_value=0.125, slippage=3, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, currency=currency.EGP)

// مرتبط بـ EGX_قرار.pine — نفس منطق canBuy / Add / Exit

string G = "ملف"
string mode = input.string("PRO موحّد", "نوع", options=["PRO موحّد", "عدّاء استثمار", "EGX يومي", "فلسي EGX", "مخصص"], group=G)
bool onClose = input.bool(true, "إغلاق الشمعة", group=G)
float minVolIn = input.float(800.0, "حد حجم", group=G)
float minRRIn = input.float(1.5, "حد R/R", group=G)
float minRankIn = input.float(58.0, "حد رتبة", group=G)
int minGatesIn = input.int(7, "بوابات", group=G)

string G_EX = "خروج"
bool usePartial = input.bool(true, "جزئي 50% عند منتصف T1", group=G_EX)
bool useTrail = input.bool(true, "trail بعد جزئي", group=G_EX)
float trailMult = input.float(1.4, "trail × ATR", group=G_EX)
string tgt = input.string("T2", "هدف الباقي", options=["T1", "T2"], group=G_EX)
bool allowAdd = input.bool(true, "إضافة دورة 7", group=G_EX)
float addPct = input.float(8.0, "حجم إضافة % equity", group=G_EX)

string G_EGX2 = "هيكل EGX"
string egxBoard = input.string("نشط (EGX100)", "لوحة", options=["نشط (EGX100)", "EGX30 (بيع مكشوف)", "SME تميّز", "SME نايل", "غير نشط"], group=G_EGX2)
bool skipSundayBuy = input.bool(false, "لا دخول يوم الأحد", group=G_EGX2)
int breakConfirmBars = input.int(2, "إغلاقات لتأكيد الاختراق", minval=1, maxval=5, group=G_EGX2)
bool skipOffHours = input.bool(false, "لا دخول خارج المستمر", group=G_EGX2)
bool useMktHalt100 = input.bool(true, "منع شراء إذا EGX100 ≤ −10%", group=G_EGX2)
float riskPctEq = input.float(1.5, "مخاطرة % محفظة", minval=0.5, maxval=3.0, step=0.1, group=G_EGX2)
float partCapPct = input.float(8.0, "سقف ADV 20 يوم %", minval=2, maxval=15, group=G_EGX2)
bool useRiskQty = input.bool(true, "حجم = مخاطرة 1–2% + سقف ADV", group=G_EGX2)
bool trimC8 = input.bool(true, "جني 25% دورة 8", group=G_EX)

string G_UL = "Ultra / DNA"
string entryProfile = input.string("مرآة قرار", "دخول ST", options=["مرآة قرار", "Core", "Ultra ST"], group=G_UL)
bool ultraOnly = input.bool(false, "فلتر Ultra إضافي", group=G_UL)
float minDnaIn = input.float(55.0, "DNA ≥", minval=40, maxval=90, group=G_UL)
bool mirrorBuyPlot = input.bool(true, "مرآة plots الماسح", group=G_UL)

string G_VL = "فوليوم ST"
bool useVolStGate = input.bool(false, "بوابة Vol Rank للدخول", group=G_VL)
float minVolRankSt = input.float(58.0, "Vol Rank ≥", minval=40, maxval=90, group=G_VL)

bool custom = mode == "مخصص"
bool proMode = mode == "PRO موحّد"
bool runnerMode = proMode or mode == "عدّاء استثمار" or mode == "فلسي EGX"
bool pennyMode = mode == "فلسي EGX"
float effVol = custom ? minVolIn : pennyMode ? 400.0 : mode == "EGX يومي" ? 1500.0 : 800.0
float effRR = custom ? minRRIn : 1.5
float effRank = custom ? minRankIn : pennyMode ? 55.0 : mode == "EGX يومي" ? 62.0 : 58.0
int effGates = custom ? minGatesIn : 7
float effAccBuy = pennyMode ? 50.0 : 55.0
float effDistMax = pennyMode ? 52.0 : 50.0

bool barOk = not onClose or barstate.isconfirmed

float ema9 = ta.ema(close, 9)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
bool bullStack = ema9 > ema21 and ema21 > ema50
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
bool macdBull = macdH > 0 and macdL > macdS

f_tfBull(string tf) =>
    request.security(syminfo.tickerid, tf, close > ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)

int mtfBias = 0
mtfBias += f_tfBull("60") ? 1 : -1
mtfBias += f_tfBull("D") ? 1 : -1
mtfBias += f_tfBull("W") ? 1 : -1
bool mtfOk = mtfBias >= 0

float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)

float volMa = ta.sma(volume, 20)
bool liqOk = volMa >= effVol
float rvol = volume / math.max(volMa, 1.0)

float mfm = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
float cmf = ta.sma(mfm * volume, 20) / ta.sma(volume, 20)
float obvSlope = ta.linreg(ta.obv, 10, 0) - ta.linreg(ta.obv, 10, 1)
bool accumulating = cmf > 0 and obvSlope > 0
bool distributing = cmf < 0 and obvSlope < 0

float acc = math.min(100.0, (accumulating ? 25.0 : 0.0) + (cmf > 0.05 ? 12.0 : cmf > 0 ? 6.0 : 0.0) + (obvSlope > 0 ? 15.0 : 0.0) + (rvol >= 1.0 and close > open ? 10.0 : 0.0))
float dist = math.min(100.0, (distributing ? 25.0 : 0.0) + (cmf < -0.05 ? 12.0 : cmf < 0 ? 6.0 : 0.0) + (obvSlope < 0 ? 15.0 : 0.0) + (rvol >= 1.8 and close < open ? 12.0 : 0.0))
float rvol252 = volume / math.max(ta.sma(volume, 252), 1.0)
float pctSt = ta.percentrank(volume, 500)
float zSt = (volume - volMa) / math.max(ta.stdev(volume, 20), 1.0)
float bRvolSt = request.security("EGX:EGX30", timeframe.period, volume / math.max(ta.sma(volume, 20), 1.0), barmerge.gaps_off, barmerge.lookahead_off)
float rsVSt = bRvolSt > 0 ? rvol / bRvolSt : 1.0
float rngSt = math.max(high - low, syminfo.mintick)
float buyPctSt = (close - low) / rngSt * 100.0
float volRankSt = math.min(pctSt, 100.0) * 0.22 + math.min(rvol, 3.0) / 3.0 * 100.0 * 0.18 + math.min(math.max(zSt, 0), 4.0) / 4.0 * 100.0 * 0.12 + math.min(rsVSt, 2.0) / 2.0 * 100.0 * 0.15 + buyPctSt * 0.12 + (cmf > 0 ? 10.0 : -5.0) + (obvSlope > 0 ? 8.0 : -4.0)
volRankSt := math.max(0.0, math.min(100.0, volRankSt))
bool volPassSt = volRankSt >= minVolRankSt and volMa >= 500
bool squeezeOn = atr < ta.sma(atr, 14) * 0.85

float wClose = request.security(syminfo.tickerid, "W", close, barmerge.gaps_off, barmerge.lookahead_off)
float wEma50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
bool htfBull = wClose > wEma50
bool rsLeader = ta.roc(close, 20) - request.security("EGX:EGX30", timeframe.period, ta.roc(close, 20), barmerge.gaps_off, barmerge.lookahead_off) > 0
bool bearMkt = request.security("EGX:EGX30", timeframe.period, close[20] > 0 ? (close / close[20] - 1) * 100 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) < -4.0

float dPrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
float dayPct = dPrev > 0 ? (close - dPrev) / dPrev * 100.0 : 0.0
float haltPct = egxBoard == "SME تميّز" or egxBoard == "SME نايل" or egxBoard == "غير نشط" ? 5.0 : 10.0
float luldPct = egxBoard == "غير نشط" ? 5.0 : (egxBoard == "SME تميّز" or egxBoard == "SME نايل" ? 10.0 : 20.0)
bool nearHaltUp = dPrev > 0 and dayPct >= math.min(9.0, haltPct - 1.0)
bool atLuldUp = dPrev > 0 and dayPct >= luldPct - 0.25
bool nearLimit = nearHaltUp or atLuldUp
float dayPct100 = useMktHalt100 ? request.security("EGX:EGX100EWI", "D", close[1] > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0, barmerge.gaps_off, barmerge.lookahead_off) : 0.0
bool mktHalt100 = useMktHalt100 and dayPct100 <= -10.0
bool sundaySkip = skipSundayBuy and dayofweek == dayofweek.sunday
int egxSessId = 0
if not na(time(timeframe.period, "1000-1415:23456", "Africa/Cairo"))
    egxSessId := 2
bool sessionPhaseOk = not skipOffHours or not timeframe.isintraday or egxSessId == 2

float hi252 = ta.highest(high, 252)
float lo252 = ta.lowest(low, 252)
float pctHi = hi252 > 0 ? (close - hi252) / hi252 * 100.0 : 0.0
float rocBase = lo252 > 0 ? (close / lo252 - 1.0) * 100.0 : 0.0
bool postCrashTrap = runnerMode and rocBase > 100 and pctHi < -28 and dist >= 38

int pLen = 8
float pl = ta.pivotlow(low, pLen, pLen)
var float swingLow = na
var float swingHigh = na
float ph = ta.pivothigh(high, pLen, pLen)
if not na(pl)
    swingLow := pl
if not na(ph)
    swingHigh := ph

var float actHigh = na
var int structUp = 0
float phs = ta.pivothigh(high, 5, 5)
if not na(phs)
    actHigh := phs
bool brokeUp = barOk and not na(actHigh) and close > actHigh and close[1] <= actHigh
if brokeUp
    structUp := 1
    actHigh := na

bool supBreak = barOk and not na(swingLow) and close < swingLow and close[1] >= swingLow
bool retest = barOk and not na(swingLow) and low <= swingLow * 1.006 and close > swingLow
bool rawBreak = brokeUp and rvol >= 1.2
var float brkHoldLvl = na
var int brkHoldBars = 0
if barstate.isconfirmed
    if rawBreak
        brkHoldLvl := nz(swingHigh, close[1])
        brkHoldBars := 1
    else if not na(brkHoldLvl) and close > brkHoldLvl
        brkHoldBars += 1
    else
        brkHoldLvl := na
        brkHoldBars := 0
bool breakConfirmed = barOk and not na(brkHoldLvl) and brkHoldBars >= breakConfirmBars and (rvol >= 1.2 or rvol[1] >= 1.2)
bool breakRetest = retest and structUp == 1
bool fakeUp = barOk and not na(swingHigh) and high > swingHigh and close < swingHigh and rvol > 1.05
bool pullback7 = structUp == 1 and close > ema50 and low <= ema21 and close > ema21

float zw = atr * 0.35
float buyTop = nz(swingLow, low) + zw
float buyBot = nz(swingLow, low) - zw * 1.2
bool atZone = low <= buyTop and close >= buyBot

float swingR = nz(swingHigh - swingLow, atr * 4)
float t1 = na(swingHigh) ? close + atr * 2.5 : swingHigh
float t2 = nz(swingLow, close) + swingR * 1.618
float entryPx = (buyTop + buyBot) / 2.0
float stopPx = buyBot - atr * 0.6
float riskPx = math.max(entryPx - stopPx, syminfo.mintick)
float rr = riskPx > 0 ? (t1 - entryPx) / riskPx : na
float tHalf = entryPx + (t1 - entryPx) * 0.5

bool chase = pctHi > -3 and rsi > 72
bool vetoHard = supBreak or fakeUp or postCrashTrap or (runnerMode and dist >= 55)
bool vetoSoft = bearMkt or nearLimit or chase

int cycle = 3
if runnerMode
    if supBreak
        cycle := 11
    else if dist >= 65 or (dist >= 55 and pctHi > -5)
        cycle := 9
    else if chase and structUp == 1
        cycle := 8
    else if pullback7
        cycle := 7
    else if structUp == 1 and close > ema21
        cycle := 6
    else if breakConfirmed
        cycle := 5
    else if acc >= effAccBuy
        cycle := 4


float spread = high - low
float closePos = spread > syminfo.mintick ? (close - low) / spread : 0.5
bool wyckSC = rvol >= 2.0 and closePos > 0.55 and low <= ta.lowest(low, 12)

int setupHits = 0
setupHits += bullStack or (htfBull and close > ema50) ? 1 : 0
setupHits += htfBull ? 1 : 0
setupHits += macdBull ? 1 : 0
setupHits += acc >= effAccBuy ? 1 : 0
setupHits += dist < effDistMax ? 1 : 0
setupHits += rsLeader ? 1 : 0
setupHits += structUp == 1 or breakConfirmed ? 1 : 0
setupHits += atZone or retest or pullback7 ? 1 : 0
setupHits += not na(rr) and rr >= effRR ? 1 : 0
setupHits += mtfOk ? 1 : 0
setupHits += rvol >= 1.0 ? 1 : 0
setupHits += runnerMode ? (cycle >= 4 and cycle <= 7 ? 1 : 0) : (accumulating ? 1 : 0)
int setupTierNum = setupHits >= 9 ? 4 : setupHits >= 7 ? 3 : setupHits >= 5 ? 2 : 1

float score = (bullStack ? 18.0 : 0.0) + (htfBull ? 14.0 : 0.0) + (acc >= 50 ? 14.0 : 0.0) + (rsLeader ? 8.0 : 0.0) - (dist >= 45 ? 10.0 : 0.0)
score := math.min(100.0, score)
float rank = math.min(100.0, score * 0.55 + setupHits / 11.0 * 45.0)
float opportunity = math.min(100.0, acc * 0.3 + rank * 0.3 + (100.0 - dist) * 0.2 + setupHits / 11.0 * 20.0)

bool gateLoc = atZone or retest or breakRetest or (pullback7 and cycle == 7) or (breakConfirmed and cycle == 5) or (wyckSC and atZone and cycle <= 4)
int gatesPass = (liqOk ? 1 : 0) + (mtfOk ? 1 : 0) + (not na(rr) and rr >= effRR ? 1 : 0) + (acc >= effAccBuy ? 1 : 0) + (dist < effDistMax ? 1 : 0) + (gateLoc ? 1 : 0) + (rsLeader or htfBull ? 1 : 0) + (not vetoHard and not vetoSoft ? 1 : 0)

bool zoneReady = liqOk and not vetoHard and acc >= effAccBuy - 3 and dist < effDistMax + 5 and not na(rr) and rr >= effRR and gatesPass >= effGates - 1
bool buyCore = barOk and zoneReady and rank >= effRank and gateLoc and not vetoSoft and (runnerMode ? cycle >= 4 and cycle <= 7 : accumulating and retest)
bool canBuyRunner = runnerMode and barOk and zoneReady and rank >= effRank and cycle >= 4 and cycle <= 7 and gateLoc and not vetoSoft
bool canBuyDaily = not runnerMode and barOk and zoneReady and rank >= effRank and accumulating and retest and gateLoc
bool canBuy = canBuyRunner or canBuyDaily

float runnerDna = 0.0
runnerDna += cycle <= 4 ? 18.0 : cycle <= 7 ? 12.0 : 0.0
runnerDna += acc >= 55 ? 22.0 : acc >= 45 ? 12.0 : 0.0
runnerDna += dist < 40 ? 18.0 : dist < 50 ? 10.0 : 0.0
runnerDna += squeezeOn ? 12.0 : 0.0
runnerDna += rvol252 >= 1.1 or rvol >= 1.3 ? 10.0 : 0.0
runnerDna += rsLeader ? 10.0 : 0.0
runnerDna := math.min(100.0, runnerDna)

bool screenerPass = canBuy and rank >= effRank and setupTierNum >= 2
bool screenerPro = screenerPass and opportunity >= 60 and gatesPass >= effGates and dist < 45
bool screenerUltra = proMode and (screenerPro or canBuy) and runnerDna >= minDnaIn and setupTierNum >= 3 and gatesPass >= effGates and not postCrashTrap

bool longEntry = entryProfile == "مرآة قرار" ? canBuy : entryProfile == "Ultra ST" ? (barOk and screenerUltra) : buyCore
longEntry := longEntry and (not ultraOnly or screenerUltra)
longEntry := longEntry and (not useVolStGate or volPassSt)
longEntry := longEntry and sessionPhaseOk and not sundaySkip and not mktHalt100
bool addEntry = allowAdd and barOk and zoneReady and cycle == 7 and pullback7 and strategy.position_size > 0
bool exitSig = barOk and (supBreak or dist >= 65 or fakeUp or postCrashTrap or (runnerMode and cycle == 9) or (cycle == 8 and chase))
bool trimSig = trimC8 and barOk and cycle == 8 and dist >= 50 and strategy.position_size > 0

float exitLim = tgt == "T2" ? t2 : t1
var bool tookHalf = false
var float trailStop = na

if strategy.position_size == 0
    tookHalf := false
    trailStop := na

float entryQtyPct = math.max(0.5, math.min(15.0, math.min(riskPctEq * close / math.max(close - stopPx, syminfo.mintick), strategy.equity > 0 ? volMa * close * (partCapPct / 100.0) / strategy.equity * 100.0 : 10.0)))

if longEntry and strategy.position_size == 0
    if useRiskQty
        strategy.entry("Q", strategy.long, qty_percent=entryQtyPct)
    else
        strategy.entry("Q", strategy.long)
    tookHalf := false
    trailStop := stopPx

if addEntry
    strategy.entry("ADD", strategy.long, qty_percent=addPct, comment="C7")

if strategy.position_size > 0
    if usePartial and not tookHalf and high >= tHalf
        strategy.close("Q", qty_percent=50, comment="50%")
        strategy.close("ADD", qty_percent=50, comment="50%")
        tookHalf := true
        trailStop := math.max(nz(trailStop, stopPx), entryPx)
    if useTrail and tookHalf
        trailStop := math.max(nz(trailStop, stopPx), close - atr * trailMult)
    float st = useTrail and tookHalf and not na(trailStop) ? trailStop : stopPx
    strategy.exit("QX", "Q", stop=st, limit=exitLim)
    strategy.exit("AX", "ADD", stop=st, limit=exitLim)

if trimSig
    strategy.close("Q", qty_percent=25, comment="Trim8")
    strategy.close("ADD", qty_percent=25, comment="Trim8")

if exitSig and strategy.position_size > 0
    strategy.close_all(comment="Exit")

plot(longEntry ? 1 : 0, "EGXQ_ST_Buy", display=display.data_window)
plot(canBuy ? 1 : 0, "EGXQ_ST_CanBuy", display=display.data_window)
plot(buyCore ? 1 : 0, "EGXQ_ST_BuyCore", display=display.data_window)
plot(screenerUltra ? 1 : 0, "EGXQ_ST_Ultra", display=display.data_window)
plot(runnerMode ? runnerDna : na, "EGXQ_ST_DNA", display=display.data_window)
plot(mirrorBuyPlot and canBuy ? 1 : 0, "EGXQ_Buy", display=display.data_window)
plot(mirrorBuyPlot and screenerUltra ? 1 : 0, "EGXQ_ScreenerUltra", display=display.data_window)
plot(mirrorBuyPlot and screenerPro ? 1 : 0, "EGXQ_ScreenerPro", display=display.data_window)
plot(volRankSt, "EGXQ_ST_VolRank", display=display.data_window)
plot(volPassSt ? 1 : 0, "EGXQ_ST_VolPass", display=display.data_window)
plot(opportunity, "EGXQ_Opportunity", display=display.data_window)
plot(setupTierNum, "EGXQ_SetupTier", display=display.data_window)

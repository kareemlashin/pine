//@version=6
indicator("EGX Volume Bollinger", shorttitle="EGX VBB", overlay=false, max_tables_count=2, calc_bars_count=5000)

// Bollinger على الحجم · docs/EGX_VOLUME.md

string G = "BB"
int len = input.int(20, "Length", group=G)
float mult = input.float(2.0, "Mult", step=0.25, group=G)

float basis = ta.sma(volume, len)
float dev = mult * ta.stdev(volume, len)
float upper = basis + dev
float lower = math.max(basis - dev, 0)

bool squeeze = (upper - lower) / math.max(basis, 1.0) < 0.5
bool breakUp = volume > upper
bool breakDn = volume < lower and volume > 0

plot(volume, "Vol", style=plot.style_columns, color=color.new(breakUp ? color.orange : color.gray, 55))
plot(basis, "Basis", color=color.yellow, linewidth=2)
plot(upper, "Upper", color=color.red, linewidth=1)
plot(lower, "Lower", color=color.lime, linewidth=1)

var table t = table.new(position.top_right, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "Vol BB", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, breakUp ? "UP band" : squeeze ? "Squeeze" : "—", text_size=size.tiny)

plot(breakUp ? 1 : 0, "EGVBB_BreakUp", display=display.all)
plot(squeeze ? 1 : 0, "EGVBB_Squeeze", display=display.all)
plot(volume / math.max(basis, 1.0), "EGVBB_Ratio", display=display.all)

alertcondition(breakUp, "Vol BB break", "Volume above upper band")

//@version=6
indicator("EGX Volume Absorption — high V · tight range", shorttitle="EGX VAbs", overlay=true, max_labels_count=80, max_tables_count=2, calc_bars_count=5000)

// امتصاص: حجم كبير + مدى ضيق · docs/EGX_VOLUME.md

string G = "VSA"
int volMa = input.int(20, "MA حجم", group=G)
float rvolMin = input.float(1.5, "RVOL حد", group=G)
float rangeMax = input.float(0.55, "مدى/ATR max", minval=0.3, maxval=0.9, step=0.05, group=G)
int rangeLen = input.int(14, "ATR", group=G)

float vma = ta.sma(volume, volMa)
float rvol = volume / math.max(vma, 1.0)
float atr = ta.atr(rangeLen)
float rng = math.max(high - low, syminfo.mintick)
float rngRatio = rng / math.max(atr, syminfo.mintick)
float cp = (close - low) / rng

bool absorb = rvol >= rvolMin and rngRatio <= rangeMax
bool bullAbs = absorb and cp >= 0.55 and close >= open
bool bearAbs = absorb and cp <= 0.45 and close <= open

plotshape(bullAbs, "Bull absorb", shape.diamond, location.belowbar, color=color.teal, size=size.small, text="Abs+")
plotshape(bearAbs, "Bear absorb", shape.diamond, location.abovebar, color=color.maroon, size=size.small, text="Abs-")
bgcolor(absorb ? color.new(bullAbs ? color.teal : bearAbs ? color.red : color.gray, 90) : na)

var table t = table.new(position.top_left, 2, 3, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 1, 2)
    table.cell(t, 0, 0, "Absorption", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, bullAbs ? "Bull" : bearAbs ? "Bear" : absorb ? "Mix" : "—", text_size=size.tiny)
    table.cell(t, 0, 1, "RVOL/Rng", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(rvol, "#.##") + " · " + str.tostring(rngRatio, "#.##"), text_size=size.tiny)

plot(bullAbs ? 1 : 0, "EGVAbs_Bull", display=display.all)
plot(bearAbs ? 1 : 0, "EGVAbs_Bear", display=display.all)
plot(absorb ? 1 : 0, "EGVAbs_Any", display=display.all)

alertcondition(bullAbs, "Bull absorb", "EGX bull absorption")
alertcondition(bearAbs, "Bear absorb", "EGX bear absorption")
